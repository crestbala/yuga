//! Retained Maya scene: analytic-sphere tracer and top-down 2D map.

import "math.yuga"

struct Rec {
    used: int,
    px: float,
    py: float,
    pz: float,
    wx: float,
    wy: float,
    wz: float,
    radius: float,
    rgb: int,
    glow: int,
    parent: int,
    orb_r: int,
    orb_ms: int,
    phase: int,
    angle: float,
    sx: float,
    sy: float,
    sr: float,
    sorbit: float,
    name: string,
}

struct V3 {
    x: float,
    y: float,
    z: float,
}

let U: float = 1024.0
let MAX_B: int = 32

let mut bodies: []Rec = []Rec {}
let mut nbody: int = 0
let mut inited: int = 0
let mut win_w: int = 960
let mut win_h: int = 540
let mut win_title: string = "Maya"
let mut pix: []int = []int {}
let mut pix_w: int = 0
let mut pix_h: int = 0
let mut cam_ex: float = 0.0
let mut cam_ey: float = 1800.0 / 1024.0
let mut cam_ez: float = 6400.0 / 1024.0
let mut cam_tx: float = 0.0
let mut cam_ty: float = 0.0
let mut cam_tz: float = 0.0
let mut cam_fov: float = 55.0 * 3.141592653589793 / 180.0
let mut cam_yaw: float = 0.0
let mut cam_pitch: float = 0.0
let mut cam_dist: float = 6.0
let mut cam_iex: float = 0.0
let mut cam_iey: float = 1800.0 / 1024.0
let mut cam_iez: float = 6400.0 / 1024.0
let mut cam_itx: float = 0.0
let mut cam_ity: float = 0.0
let mut cam_itz: float = 0.0
let mut cam_inited: int = 0
let mut ambient_rgb: int = 789012
let mut clear_rgb: int = 131592
let mut t0_ms: int = 0
let mut map_mode: int = 0
let mut view_w: int = 0
let mut view_h: int = 0
let mut paused: int = 0
let mut time_scale: float = 1.0
let mut fps_ema: float = 0.0
let mut fps_shown: int = -1
let mut hud: string = ""

fn u2(v: int) -> float {
    return (v as float) / U
}

fn clampi(v: int, lo: int, hi: int) -> int {
    if v < lo {
        return lo
    }
    if v > hi {
        return hi
    }
    return v
}

fn ch_r(rgb: int) -> int {
    return rgb / 65536
}

fn ch_g(rgb: int) -> int {
    return (rgb / 256) % 256
}

fn ch_b(rgb: int) -> int {
    return rgb % 256
}

fn vsub(a: V3, b: V3) -> V3 {
    return V3 { x: a.x - b.x, y: a.y - b.y, z: a.z - b.z }
}

fn vdot(a: V3, b: V3) -> float {
    return a.x * b.x + a.y * b.y + a.z * b.z
}

fn vnorm(v: V3) -> V3 {
    let n = math.fsqrt(vdot(v, v))
    if n < 1e-12 {
        return v
    }
    return V3 { x: v.x / n, y: v.y / n, z: v.z / n }
}

fn vcross(a: V3, b: V3) -> V3 {
    return V3 {
        x: a.y * b.z - a.z * b.y,
        y: a.z * b.x - a.x * b.z,
        z: a.x * b.y - a.y * b.x,
    }
}

fn vscale(v: V3, s: float) -> V3 {
    return V3 { x: v.x * s, y: v.y * s, z: v.z * s }
}

fn vadd(a: V3, b: V3) -> V3 {
    return V3 { x: a.x + b.x, y: a.y + b.y, z: a.z + b.z }
}

fn empty_rec() -> Rec {
    return Rec {
        used: 1,
        px: 0.0,
        py: 0.0,
        pz: 0.0,
        wx: 0.0,
        wy: 0.0,
        wz: 0.0,
        radius: 200.0 / U,
        rgb: 13421772,
        glow: 0,
        parent: 0,
        orb_r: 0,
        orb_ms: 0,
        phase: 0,
        angle: 0.0,
        sx: 0.0,
        sy: 0.0,
        sr: 0.0,
        sorbit: 0.0,
        name: "",
    }
}

fn append_str(buf: &mut []int, s: string) {
    for i in 0..s.len {
        push(buf, s[i])
    }
}

fn append_int(buf: &mut []int, n: int) {
    if n < 0 {
        push(buf, 45)
        append_int(buf, -n)
        return
    }
    if n == 0 {
        push(buf, 48)
        return
    }
    let mut digits = []int {}
    let mut x = n
    while x > 0 {
        push(digits, 48 + x % 10)
        x = x / 10
    }
    let mut i = digits.len
    while i > 0 {
        i -= 1
        push(buf, digits[i])
    }
}

fn refresh_hud() {
    let mut b = []int {}
    if map_mode == 0 {
        if fps_shown >= 0 {
            append_int(&mut b, fps_shown)
            append_str(&mut b, " fps   drag orbit  scroll zoom  shift-drag pan  R reset")
        } else {
            append_str(&mut b, "drag orbit  scroll zoom  shift-drag pan  R reset")
        }
    } else {
        if fps_shown >= 0 {
            append_int(&mut b, fps_shown)
            append_str(&mut b, " fps   ")
        }
        if paused != 0 {
            append_str(&mut b, "paused   +/- speed   space resume")
        } else {
            if time_scale >= 1.0 {
                append_int(&mut b, time_scale as int)
                append_str(&mut b, "x   +/- speed   space pause")
            } else {
                append_str(&mut b, "slow   +/- speed   space pause")
            }
        }
    }
    hud = string_from_bytes(b)
}

fn do_init(now_ms: int) {
    if inited != 0 {
        return
    }
    nbody = 0
    inited = 1
    t0_ms = now_ms
    map_mode = 0
    paused = 0
    time_scale = 1.0
    fps_ema = 0.0
    fps_shown = -1
    refresh_hud()
}

fn do_window(title: string, width: int, height: int) {
    let mut w = width
    let mut h = height
    if w < 64 {
        w = 64
    }
    if h < 64 {
        h = 64
    }
    if w > 1920 {
        w = 1920
    }
    if h > 1080 {
        h = 1080
    }
    win_w = w
    win_h = h
    if title.len > 0 {
        win_title = title
    } else {
        win_title = "Maya"
    }
}

fn do_flat() {
    map_mode = 1
}

fn do_name(id: int, label: string) {
    if id < 1 {
        return
    }
    if id > nbody {
        return
    }
    bodies[id - 1].name = label
}

fn do_add() -> int {
    if nbody >= MAX_B {
        return 0
    }
    push(bodies, empty_rec())
    nbody = bodies.len
    return nbody
}

fn do_pos(id: int, x: int, y: int, z: int) {
    if id < 1 {
        return
    }
    if id > nbody {
        return
    }
    let i = id - 1
    bodies[i].px = u2(x)
    bodies[i].py = u2(y)
    bodies[i].pz = u2(z)
    if bodies[i].orb_ms == 0 {
        bodies[i].wx = bodies[i].px
        bodies[i].wy = bodies[i].py
        bodies[i].wz = bodies[i].pz
    }
}

fn do_scale(id: int, s: int) {
    if id < 1 {
        return
    }
    if id > nbody {
        return
    }
    let mut v = s
    if v < 1 {
        v = 1
    }
    bodies[id - 1].radius = u2(v)
}

fn do_tint(id: int, rgb: int) {
    if id < 1 {
        return
    }
    if id > nbody {
        return
    }
    bodies[id - 1].rgb = rgb % 16777216
}

fn do_glow(id: int, amount: int) {
    if id < 1 {
        return
    }
    if id > nbody {
        return
    }
    bodies[id - 1].glow = clampi(amount, 0, 256)
}

fn do_orbit(id: int, around: int, radius: int, period_ms: int) {
    if id < 1 {
        return
    }
    if id > nbody {
        return
    }
    let i = id - 1
    let mut r = radius
    if r < 0 {
        r = -r
    }
    let mut ms = period_ms
    if ms < 1 {
        ms = 1
    }
    bodies[i].parent = around
    bodies[i].orb_r = r
    bodies[i].orb_ms = ms
    bodies[i].phase = math.wrap1024(id * 179)
    bodies[i].angle = (bodies[i].phase as float) * math.TAU / 1024.0
}

fn cam_apply() {
    let cp = math.fcos(cam_pitch)
    let sp = math.fsin(cam_pitch)
    let cy = math.fcos(cam_yaw)
    let sy = math.fsin(cam_yaw)
    cam_ex = cam_tx + cam_dist * cp * sy
    cam_ey = cam_ty + cam_dist * sp
    cam_ez = cam_tz + cam_dist * cp * cy
}

fn do_look(ex: int, ey: int, ez: int, tx: int, ty: int, tz: int) {
    cam_ex = u2(ex)
    cam_ey = u2(ey)
    cam_ez = u2(ez)
    cam_tx = u2(tx)
    cam_ty = u2(ty)
    cam_tz = u2(tz)
    cam_iex = cam_ex
    cam_iey = cam_ey
    cam_iez = cam_ez
    cam_itx = cam_tx
    cam_ity = cam_ty
    cam_itz = cam_tz
    let dx = cam_ex - cam_tx
    let dy = cam_ey - cam_ty
    let dz = cam_ez - cam_tz
    cam_dist = math.fsqrt(dx * dx + dy * dy + dz * dz)
    if cam_dist < 0.25 {
        cam_dist = 0.25
    }
    let xz = math.fsqrt(dx * dx + dz * dz)
    let mut den = xz
    if den < 1e-9 {
        den = 1e-9
    }
    cam_yaw = math.fatan2(dx, dz)
    cam_pitch = math.fatan2(dy, den)
    cam_inited = 1
}

fn do_fov(milli_deg: int) {
    let mut m = milli_deg
    if m < 10000 {
        m = 10000
    }
    if m > 120000 {
        m = 120000
    }
    cam_fov = (m as float) * 0.001 * 3.141592653589793 / 180.0
}

fn do_ambient(rgb: int) {
    ambient_rgb = rgb % 16777216
}

fn do_clear(rgb: int) {
    clear_rgb = rgb % 16777216
}

fn map_layout() {
    if view_w < 1 {
        view_w = win_w
    }
    if view_h < 1 {
        view_h = win_h
    }
    let mut m = view_w as float
    if view_h < view_w {
        m = view_h as float
    }
    let rmin = m * 0.09
    let rmax = m * 0.46
    let cx = (view_w as float) * 0.5
    let cy = (view_h as float) * 0.5
    let k = m / 720.0
    let mut max_orb = 1.0
    for i in 0..nbody {
        if bodies[i].orb_ms != 0 {
            let r = bodies[i].orb_r as float
            if r > max_orb {
                max_orb = r
            }
        }
    }
    for pass in 0..8 {
        for i in 0..nbody {
            bodies[i].sr = bodies[i].radius * U * k
            if bodies[i].sr < 2.0 {
                bodies[i].sr = 2.0
            }
            if bodies[i].orb_ms == 0 {
                bodies[i].sx = cx
                bodies[i].sy = cy
                bodies[i].sorbit = 0.0
            } else {
                let mut ox = cx
                let mut oy = cy
                if bodies[i].parent != 0 {
                    let p = bodies[i].parent
                    if p >= 1 {
                        if p <= nbody {
                            ox = bodies[p - 1].sx
                            oy = bodies[p - 1].sy
                        }
                    }
                }
                let R = rmin + ((bodies[i].orb_r as float) / max_orb) * (rmax - rmin)
                bodies[i].sorbit = R
                bodies[i].sx = ox + R * math.fcos(bodies[i].angle)
                bodies[i].sy = oy + R * math.fsin(bodies[i].angle)
            }
        }
    }
}

fn is_map() -> int {
    return map_mode
}

fn set_viewport(w: int, h: int) {
    let mut vw = w
    let mut vh = h
    if vw < 64 {
        vw = 64
    }
    if vh < 64 {
        vh = 64
    }
    view_w = vw
    view_h = vh
    if map_mode != 0 {
        map_layout()
        return
    }
    let mut rw = vw
    let mut rh = vh
    if rw > 640 {
        rh = rh * 640 / rw
        rw = 640
    }
    if rh > 360 {
        rw = rw * 360 / rh
        rh = 360
    }
    if rw < 160 {
        rw = 160
    }
    if rh < 90 {
        rh = 90
    }
    win_w = rw
    win_h = rh
}

fn fixed_update(dt_ms: int) {
    if map_mode == 0 {
        return
    }
    let mut dt = (dt_ms as float) / 1000.0
    if dt < 0.0 {
        dt = 0.0
    }
    if paused == 0 {
        for i in 0..nbody {
            if bodies[i].orb_ms != 0 {
                let mut t_wall = (bodies[i].orb_ms as float) / 1000.0
                if t_wall < 1e-6 {
                    t_wall = 1e-6
                }
                let omega = math.TAU / t_wall
                bodies[i].angle = bodies[i].angle + omega * dt * time_scale
                while bodies[i].angle > math.TAU {
                    bodies[i].angle = bodies[i].angle - math.TAU
                }
                while bodies[i].angle < -math.TAU {
                    bodies[i].angle = bodies[i].angle + math.TAU
                }
            }
        }
    }
    map_layout()
}

fn ensure_cam() {
    if cam_inited == 0 {
        do_look(0, 1800, 6400, 0, 0, 0)
    }
}

fn cam_orbit(dx: int, dy: int) {
    if map_mode != 0 {
        return
    }
    ensure_cam()
    cam_yaw = cam_yaw - (dx as float) * 0.007
    cam_pitch = cam_pitch + (dy as float) * 0.007
    if cam_pitch > 1.45 {
        cam_pitch = 1.45
    }
    if cam_pitch < -1.45 {
        cam_pitch = -1.45
    }
    cam_apply()
}

fn cam_zoom(dy100: int) {
    if map_mode != 0 {
        return
    }
    ensure_cam()
    let dy = (dy100 as float) / 100.0
    let k = math.fexp(-dy * 0.015)
    cam_dist = cam_dist * k
    if cam_dist < 0.35 {
        cam_dist = 0.35
    }
    if cam_dist > 80.0 {
        cam_dist = 80.0
    }
    cam_apply()
}

fn cam_pan(dx: int, dy: int) {
    if map_mode != 0 {
        return
    }
    ensure_cam()
    let eye = V3 { x: cam_ex, y: cam_ey, z: cam_ez }
    let tgt = V3 { x: cam_tx, y: cam_ty, z: cam_tz }
    let fwd = vnorm(vsub(tgt, eye))
    let world_up = V3 { x: 0.0, y: 1.0, z: 0.0 }
    let right = vnorm(vcross(fwd, world_up))
    let up = vnorm(vcross(right, fwd))
    let s = cam_dist * 0.0018
    let fx = (-right.x * (dx as float) + up.x * (dy as float)) * s
    let fy = (-right.y * (dx as float) + up.y * (dy as float)) * s
    let fz = (-right.z * (dx as float) + up.z * (dy as float)) * s
    cam_tx = cam_tx + fx
    cam_ty = cam_ty + fy
    cam_tz = cam_tz + fz
    cam_apply()
}

fn cam_reset() {
    if map_mode != 0 {
        return
    }
    do_look(
        (cam_iex * U) as int,
        (cam_iey * U) as int,
        (cam_iez * U) as int,
        (cam_itx * U) as int,
        (cam_ity * U) as int,
        (cam_itz * U) as int,
    )
}

fn input_key(key: int) {
    if map_mode != 0 {
        if key == 32 {
            if paused != 0 {
                paused = 0
            } else {
                paused = 1
            }
        } else if key == 43 {
            time_scale = time_scale * 2.0
            if time_scale > 64.0 {
                time_scale = 64.0
            }
            paused = 0
        } else if key == 61 {
            time_scale = time_scale * 2.0
            if time_scale > 64.0 {
                time_scale = 64.0
            }
            paused = 0
        } else if key == 45 {
            time_scale = time_scale * 0.5
            if time_scale < 0.0625 {
                time_scale = 0.0625
            }
        } else if key == 95 {
            time_scale = time_scale * 0.5
            if time_scale < 0.0625 {
                time_scale = 0.0625
            }
        }
        refresh_hud()
        return
    }
    if key == 114 {
        cam_reset()
    } else if key == 82 {
        cam_reset()
    } else if key == 97 {
        cam_orbit(14, 0)
    } else if key == 65 {
        cam_orbit(14, 0)
    } else if key == 100 {
        cam_orbit(-14, 0)
    } else if key == 68 {
        cam_orbit(-14, 0)
    } else if key == 119 {
        cam_orbit(0, 14)
    } else if key == 87 {
        cam_orbit(0, 14)
    } else if key == 115 {
        cam_orbit(0, -14)
    } else if key == 83 {
        cam_orbit(0, -14)
    } else if key == 113 {
        cam_zoom(-800)
    } else if key == 81 {
        cam_zoom(-800)
    } else if key == 45 {
        cam_zoom(-800)
    } else if key == 95 {
        cam_zoom(-800)
    } else if key == 101 {
        cam_zoom(800)
    } else if key == 69 {
        cam_zoom(800)
    } else if key == 43 {
        cam_zoom(800)
    } else if key == 61 {
        cam_zoom(800)
    }
}

fn note_present(dt_ms: int) {
    if dt_ms < 1 {
        return
    }
    let mut d = dt_ms
    if d > 1000 {
        d = 1000
    }
    let fps = 1000.0 / (d as float)
    if fps_ema <= 0.0 {
        fps_ema = fps
    } else {
        fps_ema = fps_ema * 0.9 + fps * 0.1
    }
    let mut shown = (fps_ema + 0.5) as int
    if shown < 0 {
        shown = 0
    }
    if shown > 999 {
        shown = 999
    }
    if shown != fps_shown {
        fps_shown = shown
        refresh_hud()
    }
}

fn sprite_count() -> int {
    return nbody
}

fn sprite_x(i: int) -> int {
    if i < 0 {
        return 0
    }
    if i >= nbody {
        return 0
    }
    return bodies[i].sx as int
}

fn sprite_y(i: int) -> int {
    if i < 0 {
        return 0
    }
    if i >= nbody {
        return 0
    }
    return bodies[i].sy as int
}

fn sprite_r(i: int) -> int {
    if i < 0 {
        return 0
    }
    if i >= nbody {
        return 0
    }
    return bodies[i].sr as int
}

fn sprite_orbit_r(i: int) -> int {
    if i < 0 {
        return 0
    }
    if i >= nbody {
        return 0
    }
    return bodies[i].sorbit as int
}

fn sprite_rgb(i: int) -> int {
    if i < 0 {
        return 0
    }
    if i >= nbody {
        return 0
    }
    return bodies[i].rgb
}

fn sprite_is_sun(i: int) -> int {
    if i < 0 {
        return 0
    }
    if i >= nbody {
        return 0
    }
    if bodies[i].glow > 0 {
        return 1
    }
    return 0
}

fn sprite_name(i: int) -> string {
    if i < 0 {
        return ""
    }
    if i >= nbody {
        return ""
    }
    return bodies[i].name
}

fn hud_text() -> string {
    if hud.len == 0 {
        refresh_hud()
    }
    return hud
}

fn window_title() -> string {
    return win_title
}

fn window_w() -> int {
    return win_w
}

fn window_h() -> int {
    return win_h
}

fn fb_w() -> int {
    return pix_w
}

fn fb_h() -> int {
    return pix_h
}

fn fb_at(i: int) -> int {
    if i < 0 {
        return 0
    }
    if i >= pix.len {
        return 0
    }
    return pix[i]
}

fn to_u8(x: float) -> int {
    let mut t = x
    if t < 0.0 {
        t = 0.0
    }
    if t > 1.0 {
        t = 1.0
    }
    return (t * 255.0 + 0.5) as int
}

fn pack_rgb(r: float, g: float, b: float) -> int {
    return to_u8(r) * 65536 + to_u8(g) * 256 + to_u8(b)
}

fn ensure_fb(w: int, h: int) {
    let need = w * h
    while pix.len < need {
        push(pix, 0)
    }
    pix_w = w
    pix_h = h
}

fn update_orbits(ms: int) {
    for pass in 0..8 {
        for i in 0..nbody {
            if bodies[i].orb_ms == 0 {
                bodies[i].wx = bodies[i].px
                bodies[i].wy = bodies[i].py
                bodies[i].wz = bodies[i].pz
            } else {
                let mut ox = 0.0
                let mut oy = 0.0
                let mut oz = 0.0
                if bodies[i].parent != 0 {
                    let p = bodies[i].parent
                    if p >= 1 {
                        if p <= nbody {
                            ox = bodies[p - 1].wx
                            oy = bodies[p - 1].wy
                            oz = bodies[p - 1].wz
                        }
                    }
                }
                let period = bodies[i].orb_ms
                let turns = math.wrap1024(bodies[i].phase + (ms % period) * 1024 / period)
                let c = math.cos_turns(turns)
                let s = math.sin_turns(turns)
                bodies[i].wx = ox + ((c * bodies[i].orb_r) as float) / (U * U)
                bodies[i].wy = oy
                bodies[i].wz = oz + ((s * bodies[i].orb_r) as float) / (U * U)
            }
        }
    }
}

fn hit_sphere(ro: V3, rd: V3, i: int) -> V3 {
    let c = V3 { x: bodies[i].wx, y: bodies[i].wy, z: bodies[i].wz }
    let oc = vsub(ro, c)
    let b = vdot(oc, rd)
    let ctm = vdot(oc, oc) - bodies[i].radius * bodies[i].radius
    let disc = b * b - ctm
    if disc < 0.0 {
        return V3 { x: 0.0, y: 0.0, z: -1.0 }
    }
    let s = math.fsqrt(disc)
    let mut t = -b - s
    if t < 1e-4 {
        t = -b + s
    }
    if t < 1e-4 {
        return V3 { x: 0.0, y: 0.0, z: -1.0 }
    }
    let n = vnorm(V3 {
        x: ro.x + rd.x * t - c.x,
        y: ro.y + rd.y * t - c.y,
        z: ro.z + rd.z * t - c.z,
    })
    return V3 { x: n.x, y: n.y, z: t }
}

fn shade(i: int, hit: V3, N: V3, sun: V3, has_sun: int) -> V3 {
    let cr = (ch_r(bodies[i].rgb) as float) / 255.0
    let cg = (ch_g(bodies[i].rgb) as float) / 255.0
    let cb = (ch_b(bodies[i].rgb) as float) / 255.0
    let ar = (ch_r(ambient_rgb) as float) / 255.0
    let ag = (ch_g(ambient_rgb) as float) / 255.0
    let ab = (ch_b(ambient_rgb) as float) / 255.0
    let em = (bodies[i].glow as float) / 256.0
    if em > 0.01 {
        let k = 0.55 + 0.45 * em
        return V3 { x: cr * k, y: cg * k, z: cb * k }
    }
    let mut L = V3 { x: 0.35, y: 0.8, z: 0.45 }
    if has_sun != 0 {
        L = vsub(sun, hit)
    }
    L = vnorm(L)
    let mut ndl = vdot(N, L)
    if ndl < 0.0 {
        ndl = 0.0
    }
    let mut shadowed = 0
    if has_sun != 0 {
        let ro = V3 { x: hit.x + N.x * 1e-4, y: hit.y + N.y * 1e-4, z: hit.z + N.z * 1e-4 }
        for j in 0..nbody {
            if j != i {
                if bodies[j].glow == 0 {
                    let h = hit_sphere(ro, L, j)
                    if h.z >= 0.0 {
                        let tosun = vsub(sun, ro)
                        if h.z * h.z < vdot(tosun, tosun) {
                            shadowed = 1
                        }
                    }
                }
            }
        }
    }
    if shadowed != 0 {
        ndl = ndl * 0.12
    }
    let H = vnorm(V3 { x: L.x, y: L.y + 1.0, z: L.z })
    let mut spec = vdot(N, H)
    if spec < 0.0 {
        spec = 0.0
    }
    spec = spec * spec
    spec = spec * spec
    spec = spec * 0.28
    return V3 {
        x: cr * (ar * 1.4 + ndl * 0.92) + spec,
        y: cg * (ag * 1.4 + ndl * 0.92) + spec,
        z: cb * (ab * 1.4 + ndl * 0.92) + spec,
    }
}

fn render(w: int, h: int) {
    let eye = V3 { x: cam_ex, y: cam_ey, z: cam_ez }
    let tgt = V3 { x: cam_tx, y: cam_ty, z: cam_tz }
    let fwd = vnorm(vsub(tgt, eye))
    let world_up = V3 { x: 0.0, y: 1.0, z: 0.0 }
    let right = vnorm(vcross(fwd, world_up))
    let up = vnorm(vcross(right, fwd))
    let tan_h = math.ftan(cam_fov * 0.5)
    let aspect = (w as float) / (h as float)
    let mut sun = V3 { x: 0.0, y: 0.0, z: 0.0 }
    let mut has_sun = 0
    for i in 0..nbody {
        if has_sun == 0 {
            if bodies[i].glow > 0 {
                sun = V3 { x: bodies[i].wx, y: bodies[i].wy, z: bodies[i].wz }
                has_sun = 1
            }
        }
    }
    let br = (ch_r(clear_rgb) as float) / 255.0
    let bg = (ch_g(clear_rgb) as float) / 255.0
    let bb = (ch_b(clear_rgb) as float) / 255.0
    for y in 0..h {
        for x in 0..w {
            let ndc_x = ((x as float) + 0.5) / (w as float) * 2.0 - 1.0
            let ndc_y = 1.0 - ((y as float) + 0.5) / (h as float) * 2.0
            let rd = vnorm(V3 {
                x: right.x * ndc_x * tan_h * aspect + up.x * ndc_y * tan_h + fwd.x,
                y: right.y * ndc_x * tan_h * aspect + up.y * ndc_y * tan_h + fwd.y,
                z: right.z * ndc_x * tan_h * aspect + up.z * ndc_y * tan_h + fwd.z,
            })
            let mut best_t = 1e30
            let mut best = -1
            let mut best_n = V3 { x: 0.0, y: 0.0, z: 0.0 }
            for i in 0..nbody {
                let hit = hit_sphere(eye, rd, i)
                if hit.z >= 0.0 {
                    if hit.z < best_t {
                        best_t = hit.z
                        best = i
                        best_n = V3 { x: hit.x, y: hit.y, z: 0.0 }
                        let c = V3 { x: bodies[i].wx, y: bodies[i].wy, z: bodies[i].wz }
                        let p = V3 {
                            x: eye.x + rd.x * best_t,
                            y: eye.y + rd.y * best_t,
                            z: eye.z + rd.z * best_t,
                        }
                        best_n = vnorm(vsub(p, c))
                    }
                }
            }
            let mut col = V3 { x: br, y: bg, z: bb }
            if best >= 0 {
                let p = V3 {
                    x: eye.x + rd.x * best_t,
                    y: eye.y + rd.y * best_t,
                    z: eye.z + rd.z * best_t,
                }
                col = shade(best, p, best_n, sun, has_sun)
            } else {
                let hsh = x * 17 + y * 31
                if hsh % 2048 == 0 {
                    col = V3 { x: 0.85, y: 0.85, z: 0.85 }
                }
            }
            pix[y * w + x] = pack_rgb(col.x, col.y, col.z)
        }
    }
}

fn frame(now_ms: int, headless: int) {
    let mut sec_ms = now_ms - t0_ms
    let mut w = win_w
    let mut h = win_h
    if headless != 0 {
        sec_ms = 2400
        w = 160
        h = 90
    }
    update_orbits(sec_ms)
    ensure_fb(w, h)
    render(w, h)
}
