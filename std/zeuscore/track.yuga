//! Fine-grained reactivity: a tracking-scope stack and a signal → effect map.
//!
//! `styled` / any future tracked closure pushes an effect id. `get(sig)`
//! records that signal as a dependency. `set(sig)` re-runs only those
//! closures. Closures never rebuild the tree.

import "platform.yuga"

let mut stack: []int = []int {}
let mut fn_ids: []int = []int {}
let mut node_ids: []int = []int {}
let mut dep_sig: []int = []int {}
let mut dep_eff: []int = []int {}
let mut ready: int = 0

fn boot() {
    if ready != 0 {
        return
    }
    ready = 1
    push(fn_ids, 0)
    push(node_ids, 0)
}

fn reset() {
    stack = []int {}
    fn_ids = []int {}
    node_ids = []int {}
    dep_sig = []int {}
    dep_eff = []int {}
    ready = 0
    boot()
}

fn alloc(fnid: int, nid: int) -> int {
    boot()
    push(fn_ids, fnid)
    push(node_ids, nid)
    return fn_ids.len - 1
}

fn note_read(sid: int) {
    if stack.len == 0 {
        return
    }
    if sid <= 0 {
        return
    }
    let eid = stack[stack.len - 1]
    let n = dep_sig.len
    for i in 0..n {
        if dep_sig[i] == sid {
            if dep_eff[i] == eid {
                return
            }
        }
    }
    push(dep_sig, sid)
    push(dep_eff, eid)
}

fn drop_eid_deps(eid: int) {
    let mut ns = []int {}
    let mut ne = []int {}
    let n = dep_sig.len
    for i in 0..n {
        if dep_eff[i] != eid {
            push(ns, dep_sig[i])
            push(ne, dep_eff[i])
        }
    }
    dep_sig = ns
    dep_eff = ne
}

fn run(eid: int) {
    boot()
    if eid <= 0 {
        return
    }
    if eid >= fn_ids.len {
        return
    }
    drop_eid_deps(eid)
    push(stack, eid)
    platform.plat_invoke_fn(fn_ids[eid])
    if stack.len > 0 {
        pop(stack)
    }
}

fn run_node(nid: int) {
    boot()
    let n = node_ids.len
    for i in 1..n {
        if node_ids[i] == nid {
            run(i)
        }
    }
}

fn notify(sid: int) {
    if sid <= 0 {
        return
    }
    let mut hit = []int {}
    let n = dep_sig.len
    for i in 0..n {
        if dep_sig[i] == sid {
            let e = dep_eff[i]
            let mut seen = 0
            let h = hit.len
            for j in 0..h {
                if hit[j] == e {
                    seen = 1
                }
            }
            if seen == 0 {
                push(hit, e)
            }
        }
    }
    let h = hit.len
    for i in 0..h {
        run(hit[i])
    }
}
