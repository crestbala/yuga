//! `maya` — small 3D/2D engine (raylib-shaped, not raylib-heavy).
//!
//! Build a retained scene, then `maya.run()`. Scene, tracer, and 2D map
//! live in Yuga (`mayacore/`). C is the host event loop and present.
//!
//! Example (3D sphere):
//! ```
//! import "std:maya"
//!
//! fn main() {
//!     maya.init()
//!     maya.window("hello", 800, 600)
//!     maya.add(maya.sphere(16)).pos(0, 0, 0).scale(512).tint(maya.rgb(200, 80, 80))
//!     maya.run()
//! }
//! ```
//!
//! 3D: analytic spheres, world unit 1024 = 1.0. CPU tracer, Cocoa 2D blit.
//! Camera: drag to orbit, scroll to zoom, shift/right-drag to pan, WASD orbit,
//! Q/E zoom, R reset.
//!
//! 2D: `maya.flat()` draws discs + orbit rings. `name()` labels a body.
//! `scale` is disc radius in 720p pixels. `orbit` period is milliseconds.
//!
//! Sine/cosine: 1024 turns = 360°, result -1024..1024.
//! `sin(0)=0`  `sin(256)=1024`  `sin(512)=0`  `sin(768)=-1024`
//! `cos(t) = sin(t + 256)`
//!
//! `MAYA_HEADLESS=1` / `ZEUS_HEADLESS=1`: one frame, then exit.

import "mayacore/math.yuga"
import "mayacore/scene.yuga"

/// Integer 3D vector. Unit 1024 = 1.0 world.
struct Vec3 {
    x: int,
    y: int,
    z: int,
}

/// A mesh asset (analytic sphere). Copy handle.
struct Mesh {
    id: int,
}

/// An instance of a mesh in the scene. Chain `.pos` / `.scale` / `.tint`.
struct Body {
    id: int,
}

fn plat_run() {}
fn plat_headless() -> int {}
fn plat_window(title: string, w: int, h: int) {}
fn plat_now_ms() -> int {}

/// Build a `Vec3`.
fn vec3(x: int, y: int, z: int) -> Vec3 {
    return Vec3 { x: x, y: y, z: z }
}

/// Pack 0..255 channels into an RGB int (`r*65536 + g*256 + b`).
fn rgb(r: int, g: int, b: int) -> int {
    return r * 65536 + g * 256 + b
}

/// Sine. `turns` is 1024 = 360°. Result is -1024..1024.
fn sin(turns: int) -> int {
    return math.sin_turns(turns)
}

/// Cosine. Same units as `sin`. `cos(t) = sin(t + 256)`.
fn cos(turns: int) -> int {
    return math.cos_turns(turns)
}

/// Initialize the engine. Call once before `window`.
fn init() {
    scene.do_init(plat_now_ms())
}

/// Open a window. Sizes are pixels.
fn window(title: string, width: int, height: int) {
    init()
    scene.do_window(title, width, height)
}

/// Unit sphere mesh. `segments` is a quality hint (unused for analytic spheres).
fn sphere(segments: int) -> Mesh {
    if segments < 0 {
        return Mesh { id: 0 }
    }
    return Mesh { id: 1 }
}

/// Place `mesh` in the scene. Returns a `Body` to position and color.
fn add(mesh: Mesh) -> Body {
    if mesh.id < 0 {
        return Body { id: 0 }
    }
    return Body { id: scene.do_add() }
}

/// Set world position (unit 1024 = 1.0).
fn pos(body: Body, x: int, y: int, z: int) -> Body {
    scene.do_pos(body.id, x, y, z)
    return body
}

/// Uniform scale (unit 1024 = 1.0).
fn scale(body: Body, s: int) -> Body {
    scene.do_scale(body.id, s)
    return body
}

/// Diffuse color (`maya.rgb`).
fn tint(body: Body, rgb: int) -> Body {
    scene.do_tint(body.id, rgb)
    return body
}

/// 0..256. 256 = the body emits light (the sun) and lights others.
fn glow(body: Body, amount: int) -> Body {
    scene.do_glow(body.id, amount)
    return body
}

/// Circle in the XZ plane around `around` (or world origin if `around.id` is 0).
/// `period_ms` is one revolution.
fn orbit(body: Body, around: Body, radius: int, period_ms: int) -> Body {
    scene.do_orbit(body.id, around.id, radius, period_ms)
    return body
}

/// Place the camera: eye `(ex,ey,ez)` looks at `(tx,ty,tz)`.
fn look(ex: int, ey: int, ez: int, tx: int, ty: int, tz: int) {
    scene.do_look(ex, ey, ez, tx, ty, tz)
}

/// Field of view in millidegrees.
fn fov(milli_deg: int) {
    scene.do_fov(milli_deg)
}

/// Ambient light color.
fn ambient(rgb: int) {
    scene.do_ambient(rgb)
}

/// Background clear color.
fn clear(rgb: int) {
    scene.do_clear(rgb)
}

/// Top-down 2D discs. No lighting. Planet data belongs in the app.
fn flat() {
    init()
    scene.do_flat()
}

/// Label a body (2D overlay).
fn name(body: Body, label: string) -> Body {
    scene.do_name(body.id, label)
    return body
}

/// Event loop + vsync present. Returns after the window closes.
fn run() {
    init()
    if plat_headless() != 0 {
        if scene.is_map() != 0 {
            engine_set_viewport(scene.window_w(), scene.window_h())
            engine_fixed_update(8)
        } else {
            engine_frame()
        }
        return
    }
    plat_window(scene.window_title(), scene.window_w(), scene.window_h())
    plat_run()
}

fn engine_is_map() -> int {
    return scene.is_map()
}

fn engine_set_viewport(w: int, h: int) {
    scene.set_viewport(w, h)
}

fn engine_fixed_update(dt_ms: int) {
    scene.fixed_update(dt_ms)
}

fn engine_frame() {
    scene.frame(plat_now_ms(), plat_headless())
}

fn engine_input_key(key: int) {
    scene.input_key(key)
}

fn engine_cam_orbit(dx: int, dy: int) {
    scene.cam_orbit(dx, dy)
}

fn engine_cam_zoom(dy100: int) {
    scene.cam_zoom(dy100)
}

fn engine_cam_pan(dx: int, dy: int) {
    scene.cam_pan(dx, dy)
}

fn engine_cam_reset() {
    scene.cam_reset()
}

fn engine_note_present(dt_ms: int) {
    scene.note_present(dt_ms)
}

fn engine_sprite_count() -> int {
    return scene.sprite_count()
}

fn engine_sprite_x(i: int) -> int {
    return scene.sprite_x(i)
}

fn engine_sprite_y(i: int) -> int {
    return scene.sprite_y(i)
}

fn engine_sprite_r(i: int) -> int {
    return scene.sprite_r(i)
}

fn engine_sprite_orbit_r(i: int) -> int {
    return scene.sprite_orbit_r(i)
}

fn engine_sprite_rgb(i: int) -> int {
    return scene.sprite_rgb(i)
}

fn engine_sprite_is_sun(i: int) -> int {
    return scene.sprite_is_sun(i)
}

fn engine_sprite_name(i: int) -> string {
    return scene.sprite_name(i)
}

fn engine_hud() -> string {
    return scene.hud_text()
}

fn engine_fb_w() -> int {
    return scene.fb_w()
}

fn engine_fb_h() -> int {
    return scene.fb_h()
}

fn engine_fb_at(i: int) -> int {
    return scene.fb_at(i)
}
