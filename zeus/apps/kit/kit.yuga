                ui.Badge(BadgeProps { label: "md", color: theme.accent() }).size(ui.md()).look(ui.soft()),
                ui.Badge(BadgeProps { label: "lg", color: theme.accent() }).size(ui.lg()).look(ui.outline()),
                ui.Badge(BadgeProps { label: "ghost", color: theme.purple() }).size(ui.md()).look(ui.ghost()),
