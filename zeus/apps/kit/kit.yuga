                ui.Button(ButtonProps { label: "Soft", on_press: || { ticks = ticks + 1 } }).size(ui.lg()).look(ui.soft()),
                ui.Button(ButtonProps { label: "Outline", on_press: || { ticks = ticks + 1 } }).size(ui.lg()).look(ui.outline()),
                ui.Button(ButtonProps { label: "Ghost", on_press: || { ticks = ticks + 1 } }).size(ui.lg()).look(ui.ghost()),
                ui.Button(ButtonProps { label: "Danger", on_press: || { ticks = ticks + 1 } }).size(ui.lg()).look(ui.danger()),
