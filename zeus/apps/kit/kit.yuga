        ui.Accordion(AccordionProps { title: "Large soft", body: "Size changes type and padding. The look changes the plate.", open: acc_lg }).size(ui.lg()).look(ui.soft()),
        ui.Empty(EmptyProps { title: "No results", body: "Try another filter. Small empty state." }).size(ui.sm()).look(ui.soft()),
        ui.Empty(EmptyProps { title: "No results", body: "Try another filter. This empty state is a full-width card; the body copy wraps like a paragraph." }),
