            ),
            Note("kbd"),
            Wrap().child(
                ui.Kbd(KbdProps { key: "Esc" }).size(ui.sm()).look(ui.outline()),
                ui.Kbd(KbdProps { key: "⌘S" }).size(ui.md()).look(ui.soft()),
                ui.Kbd(KbdProps { key: "Tab" }).size(ui.lg()).look(ui.solid()),
            ),
            Note("avatars"),
            Wrap().child(
                ui.Avatar(AvatarProps { initials: "SM", color: theme.accent() }).size(ui.sm()).look(ui.solid()),
                ui.Avatar(AvatarProps { initials: "MD", color: theme.purple() }).size(ui.md()).look(ui.soft()),
