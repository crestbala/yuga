                    ui.Checkbox(CheckboxProps { label: "Large", sig: on }).size(ui.lg()).look(ui.danger()),
                ),
                Wrap().child(
                    ui.Switch(SwitchProps { sig: on }).size(ui.sm()).look(ui.soft()),
                    ui.Switch(SwitchProps { sig: on }).size(ui.md()).look(ui.solid()),
                    ui.Switch(SwitchProps { sig: on }).size(ui.lg()).look(ui.danger()),
