                Glyph("LAPTOP", icons.laptop()),
                Glyph("FOLDER", icons.folder()),
                Glyph("GIT BRANCH", icons.git_branch()),
                Glyph("SUN", icons.sun()),
                Glyph("MOON", icons.moon()),
                Glyph("PLAY", icons.play()),
                Glyph("PAUSE", icons.pause()),
                Glyph("STAR", icons.star()),
                Glyph("HEART", icons.heart()),
                Glyph("BELL", icons.bell()),
                Glyph("TERMINAL", icons.terminal()),
                Glyph("PLUS", icons.plus()),
                Glyph("CLOSE", icons.close()),
                Glyph("CHECK", icons.check()),
                Glyph("COPY", icons.copy()),
                Glyph("RETURN", icons.return_key()),
                Glyph("LIST", icons.list()),
                Glyph("TAG", icons.tag()),
                Glyph("KEYBOARD", icons.keyboard()),
            )
        ),
        ui.Snippet(SnippetProps { text: "Wrap().child(ui.Button(ButtonProps { label: \"Save\", on_press: || { ticks = ticks + 1 } }).size(ui.lg()).look(ui.solid()))" }),
        Wrap().child(
            ui.GhostOpen(ButtonProps { label: "Toast", on_press: || { toast_open.set(1) } }),
            ui.Open(ButtonProps { label: "Dialog", on_press: || { note_open.set(1) } }),
        ),
        ui.Body(TypeProps { text: "Primary increments a counter. Radio, select, list, tabs, and pages write signals. Esc dismisses overlays." }),
        ui.Toast(ToastProps { title: "Saved", body: "Your settings were written.", open: toast_open }),
        ui.Dialog(DialogProps { title: "Discard changes?", body: "This cannot be undone. The working tree keeps whatever you have not saved.", cancel: "Cancel", discard: "Discard", open: note_open }),
    ).run()
}
