import "std:zeus"
import "../../lib/theme.yuga"
import "../../lib/ui.yuga"
import "../../lib/ui/icons.yuga"

struct Job {
    title: string,
    meta: string,
    value: int,
}

struct FileRow {
    name: string,
    kind: string,
    size: string,
}

fn Wrap() -> Node {
    return zeus.row().gap(theme.space_sm()).align(zeus.flex_center()).justify(zeus.flex_start()).flex_wrap()
}

fn Note(s: string) -> Node {
    return zeus.label(s).fg(theme.muted()).font(11)
}

fn Orb(n: Node, s: string) -> Node {
    return zeus.col().gap(theme.space_sm()).align(zeus.flex_center()).shrink(0).child(
        n,
        Note(s),
    )
}

fn Glyph(label: string, markup: string) -> Node {
    return zeus.col().w(88).h(76).gap(6).bg(theme.card()).radius(theme.button_radius()).center().shrink(0).child(
        ui.Icon(GlyphProps { markup: markup, color: theme.text(), size: 22 }),
        zeus.label(label).fg(theme.muted()).font(9),
    )
}

fn main() {
    let mut ticks = 0
    let load = zeus.signal(42)
    let page = zeus.signal(4)
    let page_sm = zeus.signal(2)
    let tab = zeus.signal(0)
    let tab_sm = zeus.signal(0)
    let tab_lg = zeus.signal(1)
    let tab_pill = zeus.signal(0)
    let acc = zeus.signal(1)
    let acc_sm = zeus.signal(0)
    let acc_lg = zeus.signal(1)
    let plan = zeus.signal(1)
    let status = zeus.signal(1)
    let picked = zeus.signal(0)
    let count = zeus.signal(3)
    let toast_open = zeus.signal(0)
    let note_open = zeus.signal(0)
    let year = zeus.signal(2026)
    let month = zeus.signal(10)
    let day = zeus.signal(17)
    let sort = zeus.signal(0)
    let level = zeus.signal(50)
    let mut on = zeus.signal(1)
    let mut jobs = []Job {}
    push(jobs, Job { title: "Deploy web", meta: "2m", value: 0 })
    push(jobs, Job { title: "Job #12", meta: "14m", value: 1 })
    push(jobs, Job { title: "Signup", meta: "1h", value: 2 })
    push(jobs, Job { title: "Invoice #88", meta: "3h", value: 3 })
    push(jobs, Job { title: "Build linux", meta: "5h", value: 4 })
    push(jobs, Job { title: "Mirror docs", meta: "1d", value: 5 })
    push(jobs, Job { title: "Rotate keys", meta: "2d", value: 6 })
    push(jobs, Job { title: "Archive logs", meta: "4d", value: 7 })
    push(jobs, Job { title: "Warm cache", meta: "1w", value: 8 })
    push(jobs, Job { title: "Trim indexes", meta: "2w", value: 9 })
    let mut picks = []Job {}
    push(picks, Job { title: "Deploy web", meta: "2m", value: 0 })
    push(picks, Job { title: "Job #12", meta: "14m", value: 1 })
    push(picks, Job { title: "Signup", meta: "1h", value: 2 })
    let mut files = []FileRow {}
    push(files, FileRow { name: "bezel.toml", kind: "Config", size: "812 B" })
    push(files, FileRow { name: "palette.rs", kind: "Source", size: "24.9 kB" })
    push(files, FileRow { name: "README.md", kind: "Document", size: "4.2 kB" })
    push(files, FileRow { name: "Geist.ttf", kind: "Font", size: "1.3 MB" })
    push(files, FileRow { name: "zeus_plat.c", kind: "Source", size: "18 kB" })
    push(files, FileRow { name: "kit.yuga", kind: "Source", size: "12 kB" })

    theme.Page("Zeus Kit", 960, 4200).child(
        ui.Navbar(NavbarProps { brand: "Zeus", a: "Foundations", b: "Components", c: "Patterns", appearance: "Dark" }),
        ui.Breadcrumbs(BreadcrumbProps { a: "Zeus", b: "Examples", c: "Kit" }),
        ui.Overline(TypeProps { text: "Library" }),
        ui.Display(TypeProps { text: "Build interfaces with Zeus" }),
        ui.Body(TypeProps { text: "Every widget ships medium. Chain .size(ui.sm) or .size(ui.lg), and .look(ui.solid) / ui.soft / ui.outline / ui.ghost / ui.danger. Values come from the app, not the widget." }),
        Wrap().child(
            ui.Chip(ChipProps { label: "Stable", color: theme.success() }),
            ui.Chip(ChipProps { label: "Headless tests", color: theme.accent() }),
            ui.Badge(BadgeProps { label: "v1", color: theme.purple() }),
            ui.Kbd(KbdProps { key: "Esc" }),
        ),
        ui.Alert(AlertProps { title: "Local state", body: "Clicks run a callback that writes component state. Passing that value into a child is a prop: the next view rebuild shows the new number.", color: theme.accent() }),
        ui.Card().child(
            ui.CardHeader(CardHeaderProps { title: "Project card", subtitle: "A surface with a title, supporting copy that wraps to the column width, and a footer of actions — the same pattern as a Tailwind card." }),
            ui.CardFooter().child(
                ui.Ghost(ButtonProps { label: "Cancel", on_press: || { ticks = ticks + 1 } }),
                ui.Prominent(ButtonProps { label: "Save", on_press: || { ticks = ticks + 1 } }),
                zeus.spacer(),
            ).child(zeus.label("0").bind_n(ticks).fg(theme.muted()).font(12)),
        ),
        ui.Overline(TypeProps { text: "Scale" }),
        ui.Heading(TypeProps { text: "Buttons" }),
        ui.Body(TypeProps { text: "Five looks, three sizes. Medium is the default Ghost / Soft / Outline / Prominent / Destructive row." }),
        ui.Panel(PanelProps { title: "Looks" }).child(
            Note("small"),
            Wrap().child(
                ui.Button(ButtonProps { label: "Solid", on_press: || { ticks = ticks + 1 } }).size(ui.sm()).look(ui.solid()),
                ui.Button(ButtonProps { label: "Soft", on_press: || { ticks = ticks + 1 } }).size(ui.sm()).look(ui.soft()),
                ui.Button(ButtonProps { label: "Outline", on_press: || { ticks = ticks + 1 } }).size(ui.sm()).look(ui.outline()),
                ui.Button(ButtonProps { label: "Ghost", on_press: || { ticks = ticks + 1 } }).size(ui.sm()).look(ui.ghost()),
                ui.Button(ButtonProps { label: "Danger", on_press: || { ticks = ticks + 1 } }).size(ui.sm()).look(ui.danger()),
            ),
            Note("medium"),
            Wrap().child(
                ui.Prominent(ButtonProps { label: "Solid", on_press: || { ticks = ticks + 1 } }),
                ui.Soft(ButtonProps { label: "Soft", on_press: || { ticks = ticks + 1 } }),
                ui.Outline(ButtonProps { label: "Outline", on_press: || { ticks = ticks + 1 } }),
                ui.Ghost(ButtonProps { label: "Ghost", on_press: || { ticks = ticks + 1 } }),
