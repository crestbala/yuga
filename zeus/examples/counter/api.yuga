// Shared wire types for the wasm client and native server. A renamed path
// or field is a compile error on both sides, not a silent 404.

fn hello_path() -> string {
    return "/api/hello"
}

fn hello_count_key() -> string {
    return "count"
}

fn stats_path() -> string {
    return "/api/stats"
}

fn users_key() -> string {
    return "users"
}

fn jobs_key() -> string {
    return "jobs"
}

fn uptime_key() -> string {
    return "uptime"
}

fn load_key() -> string {
    return "load"
}

fn ticks_key() -> string {
    return "ticks"
}

fn stats_body() -> string {
    return "{\"users\":\"1,204\",\"jobs\":\"12\",\"uptime\":\"99.9%\",\"load\":42,\"ticks\":0}"
}
