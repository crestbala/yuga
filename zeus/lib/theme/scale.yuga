// Size and look tokens. Medium is the default every widget already ships.
// 0 sm / 1 md / 2 lg. Looks: 0 solid / 1 soft / 2 outline / 3 ghost / 4 danger.

fn sm() -> int {
    return 0
}

fn md() -> int {
    return 1
}

fn lg() -> int {
    return 2
}

fn solid() -> int {
    return 0
}

fn soft() -> int {
    return 1
}

fn outline() -> int {
    return 2
}

fn ghost() -> int {
    return 3
}

fn danger() -> int {
    return 4
}

fn pad_x(size: int) -> int {
    if size == 0 {
        return 8
    }
    if size == 2 {
        return 16
    }
    return 12
}

fn pad_y(size: int) -> int {
    if size == 0 {
        return 4
    }
    if size == 2 {
        return 10
    }
    return 6
}

