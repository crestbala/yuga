// Numbers drive layout, colors are paint. Nothing here reads the theme.
// 4px grid with 2px half-steps, mirroring bezel's crates/theme/src/theme/layout.rs.

// ---- base scale (px) ----

fn space_2xs() -> int {
    return 2
}

fn space_xs() -> int {
    return 4
}

fn space_tight() -> int {
    return 5
}

fn space_snug() -> int {
    return 6
}

fn space_sm() -> int {
    return 8
}

fn space_cozy() -> int {
    return 10
}

fn space_md() -> int {
    return 12
}

fn space_comfy() -> int {
    return 14
}

fn space_lg() -> int {
    return 16
}

fn space_xl() -> int {
    return 20
}

fn space_2xl() -> int {
    return 24
}

fn page() -> int {
    return 28
}

fn section() -> int {
    return 20
}

// ---- reserved chrome. Fixed height, never conditionally rendered. ----

fn header_height() -> int {
    return 44
}

fn titlebar_height() -> int {
    return 38
}

fn status_strip_height() -> int {
    return 24
}

fn bar_height() -> int {
    return 56
}

// ---- radii. One base; every other corner is a ratio of it, so moving
// base_radius moves the whole set together. ----

fn base_radius() -> int {
    return 8
}

fn radius(num: int, den: int) -> int {
    return base_radius() * num / den
}

fn kbd_radius() -> int {
    return radius(5, 8)
}

fn hit_radius() -> int {
    return radius(7, 8)
}

fn control_radius() -> int {
    return radius(3, 4)
}

fn button_radius() -> int {
    return radius(1, 1)
}

fn toggle_group_radius() -> int {
    return radius(9, 8)
}

fn panel_radius() -> int {
    return radius(5, 4)
}

fn surface_radius() -> int {
    return radius(3, 2)
}

fn bubble_radius() -> int {
    return radius(2, 1)
}

fn pill_radius() -> int {
    return 999
}

// A child inset by `inset` inside a container of radius `outer` keeps its
// corners parallel to the container's. Stated as arithmetic where the child is
// defined, so a container that changes its padding carries its rows with it.
fn inset_radius(outer: int, inset: int) -> int {
    if outer > inset {
        return outer - inset
    }
    return 0
}

