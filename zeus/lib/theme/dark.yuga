import "std:zeus"

// Exact dark RGB. colors.yuga registers these against light.yuga.

fn bg() -> int {
    return zeus.rgb(10, 10, 10)
}

fn panel() -> int {
    return zeus.rgb(18, 18, 18)
}

fn line() -> int {
    return zeus.rgb(35, 35, 35)
}

fn line_strong() -> int {
    return zeus.rgb(54, 54, 54)
}

fn text() -> int {
    return zeus.rgb(237, 237, 237)
}

fn muted() -> int {
    return zeus.rgb(161, 161, 161)
}

fn faint() -> int {
    return zeus.rgb(111, 111, 111)
}

fn ink() -> int {
    return zeus.rgb(28, 28, 28)
}

fn on_solid() -> int {
    return zeus.rgb(10, 10, 10)
}

fn accent() -> int {
    return zeus.rgb(237, 237, 237)
}

fn purple() -> int {
    return zeus.rgb(161, 161, 161)
}

fn danger_fill() -> int {
    return zeus.rgb(184, 78, 72)
}

fn success_fill() -> int {
    return zeus.rgb(22, 48, 36)
}

fn success_text() -> int {
    return zeus.rgb(110, 200, 150)
}

fn warning_fill() -> int {
    return zeus.rgb(48, 36, 16)
}

fn warning_text() -> int {
    return zeus.rgb(232, 196, 120)
}

fn scrim() -> int {
    return zeus.rgb(0, 0, 0)
}
