//! Bezel motion catalog, ported as duration tokens (ms).
//!
//! Curves (CSS cubic-bezier), same names as `crates/motion`:
//!   EASE_OUT_EXPO  (0.16, 1, 0.3, 1)   — FADE_IN
//!   EASE_OUT       (0, 0, 0.58, 1)     — RESIZE, TAB_SLIDE, COLLAPSE
//!   EASE           (0.25, 0.1, 0.25, 1)
//!   EASE_IN_OUT    (0.42, 0, 0.58, 1)  — SCROLL_GLIDE
//!   EASE_RESORT    (0.22, 1, 0.36, 1)
//!   EASE_TAILWIND  (0.4, 0, 0.2, 1)    — HOVER_FADE
//!
//! The engine steps hover / enter / toggle from these durations at ~60fps.
//! `progress(t)` is an integer ease-out (0..100) — the same idea as bezel's
//! `curve.progress()`, used when painting hover fades.

fn hover_open_ms() -> int {
    return 500
}

fn overlay_dim() -> int {
    return 55
}

fn fade_in_ms() -> int {
    return 500
}

fn fade_quick_ms() -> int {
    return 150
}

fn hover_fade_ms() -> int {
    return 150
}

fn menu_in_ms() -> int {
    return 140
}

fn menu_out_ms() -> int {
    return 100
}

fn dialog_in_ms() -> int {
    return 180
}

fn splash_out_ms() -> int {
    return 500
}

fn splash_out_delay_ms() -> int {
    return 150
}

fn resize_ms() -> int {
    return 200
}

fn tab_slide_ms() -> int {
    return 150
}

fn collapse_ms() -> int {
    return 180
}

fn chevron_ms() -> int {
    return 200
}

fn scroll_glide_ms() -> int {
    return 500
}

fn pulse_ms() -> int {
    return 2400
}

fn gradient_spin_ms() -> int {
    return 750
}

/// Integer ease-out, t in 0..100. Matches the shape hover fades paint with.
fn progress(t: int) -> int {
    if t <= 0 {
        return 0
    }
    if t >= 100 {
        return 100
    }
    let u = 100 - t
    return 100 - u * u / 100
}
