import "std:zeus"
import "../theme/spacing.yuga"
import "../theme/colors.yuga"
import "../theme/scale.yuga"
import "look.yuga"

struct CardHeaderProps {
    title: string,
    subtitle: string,
}

fn style_card(n: Node) {
    let size = n.size_of()
    look.field(n, n.look_of()).padX(scale.surface_x(size)).padY(scale.surface_y(size)).gap(scale.gap_of(size)).radius(scale.radius_of(size)).overflow(zeus.overflow_hidden())
}

fn CardAt(size: int, variant: int) -> Node {
    let n = zeus.col().with_size(size).with_look(variant)
    n.styled(|| { style_card(n) })
    return n
}

fn Card() -> Node {
    return CardAt(scale.md(), scale.soft())
}

fn Header(p: CardHeaderProps) -> Node {
    let n = zeus.col().gap(spacing.space_snug())
    let bar = n.add(zeus.row().gap(spacing.space_sm()).justify(zeus.flex_between()).align(zeus.flex_center()))
    bar.child(zeus.label(p.title).fg(colors.text()).font(16))
    bar.child(zeus.box().w(spacing.dot()).h(spacing.dot()).bg(colors.muted()).radius(spacing.dot() / 2))
    n.child(zeus.label(p.subtitle).fg(colors.muted()).font(13).flex_wrap())
    return n
}

fn Body() -> Node {
    return zeus.col().gap(spacing.space_cozy())
}

fn Footer() -> Node {
    return zeus.row().gap(spacing.space_sm()).justify(zeus.flex_start()).align(zeus.flex_center()).shrink(0)
}
