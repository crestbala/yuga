import "std:zeus"
import "divider.yuga"
import "../theme/spacing.yuga"
import "../theme/colors.yuga"

struct GroupRowProps {
    label: string,
    icon: int,
}

fn Box() -> Node {
    return zeus.col().border(1).border_color(colors.line()).radius(spacing.surface_radius()).overflow(zeus.overflow_hidden())
}

fn Row(p: GroupRowProps) -> Node {
    let n = zeus.row().padX(spacing.row_pad_x()).padY(spacing.row_pad_y()).gap(spacing.row_gap()).align(zeus.flex_center())
    let box = n.add(zeus.col().w(spacing.tile()).h(spacing.tile()).bg(colors.ink()).radius(spacing.panel_radius()).center())
    if p.icon == 0 {
        box.child(zeus.box().w(spacing.icon_sm()).h(spacing.space_cozy()).border(1).border_color(colors.text()).radius(spacing.space_2xs()))
    } else {
        box.child(zeus.box().w(spacing.space_lg()).h(spacing.space_md()).bg(colors.text()).radius(spacing.space_2xs()))
    }
    n.txt(p.label, colors.text(), 13)
    return n
}

fn Split() -> Node {
    return divider.Line()
}
