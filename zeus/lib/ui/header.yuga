import "std:zeus"
import "switch.yuga"
import "button.yuga"
import "../theme/spacing.yuga"
import "../theme/colors.yuga"

struct HeaderProps {
    title: string,
    live_label: string,
    sig: Signal,
    btn: string,
    appearance: string,
}

/// Brand stays one unit; actions wrap on the next line when the bar is narrow.
/// Extra `.child(...)` nodes (dashboard Note) land on the action side.
fn Header(p: HeaderProps) -> Node {
    let bar = zeus.row().gap(spacing.space_md()).align(zeus.flex_center()).flex_wrap()
    let brand = bar.add(zeus.row().gap(spacing.space_md()).align(zeus.flex_center()).shrink(0))
    brand.child(zeus.box().w(spacing.space_sm()).h(spacing.status_strip_height()).bg(colors.accent()).radius(spacing.space_xs()).shrink(0))
    brand.child(zeus.label(p.title).fg(colors.text()).font(22).shrink(0))
    bar.child(zeus.spacer())
    let actions = bar.add(zeus.row().gap(spacing.space_md()).align(zeus.flex_center()).flex_wrap())
    actions.txt(p.appearance, colors.muted(), 13)
    actions.child(switch.Switch(SwitchProps { sig: zeus.appearance() }))
    actions.txt(p.live_label, colors.label(), 13)
    actions.bound(p.sig, colors.success(), 16)
    actions.child(button.Prominent(ButtonProps { label: p.btn, on_press: || { p.sig.set(p.sig.get() + 1) } }))
    return bar
}
