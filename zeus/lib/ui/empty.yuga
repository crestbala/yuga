import "std:zeus"
import "../theme/spacing.yuga"
import "../theme/colors.yuga"
import "../theme/scale.yuga"
import "look.yuga"

struct EmptyProps {
    title: string,
    body: string,
}

struct EmptyParts {
    n: Node,
    title: Node,
    body: Node,
}

fn style_empty(p: EmptyParts) {
    let size = p.n.size_of()
    look.field(p.n, p.n.look_of()).padX(scale.surface_x(size)).padY(scale.surface_y(size) * 2).gap(scale.gap_of(size)).radius(scale.radius_of(size)).align(zeus.flex_center()).justify(zeus.flex_center())
    p.title.fg(colors.text()).font(scale.font_px(size) + 1)
    p.body.fg(colors.muted()).font(scale.font_px(size)).flex_wrap()
}

fn State(p: EmptyProps) -> Node {
    let n = zeus.col().with_size(scale.md()).with_look(scale.soft())
    let t = n.add(zeus.label(p.title))
    let b = n.add(zeus.label(p.body))
    n.styled(|| { style_empty(EmptyParts { n: n, title: t, body: b }) })
    return n
}
