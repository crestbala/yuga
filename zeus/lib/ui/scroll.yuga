import "std:zeus"
import "../theme/spacing.yuga"
import "../theme/colors.yuga"

struct ScrollProps {
    height: int,
}

struct ScrollRowProps {
    title: string,
    meta: string,
}

fn Pane(p: ScrollProps) -> Node {
    return zeus.scroll().h(p.height)
}

fn Row(p: ScrollRowProps) -> Node {
    let n = zeus.row().gap(spacing.space_sm()).padX(spacing.step_pad_x()).padY(spacing.step_pad_y()).align(zeus.flex_center())
    n.txt(p.title, colors.text(), 13)
    n.child(zeus.spacer())
    n.txt(p.meta, colors.muted(), 12)
    return n
}
