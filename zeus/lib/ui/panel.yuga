import "std:zeus"
import "type.yuga"
import "../theme/spacing.yuga"
import "../theme/colors.yuga"

struct PanelProps {
    title: string,
}

fn Box(p: PanelProps) -> Node {
    let n = zeus.col().bg(colors.card()).padX(spacing.row_pad_x()).padY(spacing.row_pad_y()).gap(spacing.space_md()).radius(spacing.surface_radius()).overflow(zeus.overflow_hidden())
    n.child(type.Overline(TypeProps { text: p.title }))
    return n
}
