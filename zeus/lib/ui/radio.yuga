import "std:zeus"
import "../theme/spacing.yuga"
import "../theme/colors.yuga"
import "../theme/scale.yuga"

struct RadioProps {
    label: string,
    sig: Signal,
    value: int,
}

struct RadioGroupProps {
    label: string,
    sig: Signal,
    last: int,
}

struct RadioParts {
    n: Node,
    on: Node,
    dot: Node,
    off: Node,
    lab: Node,
}

fn style_radio(p: RadioParts) {
    let size = p.n.size_of()
    let d = scale.check_of(size)
    p.n.gap(scale.gap_of(size)).align(zeus.flex_center()).shrink(0)
    p.on.w(d).h(d).bg(colors.card()).border(1).border_color(colors.text()).radius(spacing.pill_radius()).center().shrink(0)
    p.dot.w(spacing.dot()).h(spacing.dot()).bg(colors.text()).radius(spacing.dot() / 2).shrink(0)
    p.off.w(d).h(d).bg(colors.card()).border(1).border_color(colors.line()).radius(spacing.pill_radius()).shrink(0)
    p.lab.fg(colors.text()).font(scale.font_px(size)).shrink(0)
}

fn Option(p: RadioProps) -> Node {
    let n = zeus.row().with_size(scale.md()).with_look(scale.soft())
    n.on_click_set(p.sig, p.value)
    let on = n.add(zeus.col().show_eq(p.sig, p.value))
    let dot = on.add(zeus.box())
    let off = n.add(zeus.box().show_ne(p.sig, p.value))
    let lab = n.add(zeus.label(p.label))
    n.styled(|| { style_radio(RadioParts { n: n, on: on, dot: dot, off: off, lab: lab }) })
    return n
}

fn Group(p: RadioGroupProps) -> Node {
    let n = zeus.col().gap(scale.gap_of(scale.md()))
    n.key("down", "radio.next").key("right", "radio.next").key("up", "radio.prev").key("left", "radio.prev").focusable()
    n.on_range("radio.next", p.sig, 1, 0, p.last)
    n.on_range("radio.prev", p.sig, -1, 0, p.last)
    n.txt(p.label, colors.label(), scale.caption_px(scale.md()))
    n.bound(p.sig, colors.muted(), scale.font_px(scale.md()) + 1)
    return n
}
