import "std:zeus"
import "../theme/colors.yuga"
import "../theme/scale.yuga"
import "icons.yuga"

struct CheckboxProps {
    label: string,
    sig: Signal,
}

struct CheckboxParts {
    n: Node,
    mark: Node,
    lab: Node,
}

fn fill(variant: int) -> int {
    if variant == 0 {
        return colors.text()
    }
    if variant == 4 {
        return colors.danger()
    }
    if variant == 3 {
        return -1
    }
    return colors.line()
}

fn style_check(p: CheckboxParts) {
    let size = p.n.size_of()
    let variant = p.n.look_of()
    let d = scale.check_of(size)
    p.n.gap(scale.gap_of(size)).align(zeus.flex_center())
    p.mark.w(d).h(d).radius(scale.radius_of(size) / 2).bg(fill(variant)).fg(colors.text()).border_color(colors.on_solid())
    p.lab.fg(colors.text()).font(scale.font_px(size))
}

fn Box(p: CheckboxProps) -> Node {
    let n = zeus.row().with_size(scale.md()).with_look(scale.soft())
    n.key("space", "check.toggle").key("enter", "check.toggle").focusable()
    n.on_key_toggle("check.toggle", p.sig)
    let mark = n.add(zeus.raw_check(icons.check()).bind(p.sig).on_click_toggle(p.sig))
    let lab = n.add(zeus.label(p.label))
    n.styled(|| { style_check(CheckboxParts { n: n, mark: mark, lab: lab }) })
    return n
}
