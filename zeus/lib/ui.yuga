// --- type ---

fn Overline(p: TypeProps) -> Node {
    return type.Overline(p)
}

fn Display(p: TypeProps) -> Node {
    return type.Display(p)
}

fn Title(p: TypeProps) -> Node {
    return type.Title(p)
}

fn Heading(p: TypeProps) -> Node {
    return type.Heading(p)
}

fn Body(p: TypeProps) -> Node {
    return type.Body(p)
}

// --- size / look tokens and chain modifiers ---

fn sm() -> int {
    return scale.sm()
}

fn md() -> int {
    return scale.md()
}

fn lg() -> int {
    return scale.lg()
}

fn solid() -> int {
    return scale.solid()
}

fn soft() -> int {
    return scale.soft()
}

fn outline() -> int {
    return scale.outline()
}

fn ghost() -> int {
    return scale.ghost()
}

fn danger() -> int {
    return scale.danger()
}

fn size(n: Node, s: int) -> Node {
    return n.with_size(s)
}

fn look(n: Node, v: int) -> Node {
    return n.with_look(v)
}

// --- navigation ---

fn Navbar(p: NavbarProps) -> Node {
    return navbar.Bar(p)
}

fn Toolbar() -> Node {
    return toolbar.Bar()
}

fn Breadcrumbs(p: BreadcrumbProps) -> Node {
    return breadcrumbs.Trail(p)
}

fn Header(p: HeaderProps) -> Node {
