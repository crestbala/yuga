                Glyph("REFRESH", refresh()),
                Glyph("RESTART", restart()),
                Glyph("ADD CIRCLE", add_circle()),
                Glyph("TUNING", tuning()),
                Glyph("PAPERCLIP", paperclip()),
                Glyph("PEN", pen()),
                Glyph("ARCHIVE", archive_minimalistic()),
                Glyph("TRASH", trash_bin_minimalistic()),
                Glyph("SETTINGS", settings_minimalistic()),
                Glyph("LOGOUT", logout_2()),
                Glyph("MAGNIFIER", magnifer()),
                Glyph("COMMAND", command()),
                Glyph("DOCUMENT", document()),
                Glyph("DOWNLOAD", download()),
                Glyph("LINK", link()),
                Glyph("BOOK", book()),
                Glyph("COMPASS", compass()),
                Glyph("CPU", cpu()),
                Glyph("GLOBAL", global()),
                Glyph("CHECKLIST", checklist()),
                Glyph("WIDGET", widget()),
                Glyph("CLOSE", close()),
                Glyph("INFO", info_circle()),
                Glyph("DANGER", danger_triangle()),
                Glyph("MONITOR", monitor()),
                Glyph("FOLDER", folder()),
                Glyph("SUN", sun()),
                Glyph("MOON", moon()),
                Glyph("PLAY", play()),
                Glyph("PAUSE", pause()),
                Glyph("STAR", star()),
