//! The Bezel component kit, in the declarative Zeus syntax. Every widget is a
//! `fn`, the tree comes from trailing blocks, state is `signal`, and
//! interpolation is `{{ }}`. Colors and spacing are the bezel tokens in
//! packages/zeus-components/theme.yuga — the same design language as
//! https://github.com/crabtalk/bezel. Names are unqualified: the barrel
//! import exposes `Button`, `Card`, `muted()`, … directly.

import "std:zeus"
import "../../../packages/zeus-components/ui.yuga"
import "../../../packages/zeus-components/ui/display/icons.yuga"

fn Note(s: string) {
    Text(s, color = muted(), font = type_caption())
}

fn Section(title: string) {
    Text(title, color = text(), font = type_heading())
}

fn Orb(kind: int, s: string) {
    Box(align_direction = DIRECTION.Column, spacing = SPACE.Sm, align_items = ALIGN.Center, shrink = 0) {
        if kind == 0 {
            LoaderCluster()
        }
        if kind == 1 {
            LoaderRing()
        }
        if kind == 2 {
            LoaderConverge()
        }
        if kind == 3 {
            LoaderBloom()
        }
        if kind == 4 {
            LoaderPulse()
        }
        if kind == 5 {
            LoaderMatrix()
        }
        if kind == 6 {
            LoaderMini()
        }
        if kind == 7 {
            LoaderWord(size = 1)
        }
        Note(s)
    }
}

fn Glyph(label: string, markup: string) {
    Box(align_direction = DIRECTION.Column, width = 88, height = 76, spacing = 6, background = panel(), radius = button_radius(), align_items = ALIGN.Center, justify_content = ALIGN.Center, shrink = 0) {
        Icon(markup = markup, color = text(), size = 22),
        Text(label, color = muted(), font = 9)
    }
}

fn main() {
    let ticks = signal(0)
    let load = signal(42)
    let page = signal(4)
    let tab = signal(0)
    let tab_lg = signal(1)
    let tab_pill = signal(0)
    let acc = signal(1)
    let plan = signal(1)
    let status = signal(1)
    let picked = signal(0)
    let count = signal(3)
    let toast_open = signal(0)
    let note_open = signal(0)
    let year = signal(2026)
    let month = signal(10)
    let day = signal(17)
    let sort = signal(0)
    let level = signal(50)
    let on = signal(1)
    let notify = signal(1)

    App("Zeus Kit", 960, 2800, fn() {
        Scroll(background = canvas(), padding = SPACE.Page, spacing = SPACE.Section) {
            Navbar(brand = "Zeus", a = "Foundations", b = "Components", c = "Patterns"),
            Breadcrumbs(a = "Zeus", b = "Examples", c = "Kit"),
            Overline(text = "Library"),
            Display(text = "Build interfaces with Zeus"),
            Body(text = "Every widget ships medium. Size and look are props: size = sm() / md() / lg(), look = solid() / soft() / outline() / ghost() / danger(). Values come from the app, not the widget."),
            Box(align_direction = DIRECTION.Row, spacing = SPACE.Sm, align_items = ALIGN.Center) {
                Chip(label = "Stable", color = success()),
                Chip(label = "Headless tests", color = accent()),
                Badge(label = "v1", color = purple()),
                Kbd(key = "Esc")
            },
            Alert(title = "Local state", body = "Clicks run a callback that writes component state. Passing that value into a child is a prop: the next label re-render shows the new number.", color = accent()),
            Card() {
                CardHeader(title = "Project card", subtitle = "A surface with a title, supporting copy that wraps to the column width, and a footer of actions — the same pattern as a Tailwind card."),
                CardFooter() {
                    Ghost(label = "Cancel", on_press = fn() => ticks.set(ticks.get() + 1)),
                    Prominent(label = "Save", on_press = fn() => ticks.set(ticks.get() + 1))
                },
                Text("{{ticks.get()}}", color = muted(), font = 12)
            },

            Section("Buttons"),
            Note("five looks, small"),
            Box(align_direction = DIRECTION.Row, spacing = SPACE.Sm, align_items = ALIGN.Center) {
                Button(label = "Solid", look = solid(), size = sm()),
                Button(label = "Soft", look = soft(), size = sm()),
                Button(label = "Outline", look = outline(), size = sm()),
                Button(label = "Ghost", look = ghost(), size = sm()),
                Button(label = "Danger", look = danger_look(), size = sm())
            },
            Note("medium variants"),
            Box(align_direction = DIRECTION.Row, spacing = SPACE.Sm, align_items = ALIGN.Center) {
                Prominent(label = "Solid", on_press = fn() => ticks.set(ticks.get() + 1)),
                Soft(label = "Soft", on_press = fn() => ticks.set(ticks.get() + 1)),
                Outline(label = "Outline", on_press = fn() => ticks.set(ticks.get() + 1)),
                Ghost(label = "Ghost", on_press = fn() => ticks.set(ticks.get() + 1)),
                Destructive(label = "Danger", on_press = fn() => ticks.set(ticks.get() + 1))
            },
            Note("large"),
            Box(align_direction = DIRECTION.Row, spacing = SPACE.Sm, align_items = ALIGN.Center) {
                Button(label = "Solid", look = solid(), size = lg()),
                Button(label = "Soft", look = soft(), size = lg()),
                Button(label = "Outline", look = outline(), size = lg()),
                Button(label = "Ghost", look = ghost(), size = lg()),
                Button(label = "Danger", look = danger_look(), size = lg())
            },

            Section("Chips, badges, keys, avatars"),
            Note("small"),
            Box(align_direction = DIRECTION.Row, spacing = SPACE.Sm, align_items = ALIGN.Center) {
                Chip(label = "Solid", color = accent(), size = sm()),
                Chip(label = "Soft", color = success(), size = sm()),
                Chip(label = "Outline", color = purple(), size = sm()),
                Chip(label = "Ghost", color = muted(), size = sm()),
                Chip(label = "Danger", color = danger(), size = sm())
            },
            Note("badges, keys, avatars"),
            Box(align_direction = DIRECTION.Row, spacing = SPACE.Sm, align_items = ALIGN.Center) {
                Badge(label = "sm", color = accent(), size = sm()),
                Badge(label = "md", color = accent()),
                Badge(label = "lg", color = purple(), size = lg()),
                Kbd(key = "Esc", size = sm()),
                Kbd(key = "⌘S"),
                Kbd(key = "Tab", size = lg()),
                Avatar(initials = "SM", color = accent(), size = sm()),
                Avatar(initials = "MD", color = purple()),
                Avatar(initials = "LG", color = success(), size = lg()),
                Avatar(initials = "DN", color = danger())
            },

            Section("Alerts"),
            Alert(title = "Medium outline", body = "Outline uses the tint on the border instead of a fill.", color = purple()),
            Alert(title = "Large solid", body = "Solid fills the tint. Use it for a status that must not be missed.", color = success()),
            Alert(title = "Danger", body = "The danger look is the warning plate, at any size.", color = danger()),

