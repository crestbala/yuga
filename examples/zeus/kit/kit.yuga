            DatePicker(day = day, month = month, year = year),

            Section("Tooltip and hover card"),
            Box(align_direction = DIRECTION.Row, spacing = SPACE.Lg, align_items = ALIGN.Start) {
                Box(align_direction = DIRECTION.Column, spacing = SPACE.Sm, grow = 1) {
                    Tooltip(label = "Hover me", message = "Copy path", shortcut = "Ctrl+C")
                },
                Box(align_direction = DIRECTION.Column, spacing = SPACE.Sm, grow = 1) {
                    HoverCard(handle = "@clearloop", name = "clearloop", bio = "Builds desktop software in Yuga. Maintains Zeus.", meta = "Joined 2019 · 412 repositories", color = accent())
