                User(initials = "RK", name = "Ravi Kumar", role = "Operator", color = accent()),
                Divider(),
                User(initials = "AM", name = "Ada Park", role = "Admin", color = success())
            },
            Accordion(title = "Where do components live?", body = "Zeus examples live under examples/zeus/: components, themes, and the kit apps. std:zeus stays primitives: Text, Button, Box, Input, signal. The kit layers theme on top.", open = acc),
            Empty(title = "No results", body = "Try another filter. This empty state is a full-width card; the body copy wraps like a paragraph."),

            Section("Links and cards"),
            Box(align_direction = DIRECTION.Row, spacing = SPACE.Sm, align_items = ALIGN.Center) {
