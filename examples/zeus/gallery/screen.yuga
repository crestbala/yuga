// Catalog screens. Components mirror the shadcn/ui catalogue (default zinc
// theme): every row here demos one `std:zeus` component with its SVG icons.
// Dark restyles the whole palette via `zeus.appearance()`.
import "std:zeus"
import "std:kv"

fn Navbar(page: Signal<int>) {
    zeus.Column(0) {
        zeus.Box(align_direction = DIRECTION.Row, spacing = SPACE.Md,
                 align_items = ALIGN.Center, height = zeus.BAR) {
            zeus.Box(width = 22, height = 22, radius = 6, background = zeus.ink())
            zeus.Text("Zeus", color = zeus.ink(), font = zeus.FONT_TITLE)
            zeus.NavTab("Foundations", page, 0)
            zeus.NavTab("Components", page, 1)
            zeus.NavTab("Patterns", page, 2)
            zeus.Grow()
            zeus.Text("Dark", color = zeus.mute(), font = zeus.FONT_CONTROL)
            zeus.Switch(zeus.appearance())
        }
        zeus.Separator()
    }
}

fn ProjectCard() {
    let ticks = zeus.signal(0)
    zeus.Card() {
        zeus.Row(SPACE.Sm) {
            zeus.Title("Project card")
            zeus.Grow()
            zeus.Badge("In progress", zeus.TINT.Ok)
        }
        zeus.Body("A card with a title, supporting copy, and a footer of actions. Shadcn chrome: rounded-xl, hairline border, white surface.")
        zeus.Row(SPACE.Sm) {
            zeus.Button("Cancel", look = zeus.LOOK.Outline, size = zeus.SIZE.Md, on_click =  fn() => ticks.set(ticks.get() + 1))
            zeus.Button("Save", look = zeus.LOOK.Solid, size = zeus.SIZE.Md, on_click =  fn() => ticks.set(ticks.get() + 1))
            zeus.Grow()
            zeus.Text("{{ticks.get()}}", color = zeus.mute(), font = zeus.FONT_CAPTION)
        }
    }
}

fn Foundations() {
    zeus.Breadcrumbs("Zeus", "Examples", "Gallery")
    zeus.Column(SPACE.Exs) {
        zeus.Display("Build interfaces with Zeus")
        zeus.Body("Zinc tokens, neutral primary, and lucide SVG icons. Dark inverts every token that reads appearance.")
    }
    zeus.Row(SPACE.Sm) {
        zeus.Chip("Stable", zeus.TINT.Ok)
        zeus.Chip("Canvas2D", zeus.TINT.Ink)
        zeus.Badge("zeus", zeus.TINT.Mute)
        zeus.Kbd("⌘K")
    }
    zeus.Alert("Heads up", "Signals update on click. Hover and press are engine fades — no DOM.")
    zeus.AlertDestructive("Session expired", "Sign back in to keep syncing. Your drafts are saved locally.")
    ProjectCard()
}

fn ButtonScale() {
    zeus.SectionHeader("Actions", "Buttons",
        "The six shadcn variants across three sizes. Primary is the neutral ink fill; it inverts with appearance.")
    zeus.Card() {
        zeus.Overline("Primary · Secondary · Outline · Ghost · Destructive · Link")
        zeus.Note("small")
        zeus.RowWrap(SPACE.Sm) {
            zeus.Button("Solid", look = zeus.LOOK.Solid, size = zeus.SIZE.Sm)
            zeus.Button("Soft", look = zeus.LOOK.Soft, size = zeus.SIZE.Sm)
            zeus.Button("Outline", look = zeus.LOOK.Outline, size = zeus.SIZE.Sm)
            zeus.Button("Ghost", look = zeus.LOOK.Ghost, size = zeus.SIZE.Sm)
            zeus.Button("Danger", look = zeus.LOOK.Danger, size = zeus.SIZE.Sm)
            zeus.Button("Link", look = zeus.LOOK.Link, size = zeus.SIZE.Sm)
        }
        zeus.Note("medium")
        zeus.RowWrap(SPACE.Sm) {
            zeus.Button("Solid", look = zeus.LOOK.Solid, size = zeus.SIZE.Md)
            zeus.Button("Soft", look = zeus.LOOK.Soft, size = zeus.SIZE.Md)
            zeus.Button("Outline", look = zeus.LOOK.Outline, size = zeus.SIZE.Md)
            zeus.Button("Ghost", look = zeus.LOOK.Ghost, size = zeus.SIZE.Md)
            zeus.Button("Danger", look = zeus.LOOK.Danger, size = zeus.SIZE.Md)
            zeus.Button("Link", look = zeus.LOOK.Link, size = zeus.SIZE.Md)
        }
        zeus.Note("large")
        zeus.RowWrap(SPACE.Sm) {
            zeus.Button("Solid", look = zeus.LOOK.Solid, size = zeus.SIZE.Lg)
            zeus.Button("Soft", look = zeus.LOOK.Soft, size = zeus.SIZE.Lg)
            zeus.Button("Outline", look = zeus.LOOK.Outline, size = zeus.SIZE.Lg)
            zeus.Button("Ghost", look = zeus.LOOK.Ghost, size = zeus.SIZE.Lg)
            zeus.Button("Danger", look = zeus.LOOK.Danger, size = zeus.SIZE.Lg)
            zeus.Button("Link", look = zeus.LOOK.Link, size = zeus.SIZE.Lg)
        }
        zeus.Note("icon — square, 16px lucide glyphs in every look")
        zeus.RowWrap(SPACE.Sm) {
            zeus.IconButton(zeus.IC_PLUS, zeus.LOOK.Solid, zeus.SIZE.Sm, "Add")
            zeus.IconButton(zeus.IC_MINUS, zeus.LOOK.Soft, zeus.SIZE.Md, "Remove")
            zeus.IconButton(zeus.IC_X, zeus.LOOK.Outline, zeus.SIZE.Md, "Close")
            zeus.IconButton(zeus.IC_CHEV_LEFT, zeus.LOOK.Ghost, zeus.SIZE.Md, "Back")
            zeus.IconButton(zeus.IC_ALERT_CIRCLE, zeus.LOOK.Danger, zeus.SIZE.Lg, "Warn")
        }
    }
}

fn DisplayRow() {
    zeus.SectionTitle("Display", "Chips, badges, keys")
    zeus.Card() {
        zeus.Note("chips")
        zeus.Row(SPACE.Sm) {
            zeus.Chip("Iris", zeus.TINT.Ink)
            zeus.Chip("Live", zeus.TINT.Ok)
            zeus.Chip("Quiet", zeus.TINT.Mute)
            zeus.Chip("Faint", zeus.TINT.Dim)
            zeus.Chip("Alert", zeus.TINT.Danger)
        }
        zeus.Note("badges")
        zeus.Row(SPACE.Sm) {
            zeus.Badge("secondary", zeus.TINT.Mute)
            zeus.Badge("default", zeus.TINT.Ink)
            zeus.Badge("success", zeus.TINT.Ok)
            zeus.Badge("outline", zeus.TINT.Dim)
            zeus.Badge("destructive", zeus.TINT.Danger)
        }
        zeus.Note("kbd")
        zeus.Row(SPACE.Sm) {
            zeus.Kbd("Esc")
            zeus.Kbd("⌘S")
            zeus.Kbd("Ctrl K")
        }
    }
}

fn Field(name: Signal<string>, note: Signal<string>, st: Store) {
    zeus.SectionHeader("Forms", "Input",
        "A label + input pair, shadcn style: h-9, rounded-md, hairline border.")
    zeus.Card() {
        zeus.Field("Name", name, "Your name")
        zeus.Text(if name.get().len < 3 { "Name must be at least 3 characters." } else { "" },
                  color = zeus.danger(), font = zeus.FONT_CONTROL)
        zeus.TextArea(note, "Draft — saved as you type", fn() => kv.set(st, "draft", note.get()))
        zeus.Note("{{note.get().len}} chars · std:kv under Application Support")
        zeus.Button("Submit", look = zeus.LOOK.Solid, size = zeus.SIZE.Md, on_click =  fn() => name.set(name.get()))
    }
}

fn DateSection() {
    let year = zeus.signal(2026)
    let month = zeus.signal(10)
    let day = zeus.signal(17)
    zeus.SectionHeader("Forms", "Date picker",
        "Input-like trigger with a calendar icon; the sheet floats above the page, so the scroller cannot clip it.")
    zeus.Card() {
        zeus.DatePicker(year, month, day)
    }
}

fn Choice() {
    let tab = zeus.signal(0)
    let size = zeus.signal(1)
    let mode = zeus.signal(1)
    let group = zeus.signal(0)
    zeus.SectionHeader("Choice", "Tabs, select, radio, toggle",
        "A muted tray for tabs, a dropdown for sizes, radio dots for one pick, and an accent-pressed toggle group.")
    zeus.Card() {
        zeus.Note("tabs — active trigger is the card surface")
        zeus.Tabs(tab, []string { "One", "Two", "Three" })
        zeus.Note("select — the menu floats below the trigger")
        zeus.Select(size, []string { "Small", "Medium", "Large" })
        zeus.Note("radio group — filled dot on the picked row")
        zeus.RadioGroup(mode, []string { "Default", "Comfortable", "Compact" })
        zeus.Note("toggle group — muted fill when pressed")
        zeus.ToggleGroup(group, []string { "Bold", "Italic", "Underline" })
        zeus.Note("toggle — borderless until pressed")
        let blink = zeus.signal(1)
        zeus.Toggle("Blink cursor", blink)
    }
}

fn Controls() {
    let on = zeus.signal(1)
    let notes = zeus.signal(0)
    let vol = zeus.signal(42)
    zeus.SectionHeader("Controls", "Switch, check, slider, toggle",
        "The switch eases onto its track; drag the slider thumb or use the arrow keys. Progress echoes the value.")
    zeus.Card() {
        zeus.Row(SPACE.Md) {
            zeus.Switch(on)
            zeus.Text(if on.get() == 1 { "On" } else { "Off" }, color = zeus.ink(), font = zeus.FONT_BODY)
            zeus.Grow()
            zeus.Checkbox("Notify me", notes)
        }
        zeus.Note("volume  {{vol.get()}}%")
        zeus.Slider(vol)
        zeus.Progress(vol)
    }
}

fn People() {
    zeus.SectionTitle("People", "Avatars and stats")
    zeus.Row(SPACE.Md) {
        zeus.Card() {
            zeus.User("AP", "Ada Park", "Operator")
            zeus.User("BL", "Bea Liu", "Editor")
            zeus.Row(SPACE.Xs) {
                zeus.Avatar("AP", 32)
                zeus.Avatar("BL", 40)
                zeus.Avatar("CD", 48)
            }
        }
        zeus.Stat("Uptime", "99.9%", zeus.TINT.Ok)
        zeus.Stat("Errors", "2", zeus.TINT.Danger)
    }
}

fn Upload() {
    let photo = zeus.signal("")
    let pw = zeus.signal(0)
    let ph = zeus.signal(0)
    zeus.SectionHeader("Media", "Upload",
        "Choose a PNG, JPEG, WebP, or GIF. The preview keeps aspect and shrinks to the card.")
    zeus.Card() {
        zeus.Row(SPACE.Sm) {
            zeus.Button("Choose image", look = zeus.LOOK.Solid, size = zeus.SIZE.Md, on_click =  fn() {
                zeus.pick_image(photo, pw, ph)
            })
            zeus.Button("Clear", look = zeus.LOOK.Ghost, size = zeus.SIZE.Md, on_click =  fn() {
                photo.set("")
                pw.set(0)
                ph.set(0)
            })
        }
        let host = zeus.Box(
            align_direction = DIRECTION.Row,
            align_items = ALIGN.Center,
            justify = ALIGN.Center,
            radius = 8,
            background = zeus.raised(),
            max_width = || {
                let w = pw.get()
                if w > 0 { w } else { 100000 }
            }) {
            zeus.Text("No image yet", color = zeus.mute(), font = zeus.FONT_CAPTION,
                      show = || { photo.get().len == 0 })
            zeus.Image(|| { photo.get() },
                       position = zeus.pos_absolute(), left = 0, top = 0, right = 0, bottom = 0,
                       radius = 8, fit = IMAGE_FIT.Contain,
                       show = || { photo.get().len > 0 })
        }
        zeus.styled(host, || {
            let iw = pw.get()
            let ih = ph.get()
            if iw > 0 {
                if ih > 0 {
                    zeus.aspect(host, iw, ih)
                    zeus.h(host, -1)
                    return
                }
            }
            zeus.aspect(host, 0, 0)
            zeus.h(host, 200)
        })
    }
}

fn Data() {
    let page = zeus.signal(3)
    zeus.SectionTitle("Data", "Table and pagination")
    zeus.Card() {
        zeus.TableHead("Name", "Role", "Status")
        zeus.TableRow("Ada", "Operator", "Active")
        zeus.TableRow("Bea", "Editor", "Away")
        zeus.TableRow("Cal", "Viewer", "Active")
    }
    zeus.Note("Pagination — {{page.get()}} / 5 · ghost pages, outline current")
    zeus.Pagination(page, 5)
}

fn Components() {
    let st = kv.open("zeus-gallery")
    let name = zeus.signal("")
    let note = zeus.signal(kv.get(st, "draft"))
    DateSection()
    ButtonScale()
    DisplayRow()
    Field(name, note, st)
    Choice()
    Controls()
    People()
    Upload()
    Data()
}

fn NameRow(name: string) -> Node {
    zeus.Row(SPACE.Sm) {
        zeus.Pip(zeus.mute(), 6)
        zeus.Body(name)
    }
}

fn LiveList() {
    let n = zeus.signal(2)
    zeus.SectionHeader("Lists", "Growing rows",
        "Add and remove rows. Extra rows are shown, not rebuilt with zeus.For.")
    zeus.Card() {
        zeus.show_ge(NameRow("Ada"), n, 1)
        zeus.show_ge(NameRow("Bea"), n, 2)
        zeus.show_ge(NameRow("Row"), n, 3)
        zeus.show_ge(NameRow("Row"), n, 4)
        zeus.Row(SPACE.Sm) {
            zeus.Button("Add row", look = zeus.LOOK.Solid, size = zeus.SIZE.Md, on_click =  fn() {
                if n.get() < 4 {
                    n.set(n.get() + 1)
                }
            })
            zeus.Button("Remove", look = zeus.LOOK.Ghost, size = zeus.SIZE.Md, on_click =  fn() {
                if n.get() > 0 {
                    n.set(n.get() - 1)
                }
            })
        }
    }
}

fn Cards() {
    zeus.SectionTitle("Surfaces", "Cards")
    zeus.Grid(config = GridConfig(columns = 3, gap = SPACE.Md)) {
        zeus.Card() { zeus.Pip(zeus.accent(), 8) zeus.Title("Small") zeus.Body("Neutral primary on paper.") }
        zeus.Card() { zeus.Pip(zeus.ok(), 8) zeus.Title("Medium") zeus.Body("Rounded-xl is the card radius.") }
        zeus.Card() { zeus.Pip(zeus.danger(), 8) zeus.Title("Large") zeus.Body("Badges and caps mark status.") }
    }
}

fn Skeletons() {
    zeus.SectionHeader("Feedback", "Skeleton",
        "Placeholder fills while content loads. Radius matches the shape it replaces.")
    zeus.Card() {
        zeus.Row(SPACE.Md) {
            zeus.Skeleton(40, 40, 20)
            zeus.Column(SPACE.Exs) {
                zeus.Skeleton(220, 14, 7)
                zeus.Skeleton(160, 14, 7)
            }
        }
    }
}

fn Overlays() {
    let open = zeus.signal(0)
    let ask = zeus.signal(0)
    zeus.SectionTitle("Overlay", "Dialog and alert dialog")
    zeus.Row(SPACE.Sm) {
        zeus.Button("Dialog", look = zeus.LOOK.Solid, size = zeus.SIZE.Md, on_click =  fn() => open.set(1))
        zeus.Button("Alert dialog", look = zeus.LOOK.Outline, size = zeus.SIZE.Md, on_click =  fn() => ask.set(1))
    }
    zeus.Body("Dialog has a corner X; alert dialog does not. Cancel is ghost or outline; the destructive action closes.")
    zeus.Dialog(open) {
        zeus.Title("Share the link?")
        zeus.Body("Anyone with the link can view this project. You can revoke access later.")
        zeus.Row(SPACE.Sm) {
            zeus.Grow()
            zeus.Button("Cancel", look = zeus.LOOK.Ghost, size = zeus.SIZE.Md, on_click =  fn() => open.set(0))
            zeus.Button("Share", look = zeus.LOOK.Solid, size = zeus.SIZE.Md, on_click =  fn() => open.set(0))
        }
    }
    zeus.AlertDialog(ask) {
        zeus.Title("Discard changes?")
        zeus.Body("This cannot be undone. The working tree keeps whatever you have not saved.")
        zeus.Row(SPACE.Sm) {
            zeus.Grow()
            zeus.Button("Cancel", look = zeus.LOOK.Outline, size = zeus.SIZE.Md, on_click =  fn() => ask.set(0))
            zeus.Button("Discard", look = zeus.LOOK.Danger, size = zeus.SIZE.Md, on_click =  fn() => ask.set(0))
        }
    }
}

// --- Charts (Patterns page): shadcn chart cards over zeus plots ---

let mut chart_labs: []string = []string {}
let mut chart_series: []string = []string {}
let mut chart_vals: []int = []int {}

fn ChartCards() {
    if chart_labs.len == 0 {
        push(chart_labs, "Jan")
        push(chart_labs, "Feb")
        push(chart_labs, "Mar")
        push(chart_labs, "Apr")
        push(chart_labs, "May")
        push(chart_labs, "Jun")
        push(chart_labs, "Jul")
        push(chart_labs, "Aug")
        push(chart_labs, "Sep")
        push(chart_labs, "Oct")
        push(chart_labs, "Nov")
        push(chart_labs, "Dec")
        push(chart_series, "Desktop")
        push(chart_series, "Mobile")
        push(chart_vals, 186)
        push(chart_vals, 82)
        push(chart_vals, 305)
        push(chart_vals, 134)
        push(chart_vals, 237)
        push(chart_vals, 290)
        push(chart_vals, 73)
        push(chart_vals, 226)
        push(chart_vals, 209)
        push(chart_vals, 91)
        push(chart_vals, 214)
        push(chart_vals, 240)
        push(chart_vals, 130)
        push(chart_vals, 170)
        push(chart_vals, 160)
        push(chart_vals, 210)
        push(chart_vals, 180)
        push(chart_vals, 150)
        push(chart_vals, 230)
        push(chart_vals, 190)
        push(chart_vals, 250)
        push(chart_vals, 220)
        push(chart_vals, 170)
        push(chart_vals, 260)
    }
    zeus.SectionHeader("Data", "Charts",
        "Hover a column or a point: the floating tooltip lists every series value, like the recharts cursor. The plot re-fits its card on window resize.")
    zeus.Card() {
        zeus.Title("Bar chart · Total visitors")
        zeus.Body("Desktop and mobile sessions by month, grouped per category.")
        zeus.BarChart(chart_labs, chart_series, chart_vals, 850, 216)
    }
    zeus.Card() {
        zeus.Title("Line chart · Trend")
        zeus.Body("Straight segments with a dot on every data point; the stroke follows the series color.")
        zeus.LineChart(chart_labs, chart_series, chart_vals, 850, 216)
    }
    zeus.Card() {
        zeus.Title("Area chart · Volume")
        zeus.Body("A tinted wash under the line; the fill restyles with the appearance.")
        zeus.AreaChart(chart_labs, chart_series, chart_vals, 850, 216)
    }
}

fn Patterns() {
    LiveList()
    Cards()
    ChartCards()
    Skeletons()
    Overlays()
}

fn Showcase() {
    let page = zeus.signal(1)
    zeus.Page() {
        Navbar(page)
        zeus.show_eq(zeus.Column(zeus.SECTION) {
            Foundations()
        }, page, 0)
        zeus.show_eq(zeus.Column(zeus.SECTION) {
            Components()
        }, page, 1)
        zeus.show_eq(zeus.Column(zeus.SECTION) {
            Patterns()
        }, page, 2)
    }
}

fn Screen() {
    Showcase()
}
