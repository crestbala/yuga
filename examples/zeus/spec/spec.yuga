// The spec's reference app, in the declarative surface: components are plain
// `fn`s, hierarchy is block structure, props are named arguments, and state is
// a signal read inside a `{{ }}` hole so only that label repaints.
import "std:zeus"

fn Header(title: string) {
    zeus.Box(background = "#1e1e2e", padding = SPACE.Md) {
        zeus.Text(title, color = "#cdd6f4", font = 22)
    }
}

fn Counter() {
    let count = zeus.signal(0)

    zeus.Box(align_direction = DIRECTION.Column, spacing = SPACE.Sm, padding = SPACE.Md) {
        zeus.Text("Count: {{count.get()}}", color = "#cdd6f4")
        zeus.Box(align_direction = DIRECTION.Row, spacing = SPACE.Sm) {
            zeus.Button("-", on_click = fn() => count.set(count.get() - 1))
            zeus.Button("+", on_click = fn() => count.set(count.get() + 1))
        }
    }
}

fn main() {
    zeus.App("Zeus spec", 360, 220, fn() {
        Header("Counter")
        Counter()
    })
}
