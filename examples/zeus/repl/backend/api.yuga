//! Shared RPC contracts for the playground.
//!
//! Wasm (`frontend/app.yuga`), macOS (`macos/app.yuga`), and this backend all
//! import this file. `#[proto]` injects `encode_*` / `decode_*` that call
//! `std:http`. A renamed method or field is a compile error.

/// Source to compile and run (`Playground.Run`).
#[proto]
struct RunReq {
    source: string,
}

/// `ok` is 1 when the program compiled (and, for print programs, exited 0).
/// `kind` 0 = stdout in `log`. `kind` 1 = Zeus Canvas2D wasm in `wasm`.
#[proto]
struct RunResp {
    ok: int,
    log: string,
    kind: int,
    wasm: string,
}

/// RPC name `Playground.Run` → path `/Playground/Run`.
fn run_rpc() -> string {
    return "Playground.Run"
}

/// Native macOS loopback. Wasm uses `http.client("")` (Vite proxy).
fn native_addr() -> string {
    return "127.0.0.1:8081"
}
