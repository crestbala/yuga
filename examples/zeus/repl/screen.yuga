//! Shared playground UI. Wasm and macOS pass the RPC address and a host chip.
//! Declarative ZEUS_SPEC.md syntax; the source buffer and the output log are
//! signals, so the output label re-renders when Run completes.

import "std:zeus"
import "std:http"
import "backend/api.yuga"

let bg      = "#1e1e2e"
let surface = "#313244"
let text    = "#cdd6f4"
let muted   = "#a6adc8"
let blue    = "#89b4fa"
let green   = "#a6e3a1"

fn hello_src() -> string {
    return "import \"std:fmt\"\n\nfn main() {\n    println(\"hello, yuga\")\n}\n"
}

fn fib_src() -> string {
    return "import \"std:fmt\"\n\nfn fib(n: int) -> int {\n    if n < 2 {\n        return n\n    }\n    return fib(n - 1) + fib(n - 2)\n}\n\nfn main() {\n    println(\"fib(10) =\", fib(10))\n}\n"
}

fn fizz_src() -> string {
    return "import \"std:fmt\"\n\nfn main() {\n    for i in 1..31 {\n        if i % 15 == 0 {\n            println(\"fizzbuzz\")\n        } else if i % 3 == 0 {\n            println(\"fizz\")\n        } else if i % 5 == 0 {\n            println(\"buzz\")\n        } else {\n            println(i)\n        }\n    }\n}\n"
}

fn struct_src() -> string {
    return "import \"std:fmt\"\n\nstruct Counter {\n    name: string,\n    count: int,\n}\n\nfn increment(c: &mut Counter) {\n    c.count += 1\n}\n\nfn main() {\n    let mut c = Counter { name: \"tick\", count: 0 }\n    increment(&mut c)\n    increment(c)\n    println(c.name, c.count)\n}\n"
}

fn ui_src() -> string {
    return "import \"std:zeus\"\n\nfn main() {\n    let count = signal(5)\n    App(\"Zeus\", 560, 520, fn() {\n        Box(align_direction = \"column\", background = \"#1e1e2e\", padding = 16, spacing = 12) {\n            Text(\"Counter\", color = \"#cdd6f4\", font = 24)\n            Box(align_direction = \"row\", spacing = 8) {\n                Button(\"-1\", on_click = fn() => count.set(count.get() - 1)),\n                Text(\"\{{count.get()}}\", color = \"#cdd6f4\", font = 16),\n                Button(\"+1\", on_click = fn() => count.set(count.get() + 1))\n            },\n            Progress(sig = count)\n        }\n    })\n}\n"
}

struct ChipProps {
    label: string = "",
    color: string = blue,
}

fn Chip(p: ChipProps) {
    Box(background = p.color, padding = 6, radius = 8) {
        Text(p.label, color = bg, font = 11)
    }
}

struct AlertProps {
    title: string = "",
    body: string = "",
    color: string = blue,
}

fn Alert(p: AlertProps) {
    Box(background = surface, padding = 12, radius = 8, gap = 4) {
        Text(p.title, color = p.color, font = 13),
        Text(p.body, color = muted, font = 12)
    }
}

struct CardProps {
    title: string = "",
    subtitle: string = "",
}

fn Card(p: CardProps) -> Node {
    return Box(background = surface, padding = 16, radius = 8, spacing = 10) {
        Text(p.title, color = text, font = 15),
        Text(p.subtitle, color = muted, font = 12)
    }
}

/// Page built once. `chip` is Canvas2D / macOS.
fn Screen(addr: string, chip: string) {
    let c = http.client(addr)
    let src = signal(hello_src())
    let last_log = signal("Click the source, edit Yuga, press Run. Playground.Run is protobuf.")

    Box(align_direction = DIRECTION.Column, background = bg, padding = 16, spacing = 14) {
        Box(align_direction = DIRECTION.Row, spacing = 8) {
            Text("Playground", color = text, font = 24),
            Chip(label = chip, color = blue),
            Chip(label = "gRPC", color = green)
        },
        Alert(title = "RPC", body = "Edit the source, then Run. The client POSTs Playground.Run (protobuf) and yugac compiles it.", color = blue),
        Box(align_direction = DIRECTION.Row, spacing = 8) {
            Button("hello", on_click = fn() => src.set(hello_src())),
            Button("fib", on_click = fn() => src.set(fib_src())),
            Button("fizz", on_click = fn() => src.set(fizz_src())),
            Button("struct", on_click = fn() => src.set(struct_src())),
            Button("ui", on_click = fn() => src.set(ui_src())),
            Spacer(),
            Button("Run", background = blue, color = bg, on_click = fn() {
                let req = RunReq { source: src.get() }
                let resp = api.decode_RunResp(c.call(api.run_rpc(), api.encode_RunReq(req)))
                last_log.set(resp.log)
            })
        },
        Card(title = "Source", subtitle = "Click here and type Yuga. Samples replace the buffer.") {
            Input(bind = src, font = 13, background = bg, padding = 12)
        },
        Card(title = "Output", subtitle = "Playground.Run") {
            Text("{{last_log.get()}}", color = muted, font = 13)
        }
    }
}
