//! macOS desktop playground UI. Same Zeus tree as wasm; HTTP is gRPC-Web.
//!
//! `main` POSTs `Playground.Run` to the native backend on `127.0.0.1:8081`.
//! Start the backend first: `../backend/run.sh`, or use `./run.sh`.

import "std:zeus"
import "../backend/api.yuga"
import "../screen.yuga"

fn main() {
    zeus.app("Playground", 760, 720, || {
        screen.Screen(api.native_addr(), "macOS")
    })
}
