//! Zeus declarative example — same widgets as the counter app, no backend.
//!
//! `yugac --run demo.yuga` opens a native window. In the playground, pick `ui`.

import "std:zeus"

fn main() {
    let count = signal(5)
    let load = signal(42)
    App("Zeus", 560, 520, fn() {
        Box(align_direction = DIRECTION.Column, background = "#1e1e2e", padding = 16, spacing = 12) {
            Text("Counter", color = "#cdd6f4", font = 24),
            Box(align_direction = DIRECTION.Row, spacing = 8) {
                Button("-1", on_click = fn() => count.set(count.get() - 1)),
                Text("{{count.get()}}", color = "#cdd6f4", font = 16),
                Button("+1", on_click = fn() => count.set(count.get() + 1))
            },
            Progress(sig = count),
            Divider(),
            Box(align_direction = DIRECTION.Row, spacing = 10) {
                Text("Load", color = "#a6adc8", font = 13),
                Progress(sig = load)
            }
        }
    })
}
