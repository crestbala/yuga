//! Native gRPC-Web server for the counter example (`:8080`).
//!
//! Vite on `:5173`, the iOS Simulator, the macOS Cocoa app, and the Android
//! emulator all POST `Counter/*` here. The emulator reaches this process at
//! `10.0.2.2:8080`.
//! Handlers take protobuf bytes (`body`) and return protobuf bytes. Request
//! structs are empty; the interesting numbers are in the responses.

import "std:http"
import "api.yuga"
import "std:fmt"

fn main() {
    let app = http.app()
    // `Counter.Hello` — wasm uses `hello.count` as the starting counter.
    app.rpc(api.hello_rpc(), |body| {
        let req = api.decode_HelloReq(body)
        api.encode_HelloResp(HelloResp { count: 5 })
    })
    // `Counter.Stats` — Users / Jobs / Uptime cards and the Load bar.
    app.rpc(api.stats_rpc(), |body| {
        let req = api.decode_StatsReq(body)
        api.encode_StatsResp(StatsResp {
            users: "1,204",
            jobs: "12",
            uptime: "99.9%",
            load: 42,
        })
    })
    app.listen(8080)
}
