// Headless probe: programmatic scroll buttons + insert, app mode.
import "std:fmt"
import "std:zeus"
import "screen.yuga"

fn feed_at(step: string) {
    let feed = zeus.engine_find_role("list")
    fmt.println(step, "feed sy", zeus.node_scroll_y(feed), "max", zeus.node_scroll_max(feed))
    let mut found = ""
    let mut k = 0
    while k < 40 {
        let id = zeus.engine_find_text("msg {{k}}  ping from the feed")
        if id > 0 {
            found = "{{found}} {{k}}"
        }
        k = k + 1
    }
    fmt.println(step, "top rows:", found)
}

fn main() {
    zeus.window("virt-app", 900, 1400)
    zeus.view(fn() -> Node {
        return zeus.Box(align_direction = DIRECTION.Column, grow = 1) {
            screen.Screen("virt-app", "head", "1", "2", "3", 0, 0)
        }
    })
    zeus.engine_layout(900, 1400)
    feed_at("t0")

    zeus.engine_click_text("Mid")
    zeus.engine_layout(900, 1400)
    zeus.engine_layout(900, 1400)
    let feed = zeus.engine_find_role("list")
    fmt.println("Mid -> sy", zeus.node_scroll_y(feed))
    fmt.println("msg 5000 mounted?", zeus.engine_find_text("msg 5000  ping from the feed") > 0)

    zeus.engine_click_text("Insert")
    zeus.engine_layout(900, 1400)
    zeus.engine_layout(900, 1400)
    fmt.println("after Insert sy", zeus.node_scroll_y(feed))
    fmt.println("inserted at top?", zeus.engine_find_text("msg inserted at top") > 0)
    feed_at("post insert")

    zeus.engine_click_text("Top")
    zeus.engine_layout(900, 1400)
    zeus.engine_layout(900, 1400)
    feed_at("after Top")
}
