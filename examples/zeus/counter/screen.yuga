//! Shared counter UI. Wasm, iOS, macOS, and Android all pass RPC results in.
//!
//! Chrome comes from `std:kit`. `users` / `jobs` / `uptime` are static strings
//! from `Counter.Stats`; `count0` / `load0` seed signals.

import "std:zeus"
import "std:kit"

const TILE: int = 36
const BAR_H: int = 4
const FONT_DISPLAY: int = 26

fn Stat(label: string, value: string, kind: int) {
    kit.Card() {
        zeus.Box(width = TILE, height = 4, radius = 2, background = kit.tint_of(kind))
        zeus.Text(label, color = kit.dim(), font = kit.FONT_CAPTION)
        zeus.Text(value, color = kit.ink(), font = FONT_DISPLAY)
    }
}

fn StatCount(label: string, sig: Signal<int>, kind: int) {
    kit.Card() {
        zeus.Box(width = TILE, height = 4, radius = 2, background = kit.tint_of(kind))
        zeus.Text(label, color = kit.dim(), font = kit.FONT_CAPTION)
        zeus.Text("{{sig.get()}}", color = kit.ink(), font = FONT_DISPLAY)
    }
}

fn clamp(v: int) -> int {
    if v < 0 {
        0
    } else if v > 100 {
        100
    } else {
        v
    }
}

fn Bar(sig: Signal<int>) {
    zeus.Box(height = BAR_H, radius = 2, background = kit.rule(), grow = 1) {
        // Scale 2 → max 200px at 100, so the fill never overflows the row
        // (an overflowing flex child pushes the trailing buttons to a new
        // line instead of shrinking).
        zeus.Box(height = BAR_H, radius = 2, background = kit.ink(),
                 width = clamp(sig.get()) * 2)
    }
}

fn Header(title: string, chip: string) {
    kit.Row(SPACE.Md) {
        zeus.Box(width = 8, height = 24, radius = 4, background = kit.ink())
        zeus.Text(title, color = kit.ink(), font = kit.FONT_TITLE)
        kit.Chip(chip, kit.TINT.Mute)
        kit.Badge("live", kit.TINT.Ok)
        kit.Grow()
        zeus.Text("Dark", color = kit.mute(), font = kit.FONT_BODY)
        kit.Switch(zeus.appearance())
    }
}

fn Stats(users: string, jobs: string, uptime: string, count: Signal<int>) {
    zeus.Grid(config = GridConfig(columns = 2, gap = SPACE.Md)) {
        Stat("Users", users, kit.TINT.Ink)
        Stat("Jobs", jobs, kit.TINT.Mute)
        Stat("Uptime", uptime, kit.TINT.Ok)
        StatCount("Count", count, kit.TINT.Danger)
    }
}

fn CountCard(count: Signal<int>, open: Signal<int>) {
    kit.Card() {
        kit.Title("Count")
        kit.Note("Buttons write a signal. The starting value came from protobuf.")
        kit.Row(SPACE.Sm) {
            kit.Button("-1", kit.LOOK.Ghost, kit.SIZE.Md, fn() => count.set(count.get() - 1))
            // Fixed-width slot: digits may change, but the buttons beside the
            // value never slide left or right.
            zeus.Box(align_direction = DIRECTION.Row, justify = ALIGN.Center, width = 64) {
                zeus.Text("{{count.get()}}", color = kit.ink(), font = 16)
            }
            kit.Button("+1", kit.LOOK.Solid, kit.SIZE.Md, fn() => count.set(count.get() + 1))
        }
        Bar(count)
        kit.Divider()
        kit.Button("Open Dialog", kit.LOOK.Solid, kit.SIZE.Md, fn() => open.set(1))
    }
}

fn Load(load: Signal<int>) {
    kit.Row(SPACE.Md) {
        zeus.Text("Load", color = kit.dim(), font = kit.FONT_BODY)
        Bar(load)
        // Fixed-width slot so the trailing buttons do not shift with the digits.
        zeus.Box(align_direction = DIRECTION.Row, justify = ALIGN.End, width = 44) {
            zeus.Text("{{load.get()}}%", color = kit.mute(), font = kit.FONT_BODY)
        }
        kit.Button("+10", kit.LOOK.Soft, kit.SIZE.Md, fn() => load.set(clamp(load.get() + 10)))
        kit.Button("-10", kit.LOOK.Soft, kit.SIZE.Md, fn() => load.set(clamp(load.get() - 10)))
    }
}

fn Dialog(open: Signal<int>) {
    let dim = zeus.Overlay(
        background = "#000000",
        opacity = 55,
        on_click = fn() => open.set(0)
    ) {
        zeus.Box(
            width = 360,
            padding = SPACE.Xl,
            spacing = SPACE.Md,
            background = kit.plate(),
            border = 1,
            border_color = kit.rule(),
            radius = 16,
            on_click = fn() { return }
        ) {
            kit.Title("Dialog")
            kit.Body("How are you feeling today?")
            kit.Row(SPACE.Sm) {
                kit.Grow()
                kit.Button("Close", kit.LOOK.Ghost, kit.SIZE.Md, fn() => open.set(0))
                kit.Button("Save", kit.LOOK.Solid, kit.SIZE.Md, fn() => open.set(0))
            }
        }
    }
    zeus.show(dim, open)
}

/// Page built once from RPC results. `chip` is the host label
/// (Canvas2D / iOS / macOS / Android). Call from `zeus.App`.
fn Screen(title: string, chip: string, users: string, jobs: string, uptime: string, load0: int, count0: int) {
    let count = zeus.signal(count0)
    let load = zeus.signal(load0)
    let open = zeus.signal(0)

    zeus.Box(align_direction = DIRECTION.Column, spacing = SPACE.Exs,
             padding = kit.PAGE_PAD, background = kit.paper(), grow = 1) {
        Header(title, chip),
        kit.Alert("RPC", "Count is Counter.Hello. Cards are Counter.Stats."),
        Stats(users, jobs, uptime, count),
        CountCard(count, open),
        Load(load),
        Dialog(open),
    }
}
