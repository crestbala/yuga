import "std:http"
import "api.yuga"

fn main() {
    let app = http.app()
    http.get(app, api.hello_path(), |req, res| {
        res.send_json(http.json_from_int(api.hello_count_key(), 1))
    })
    http.get(app, api.stats_path(), |req, res| {
        res.send_json(api.stats_body())
    })
    http.listen(app, 8080)
}
