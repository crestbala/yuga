// Headless probe: the REAL app path — zeus.App retained tree + root scroll.
import "std:fmt"
import "std:zeus"
import "screen.yuga"

fn jobs_near(step: string) {
    let mut found = ""
    let mut i2 = 0
    while i2 < 10000 {
        let id = zeus.engine_find_text("job {{i2}}")
        if id > 0 {
            found = "{{found}} {{i2}}"
        }
        i2 = i2 + 1
    }
    fmt.println(step, "jobs:", found)
}

fn main() {
    let win = zeus.window_size()
    zeus.App("virt-app", win.width, win.height, fn() {
        screen.Screen("virt-app", "head", "1", "2", "3", 0, 0)
    })
    // zeus.App headless runs one layout; continue driving frames ourselves.
    zeus.engine_layout(900, 1400)
    jobs_near("t0")

    // Wheel over the jobs list rows (page content at y 993..1305).
    let mut k = 0
    while k < 3 {
        zeus.engine_scroll(400, 1150, 0, 72)
        zeus.engine_layout(900, 1400)
        k = k + 1
    }
    jobs_near("jobs wheel x3")
    let mut feed = zeus.engine_find_role("list")
    fmt.println("jobs(feed role) sy", zeus.node_scroll_y(feed))

    // Thumb drag the jobs list bar.
    zeus.engine_click(843, 1110)
    zeus.engine_layout(900, 1400)
    zeus.engine_drag(843, 1150)
    zeus.engine_layout(900, 1400)
    zeus.engine_drag(843, 1200)
    zeus.engine_layout(900, 1400)
    zeus.engine_mouseup()
    zeus.engine_layout(900, 1400)
    jobs_near("jobs bar drag")

    // Wheel over the feed list.
    k = 0
    while k < 3 {
        zeus.engine_scroll(400, 860, 0, 72)
        zeus.engine_layout(900, 1400)
        k = k + 1
    }
    feed = zeus.engine_find_role("list")
    fmt.println("feed sy after wheel", zeus.node_scroll_y(feed), "max", zeus.node_scroll_max(feed))
    let mut i = 0
    let mut frows = ""
    while i < 30 {
        let id = zeus.engine_find_text("msg {{i}}  ping from the feed")
        if id > 0 {
            frows = "{{frows}} {{i}}"
        }
        i = i + 1
    }
    fmt.println("feed rows:", frows)
}
