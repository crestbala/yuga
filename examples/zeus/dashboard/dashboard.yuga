// Zeus dashboard. Themed chrome from `std:zeus`; ticks, load, and alerts
// are signals. The look follows the shadcn/ui default theme: zinc palette,
// white page, primary-fill buttons, hairline cards.
import "std:zeus"

let mut req_labs: []string = []string {}
let mut req_series: []string = []string {}
let mut req_vals: []int = []int {}

fn clamp(v: int) -> int {
    if v < 0 {
        0
    } else if v > 100 {
        100
    } else {
        v
    }
}

fn Header(title: string, ticks: Signal<int>, open: Signal<int>) {
    zeus.Row(SPACE.Md) {
        zeus.Box(width = 8, height = 24, radius = 4, background = zeus.ink())
        zeus.Text(title, color = zeus.ink(), font = zeus.FONT_TITLE)
        zeus.Grow()
        zeus.Text("Dark", color = zeus.mute(), font = zeus.FONT_BODY)
        zeus.Switch(zeus.appearance())
        zeus.Text("ticks", color = zeus.dim(), font = zeus.FONT_BODY)
        zeus.Text("{{ticks.get()}}", color = zeus.ink(), font = zeus.FONT_BODY)
        zeus.Button("Tick", look = zeus.LOOK.Solid, size = zeus.SIZE.Md, on_click =  fn() => ticks.set(ticks.get() + 1))
        zeus.Button("Dialog", look = zeus.LOOK.Solid, size = zeus.SIZE.Md, on_click =  fn() => open.set(1))
    }
}

fn Activity(title: string, meta: string) {
    zeus.Box(align_direction = DIRECTION.Row, spacing = SPACE.Sm,
             align_items = ALIGN.Center, padding_x = 2, padding_y = 2) {
        zeus.Text(title, color = zeus.ink(), font = zeus.FONT_BODY, grow = 1)
        zeus.Text(meta, color = zeus.mute(), font = zeus.FONT_CAPTION)
    }
}

fn Stats(ticks: Signal<int>) {
    zeus.Grid(config = GridConfig(columns = 2, gap = SPACE.Md)) {
        zeus.Stat("Users", "1,204", zeus.TINT.Ink)
        zeus.Stat("Jobs", "12", zeus.TINT.Mute)
        zeus.Stat("Uptime", "99.9%", zeus.TINT.Ok)
        zeus.StatCount("Ticks", ticks, zeus.TINT.Danger)
    }
}

fn Load(load: Signal<int>) {
    zeus.Row(SPACE.Md) {
        zeus.Text("Load", color = zeus.dim(), font = zeus.FONT_BODY)
        zeus.Progress(load)
        zeus.Text("{{load.get()}}%", color = zeus.mute(), font = zeus.FONT_BODY)
        zeus.Button("+10", look = zeus.LOOK.Soft, size = zeus.SIZE.Md, on_click =  fn() => load.set(clamp(load.get() + 10)))
        zeus.Button("-10", look = zeus.LOOK.Soft, size = zeus.SIZE.Md, on_click =  fn() => load.set(clamp(load.get() - 10)))
    }
}

fn Alerts(notify: Signal<int>) {
    zeus.Card() {
        zeus.Row(SPACE.Md) {
            zeus.Switch(notify)
            zeus.Text("Alerts", color = zeus.ink(), font = zeus.FONT_BODY)
            zeus.Grow()
            zeus.Checkbox("Notify", notify)
        }
    }
}

fn Feed() {
    zeus.Card() {
        zeus.Title("Activity")
        Activity("Deploy web", "2m ago")
        zeus.Divider()
        Activity("Job #12 done", "14m ago")
        zeus.Divider()
        Activity("User signup", "1h ago")
        zeus.Divider()
        Activity("Cache warm", "3h ago")
        zeus.Divider()
        Activity("Index rebuild", "5h ago")
        zeus.Divider()
        Activity("Backup ok", "8h ago")
        zeus.Divider()
        Activity("Alert silenced", "12h ago")
        zeus.Divider()
        Activity("Cert renewed", "1d ago")
        zeus.Divider()
        Activity("Region failover", "2d ago")
    }
}

fn Traffic() {
    if req_labs.len == 0 {
        push(req_labs, "00")
        push(req_labs, "01")
        push(req_labs, "02")
        push(req_labs, "03")
        push(req_labs, "04")
        push(req_labs, "05")
        push(req_labs, "06")
        push(req_labs, "07")
        push(req_labs, "08")
        push(req_labs, "09")
        push(req_labs, "10")
        push(req_labs, "11")
        push(req_labs, "12")
        push(req_labs, "13")
        push(req_labs, "14")
        push(req_labs, "15")
        push(req_labs, "16")
        push(req_labs, "17")
        push(req_labs, "18")
        push(req_labs, "19")
        push(req_labs, "20")
        push(req_labs, "21")
        push(req_labs, "22")
        push(req_labs, "23")
        push(req_series, "Requests")
        push(req_vals, 18)
        push(req_vals, 12)
        push(req_vals, 10)
        push(req_vals, 9)
        push(req_vals, 12)
        push(req_vals, 22)
        push(req_vals, 58)
        push(req_vals, 130)
        push(req_vals, 210)
        push(req_vals, 245)
        push(req_vals, 235)
        push(req_vals, 190)
        push(req_vals, 150)
        push(req_vals, 140)
        push(req_vals, 155)
        push(req_vals, 190)
        push(req_vals, 240)
        push(req_vals, 275)
        push(req_vals, 250)
        push(req_vals, 190)
        push(req_vals, 130)
        push(req_vals, 80)
        push(req_vals, 40)
        push(req_vals, 22)
    }
    zeus.Card() {
        zeus.Row(SPACE.Sm) {
            zeus.Column(SPACE.Exxs) {
                zeus.Text("Requests", color = zeus.ink(), font = zeus.FONT_TITLE)
                zeus.Text("Per hour, last 24 hours", color = zeus.mute(), font = zeus.FONT_CAPTION)
            }
            zeus.Grow()
            zeus.Badge("live", zeus.TINT.Ok)
        }
        zeus.AreaChart(req_labs, req_series, req_vals, 810, 196)
    }
}

fn Dashboard() {
    let ticks = zeus.signal(0)
    let load = zeus.signal(42)
    let notify = zeus.signal(1)
    let open = zeus.signal(0)

    zeus.Page() {
        Header("Zeus Dashboard", ticks, open)
        zeus.Breadcrumbs("Zeus", "App", "Dashboard")
        zeus.Body("Rows and cards fill the window. Labels stay left; actions sit on the right.")
        zeus.Alert("Heads up", "Signals update on click. Scroll if the page overflows.")
        zeus.Row(SPACE.Md) {
            zeus.User("AP", "Ada Park", "Operator")
            zeus.Grow()
            zeus.Chip("Live", zeus.TINT.Ok)
            zeus.Chip("v1", zeus.TINT.Mute)
        }
        Stats(ticks)
        Load(load)
        Traffic()
        Alerts(notify)
        Feed()
        zeus.Note("Hover the area chart to read exact request counts. Tick, Load, and Alerts are signals.")
        zeus.Dialog(open) {
            zeus.Title("Discard changes?")
            zeus.Body("This cannot be undone. The working tree keeps whatever you have not saved.")
            zeus.Row(SPACE.Sm) {
                zeus.Grow()
                zeus.Button("Cancel", look = zeus.LOOK.Ghost, size = zeus.SIZE.Md, on_click =  fn() => open.set(0))
                zeus.Button("Discard", look = zeus.LOOK.Danger, size = zeus.SIZE.Md, on_click =  fn() => open.set(0))
            }
        }
    }
}

fn main() {
    zeus.App("Zeus Dashboard", 920, 720, fn() {
        Dashboard()
    })
}
