//! Declarative dashboard on the Bezel kit (ZEUS_SPEC.md syntax): components
//! are `fn`s, the tree comes from trailing blocks, and labels re-render from
//! signals. Clicks, toggles, a live tick counter, and a dialog. Colors and
//! spacing come from the shared theme module.

import "std:zeus"
import "../../../packages/zeus-components/ui.yuga"

fn Dashboard() {
    let ticks = signal(0)
    let load = signal(42)
    let notify = signal(1)
    let open = signal(0)

    Box(align_direction = DIRECTION.Column, background = canvas(), padding = SPACE.Page, spacing = SPACE.Section) {
        Header(title = "Zeus Dashboard", live_label = "ticks", sig = ticks, btn = "Tick"),
        Breadcrumbs(a = "Zeus", b = "App", c = "Dashboard"),
        Text("Rows and cards fill the window. Labels stay left; actions sit on the right.", color = muted(), font = type_body()),
        Alert(title = "Sync", body = "Signals update on click. Scroll if the page overflows.", color = success()),
        Box(align_direction = DIRECTION.Row, spacing = SPACE.Md, align_items = ALIGN.Center) {
            User(initials = "AP", name = "Ada Park", role = "Operator", color = accent()),
            Spacer(),
            Chip(label = "Live", color = success()),
            Chip(label = "v1", color = purple())
        },
        Stats(users_t = "Users", users = "1,204", jobs_t = "Jobs", jobs = "12", uptime_t = "Uptime", uptime = "99.9%", ticks_t = "Ticks", ticks = ticks),
        Box(align_direction = DIRECTION.Row, spacing = SPACE.Md, align_items = ALIGN.Center) {
            Text("Load", color = label(), font = 13),
            Progress(sig = load)
        },
        Surface() {
            Box(align_direction = DIRECTION.Row, spacing = SPACE.Lg, align_items = ALIGN.Center) {
                Switch(sig = notify),
                Text("Alerts", color = text(), font = 13),
                Spacer(),
                Checkbox(label = "Notify", sig = notify)
            }
        },
        Panel(title = "Activity") {
            Activity(title = "Deploy web", meta = "2m ago"),
            Divider(),
            Activity(title = "Job #12 done", meta = "14m ago"),
            Divider(),
            Activity(title = "User signup", meta = "1h ago"),
            Divider(),
            Activity(title = "Cache warm", meta = "3h ago"),
            Divider(),
            Activity(title = "Index rebuild", meta = "5h ago"),
            Divider(),
            Activity(title = "Backup ok", meta = "8h ago"),
            Divider(),
            Activity(title = "Alert silenced", meta = "12h ago"),
            Divider(),
            Activity(title = "Cert renewed", meta = "1d ago"),
            Divider(),
            Activity(title = "Region failover", meta = "2d ago")
        },
        Box(align_direction = DIRECTION.Row, spacing = SPACE.Sm, align_items = ALIGN.Center) {
            Text("Tick and Load are signals. Note opens a dialog. Scroll if content overflows.", color = muted(), font = 12),
            Spacer(),
            Open(label = "Note", on_press = fn() => open.set(1))
        },
        Dialog(title = "Discard changes?", body = "This cannot be undone. The working tree keeps whatever you have not saved.", cancel = "Cancel", discard = "Discard", open = open)
    }
}

fn main() {
    App("Zeus Dashboard", 920, 720, fn() { Dashboard() })
}
