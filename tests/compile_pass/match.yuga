import "std:fmt"

fn main() {
    let x = 2
    let mut s = 0
    match x {
        0 | 1 => {
            s = 10
        }
        2 => {
            s = 20
        }
        _ => {
            s = 30
        }
    }
    fmt.println(s)
    match true {
        true => {
            fmt.println(1)
        }
        false => {
            fmt.println(0)
        }
    }
    match "ok" {
        "ok" => {
            fmt.println(1)
        }
        _ => {
            fmt.println(0)
        }
    }
    let b: bool = false
    match b {
        true => {
            fmt.println(9)
        }
        _ => {
            fmt.println(8)
        }
    }
}
