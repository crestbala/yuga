import "std:fmt"
import "std:zeus"

fn fail() {
    let z = 0
    fmt.println(1 / z)
}

fn expect(got: int, want: int) {
    if got < want {
        fail()
    }
    if want < got {
        fail()
    }
}

fn main() {
    let sig = zeus.signal(1)
    let out = zeus.signal(0)
    let n = zeus.box()
    n.styled(|| {
        n.bg(zeus.get(sig))
        zeus.set(out, zeus.get(sig))
    })
    expect(zeus.get(out), 1)
    expect(zeus.get(sig), 1)

    zeus.set(sig, 7)
    expect(zeus.get(out), 7)
    expect(zeus.get(sig), 7)

    let bound = zeus.signal(3)
    let lab = zeus.label("0").bind(bound)
    zeus.window("styled", 120, 80)
    zeus.root(zeus.col().child(n, lab))
    zeus.engine_layout(120, 80)
    expect(zeus.get(bound), 3)
    zeus.set(bound, 9)
    expect(zeus.get(bound), 9)
}
