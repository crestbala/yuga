import "std:fmt"
import "std:http"

fn fail() {
    let z = 0
    fmt.println(1 / z)
}

fn main() {
    let nbody = http.json_from_int("count", 7)
    let n = http.json_get_int(nbody, "count")
    if n < 7 {
        fail()
    }
    if 7 < n {
        fail()
    }
    let sbody = http.json_from_string("name", "hi")
    let s = http.json_get_string(sbody, "name")
    if http.eq(s, "hi") {
        fmt.println("json")
    } else {
        fail()
    }
}
