import "std:maya"

// log2(n) in Q10 (times 1024). Used for a log-AU ring so Mercury and Neptune fit.
fn log2q(n: int) -> int {
    if n < 1 {
        return 0
    }
    let mut e = 0
    let mut p = 1
    for i in 0..62 {
        if p <= n / 2 {
            p *= 2
            e += 1
        }
    }
    let mant = n * 1024 / p
    let f = mant - 1024
    if f < 0 {
        return e * 1024
    }
    let lin = f * 1477 / 1024
    let quad = f * f / 1024 * 739 / 1024
    return e * 1024 + lin - quad
}

// milli-AU → orbit radius in 1024-units, log-scaled between 0.30 AU and 32 AU.
fn ring(milli_au: int) -> int {
    let inner = 300
    let outer = 32000
    let mut a = milli_au
    if a < inner {
        a = inner
    }
    if a > outer {
        a = outer
    }
    let span = log2q(outer) - log2q(inner)
    if span < 1 {
        return 1024
    }
    return (log2q(a) - log2q(inner)) * 1024 / span
}

// Sidereal days → wall milliseconds. One Earth year is 8s at 1x.
fn year_ms(days: int) -> int {
    if days < 1 {
        return 1
    }
    return days * 8000 / 365
}

fn sun(label: string, rgb: int, size: int) -> Body {
    return maya.name(maya.sphere(8).add().scale(size).tint(rgb).glow(256), label)
}

fn planet(around: Body, label: string, rgb: int, milli_au: int, days: int, size: int) -> Body {
    let b = maya.name(maya.sphere(8).add().scale(size).tint(rgb), label)
    return maya.orbit(b, around, ring(milli_au), year_ms(days))
}

fn main() {
    maya.init()
    maya.window("Solar system", 1280, 720)
    maya.flat()

    let star = sun("Sun", maya.rgb(255, 214, 70), 22)

    planet(star, "Mercury", maya.rgb(186, 166, 160), 387, 88, 4)
    planet(star, "Venus", maya.rgb(230, 190, 110), 723, 225, 6)
    planet(star, "Earth", maya.rgb(70, 130, 220), 1000, 365, 6)
    planet(star, "Mars", maya.rgb(200, 80, 40), 1524, 687, 5)
    planet(star, "Jupiter", maya.rgb(216, 176, 130), 5203, 4333, 14)
    planet(star, "Saturn", maya.rgb(230, 210, 150), 9537, 10759, 12)
    planet(star, "Uranus", maya.rgb(140, 200, 220), 19191, 30687, 9)
    planet(star, "Neptune", maya.rgb(50, 90, 200), 30069, 60190, 9)

    maya.run()
}
