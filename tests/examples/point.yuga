import fmt

struct Point {
    x: int,
    y: int,
}

fn abs(n: int) -> int {
    if n < 0 {
        return -n
    }
    return n
}

fn manhattan(p: &Point) -> int {
    return abs(p.x) + abs(p.y)
}

fn translate(p: &mut Point, dx: int, dy: int) {
    p.x += dx
    p.y += dy
}

fn main() {
    let mut p = Point { x: 3, y: -4 }
    fmt.println(manhattan(p))
    translate(p, 1, 1)
    fmt.println(p.x)
    fmt.println(p.y)
    fmt.println(manhattan(p))
}
