//! Load every Docs.Page into module arrays once, then Screen reads by id.

import "std:http"
import "backend/api.yuga"

let mut titles: []string = []string {}
let mut leads: []string = []string {}
let mut bodies: []string = []string {}
let mut samples: []string = []string {}

fn load(c: Client) {
    let n = api.page_count()
    for i in 0..n {
        let raw = c.call(api.page_rpc(), api.encode_PageReq(PageReq { id: i }))
        let r = api.decode_PageResp(raw)
        push(titles, r.title)
        push(leads, r.lead)
        push(bodies, r.body)
        push(samples, r.sample)
    }
}

fn n() -> int {
    return titles.len
}

fn title(id: int) -> string {
    if id < 0 {
        return ""
    }
    if id >= titles.len {
        return ""
    }
    return titles[id]
}

fn lead(id: int) -> string {
    if id < 0 {
        return ""
    }
    if id >= leads.len {
        return ""
    }
    return leads[id]
}

fn body(id: int) -> string {
    if id < 0 {
        return ""
    }
    if id >= bodies.len {
        return ""
    }
    return bodies[id]
}

fn sample(id: int) -> string {
    if id < 0 {
        return ""
    }
    if id >= samples.len {
        return ""
    }
    return samples[id]
}
