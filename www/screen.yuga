//! Docs UI. Sidebar picks a page id; article copy was loaded over Docs.Page.

import "std:zeus"
import "../packages/zeus/lib/ui.yuga"
import "../packages/zeus/lib/theme.yuga"
import "cache.yuga"

fn NavItem(page: Signal<int>, id: int, label: string) -> Node {
    return ui.ListItem(ListItemProps { title: label, meta: "", sig: page, value: id })
}

fn Nav(page: Signal<int>) -> Node {
    return ui.Panel(PanelProps { title: "Yuga" }).w(240).children(
        ui.Overline(TypeProps { text: "Start" }),
        NavItem(page, 0, "Overview"),
        NavItem(page, 1, "Install"),
        ui.Overline(TypeProps { text: "Language" }),
        NavItem(page, 2, "Syntax"),
        NavItem(page, 3, "Types"),
        NavItem(page, 4, "Ownership"),
        NavItem(page, 5, "Control flow"),
        NavItem(page, 6, "Modules"),
        ui.Overline(TypeProps { text: "Libraries" }),
        NavItem(page, 7, "Overview"),
        NavItem(page, 8, "fmt"),
        NavItem(page, 9, "zeus"),
        NavItem(page, 10, "http"),
        NavItem(page, 11, "maya"),
        NavItem(page, 12, "sys"),
        NavItem(page, 13, "net"),
        ui.Overline(TypeProps { text: "More" }),
        NavItem(page, 14, "Platforms"),
        NavItem(page, 15, "Examples"),
    )
}

fn Block(id: int) -> Node {
    return zeus.col().gap(theme.space_sm()).children(
        ui.Heading(TypeProps { text: cache.title(id) }),
        ui.Body(TypeProps { text: cache.lead(id) }),
        ui.Body(TypeProps { text: cache.body(id) }),
        ui.Snippet(SnippetProps { text: cache.sample(id) }),
    )
}

fn Article(page: Signal<int>) -> Node {
    let n = zeus.col().gap(theme.space_md()).grow(1)
    let mut i = 0
    while i < cache.n() {
        n.child(Block(i).show_eq(page, i))
        i += 1
    }
    return n
}

fn Screen(chip: string, page: Signal<int>) -> Node {
    return theme.Page("Yuga", 1080, 720).children(
        zeus.row().gap(theme.space_sm()).align(zeus.flex_center()).children(
            zeus.text("Yuga").style(zeus.heading()),
            ui.Chip(ChipProps { label: chip, color: theme.accent() }),
            ui.Badge(BadgeProps { label: "Docs.Page", color: theme.success() }),
        ),
        ui.Alert(AlertProps {
            title: "RPC",
            body: "Sidebar writes a signal. Copy was fetched once over Docs.Page (gRPC-Web).",
            color: theme.accent(),
        }),
        zeus.row().gap(theme.space_lg()).align(zeus.flex_start()).children(
            Nav(page),
            Article(page),
        ),
    )
}
