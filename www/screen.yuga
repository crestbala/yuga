//! Docs UI. Sidebar picks a page id; article copy was loaded over Docs.Page.

import "std:zeus"
import "std:kit"
import "cache.yuga"

fn NavItem(page: Signal<int>, id: int, label: string) {
    zeus.Box(
        padding_x = 12,
        padding_y = 6,
        radius = 8,
        background = fn() -> string {
            if page.get() == id {
                return kit.wash()
            }
            return ""
        },
        on_click = fn() => page.set(id)
    ) {
        zeus.Text(label, color = kit.ink(), font = 13)
    }
}

fn Nav(page: Signal<int>) {
    zeus.Box(width = 240, align_direction = DIRECTION.Column, spacing = 4) {
        kit.Overline("Start")
        NavItem(page, 0, "Overview")
        NavItem(page, 1, "Install")
        kit.Overline("Language")
        NavItem(page, 2, "Syntax")
        NavItem(page, 3, "Types")
        NavItem(page, 4, "Ownership")
        NavItem(page, 5, "Control flow")
        NavItem(page, 6, "Modules")
        kit.Overline("Libraries")
        NavItem(page, 7, "Overview")
        NavItem(page, 8, "fmt")
        NavItem(page, 9, "zeus")
        NavItem(page, 10, "http")
        NavItem(page, 11, "maya")
        NavItem(page, 12, "sys")
        NavItem(page, 13, "net")
        kit.Overline("More")
        NavItem(page, 14, "Platforms")
        NavItem(page, 15, "Examples")
    }
}

fn Block(id: int, page: Signal<int>) {
    let n = zeus.Box(align_direction = DIRECTION.Column, spacing = 8) {
        zeus.Text(cache.title(id), color = kit.ink(), font = 22)
        zeus.Text(cache.lead(id), color = kit.mute(), font = 14)
        zeus.Text(cache.body(id), color = kit.ink(), font = 13)
        zeus.Box(background = kit.wash(), padding = 12, radius = 8) {
            zeus.Text(cache.sample(id), color = kit.ink(), font = 12)
        }
    }
    zeus.show_eq(n, page, id)
}

fn Article(page: Signal<int>) {
    zeus.Box(align_direction = DIRECTION.Column, spacing = 16, grow = 1) {
        let mut i = 0
        while i < cache.n() {
            Block(i, page)
            i += 1
        }
    }
}

fn Screen(chip: string, page: Signal<int>) {
    zeus.Box(align_direction = DIRECTION.Column, spacing = 16, padding = 28,
             background = kit.paper()) {
        kit.Row(8) {
            zeus.Text("Yuga", color = kit.ink(), font = 22)
            kit.Chip(chip, kit.TINT.Ink)
            kit.Badge("Docs.Page", kit.TINT.Ok)
        }
        kit.Alert("RPC", "Sidebar writes a signal. Copy was fetched once over Docs.Page (gRPC-Web).")
        kit.Row(24) {
            Nav(page)
            Article(page)
        }
    }
}
