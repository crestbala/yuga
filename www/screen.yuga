//! Docs UI. Sidebar picks a page id; article copy was loaded over Docs.Page.

import "std:zeus"
import "../packages/zeus-components/ui.yuga"
import "cache.yuga"

fn NavItem(page: Signal<int>, id: int, label: string) -> Node {
    return ListItem(title = label, meta = "", sig = page, value = id)
}

fn Nav(page: Signal<int>) -> Node {
    let n = Panel(title = "Yuga", width = 240) {
        Overline(text = "Start"),
        NavItem(page, 0, "Overview"),
        NavItem(page, 1, "Install"),
        Overline(text = "Language"),
        NavItem(page, 2, "Syntax"),
        NavItem(page, 3, "Types"),
        NavItem(page, 4, "Ownership"),
        NavItem(page, 5, "Control flow"),
        NavItem(page, 6, "Modules"),
        Overline(text = "Libraries"),
        NavItem(page, 7, "Overview"),
        NavItem(page, 8, "fmt"),
        NavItem(page, 9, "zeus"),
        NavItem(page, 10, "http"),
        NavItem(page, 11, "maya"),
        NavItem(page, 12, "sys"),
        NavItem(page, 13, "net"),
        Overline(text = "More"),
        NavItem(page, 14, "Platforms"),
        NavItem(page, 15, "Examples")
    }
    return n
}

fn Block(id: int) -> Node {
    return Box(align_direction = DIRECTION.Column, gap = SPACE.Sm) {
        Heading(text = cache.title(id)),
        Body(text = cache.lead(id)),
        Body(text = cache.body(id)),
        Snippet(text = cache.sample(id))
    }
}

fn Article(page: Signal<int>) -> Node {
    let n = Box(align_direction = DIRECTION.Column, gap = SPACE.Md, grow = 1)
    let mut i = 0
    while i < cache.n() {
        let b = Block(i)
        show_eq(b, page, i)
        child(n, b)
        i += 1
    }
    return n
}

fn Screen(chip: string, page: Signal<int>) -> Node {
    window("Yuga", 1080, 720)
    return Box(align_direction = DIRECTION.Column, background = canvas(), padding = SPACE.Page, spacing = SPACE.Section) {
        Box(align_direction = DIRECTION.Row, gap = SPACE.Sm, align_items = ALIGN.Center) {
            Text("Yuga", font = 22),
            Chip(label = chip, color = accent()),
            Badge(label = "Docs.Page", color = success())
        },
        Alert(title = "RPC", body = "Sidebar writes a signal. Copy was fetched once over Docs.Page (gRPC-Web).", color = accent()),
        Box(align_direction = DIRECTION.Row, gap = SPACE.Lg, align_items = ALIGN.Start) {
            Nav(page),
            Article(page)
        }
    }
}
