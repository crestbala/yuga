//! Bezel theme tokens for the declarative kit. Colors are hex strings
//! (`theme.accent()`); numbers drive layout. 4px grid with 2px half-steps,
//! mirroring bezel's crates/theme/src/theme/layout.rs.

import "theme/colors.yuga"
import "theme/spacing.yuga"
import "theme/scale.yuga"
import "theme/font.yuga"
import "theme/motion.yuga"

// --- palette (declarative: hex strings) ---

fn canvas() -> string {
    return colors.canvas()
}
fn panel() -> string {
    return colors.panel()
}
fn line() -> string {
    return colors.line()
}
fn line_strong() -> string {
    return colors.line_strong()
}
fn text() -> string {
    return colors.text()
}
fn muted() -> string {
    return colors.muted()
}
fn label() -> string {
    return colors.label()
}
fn ink() -> string {
    return colors.ink()
}
fn on_solid() -> string {
    return colors.on_solid()
}
fn accent() -> string {
    return colors.accent()
}
fn purple() -> string {
    return colors.purple()
}
fn danger() -> string {
    return colors.danger()
}
fn success() -> string {
    return colors.success()
}
fn warning() -> string {
    return colors.warning()
}
fn scrim() -> string {
    return colors.scrim()
}

// --- spacing ---
// The `SPACE.*` enum lives in theme/spacing.yuga; apps reach it through
// this barrel's import of that module (`SPACE.Sm`, `SPACE.Md`, …).

