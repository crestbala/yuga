// --- size / look tokens ---
/// `size = sm()` / `md()` / `lg()`. Same values as the theme's scale tokens.
fn sm() -> int {
    return 0
}
fn md() -> int {
    return 1
}
fn lg() -> int {
    return 2
}
/// `look = solid()` / `soft()` / `outline()` / `ghost()` / `danger_look()`.
fn solid() -> int {
    return 0
}
fn soft() -> int {
    return 1
}
fn outline() -> int {
    return 2
}
fn ghost() -> int {
    return 3
}
/// Named `danger_look`, not `danger`: the theme's `danger()` is the danger
/// colour (a hex string), and apps use both. `look = danger_look()`.
fn danger_look() -> int {
    return 4
}

