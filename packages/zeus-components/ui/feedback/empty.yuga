import "std:zeus"
import "../../theme.yuga"

// Empty state: centered title and body on a panel plate.

struct EmptyProps {
    title: string = "",
    body: string = "",
}

fn Empty(p: EmptyProps) -> Node {
    return Box(
        align_direction = DIRECTION.Column,
        background = panel(),
        align_items = ALIGN.Center,
        justify_content = ALIGN.Center,
        pad_x = surface_x(1),
        pad_y = surface_y(1) * 2,
        gap = gap_of(1),
        radius = radius_of(1)
    ) {
        Text(p.title, color = text(), font = font_px(1) + 1),
        Text(p.body, color = muted(), font = font_px(1))
    }
}
