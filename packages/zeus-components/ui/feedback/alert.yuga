import "std:zeus"
import "../../theme.yuga"

// Banner: tinted left bar, title, wrapping body, on a panel surface.

struct AlertProps {
    title: string = "",
    body: string = "",
    color: string = "",
}

fn Alert(p: AlertProps) -> Node {
    return Box(
        align_direction = DIRECTION.Row,
        background = panel(),
        align_items = ALIGN.Stretch,
        pad_x = surface_x(1),
        pad_y = surface_y(1),
        gap = gap_of(1),
        radius = radius_of(1)
    ) {
        Box(background = p.color, width = SPACE.Xs, radius = SPACE.Xs2, shrink = 0),
        Box(align_direction = DIRECTION.Column, spacing = gap_of(1), grow = 1, align_self = ALIGN.Start) {
            Text(p.title, color = text(), font = font_px(1) + 1),
            Text(p.body, color = muted(), font = font_px(1))
        }
    }
}
