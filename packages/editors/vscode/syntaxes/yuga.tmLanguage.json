{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Yuga",
  "scopeName": "source.yuga",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#modules" },
    { "include": "#enums" },
    { "include": "#constants" },
    { "include": "#numbers" },
    { "include": "#functions" },
    { "include": "#operators" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "name": "comment.line.double-slash.yuga", "match": "//.*$" },
        {
          "name": "comment.block.yuga",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.yuga",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        { "name": "constant.character.escape.yuga", "match": "\\\\." },
        {
          "name": "meta.interpolation.yuga",
          "begin": "\\{\\{",
          "end": "\\}\\}",
          "contentName": "source.yuga.embedded",
          "beginCaptures": { "0": { "name": "punctuation.definition.interpolation.begin.yuga" } },
          "endCaptures": { "0": { "name": "punctuation.definition.interpolation.end.yuga" } },
          "patterns": [
            { "include": "#comments" },
            { "include": "#keywords" },
            { "include": "#types" },
            { "include": "#modules" },
            { "include": "#enums" },
            { "include": "#constants" },
            { "include": "#numbers" },
            { "include": "#functions" },
            { "include": "#operators" }
          ]
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.async.yuga",
          "match": "\\basync(?=\\s+fn\\b)"
        },
        {
          "name": "keyword.control.await.yuga",
          "match": "(?<![\\w.])await\\b"
        },
        {
          "name": "keyword.control.yuga",
          "match": "\\b(fn|let|const|mut|struct|enum|import|if|else|for|while|in|return|break|continue|match|as)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.yuga",
          "match": "\\b(int|float|bool|string|Box)\\b"
        },
        {
          "name": "entity.name.type.yuga",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "modules": {
      "patterns": [
        {
          "match": "\\b(fmt|async|zeus|http|sys|net|maya|kv|icons)\\b(?=\\s\\.)",
          "name": "entity.name.namespace.yuga"
        }
      ]
    },
    "enums": {
      "patterns": [
        {
          "match": "\\b([A-Z][A-Za-z0-9_]*)\\s*\\.\\s*([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "entity.name.type.yuga" },
            "2": { "name": "variable.other.constant.yuga" }
          }
        }
      ]
    },
    "constants": {
      "patterns": [
        { "name": "constant.language.boolean.yuga", "match": "\\b(true|false)\\b" }
      ]
    },
    "numbers": {
      "patterns": [
        { "name": "constant.numeric.yuga", "match": "\\b0[xX][0-9A-Fa-f]+\\b" },
        { "name": "constant.numeric.yuga", "match": "\\b[0-9]+(\\.[0-9]+)?\\b" }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.yuga",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.yuga",
          "match": "(\\+|\\-|\\*|/|%|==|!=|<=|>=|<|>|&&|\\|\\||\\.\\.|->|=>|::|=)"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        { "name": "punctuation.bracket.yuga", "match": "[\\(\\)\\{\\}\\[\\]]" },
        { "name": "punctuation.delimiter.yuga", "match": "[,;:.]" }
      ]
    }
  }
}
