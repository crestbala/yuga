import "std:zeus"
import "light.yuga"
import "dark.yuga"

// Exact RGB lives in light.yuga / dark.yuga. Each getter registers that
// pair and returns a paint-time role so appearance() restyles the tree.
// `get(appearance())` records the theme signal when this runs inside `.styled`.

struct Pair {
    slot: int,
    lit: int,
    dim: int,
}

fn pair(p: Pair) -> int {
    zeus.theme(p.slot, p.lit, p.dim)
    zeus.appearance().get()
    return zeus.role(p.slot)
}

fn app() -> int {
    return pair(Pair { slot: 0, lit: light.bg(), dim: dark.bg() })
}

fn card() -> int {
    return pair(Pair { slot: 1, lit: light.panel(), dim: dark.panel() })
}

fn text() -> int {
    return pair(Pair { slot: 2, lit: light.text(), dim: dark.text() })
}

fn muted() -> int {
    return pair(Pair { slot: 3, lit: light.muted(), dim: dark.muted() })
}

fn label() -> int {
    return pair(Pair { slot: 4, lit: light.faint(), dim: dark.faint() })
}

fn accent() -> int {
    return pair(Pair { slot: 5, lit: light.accent(), dim: dark.accent() })
}

fn purple() -> int {
    return pair(Pair { slot: 6, lit: light.purple(), dim: dark.purple() })
}

fn success() -> int {
    return pair(Pair { slot: 7, lit: light.success_text(), dim: dark.success_text() })
}

fn danger() -> int {
    return pair(Pair { slot: 8, lit: light.danger_fill(), dim: dark.danger_fill() })
}

fn warning() -> int {
    return pair(Pair { slot: 9, lit: light.warning_text(), dim: dark.warning_text() })
}

fn ink() -> int {
    return pair(Pair { slot: 10, lit: light.ink(), dim: dark.ink() })
}

fn line() -> int {
    return pair(Pair { slot: 11, lit: light.line(), dim: dark.line() })
}

fn line_strong() -> int {
    return pair(Pair { slot: 12, lit: light.line_strong(), dim: dark.line_strong() })
}

fn on_solid() -> int {
    return pair(Pair { slot: 13, lit: light.on_solid(), dim: dark.on_solid() })
}

fn success_fill() -> int {
    return pair(Pair { slot: 14, lit: light.success_fill(), dim: dark.success_fill() })
}

fn warning_fill() -> int {
    return pair(Pair { slot: 15, lit: light.warning_fill(), dim: dark.warning_fill() })
}

fn scrim() -> int {
    return pair(Pair { slot: 16, lit: light.scrim(), dim: dark.scrim() })
}
