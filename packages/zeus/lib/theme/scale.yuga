// Size and look tokens. Medium is the default every widget already ships.
// 0 sm / 1 md / 2 lg. Looks: 0 solid / 1 soft / 2 outline / 3 ghost / 4 danger.

fn sm() -> int {
    return 0
}

fn md() -> int {
    return 1
}

fn lg() -> int {
    return 2
}

fn solid() -> int {
    return 0
}

fn soft() -> int {
    return 1
}

fn outline() -> int {
    return 2
}

fn ghost() -> int {
    return 3
}

fn danger() -> int {
    return 4
}

fn pad_x(size: int) -> int {
    return [3]int{8, 12, 16}[size]
}

fn pad_y(size: int) -> int {
    return [3]int{4, 6, 10}[size]
}

fn font_px(size: int) -> int {
    return [3]int{12, 13, 15}[size]
}

fn caption_px(size: int) -> int {
    return [3]int{10, 12, 13}[size]
}

fn title_px(size: int) -> int {
    return [3]int{14, 16, 20}[size]
}

fn display_px(size: int) -> int {
    return [3]int{20, 26, 32}[size]
}

fn input_h(size: int) -> int {
    return [3]int{28, 36, 44}[size]
}

