//! theme — design tokens (GPUI crates/ui styles).
//! Apps import this instead of spacing/colors/font/motion/shell one by one.
//! layout numbers, paint roles, type scale, motion, and the page shell.

import "std:zeus"
import "theme/spacing.yuga"
import "theme/colors.yuga"
import "theme/font.yuga"
import "theme/motion.yuga"
import "theme/shell.yuga"
import "theme/scale.yuga"

