import "std:zeus"
import "../../theme/spacing.yuga"
import "../../theme/colors.yuga"
import "../../theme/scale.yuga"

struct SwitchProps {
    sig: Signal<int>,
}

struct Wire {
    n: Node,
    sig: Signal<int>,
}

fn fill(variant: int) -> int {
    if variant == 0 {
        return colors.text()
    }
    if variant == 4 {
        return colors.danger()
    }
    if variant == 3 {
        return -1
    }
    return colors.line()
}

fn style_switch(n: Node) {
    let size = n.size_of()
    let variant = n.look_of()
    n.w(scale.toggle_w(size)).h(scale.toggle_h(size)).radius(scale.toggle_h(size) / 2).bg(fill(variant)).fg(colors.text()).border_color(colors.on_solid())
}

fn wire_switch(p: Wire) {
    p.n.bind(p.sig).on_click_toggle(p.sig)
    p.n.key("space", "switch.toggle").key("enter", "switch.toggle")
    p.n.on_key_toggle("switch.toggle", p.sig)
}

fn Switch(p: SwitchProps) -> Node {
    let n = zeus.toggle().with_size(scale.md()).with_look(scale.soft())
    n.styled(|| { style_switch(n) })
    wire_switch(Wire { n: n, sig: p.sig })
    return n
}
