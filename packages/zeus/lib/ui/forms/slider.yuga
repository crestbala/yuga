import "std:zeus"
import "../../theme/spacing.yuga"
import "../../theme/colors.yuga"
import "../../theme/scale.yuga"

struct SliderProps {
    caption: string,
    sig: Signal<int>,
}

fn track(size: int) -> int {
    return scale.track_h(size)
}

fn tone(variant: int) -> int {
    if variant == 4 {
        return colors.danger()
    }
    if variant == 3 {
        return colors.muted()
    }
    return colors.text()
}

fn style_track(n: Node) {
    let size = n.size_of()
    let fg = tone(n.look_of())
    n.grow(1).h(scale.slider_h(size)).radius(track(size) / 2).bg(colors.line()).fg(fg).border_color(fg)
}

fn ApplyTrack(n: Node, sig: Signal<int>, size: int, variant: int) -> Node {
    n.with_size(size).with_look(variant)
    n.styled(|| { style_track(n) })
    n.bind(sig).keys(sig, 0, 100)
    return n
}

fn Track(sig: Signal<int>) -> Node {
    return ApplyTrack(zeus.slider(), sig, scale.md(), scale.solid())
}

struct SliderParts {
    n: Node,
    cap: Node,
    sl: Node,
    read: Node,
    pct: Node,
}

fn style_slider(p: SliderParts) {
    let size = p.n.size_of()
    let variant = p.n.look_of()
    p.n.gap(scale.gap_of(size))
    p.cap.fg(colors.muted()).font(scale.font_px(size)).flex_wrap()
    p.sl.with_size(size).with_look(variant)
    p.read.fg(colors.muted()).font(scale.font_px(size))
    p.pct.fg(colors.muted()).font(scale.font_px(size))
}

fn Field(p: SliderProps) -> Node {
    let n = zeus.col().with_size(scale.md()).with_look(scale.solid())
    let cap = n.add(zeus.label(p.caption))
    let sl = n.add(Track(p.sig))
    let read = n.add(zeus.row().gap(spacing.space_xs()).align(zeus.flex_center()))
    let num = read.add(zeus.label("0").bind(p.sig))
    let pct = read.add(zeus.label("%"))
    n.styled(|| { style_slider(SliderParts { n: n, cap: cap, sl: sl, read: num, pct: pct }) })
    return n
}
