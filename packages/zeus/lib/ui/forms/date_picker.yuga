import "std:zeus"
import "../../theme/spacing.yuga"
import "../display/icons.yuga"
import "../../theme/colors.yuga"

// Bezel calendar: a closed field over a 6×7 month grid. The grid is always
// 42 cells so paging months does not resize the card. Leading cells are
// empty; only real days of the shown month take clicks.

struct DatePickerProps {
    y: Signal,
    m: Signal,
    d: Signal,
}

fn cell_size() -> int {
    return spacing.cell()
}

fn cell_radius() -> int {
    return spacing.hit_radius()
}

fn nav_hit() -> int {
    return spacing.space_2xl()
}

fn is_leap(year: int) -> int {
    if year % 4 != 0 {
        return 0
    }
    if year % 100 != 0 {
        return 1
    }
    if year % 400 == 0 {
        return 1
    }
    return 0
}

fn month_len(year: int, month: int) -> int {
    if month == 2 {
        if is_leap(year) != 0 {
            return 29
        }
        return 28
    }
    if month == 4 {
        return 30
    }
    if month == 6 {
        return 30
    }
    if month == 9 {
        return 30
    }
    if month == 11 {
        return 30
    }
    return 31
}

fn month_t(month: int) -> int {
    if month == 1 {
        return 0
    }
    if month == 2 {
        return 3
    }
    if month == 3 {
        return 2
    }
    if month == 4 {
        return 5
    }
    if month == 5 {
        return 0
    }
    if month == 6 {
        return 3
    }
    if month == 7 {
        return 5
    }
    if month == 8 {
        return 1
    }
    if month == 9 {
        return 4
    }
    if month == 10 {
        return 6
    }
    if month == 11 {
        return 2
    }
    return 4
}

// Sakamoto: 0 = Sunday. The grid starts on Monday, so the leading blank
// count is (sun + 6) % 7.
fn first_monday(year: int, month: int) -> int {
    let mut y = year
    if month < 3 {
        y = y - 1
    }
    let s = y + y / 4 - y / 100 + y / 400 + month_t(month) + 1
    let sun = s % 7
    return (sun + 6) % 7
}

fn Month(m: Signal, value: int, name: string) -> Node {
    return zeus.label(name).fg(colors.text()).font(13).show_eq(m, value)
}

fn Blank() -> Node {
    return zeus.box().size(cell_size()).shrink(0)
}

fn Cell(d: Signal, value: int, open: Signal) -> Node {
    let lab = zeus.signal(value)
    let n = zeus.col().size(cell_size()).align(zeus.flex_center()).shrink(0)
    n.child(zeus.button("0").bind(lab).bg(colors.text()).fg(colors.app()).size(cell_size()).padX(0).padY(0).radius(cell_radius()).center().font(13).show_eq(d, value).on_click_set(d, value).on_click_also_set(open, 0).shrink(0))
    n.child(zeus.button("0").bind(lab).bg(-1).fg(colors.text()).size(cell_size()).padX(0).padY(0).radius(cell_radius()).center().font(13).show_ne(d, value).on_click_set(d, value).on_click_also_set(open, 0).shrink(0))
    return n
}

fn Weekday(s: string) -> Node {
    let n = zeus.col().w(cell_size()).h(spacing.space_xl()).center().shrink(0)
    n.txt(s, colors.label(), 11)
    return n
}

/// Integers `lo..hi` as a plain array — the data `.each()` maps over, not a
/// list of children itself.
fn seq(lo: int, hi: int) -> []int {
    let mut xs = []int {}
    for i in lo..hi {
        push(xs, i)
    }
    return xs
}

fn MonthGrid(year: int, month: int, d: Signal, sel: Signal, open: Signal) -> Node {
    let g = zeus.grid(7, spacing.space_xs()).show_eq(sel, month)
    let off = first_monday(year, month)
    let last = month_len(year, month)
    g.each(seq(0, off), (i) => {
        Blank()
    })
    g.each(seq(1, last + 1), (i) => {
        Cell(d, i, open)
    })
    let filled = off + last
    g.each(seq(0, 42 - filled), (i) => {
        Blank()
    })
    return g
}

fn Field(p: DatePickerProps) -> Node {
    let y = p.y
    let m = p.m
    let d = p.d
    let open = zeus.signal(0)
    let year = zeus.get(y)
    let n = zeus.col().gap(spacing.space_sm()).w(spacing.popover_w()).align_self(zeus.flex_start()).shrink(0)
    n.key("enter", "date.toggle").key("escape", "date.close").key("left", "date.prev_day").key("right", "date.next_day").key("up", "date.prev_week").key("down", "date.next_week").key("pageup", "date.prev_month").key("pagedown", "date.next_month")
    n.on_key_toggle("date.toggle", open)
    n.on_key_set("date.close", open, 0)
    n.on_range("date.next_day", d, 1, 1, 31)
    n.on_range("date.prev_day", d, -1, 1, 31)
    n.on_range("date.next_week", d, 7, 1, 31)
    n.on_range("date.prev_week", d, -7, 1, 31)
    n.on_range("date.next_month", m, 1, 1, 12)
    n.on_range("date.prev_month", m, -1, 1, 12)
    let field = n.add(zeus.row().w(spacing.popover_w()).bg(colors.card()).border(1).border_color(colors.line()).radius(spacing.button_radius()).padX(spacing.input_pad_x()).padY(spacing.input_pad_y()).gap(spacing.space_xs()).align(zeus.flex_center()).on_click_toggle(open).shrink(0))
    field.bound(y, colors.text(), 13)
    field.txt("-", colors.muted(), 13)
    field.bound(m, colors.text(), 13)
    field.txt("-", colors.muted(), 13)
    field.bound(d, colors.text(), 13)
    field.child(zeus.spacer())
    field.child(icons.Glyph(GlyphProps { markup: icons.alt_arrow_down(), color: colors.muted(), size: spacing.icon_sm() }))
    let pop = n.add(zeus.col().show(open).bg(colors.card()).pad(spacing.space_sm()).gap(spacing.space_snug()).w(spacing.popover_w()).border(1).border_color(colors.line()).radius(spacing.surface_radius()).align_self(zeus.flex_start()).shrink(0))
    let head = pop.add(zeus.row().gap(spacing.space_xs()).align(zeus.flex_center()))
    head.child(icons.Hit(HitProps { markup: icons.alt_arrow_left(), color: colors.muted(), hit: nav_hit(), size: spacing.icon_sm() }).radius(spacing.control_radius()).show_ne(m, 1).on_click_add(m, -1).shrink(0))
    head.child(icons.Hit(HitProps { markup: icons.alt_arrow_left(), color: colors.muted(), hit: nav_hit(), size: spacing.icon_sm() }).radius(spacing.control_radius()).show_eq(m, 1).on_click_set(m, 12).shrink(0))
    let title = head.add(zeus.row().gap(spacing.space_snug()).grow(1).min_w(0).justify(zeus.flex_center()).align(zeus.flex_center()))
    title.child(Month(m, 1, "January"))
    title.child(Month(m, 2, "February"))
    title.child(Month(m, 3, "March"))
    title.child(Month(m, 4, "April"))
    title.child(Month(m, 5, "May"))
    title.child(Month(m, 6, "June"))
    title.child(Month(m, 7, "July"))
    title.child(Month(m, 8, "August"))
    title.child(Month(m, 9, "September"))
    title.child(Month(m, 10, "October"))
    title.child(Month(m, 11, "November"))
    title.child(Month(m, 12, "December"))
    title.bound(y, colors.text(), 13)
    head.child(icons.Hit(HitProps { markup: icons.alt_arrow_right(), color: colors.muted(), hit: nav_hit(), size: spacing.icon_sm() }).radius(spacing.control_radius()).show_ne(m, 12).on_click_add(m, 1).shrink(0))
    head.child(icons.Hit(HitProps { markup: icons.alt_arrow_right(), color: colors.muted(), hit: nav_hit(), size: spacing.icon_sm() }).radius(spacing.control_radius()).show_eq(m, 12).on_click_set(m, 1).shrink(0))
    let week = pop.add(zeus.row().gap(spacing.space_xs()))
    week.child(Weekday("Mo"))
    week.child(Weekday("Tu"))
    week.child(Weekday("We"))
    week.child(Weekday("Th"))
    week.child(Weekday("Fr"))
    week.child(Weekday("Sa"))
    week.child(Weekday("Su"))
    pop.child(MonthGrid(year, 1, d, m, open))
    pop.child(MonthGrid(year, 2, d, m, open))
    pop.child(MonthGrid(year, 3, d, m, open))
    pop.child(MonthGrid(year, 4, d, m, open))
    pop.child(MonthGrid(year, 5, d, m, open))
    pop.child(MonthGrid(year, 6, d, m, open))
    pop.child(MonthGrid(year, 7, d, m, open))
    pop.child(MonthGrid(year, 8, d, m, open))
    pop.child(MonthGrid(year, 9, d, m, open))
    pop.child(MonthGrid(year, 10, d, m, open))
    pop.child(MonthGrid(year, 11, d, m, open))
    pop.child(MonthGrid(year, 12, d, m, open))
    return n
}
