    return link_minimalistic()
}

fn magnifier() -> string {
    return magnifer()
}

struct GlyphProps {
    markup: string,
    color: int,
    size: int,
}

struct HitProps {
    markup: string,
    color: int,
    hit: int,
    size: int,
}

fn Glyph(p: GlyphProps) -> Node {
    return zeus.svg(p.markup).size(p.size).fg(p.color)
}

fn Hit(p: HitProps) -> Node {
    let n = zeus.row().size(p.hit).center().shrink(0)
    n.child(Glyph(GlyphProps { markup: p.markup, color: p.color, size: p.size }))
    return n
}
