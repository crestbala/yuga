import "std:zeus"

/// Solar Icons (Linear) by 480 Design, CC BY 4.0 — the same set bezel embeds.
/// Markup is inline SVG; zeus.svg paints `currentColor` from the node's fg.
/// Bezel's `RETURN` glyph is `return_key()` (`return` is a Yuga keyword).

fn add_circle() -> string {
    return "<svg xmlns='http://www.w3.org/2000/svg' width='1em' height='1em' viewBox='0 0 24 24'><g fill='none' stroke='currentColor' stroke-width='1.5'><circle cx='12' cy='12' r='10'/><path stroke-linecap='round' d='M12 8v8m4-4H8'/></g></svg>"
}

