import "std:zeus"
import "../../theme/colors.yuga"
import "../../theme/scale.yuga"

struct LinkProps {
    label: string,
}

fn style_link(n: Node) {
    let size = n.size_of()
    let variant = n.look_of()
    let mut c = colors.accent()
    if variant == 3 {
        c = colors.muted()
    }
    if variant == 4 {
        c = colors.danger()
    }
    n.fg(c).font(scale.font_px(size)).hover_fade()
}

fn Link(p: LinkProps) -> Node {
    let n = zeus.label(p.label).with_size(scale.md()).with_look(scale.ghost())
    n.styled(|| { style_link(n) })
    return n
}
