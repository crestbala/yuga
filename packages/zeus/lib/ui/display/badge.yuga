import "std:zeus"
import "../../theme/spacing.yuga"
import "../../theme/colors.yuga"
import "../../theme/scale.yuga"
import "../shared/look.yuga"

struct BadgeProps {
    label: string,
    color: int,
}

struct BadgeParts {
    n: Node,
    lab: Node,
    color: int,
}

fn style_badge(p: BadgeParts) {
    let size = p.n.size_of()
    let variant = p.n.look_of()
    look.paint(p.n, variant, p.color).padX(scale.pad_x(size)).padY(scale.pad_y(size) / 2).h(scale.chip_h(size)).radius(spacing.pill_radius()).align(zeus.flex_center()).shrink(0)
    p.lab.fg(look.fg_of(variant, p.color)).font(scale.caption_px(size))
}

fn Pill(p: BadgeProps) -> Node {
    let n = zeus.row().with_size(scale.md()).with_look(scale.soft())
    let lab = n.add(zeus.label(p.label))
    n.styled(|| { style_badge(BadgeParts { n: n, lab: lab, color: p.color }) })
    return n
}
