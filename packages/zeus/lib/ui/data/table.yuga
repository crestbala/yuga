import "std:zeus"
import "../layout/divider.yuga"
import "../../theme/spacing.yuga"
import "../display/icons.yuga"
import "../../theme/colors.yuga"

struct TableHeadProps {
    a: string,
    b: string,
    c: string,
    sort: Signal,
}

struct TableRowProps {
    a: string,
    b: string,
    c: string,
}

struct TableBodyProps {
    height: int,
}

// Frame is `scroll_xy`: H bar when columns are wider than the cell, V bar
// lives on Body (fixed height). The page scroller stays vertical-only.

fn Frame() -> Node {
    return zeus.scroll_xy().bg(colors.card()).border(1).border_color(colors.line()).radius(spacing.panel_radius())
}

fn Head(p: TableHeadProps) -> Node {
    let wrap = zeus.col()
    let n = wrap.add(zeus.row().padX(spacing.table_cell_x()).padY(spacing.table_head_pad_y()).gap(spacing.space_sm()).align(zeus.flex_center()).shrink(0))
    let ca = n.add(zeus.row().gap(spacing.space_xs()).align(zeus.flex_center()).w(spacing.table_col_w()).shrink(0))
    ca.child(zeus.button(p.a).bg(-1).fg(colors.label()).font(12).padX(0).padY(0).on_click_set(p.sort, 0).shrink(0))
    ca.child(icons.Glyph(GlyphProps { markup: icons.arrow_up(), color: colors.muted(), size: 11 }).show_eq(p.sort, 0).shrink(0))
    let cb = n.add(zeus.row().gap(spacing.space_xs()).align(zeus.flex_center()).grow(1).min_w(80))
    cb.child(zeus.button(p.b).bg(-1).fg(colors.label()).font(12).padX(0).padY(0).on_click_set(p.sort, 1).shrink(0))
    cb.child(icons.Glyph(GlyphProps { markup: icons.arrow_up(), color: colors.muted(), size: 11 }).show_eq(p.sort, 1).shrink(0))
    let cc = n.add(zeus.row().gap(spacing.space_xs()).align(zeus.flex_center()).w(72).shrink(0))
    cc.child(zeus.button(p.c).bg(-1).fg(colors.label()).font(12).padX(0).padY(0).on_click_set(p.sort, 2).shrink(0))
    cc.child(icons.Glyph(GlyphProps { markup: icons.arrow_up(), color: colors.muted(), size: 11 }).show_eq(p.sort, 2).shrink(0))
    wrap.child(divider.Line())
    return wrap
}

fn Row(p: TableRowProps) -> Node {
    let n = zeus.row().padX(spacing.table_cell_x()).padY(spacing.table_row_pad_y()).gap(spacing.space_sm()).align(zeus.flex_center()).shrink(0)
    n.child(zeus.label(p.a).fg(colors.text()).font(13).w(spacing.table_col_w()).shrink(0))
    n.child(zeus.label(p.b).fg(colors.muted()).font(13).grow(1).min_w(80))
    n.child(zeus.label(p.c).fg(colors.muted()).font(13).w(72).shrink(0))
    return n
}

fn Body(p: TableBodyProps) -> Node {
    return zeus.scroll().h(p.height)
}
