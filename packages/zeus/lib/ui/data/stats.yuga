import "std:zeus"
import "../display/metric.yuga"
import "../../theme/spacing.yuga"
import "../../theme/colors.yuga"

struct StatsProps {
    users_t: string,
    users: string,
    jobs_t: string,
    jobs: string,
    uptime_t: string,
    uptime: string,
    ticks_t: string,
    ticks: Signal,
}

/// 2×2 grid of metrics. Fills the parent width; columns are equal.
fn Grid(p: StatsProps) -> Node {
    let g = zeus.grid(2, spacing.space_lg())
    g.child(metric.Static(MetricProps { title: p.users_t, value: p.users, color: colors.accent() }))
    g.child(metric.Static(MetricProps { title: p.jobs_t, value: p.jobs, color: colors.purple() }))
    g.child(metric.Static(MetricProps { title: p.uptime_t, value: p.uptime, color: colors.success() }))
    g.child(metric.Live(LiveMetricProps { title: p.ticks_t, sig: p.ticks, color: colors.danger() }))
    return g
}
