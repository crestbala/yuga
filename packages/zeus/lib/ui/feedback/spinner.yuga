import "std:zeus"
import "loader.yuga"
import "../../theme/spacing.yuga"
import "../../theme/colors.yuga"

struct SpinnerProps {
    msg: string,
}

fn Dots(p: SpinnerProps) -> Node {
    let n = zeus.row().gap(spacing.space_sm()).align(zeus.flex_center()).align_self(zeus.flex_start()).shrink(0)
    n.child(loader.Mini())
    n.txt(p.msg, colors.muted(), 11)
    return n
}
