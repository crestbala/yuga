import "std:zeus"
import "../../theme/spacing.yuga"
import "../display/icons.yuga"
import "../../theme/colors.yuga"

struct BreadcrumbProps {
    a: string,
    b: string,
    c: string,
}

/// Three-level path, left-aligned in a row that fills the parent.
fn Trail(p: BreadcrumbProps) -> Node {
    let n = zeus.row()
    zeus.gap(n, spacing.space_xs())
    zeus.align(n, zeus.flex_center())
    zeus.align_self(n, zeus.flex_start())
    n.flex_wrap()
    zeus.txt(n, p.a, colors.muted(), 12)
    n.child(icons.Glyph(GlyphProps { markup: icons.alt_arrow_right(), color: colors.label(), size: spacing.icon_xs() }))
    zeus.txt(n, p.b, colors.muted(), 12)
    n.child(icons.Glyph(GlyphProps { markup: icons.alt_arrow_right(), color: colors.label(), size: spacing.icon_xs() }))
    zeus.txt(n, p.c, colors.text(), 12)
    return n
}
