import "std:zeus"
import "../../theme/spacing.yuga"

/// Empty tool row. Fill with buttons/text; it stretches to the parent width.
/// The end inset matches the cluster gap, so the first control sits as far from
/// the bar's edge as it does from its neighbour.
fn Bar() -> Node {
    let n = zeus.row()
    zeus.gap(n, spacing.space_sm())
    zeus.align(n, zeus.flex_center())
    zeus.h(n, spacing.bar_height())
    zeus.padX(n, spacing.space_sm())
    zeus.radius(n, spacing.bubble_radius())
    n.flex_wrap()
    return n
}
