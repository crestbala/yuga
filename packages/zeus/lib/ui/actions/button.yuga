import "std:zeus"
import "../../theme/spacing.yuga"
import "../../theme/colors.yuga"
import "../../theme/scale.yuga"
import "../shared/look.yuga"

// Size and look are chain modifiers on the returned Node (`.size_px()` / `.look()`).
// Props are the constructor payload.

struct ButtonProps {
    label: string,
    on_press: fn(),
}

fn tint(variant: int) -> int {
    if variant == 4 {
        return colors.danger()
    }
    if variant == 3 {
        return colors.muted()
    }
    return colors.text()
}

fn style_button(n: Node) {
    let size = n.size_of()
    let variant = n.look_of()
    look.paint(n, variant, tint(variant)).padX(scale.pad_x(size)).padY(scale.pad_y(size)).radius(scale.radius_of(size)).font(scale.font_px(size)).shrink(0)
}

fn build(p: ButtonProps, variant: int) -> Node {
    let n = zeus.button(p.label).on(zeus.click(), p.on_press).key("enter", "button.press").key("space", "button.press").on_key_fn("button.press").with_size(scale.md()).with_look(variant)
    n.styled(|| { style_button(n) })
    return n
}

fn Press(p: ButtonProps) -> Node {
    return build(p, scale.solid())
}

fn Ghost(p: ButtonProps) -> Node {
    return build(p, scale.ghost())
}

fn Prominent(p: ButtonProps) -> Node {
    return build(p, scale.solid())
}

fn Destructive(p: ButtonProps) -> Node {
    return build(p, scale.danger())
}

fn Soft(p: ButtonProps) -> Node {
    return build(p, scale.soft())
}

fn Outline(p: ButtonProps) -> Node {
    return build(p, scale.outline())
}

fn Primary(p: ButtonProps) -> Node {
    return Prominent(p)
}

fn Secondary(p: ButtonProps) -> Node {
    return Ghost(p)
}

fn Danger(p: ButtonProps) -> Node {
    return Destructive(p)
}

fn Close(p: ButtonProps) -> Node {
    return build(p, scale.ghost())
}

fn Discard(p: ButtonProps) -> Node {
    return build(p, scale.danger())
}

fn Open(p: ButtonProps) -> Node {
    return build(p, scale.solid())
}

fn GhostOpen(p: ButtonProps) -> Node {
    return build(p, scale.ghost())
}
