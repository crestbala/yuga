import "std:zeus"
import "../actions/button.yuga"
import "../../theme/spacing.yuga"
import "../../theme/colors.yuga"
import "../../theme/motion.yuga"

struct DialogProps {
    title: string,
    body: string,
    cancel: string,
    discard: string,
    open: Signal<int>,
}

// bezel dialog: centred card over a dim scrim. Title, wrapping body,
// then Ghost Cancel and Destructive Discard, right-aligned.

fn Modal(p: DialogProps) -> Node {
    let dim = zeus.overlay().show(p.open).on_click_set(p.open, 0).bg(colors.scrim()).opacity(motion.overlay_dim())
    let card = dim.add(zeus.col().bg(colors.app()).pad(spacing.space_xl()).gap(spacing.space_md()).w(spacing.dialog_w()).radius(spacing.bubble_radius()))
    card.key("escape", "dialog.close")
    card.on_key_set("dialog.close", p.open, 0)
    card.child(zeus.label(p.title).fg(colors.text()).font(15))
    card.child(zeus.label(p.body).fg(colors.muted()).font(13).flex_wrap())
    let foot = card.add(zeus.row().gap(spacing.space_sm()).justify(zeus.flex_end()).align(zeus.flex_center()))
    foot.child(button.Close(ButtonProps { label: p.cancel, on_press: || { p.open.set(0) } }))
    foot.child(button.Discard(ButtonProps { label: p.discard, on_press: || { p.open.set(0) } }))
    return dim
}
