import "std:zeus"
import "../../theme/colors.yuga"

// Paint a control from a variant + tint. Solid fills the tint; soft sits on
// a card; outline keeps a border in the tint; ghost is text only; danger is
// the warning plate.

fn bg_of(variant: int, tint: int) -> int {
    if variant == 0 {
        return tint
    }
    if variant == 1 {
        return colors.card()
    }
    if variant == 2 {
        return colors.card()
    }
    if variant == 4 {
        return colors.danger()
    }
    return -1
}

fn fg_of(variant: int, tint: int) -> int {
    if variant == 0 {
        return colors.app()
    }
    if variant == 4 {
        return colors.app()
    }
    if variant == 3 {
        return colors.muted()
    }
    return tint
}

fn bw_of(variant: int) -> int {
    if variant == 1 {
        return 1
    }
    if variant == 2 {
        return 1
    }
    return 0
}

fn edge_of(variant: int, tint: int) -> int {
    if variant == 1 {
        return colors.line()
    }
    if variant == 2 {
        return tint
    }
    return -1
}

fn paint(n: Node, variant: int, tint: int) -> Node {
    return n.bg(bg_of(variant, tint)).fg(fg_of(variant, tint)).border(bw_of(variant)).border_color(edge_of(variant, tint))
}

fn field_bg(variant: int) -> int {
    if variant == 3 {
        return -1
    }
    if variant == 0 {
        return colors.ink()
    }
    return colors.card()
}

fn field_edge(variant: int) -> int {
    if variant == 3 {
        return -1
    }
    if variant == 0 {
        return colors.ink()
    }
    if variant == 2 {
        return colors.text()
    }
    return colors.line()
}

fn field_bw(variant: int) -> int {
    if variant == 3 {
        return 0
    }
    if variant == 0 {
        return 0
    }
    return 1
}

fn field(n: Node, variant: int) -> Node {
    return n.bg(field_bg(variant)).border(field_bw(variant)).border_color(field_edge(variant))
}
