import "std:zeus"
import "../../theme/colors.yuga"
import "../../theme/font.yuga"

/// Tailwind-like type scale. Block labels: full width, wrap.

struct TypeProps {
    text: string,
}

fn Display(p: TypeProps) -> Node {
    return zeus.label(p.text).fg(colors.text()).font(font.display())
}

fn Title(p: TypeProps) -> Node {
    return zeus.label(p.text).fg(colors.text()).font(font.title())
}

fn Heading(p: TypeProps) -> Node {
    return zeus.label(p.text).fg(colors.text()).font(font.heading())
}

fn Body(p: TypeProps) -> Node {
    return zeus.label(p.text).fg(colors.muted()).font(font.body())
}

fn Overline(p: TypeProps) -> Node {
    return zeus.label(p.text).fg(colors.label()).font(font.overline())
}
