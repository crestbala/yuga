import "std:fmt"

fn main() {
    let max = 9223372036854775807
    fmt.println(wrapping_add(max, 1))
    fmt.println(saturating_add(max, 1))
    fmt.println(wrapping_add(0, 5))
    fmt.println(wrapping_shr(256, 7))
    fmt.println(wrapping_shl(1, 3))
    fmt.println(wrapping_or(1, 2))
    fmt.println(wrapping_and(7, 3))
}
