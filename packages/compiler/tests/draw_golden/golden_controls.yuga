// DRAW-list golden: deterministic headless paint of common zeus chrome —
// buttons, the semantic alert tiers, role-backed native thumbs, badges, and
// the skeleton token. Any change that moves a pixel or a palette value shows
// up here first. Keep this file free of prints: stdout is the golden.

import "std:zeus"

fn main() {
    zeus.snapshot(560, 360, fn() -> Node {
        let load = zeus.signal(30)
        let on = zeus.signal(1)
        zeus.Page() {
            zeus.Row(SPACE.Sm) {
                zeus.Button("Primary", look = zeus.LOOK.Solid, size = zeus.SIZE.Md)
                zeus.Button("Soft", look = zeus.LOOK.Soft, size = zeus.SIZE.Md)
                zeus.Button("Outline", look = zeus.LOOK.Outline, size = zeus.SIZE.Md)
                zeus.Button("Danger", look = zeus.LOOK.Danger, size = zeus.SIZE.Md)
            }
            zeus.Row(SPACE.Sm) {
                zeus.Badge("ok", zeus.TINT.Ok)
                zeus.Badge("warn", zeus.TINT.Warn)
                zeus.Badge("bad", zeus.TINT.Danger)
                zeus.Chip("busy", zeus.TINT.Warn)
            }
            zeus.AlertWarning("Low disk", "The volume is almost full.")
            zeus.Row(SPACE.Sm) {
                zeus.Switch(on)
                zeus.Progress(load)
            }
            zeus.Row(SPACE.Sm) {
                zeus.Skeleton(96, 24, 8)
            }
        }
    })
}
