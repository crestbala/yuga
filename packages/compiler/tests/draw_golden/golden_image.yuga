// DRAW-list golden: one raster Image (data URI). Dump omits src so the
// golden is stable; hosts decode PNG / JPEG / WebP / GIF themselves.

import "std:zeus"

fn main() {
    zeus.snapshot(120, 48, fn() -> Node {
        zeus.Box(padding = 8, background = "#ffffff") {
            zeus.Image("data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAIAAACQd1PeAAAADElEQVR42mO4o6YGAAMKASneDRr/AAAAAElFTkSuQmCC", width = 32, height = 32, radius = 4)
        }
    })
}
