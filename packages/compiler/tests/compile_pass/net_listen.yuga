import "std:net"
import "std:fmt"
import "std:sys"

fn must(ok: bool) {
    if !ok {
        fmt.println("FAIL: net_listen assertion failed")
        sys.exit(1)
    }
}

fn main() {
    let fd = net.tcp_listen(0)
    // Environments without raw sockets (sandboxed builds, restricted CI)
    // cannot run this test; skip it instead of failing the suite.
    if fd < 0 {
        fmt.println("SKIP net_listen: no TCP sockets in this environment")
        return
    }
    let p = net.tcp_bound_port(fd)
    must(p > 0)
    must(p < 65536)
    net.tcp_close(fd)
    fmt.println(p)
}
