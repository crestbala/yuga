import "std:fmt"
import "std:sys"
import "std:zeus"
import "std:kit"

let mut opts: []string = []string {}

fn Menu(sel: Signal<int>) {
    kit.Select(sel, opts)
}

fn main() {
    push(opts, "A")
    push(opts, "B")
    let sel = zeus.signal(1)
    zeus.snapshot(240, 80, fn() -> Node {
        kit.Row(SPACE.Sm) {
            Menu(sel)
        }
    })
    if zeus.draw_count() < 1 {
        fmt.println("FAIL select")
        sys.exit(1)
    }
    fmt.println("select ok")
}
