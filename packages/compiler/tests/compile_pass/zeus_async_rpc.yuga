// Phase 1 exit proof: an async completion repaints a signal-fed label through
// the headless pump (no manual `engine_layout`), and a real gRPC-Web round
// trip (`http.call_async`) completes while the pump keeps running frames.
//
// The RPC server is this same binary re-executed with YUGA_ASYNC_SRV=1 (the
// make test runner executes binaries from the repo root, so the child path
// below matches the tmp output path). The child binds an ephemeral port,
// writes "127.0.0.1:<port>" to a file, serves one Echo.Ping, and exits.

import "std:async"
import "std:fmt"
import "std:http"
import "std:net"
import "std:sys"
import "std:zeus"

fn fail(what: string) {
    fmt.println("FAIL", what)
    sys.exit(1)
}

/// Child process: one blocking Echo.Ping server, then exit.
fn srv_main() {
    let app = http.app()
    app.rpc("Echo.Ping", |body| { body })
    let l = net.tcp_listen(0)
    if l < 0 {
        fail("child listen")
    }
    let p = net.tcp_bound_port(l)
    if p <= 0 {
        fail("child port")
    }
    let addr = http.concat_str("127.0.0.1:", http.string_of(http.u_itoa(p)))
    let w = sys.write_file("/tmp/yuga_async_rpc.port", addr)
    if w != 0 {
        fail("child port file")
    }
    // Wait up to ~2s for the parent's client, serve it, then go away.
    for k in 0..5 {
        let r = net.tcp_poll(l, 1, 400)
        if r > 0 {
            let c = net.tcp_accept(l)
            if c >= 0 {
                http.serve_conn(app, c)
                net.tcp_close(c)
            }
            net.tcp_close(l)
            sys.exit(0)
        }
    }
    sys.exit(0)
}

fn Panel(n: Signal<int>) {
    zeus.Box(align_direction = DIRECTION.Column, padding = 8, width = 220) {
        zeus.Text("async: {{n.get()}}", font = 18)
    }
}

fn cli_main() {
    sys.write_file("/tmp/yuga_async_rpc.port", "")
    let n = zeus.signal(0)
    zeus.App("async-rpc", 240, 90, fn() {
        Panel(n)
    })

    // Fake async op: a spawn completes on the very next pump's tick; the
    // signal it sets must repaint the label without a manual engine_layout.
    async.spawn(|| { n.set(7) })
    zeus.pump()
    if n.get() != 7 {
        fail("spawn did not complete")
    }
    if zeus.engine_find_text("async: 7") == 0 {
        fail("spawn result did not repaint")
    }

    // Real async gRPC-Web round trip against the child server. The pump loop
    // below is the headless frame loop: each pump ticks the async state
    // machines, relayouts, and repaints.
    let cmd = "YUGA_ASYNC_SRV=1 packages/compiler/tests/tmp/zeus_async_rpc >/dev/null 2>&1 &"
    sys.exec(cmd)
    let mut addr = sys.read_file("/tmp/yuga_async_rpc.port")
    let mut guard = 0
    while addr.len == 0 && guard < 400 {
        async.sleep(5)
        addr = sys.read_file("/tmp/yuga_async_rpc.port")
        guard = guard + 1
    }
    if addr.len == 0 {
        fail("child server never started")
    }
    let c = http.client(addr)
    c.call_async("Echo.Ping", "ping", fn(out) {
        if http.eq(out, "ping") {
            n.set(9)
        } else {
            n.set(11)
        }
    })
    let mut guard2 = 0
    while n.get() != 9 && n.get() != 11 && guard2 < 4000 {
        async.sleep(1)
        zeus.pump()
        guard2 = guard2 + 1
    }
    if n.get() != 9 {
        fail("async rpc did not complete")
    }
    if zeus.engine_find_text("async: 9") == 0 {
        fail("rpc result did not repaint")
    }
    fmt.println("async rpc ok")
}

fn main() {
    if sys.env_set("YUGA_ASYNC_SRV") != 0 {
        srv_main()
        return
    }
    cli_main()
}
