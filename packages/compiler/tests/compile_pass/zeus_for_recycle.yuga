// A streaming `For` must not grow the arena: every rebuild drops the old
// rows and re-creates them, so node ids, row-owned signals, and interned
// handlers are recycled instead of appended for the life of the app.
// Regression for the arena-compaction work (docs/zeus_kit_downsides.md §1–2).

import "std:fmt"
import "std:sys"
import "std:zeus"

fn Row(i: int, s: string) {
    // Row-owned state: created on every rebuild. If it is not freed when the
    // row is dropped, `sigs` grows by one per rebuild forever.
    let hot = zeus.signal(0)
    zeus.Box(align_direction = DIRECTION.Row, spacing = 4) {
        zeus.Text("{{s}}")
        zeus.Button("up", on_click = fn() => hot.set(hot.get() + 1), width = 40)
    }
}

fn main() {
    let names = zeus.signal([]string {})
    zeus.push_item(names, "r0")
    zeus.snapshot(240, 160, fn() -> Node {
        zeus.For(names, Row)
    })
    let base_nodes = zeus.arena_nodes()
    let base_sigs = zeus.arena_sigs()
    // Stream: alternate push/pop so the live row count returns to one each
    // cycle. Each mutation changes the list generation, so the `For` host
    // drops its rows and rebuilds them on the next layout. Slots reach a
    // high-water mark after the first cycle, then must stay flat forever.
    let mut cyc = 0
    while cyc < 2 {
        zeus.push_item(names, "y")
        zeus.engine_layout(240, 160)
        zeus.pop_item(names)
        zeus.engine_layout(240, 160)
        cyc = cyc + 1
    }
    let hi_nodes = zeus.arena_nodes()
    let hi_sigs = zeus.arena_sigs()
    while cyc < 60 {
        zeus.push_item(names, "y")
        zeus.engine_layout(240, 160)
        zeus.pop_item(names)
        zeus.engine_layout(240, 160)
        cyc = cyc + 1
    }
    let nn = zeus.arena_nodes()
    let ss = zeus.arena_sigs()
    if nn != hi_nodes {
        fmt.println("FAIL nodes grew", hi_nodes, "->", nn)
        sys.exit(1)
    }
    if ss != hi_sigs {
        fmt.println("FAIL sigs grew", hi_sigs, "->", ss)
        sys.exit(1)
    }
    // The rebuilt row still clicks and its signal still reacts.
    if zeus.engine_click_text("up") == 0 {
        fmt.println("FAIL click up")
        sys.exit(1)
    }
    fmt.println("stream ok", nn, ss)
}
