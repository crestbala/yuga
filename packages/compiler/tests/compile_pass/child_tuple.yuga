import "std:zeus"

fn main() {
    App("Tuple", 320, 200, || {
        Box(align_direction = DIRECTION.Column, padding = 8) {
            Text("a"),
            Text("b"),
            Box(align_direction = DIRECTION.Row, gap = 4) {
                Text("c"),
                Text("d")
            }
        }
    })
}
