import "std:zeus"

fn main() {
    zeus.App("Tuple", 320, 200, fn() {
        zeus.Box(align_direction = DIRECTION.Column, padding = 8) {
            zeus.Text("a")
            zeus.Text("b")
            zeus.Box(align_direction = DIRECTION.Row, spacing = 4) {
                zeus.Text("c")
                zeus.Text("d")
            }
        }
    })
}
