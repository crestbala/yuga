import "std:fmt"
import "std:sys"
import "std:zeus"
import "std:kit"

let mut labs: []string = []string {}
let mut cs: []string = []string {}
let mut cv: []int = []int {}

fn Picks(sel: Signal<int>) {
    kit.Tabs(sel, labs)
}

fn ChartSeed() {
    if labs.len == 0 {
        push(labs, "A")
        push(labs, "B")
        push(cs, "One")
        push(cs, "Two")
        push(cv, 12)
        push(cv, 8)
        push(cv, 20)
        push(cv, 14)
    }
}

fn main() {
    ChartSeed()
    let open = zeus.signal(1)
    let on = zeus.signal(1)
    let sel = zeus.signal(0)
    zeus.snapshot(320, 240, fn() -> Node {
        kit.Card() {
            kit.Heading("Hello")
            kit.Button("Go", kit.LOOK.Solid, kit.SIZE.Md)
            kit.Chip("live", kit.TINT.Ok)
            kit.Checkbox("On", on)
            kit.Field("Name", zeus.signal(""), "Ada")
            kit.User("AP", "Ada", "Op")
            Picks(sel)
            zeus.Box(safe = 1, min_width = 40, wrap = 1) {
                kit.Note("safe")
            }
            kit.BarChart(labs, cs, cv, 260, 120)
            kit.LineChart(labs, cs, cv, 260, 120)
            kit.AreaChart(labs, cs, cv, 260, 120)
            kit.Dialog(open) {
                kit.Title("Hi")
                kit.Button("Ok", kit.LOOK.Solid, kit.SIZE.Sm, fn() => open.set(0))
            }
        }
    })
    if zeus.draw_count() < 1 {
        fmt.println("FAIL kit")
        sys.exit(1)
    }
    fmt.println("kit ok")
}
