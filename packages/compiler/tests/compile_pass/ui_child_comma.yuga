// Trailing commas after UI children and after the last named Box prop.
import "std:fmt"
import "std:sys"
import "std:zeus"

fn Kids() {
    zeus.Box(
        align_direction = DIRECTION.Column,
        spacing = 8,
        padding = 12
    ) {
        zeus.Text("a"),
        zeus.Text("b"),
        zeus.Box(width = 4, height = 4, background = "#89b4fa"),
    }
}

fn main() {
    zeus.snapshot(200, 120, fn() -> Node {
        zeus.Box(align_direction = DIRECTION.Column) {
            Kids()
        }
    })
    if zeus.draw_count() < 2 {
        fmt.println("FAIL child comma")
        sys.exit(1)
    }
    fmt.println("child comma ok")
}
