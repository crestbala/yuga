import "std:http"
import "std:net"
import "std:fmt"
import "std:sys"

fn must(ok: bool) {
    if !ok {
        fmt.println("FAIL: http_h2_live assertion failed")
        sys.exit(1)
    }
}

fn main() {
    let app = http.app()
    app.rpc("Echo.Ping", |body| {
        body
    })
    let l = net.tcp_listen(0)
    // Environments without raw sockets (sandboxed builds, restricted CI)
    // cannot run this live test; skip it instead of failing the suite.
    if l < 0 {
        fmt.println("SKIP http_h2_live: no TCP sockets in this environment")
        return
    }
    let p = net.tcp_bound_port(l)
    must(p > 0)
    let c = net.tcp_connect("127.0.0.1", p)
    must(c >= 0)
    let s = net.tcp_accept(l)
    must(s >= 0)
    let framed = http.frame_str("hi")
    let req = http.client_h2("/Echo/Ping", framed)
    let n = net.tcp_write(c, req)
    must(n >= 0)
    http.serve_conn(app, s)
    let out = http.h2_read_unary(c)
    must(http.eq(out, "hi"))
    must(http.last_rpc_status() == 0)
    net.tcp_close(c)
    net.tcp_close(s)
    net.tcp_close(l)
    fmt.println(out.len, p)
}
