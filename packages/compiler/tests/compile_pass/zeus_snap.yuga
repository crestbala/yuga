import "std:fmt"
import "std:sys"
import "std:zeus"

fn main() {
    let count = zeus.signal(0)
    zeus.snapshot(320, 200, fn() -> Node {
        zeus.Box(align_direction = DIRECTION.Column, padding = 16, spacing = 12) {
            zeus.Text("Hello", font = 22)
            zeus.Button("Click", on_click = fn() => count.set(count.get() + 1))
        }
    })
    if zeus.draw_count() < 1 {
        sys.exit(1)
    }
}
