import "std:fmt"
import "std:zeus"

fn main() {
    let count = signal(0)
    snapshot(320, 200, || {
        Box(align_direction = DIRECTION.Column, padding = 16, gap = 12) {
            Text("Hello", font = 22)
            Button("Click", on_click = fn() => count.set(count.get() + 1))
        }
    })
    if draw_count() < 1 {
        let z = 0
        let boom = 1 / z
        fmt.println(boom)
    }
}
