// position / left / top / right / bottom / z_index are declarative widget
// props (the former `zeus.position(n, ...)` chain used for menus, dialogs,
// and chart overlays), so a pinned child needs no post-build node
// mutation. Pins resolve against the parent content box on the next layout,
// and a pin thunk that reads a signal re-pins in place without a rebuild.

import "std:fmt"
import "std:sys"
import "std:zeus"

fn expect(ok: bool, what: string) {
    if ok {
        return
    }
    fmt.println("FAIL", what)
    sys.exit(1)
}

fn main() {
    let slide = zeus.signal(0)
    zeus.snapshot(320, 200, fn() -> Node {
        // border = 0 pins the content origin to x + padding exactly (a Box's
        // default border prop applies -1, which shifts content by a px).
        let host = zeus.Box(padding = 10, width = 300, height = 150, border = 0,
                            background = "#ffffff", a11y_label = "host") {
            zeus.Text("flow", color = "#000000")
            zeus.Box(
                position = zeus.pos_absolute(),
                left = 30, top = 40, width = 60, height = 20,
                background = "#ff0000", z_index = 3, a11y_label = "pinned"
            )
            zeus.Box(
                position = zeus.pos_absolute(),
                right = 8, bottom = 6, width = 20, height = 10,
                background = "#0000ff", a11y_label = "rb"
            )
            zeus.Text("slide",
                position = zeus.pos_absolute(),
                left = fn() -> int { slide.get() }, top = 90,
                color = "#000000")
        }
        return host
    })
    let host = zeus.engine_find_text("host")
    let pinned = zeus.engine_find_text("pinned")
    let rb = zeus.engine_find_text("rb")
    let flow = zeus.engine_find_text("flow")
    let slide_node = zeus.engine_find_text("slide")
    expect(host > 0 && pinned > 0 && rb > 0 && flow > 0 && slide_node > 0,
           "nodes found")
    let hx = zeus.node_x(host)
    let hy = zeus.node_y(host)
    let hw = zeus.node_w(host)
    let hh = zeus.node_h(host)
    // Absolute children land at the parent content origin (pad 10), offset
    // by their pins; in-flow siblings do not move for them.
    expect(zeus.node_x(pinned) == hx + 40, "left pin lands at pad + left")
    expect(zeus.node_y(pinned) == hy + 50, "top pin lands at pad + top")
    expect(zeus.node_w(pinned) == 60 && zeus.node_h(pinned) == 20,
           "pinned child keeps its size")
    expect(zeus.node_x(pinned) + zeus.node_w(pinned) <= hx + hw,
           "pinned child stays inside the host")
    expect(zeus.node_y(flow) == hy + 10, "in-flow child starts at content origin")
    // right/bottom pin from the opposite edges of the inner box.
    expect(zeus.node_x(rb) + zeus.node_w(rb) == hx + hw - 18,
           "right pin hugs the inner right edge")
    expect(zeus.node_y(rb) + zeus.node_h(rb) == hy + hh - 16,
           "bottom pin hugs the inner bottom edge")
    expect(zeus.node_x(slide_node) == hx + 10, "reactive pin starts unpinned at 0")
    // A pin thunk that reads a signal re-pins on the next layout after set.
    slide.set(150)
    zeus.engine_layout(320, 200)
    expect(zeus.node_x(slide_node) == hx + 160, "reactive pin follows the signal")
    fmt.println("position props ok")
}
