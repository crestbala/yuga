import "std:fmt"
import "std:sys"
import "std:zeus"

let mut labs: []string = []string {}
let mut cs: []string = []string {}
let mut cv: []int = []int {}

fn Picks(sel: Signal<int>) {
    zeus.Tabs(sel, labs)
}

fn ChartSeed() {
    if labs.len == 0 {
        push(labs, "A")
        push(labs, "B")
        push(cs, "One")
        push(cs, "Two")
        push(cv, 12)
        push(cv, 8)
        push(cv, 20)
        push(cv, 14)
    }
}

fn main() {
    ChartSeed()
    let open = zeus.signal(1)
    let on = zeus.signal(1)
    let sel = zeus.signal(0)
    zeus.snapshot(320, 240, fn() -> Node {
        zeus.Card() {
            zeus.Heading("Hello")
            zeus.Button("Go", look = zeus.LOOK.Solid, size = zeus.SIZE.Md)
            zeus.Chip("live", zeus.TINT.Ok)
            zeus.Checkbox("On", on)
            zeus.Field("Name", zeus.signal(""), "Ada")
            zeus.User("AP", "Ada", "Op")
            Picks(sel)
            zeus.Box(safe = 1, min_width = 40, wrap = 1) {
                zeus.Note("safe")
            }
            zeus.BarChart(labs, cs, cv, 260, 120)
            zeus.LineChart(labs, cs, cv, 260, 120)
            zeus.AreaChart(labs, cs, cv, 260, 120)
            zeus.Dialog(open) {
                zeus.Title("Hi")
                zeus.Button("Ok", look = zeus.LOOK.Solid, size = zeus.SIZE.Sm, on_click =  fn() => open.set(0))
            }
        }
    })
    if zeus.draw_count() < 1 {
        fmt.println("FAIL zeus")
        sys.exit(1)
    }
    fmt.println("zeus components ok")
}
