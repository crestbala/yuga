import "std:fmt"
import "std:sys"
import "std:zeus"

fn fail() {
    sys.exit(1)
}

fn expect(got: int, want: int) {
    if got < want {
        fail()
    }
    if want < got {
        fail()
    }
}

fn main() {
    let sel = zeus.signal(0)
    let open = zeus.signal(0)
    let saved = zeus.signal(0)
    zeus.window("keytest", 400, 300)
    let box = zeus.Box(width = 200, height = 100, align_direction = DIRECTION.Column)
    zeus.focusable(box)
    zeus.key_context(box, "Select")
    zeus.on_range(box, "select.next", sel, 1, 0, 2)
    zeus.on_range(box, "select.prev", sel, -1, 0, 2)
    zeus.on_action(box, "select.toggle", open, 1, 0)
    zeus.__ui_push(box.id)
    zeus.Button("Comfortable", on_click = fn() => open.set(1 - open.get()), width = 200, height = 40)
    zeus.__ui_pop()
    let top = zeus.Box(align_direction = DIRECTION.Column)
    zeus.child(top, box)
    zeus.root(top)
    zeus.map_key("down", "select.next", "Select")
    zeus.map_key("up", "select.prev", "Select")
    zeus.map_key("enter", "select.toggle", "Select")
    zeus.map_key("cmd-s", "app.save", "")
    zeus.on_action_global("app.save", saved, 2, 1)
    zeus.engine_layout(400, 300)

    zeus.engine_key_ev(1003, 0)
    expect(sel.get(), 0)

    zeus.engine_key_ev(115, 8)
    expect(saved.get(), 1)

    zeus.engine_click(20, 20)
    zeus.engine_mouseup()
    zeus.engine_layout(400, 300)

    zeus.engine_key_ev(1003, 0)
    expect(sel.get(), 1)
    zeus.engine_key_ev(1003, 0)
    expect(sel.get(), 2)
    zeus.engine_key_ev(1003, 0)
    expect(sel.get(), 2)

    zeus.engine_key_ev(1002, 0)
    expect(sel.get(), 1)
    zeus.engine_key_ev(1002, 0)
    zeus.engine_key_ev(1002, 0)
    expect(sel.get(), 0)

    zeus.engine_key_ev(27, 0)
    zeus.engine_layout(400, 300)
    zeus.engine_key_ev(9, 0)
    zeus.engine_key_ev(1003, 0)
    expect(sel.get(), 1)

    let before = open.get()
    zeus.engine_key_ev(13, 0)
    expect(open.get(), 1 - before)
}
