import "std:fmt"
import "std:zeus"

fn fail() {
    let z = 0
    fmt.println(1 / z)
}

fn expect(got: int, want: int) {
    if got < want {
        fail()
    }
    if want < got {
        fail()
    }
}

fn main() {
    let sel = signal(0)
    let open = signal(0)
    let saved = signal(0)
    // Keyboard wiring is plain calls on a node, not method chains.
    let face = Button("Comfortable")
    on_click_toggle(face, open)
    let box = Box(align_direction = DIRECTION.Column, width = 200, height = 100)
    focusable(box)
    key_context(box, "Select")
    on_range(box, "select.next", sel, 1, 0, 2)
    on_range(box, "select.prev", sel, -1, 0, 2)
    on_action(box, "select.toggle", open, 1, 0)
    child(box, face)
    window("keytest", 400, 300)
    let rootbox = Box(align_direction = DIRECTION.Column)
    child(rootbox, box)
    root(rootbox)
    map_key("down", "select.next", "Select")
    map_key("up", "select.prev", "Select")
    map_key("enter", "select.toggle", "Select")
    map_key("cmd-s", "app.save", "")
    on_action_global("app.save", saved, 2, 1)
    engine_layout(400, 300)

    engine_key_ev(1003, 0)
    expect(sel.get(), 0)

    engine_key_ev(115, 8)
    expect(saved.get(), 1)

    engine_click(20, 20)
    engine_mouseup()
    engine_layout(400, 300)

    engine_key_ev(1003, 0)
    expect(sel.get(), 1)
    engine_key_ev(1003, 0)
    expect(sel.get(), 2)
    engine_key_ev(1003, 0)
    expect(sel.get(), 2)

    engine_key_ev(1002, 0)
    expect(sel.get(), 1)
    engine_key_ev(1002, 0)
    engine_key_ev(1002, 0)
    expect(sel.get(), 0)

    engine_key_ev(27, 0)
    engine_layout(400, 300)
    engine_key_ev(9, 0)
    engine_key_ev(1003, 0)
    expect(sel.get(), 1)

    let before = open.get()
    engine_key_ev(13, 0)
    expect(open.get(), 1 - before)
}
