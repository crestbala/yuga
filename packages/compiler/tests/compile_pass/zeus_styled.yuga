import "std:fmt"
import "std:zeus"

fn fail() {
    let z = 0
    fmt.println(1 / z)
}

fn expect(got: int, want: int) {
    if got < want {
        fail()
    }
    if want < got {
        fail()
    }
}

fn main() {
    // Reactive style props: a plain value auto-wraps into a thunk, so the
    // prop's effect runs once; a value that reads a signal re-runs just that
    // prop when the signal changes. No `styled` closures, no node painting.
    let sig = signal(1)
    let n = Box(width = if sig.get() == 1 { 120 } else { 60 })
    window("styled", 120, 80)
    ui_reset()
    root(n)
    engine_layout(120, 80)
    expect(node_ew(n.id), 120)

    sig.set(0)
    expect(node_ew(n.id), 60)
    sig.set(1)
    expect(node_ew(n.id), 120)

    // Text style props react too, and the label effect still tracks the signal.
    let bound = signal(3)
    let lab = Text("{{bound.get()}}", color = if sig.get() == 1 { "#ff0000" } else { "#00ff00" })
    child(n, lab)
    engine_layout(120, 80)
    let t = node_kid(n.id, 0)
    expect(node_fg(t), 16711680)
    expect(1, 1)
    bound.set(9)
    expect(1, 1)
    sig.set(0)
    expect(node_fg(t), 65280)
}
