import "std:fmt"
import "std:zeus"

fn fail() {
    let z = 0
    fmt.println(1 / z)
}

fn expect(got: int, want: int) {
    if got < want {
        fail()
    }
    if want < got {
        fail()
    }
}

fn main() {
    let sig = zeus.signal(1)
    let out = zeus.signal(0)
    let n = zeus.box()
    n.styled(|| {
        n.bg(sig.get())
        out.set(sig.get())
    })
    expect(out.get(), 1)
    expect(sig.get(), 1)

    sig.set(7)
    expect(out.get(), 7)
    expect(sig.get(), 7)

    let bound = zeus.signal(3)
    let lab = zeus.label("0").bind(bound)
    zeus.window("styled", 120, 80)
    zeus.root(zeus.col().children(n, lab))
    zeus.engine_layout(120, 80)
    expect(bound.get(), 3)
    bound.set(9)
    expect(bound.get(), 9)
}
