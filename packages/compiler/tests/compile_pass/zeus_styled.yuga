import "std:fmt"
import "std:sys"
import "std:zeus"

fn fail() {
    sys.exit(1)
}

fn expect(got: int, want: int) {
    if got < want {
        fail()
    }
    if want < got {
        fail()
    }
}

fn main() {
    let sig = zeus.signal(1)
    let out = zeus.signal(0)
    zeus.Box(background = fn() -> string {
        out.set(sig.get())
        "#010101"
    })
    expect(out.get(), 1)
    expect(sig.get(), 1)

    sig.set(7)
    expect(out.get(), 7)
    expect(sig.get(), 7)

    let bound = zeus.signal(3)
    zeus.window("styled", 120, 80)
    zeus.root(zeus.Box(align_direction = DIRECTION.Column) {
        zeus.Text("{{bound.get()}}")
    })
    zeus.engine_layout(120, 80)
    expect(bound.get(), 3)
    bound.set(9)
    expect(bound.get(), 9)
}
