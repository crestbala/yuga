import "std:fmt"
import "std:sys"
import "std:http"
import "std:zeus"

#[proto]
struct HelloReq {
}

#[proto]
struct HelloResp {
    count: int,
}

fn Panel(initial: int) {
    zeus.Box(align_direction = DIRECTION.Column) {
        zeus.Text("{{initial}}", font = 18)
    }
}

fn fail() {
    sys.exit(1)
}

fn main() {
    let app = http.app()
    app.rpc("Counter.Hello", |body| {
        let req = decode_HelloReq(body)
        encode_HelloResp(HelloResp { count: 7 })
    })
    let out = http.dispatch(app, "Counter.Hello", encode_HelloReq(HelloReq {}))
    let hello = decode_HelloResp(out)
    let initial = hello.count
    if initial < 7 {
        fail()
    }
    if 7 < initial {
        fail()
    }
    zeus.snapshot(480, 320, fn() -> Node {
        zeus.Box(align_direction = DIRECTION.Column) {
            Panel(initial)
        }
    })
    if zeus.draw_count() < 1 {
        fail()
    }
}
