import "std:fmt"
import "std:http"
import "std:zeus"

#[proto]
struct HelloReq {
}

#[proto]
struct HelloResp {
    count: int,
}

fn Panel(initial: int) -> Node {
    Box(align_direction = DIRECTION.Column) {
        bind_n(Text("count", font = 18), initial)
    }
}

fn fail() {
    let z = 0
    fmt.println(1 / z)
}

fn main() {
    let app = http.app()
    app.rpc("Counter.Hello", |body| {
        let req = decode_HelloReq(body)
        encode_HelloResp(HelloResp { count: 7 })
    })
    let out = http.dispatch(app, "Counter.Hello", encode_HelloReq(HelloReq {}))
    let hello = decode_HelloResp(out)
    let initial = hello.count
    if initial < 7 {
        fail()
    }
    if 7 < initial {
        fail()
    }
    let n = Panel(initial)
    window("Zeus", 480, 320)
    root(n)
    run(n)
    engine_paint()
    if draw_count() < 1 {
        fail()
    }
}
