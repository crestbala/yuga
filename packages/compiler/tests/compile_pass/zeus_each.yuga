import "std:zeus"

struct Row {
    a: string,
    b: string,
}

fn main() {
    let mut rows = []Row {}
    push(rows, Row { a: "bezel.toml", b: "Config" })
    push(rows, Row { a: "kit.yuga", b: "Source" })
    let open = zeus.signal(1)
    let mut nums = []int {}
    for i in 1..4 {
        push(nums, i)
    }
    let top = zeus.Box(align_direction = DIRECTION.Column)
    zeus.__ui_push(top.id)
    for i in 0..nums.len {
        let v = nums[i]
        zeus.Text("{{v}}")
    }
    for i in 0..rows.len {
        let a = rows[i].a
        zeus.Text(a)
    }
    let shown = zeus.Text("shown")
    zeus.show(shown, open)
    zeus.__ui_pop()
    zeus.snapshot(240, 160, fn() -> Node { top })
}
