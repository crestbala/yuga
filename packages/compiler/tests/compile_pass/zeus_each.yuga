// `each` / `when` as plain functions (no chaining), `bind_n` for int paint,
// and explicit `child` attachment.
import "std:zeus"

struct Row {
    a: string,
    b: string,
}

fn main() {
    let mut rows = []Row {}
    push(rows, Row { a: "bezel.toml", b: "Config" })
    push(rows, Row { a: "kit.yuga", b: "Source" })
    let open = signal(1)
    let mut nums = []int {}
    for i in 1..4 {
        push(nums, i)
    }
    let col = Box(align_direction = DIRECTION.Column)
    each(col, nums, (i, n) => {
        bind_n(Text("n", font = 11), n)
    })
    each(col, rows, (i, r) => {
        bind_n(Text(r.a, font = 12), i)
    })
    child(col, when(open, || {
        Text("shown", font = 12)
    }))
    window("each", 240, 160)
    root(col)
    run(col)
}
