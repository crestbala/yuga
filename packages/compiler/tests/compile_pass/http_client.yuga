import "std:http"
import "std:fmt"
import "std:sys"

fn must(ok: bool) {
    if !ok {
        sys.exit(1)
    }
}

fn main() {
    let hp = http.parse_addr("127.0.0.1:8080")
    must(http.eq(hp.host, "127.0.0.1"))
    must(hp.port == 8080)
    let loc = http.parse_addr("localhost:9")
    must(http.eq(loc.host, "localhost"))
    must(loc.port == 9)
    let bad = http.parse_addr("nope")
    must(bad.port == 0)
    let nohost = http.parse_addr(":8080")
    must(nohost.port == 0)
    let noport = http.parse_addr("127.0.0.1:")
    must(noport.port == 0)
    // https:// scheme: TLS flag, default port 443, explicit ports win.
    let tls1 = http.parse_addr("https://example.com")
    must(http.eq(tls1.host, "example.com"))
    must(tls1.port == 443)
    must(tls1.tls == 1)
    let tls2 = http.parse_addr("https://example.com:8443")
    must(http.eq(tls2.host, "example.com"))
    must(tls2.port == 8443)
    must(tls2.tls == 1)
    let tls3 = http.parse_addr("http://example.com")
    must(http.eq(tls3.host, "example.com"))
    must(tls3.port == 80)
    must(tls3.tls == 0)
    // https:// over transports that cannot carry it fails cleanly.
    let h2tls = http.h2_call("https://example.com", "Nope.Missing", "")
    must(h2tls.len == 0)
    let tlsmiss = http.call(http.client("https://0.0.0.1:9"), "Nope.Missing", "")
    must(tlsmiss.len == 0)
    let req = http.client_post("127.0.0.1", 8080, "/S/M", "hi")
    must(req[0] == 80)
    must(req[1] == 79)
    must(req[2] == 83)
    must(req[3] == 84)
    let resp = http.concat_str("HTTP/1.1 200 OK\r\n\r\n", "BODY")
    must(http.eq(http.http_payload(resp), "BODY"))
    let nosplit = http.http_payload("no splitter")
    must(nosplit.len == 0)
    let miss = http.call(http.client("256.0.0.1:9"), "Nope.Missing", "")
    must(miss.len == 0)
    let h2miss = http.h2_call("256.0.0.1:9", "Nope.Missing", "")
    must(h2miss.len == 0)
    fmt.println(hp.port, loc.host)
}
