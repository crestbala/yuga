import "std:fmt"

fn main() {
    let mut n = 0
    for i in 0..10 {
        if i == 3 {
            continue
        }
        if i == 7 {
            break
        }
        n += i
    }
    fmt.println(n)
    let mut i = 0
    let mut s = 0
    while i < 5 {
        i += 1
        if i == 2 {
            continue
        }
        s += i
    }
    fmt.println(s)
}
