// The calendar picker must be one lazy 7x6 grid, not 12 pre-built month
// grids: flipping month/year updates the visible cells through prop thunks
// never rebuilds. Regression for the lazy-DatePicker work.

import "std:fmt"
import "std:sys"
import "std:zeus"

fn expect(ok: bool, what: string) {
    if ok {
        return
    }
    fmt.println("FAIL", what)
    sys.exit(1)
}

fn main() {
    let y = zeus.signal(2026)
    let m = zeus.signal(9)
    let d = zeus.signal(3)
    zeus.snapshot(340, 420, fn() -> Node {
        zeus.Page() {
            zeus.DatePicker(y, m, d)
        }
    })
    // A closed picker is one grid of 42 cells plus rails and weekday header:
    // nowhere near the ~500 nodes twelve month grids used to cost.
    expect(zeus.arena_nodes() < 200, "lazy picker stays small")
    // Open it, pick day 15: date closes and `d` updates.
    expect(zeus.engine_click_text("Pick a date") != 0, "trigger click")
    zeus.engine_layout(340, 420)
    expect(zeus.engine_click_text("15") != 0, "day 15 click")
    expect(d.get() == 15, "day picked")
    // Step to the next month: the same 15th must still exist, and the
    // month label must have followed. The grid was not rebuilt.
    let before = zeus.arena_nodes()
    expect(zeus.engine_click_text("Pick a date") != 0, "trigger re-open")
    zeus.engine_layout(340, 420)
    expect(zeus.engine_click_text("Next month") != 0, "next month click")
    expect(m.get() == 10, "month stepped")
    expect(zeus.arena_nodes() == before, "no rebuild on month step")
    zeus.engine_layout(340, 420)
    // The old 12-name stack is gone: the single name label followed the
    // step, and the stepped month's cells are the ones in the tree.
    expect(zeus.engine_click_text("October") != 0, "month label follows")
    expect(zeus.engine_click_text("15") != 0, "day 15 still there")
    expect(d.get() == 15, "day re-picked")
    fmt.println("picker ok")
}
