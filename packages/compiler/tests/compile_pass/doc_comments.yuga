//! Module docs (`//!`) describe the file. Hover on the module name shows this.
//!
//! Example:
//!   let n = add(1, 2)

import "std:fmt"

/// Adds two integers.
///
/// Example:
///   let n = add(2, 3)
fn add(a: int, b: int) -> int {
    return a + b
}

/// A named pair of ints.
struct Point {
    /// Horizontal position.
    x: int,
    /// Vertical position.
    y: int,
}

fn main() {
    /// Local docs attach to `let`.
    let p = Point { x: 1, y: 2 }
    fmt.println(add(p.x, p.y))
}
