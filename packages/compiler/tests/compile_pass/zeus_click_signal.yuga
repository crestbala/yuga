import "std:fmt"
import "std:sys"
import "std:zeus"

/// A capturing `on_press` lives in a struct field, is interned by
/// `Button(on_click = ...)`, then the struct is dropped. The click must still
/// see the captured signal.
struct ClickProps {
    on_press: fn(),
}

fn fail() {
    sys.exit(1)
}

fn expect(got: int, want: int) {
    if got < want {
        fail()
    }
    if want < got {
        fail()
    }
}

fn wire(p: ClickProps) -> Node {
    let n = zeus.Button("+", width = 120, height = 40)
    return zeus.on_click(n, p.on_press)
}

fn main() {
    let n = zeus.signal(5)
    let b = wire(ClickProps { on_press: || { n.set(n.get() + 1) } })
    zeus.window("click-signal", 120, 40)
    zeus.root(b)
    zeus.engine_layout(120, 40)
    expect(n.get(), 5)
    zeus.engine_click(60, 20)
    expect(n.get(), 6)
    zeus.engine_click(60, 20)
    expect(n.get(), 7)
}
