// Kit widgets arrive unqualified through the barrel import — no `ui.` or
// `zeus.` prefix, no chaining. `size_of` reads the size token back.
import "std:fmt"
import "../../../../packages/zeus-components/ui.yuga"

fn fail() {
    let z = 0
    fmt.println(1 / z)
}

fn expect(got: int, want: int) {
    if got < want {
        fail()
    }
    if want < got {
        fail()
    }
}

fn main() {
    let sm_btn = Button(label = "Go", size = sm())
    expect(size_of(sm_btn), sm())
    let lg_chip = Chip(label = "Hi", color = "#ededed", size = lg())
    expect(size_of(lg_chip), lg())
}
