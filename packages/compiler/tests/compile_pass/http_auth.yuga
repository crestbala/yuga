// Phase 1b auth/session convention: the client sends `Authorization: Bearer
// <t>` (set_token) on every gRPC-Web call; the server exposes it as
// `req_token()` to `app.before` middleware, which can `reject()` — dispatch
// then skips the handler and answers grpc-status 16 (unauthenticated).

import "std:http"
import "std:net"
import "std:fmt"
import "std:sys"

fn must(ok: bool, what: string) {
    if !ok {
        fmt.println("FAIL", what)
        sys.exit(1)
    }
}

fn roundtrip(app: App, body: string) -> string {
    let l = net.tcp_listen(0)
    must(l >= 0, "listen")
    let p = net.tcp_bound_port(l)
    must(p > 0, "port")
    let c = net.tcp_connect("127.0.0.1", p)
    must(c >= 0, "connect")
    let s = net.tcp_accept(l)
    must(s >= 0, "accept")
    let framed = http.frame_str(body)
    let req = http.client_post("127.0.0.1", p, "/Echo/Ping", framed)
    let n = net.tcp_write(c, req)
    must(n >= 0, "write")
    http.serve_conn(app, s)
    net.tcp_close(s)
    let out = http.h1_read_unary(c)
    net.tcp_close(c)
    net.tcp_close(l)
    return out
}

fn main() {
    let app = http.app()
    app.rpc("Echo.Ping", |body| {
        body
    })
    app.before(|name, body| {
        // the session convention: every request must carry our token
        if !fmt.eq(http.req_token(), "s3cret") {
            http.reject()
            return ""
        }
        body
    })

    // Authenticated call: echoed body, grpc-status 0.
    http.set_token("s3cret")
    let out = roundtrip(app, "hi")
    must(http.eq(out, "hi"), "authed call echoed")
    must(http.last_rpc_status() == 0, "authed status")

    // Anonymous call: handler skipped, grpc-status 16, empty body.
    http.set_token("")
    let out2 = roundtrip(app, "hi")
    must(out2.len == 0, "anon call rejected")
    must(http.last_rpc_status() == 16, "rejected status")

    fmt.println("auth ok")
}
