import "std:zeus"

fn Readout(n: int) {
    zeus.Text("{{n}}")
}

fn CounterPanel(initial: int) {
    let mut count = initial
    zeus.Box(align_direction = DIRECTION.Column, padding = 16, spacing = 12) {
        zeus.Text("Counter", font = 22)
        zeus.Box(align_direction = DIRECTION.Row, spacing = 8) {
            zeus.Button("+1", on_click = fn() { count = count + 1 })
            Readout(count)
        }
    }
}

fn main() {
    zeus.App("Counter", 400, 240, fn() {
        CounterPanel(0)
    })
}
