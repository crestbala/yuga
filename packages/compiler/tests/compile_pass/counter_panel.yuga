import "std:zeus"

fn Readout(n: int) -> Node {
    return bind_n(Text(""), n)
}

fn CounterPanel(initial: int) -> Node {
    let mut count = initial
    Box(align_direction = DIRECTION.Column, padding = 16, gap = 12) {
        Text("Counter", font = 22)
        Box(align_direction = DIRECTION.Row, gap = 8) {
            Button("+1", on_click = fn() => count = count + 1),
            Readout(count)
        }
    }
}

fn main() {
    App("Counter", 400, 240, || {
        CounterPanel(0)
    })
}
