// Flexbox and grid through the declarative surface: one container, `Box`,
// with `align_direction`, and `Grid` taking a `GridConfig` struct.
import "std:fmt"
import "std:sys"
import "std:zeus"

fn DashboardLayout() {
    zeus.Box(align_direction = DIRECTION.Row, spacing = 16, align_items = ALIGN.Center) {
        zeus.Box(grow = 1, background = "#313244", padding = 12) {
            zeus.Text("Flexible Left Panel")
        }
        zeus.Box(width = 150, background = "#45475a", padding = 12) {
            zeus.Text("Fixed Right Panel (150px)")
        }
    }

    zeus.Grid(config = GridConfig(columns = 3, gap = 12, padding = 16)) {
        zeus.Box(background = "#89b4fa", height = 100) { zeus.Text("Card 1") }
        zeus.Box(background = "#a6e3a1", height = 100) { zeus.Text("Card 2") }
        zeus.Box(background = "#f9e2af", height = 100) { zeus.Text("Card 3") }
    }
}

fn main() {
    zeus.snapshot(640, 480, fn() -> Node {
        zeus.Box(align_direction = DIRECTION.Column) {
            DashboardLayout()
        }
    })
    if zeus.draw_count() < 8 {
        fmt.println("FAIL layout")
        sys.exit(1)
    }
    fmt.println("layout ok")
}
