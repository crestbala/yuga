//! layout — measure + flex/grid/absolute (GPUI taffy.rs).
//!
//! Kind 11 (`scroll`): children are not shrunk on the block axis, so extra
//! height becomes `scroll_y`. Horizontal overflow is off unless `overflow` is
//! auto (3 / `scroll_xy`): then children keep intrinsic width and `scroll_x`
//! can move. Page containers use vertical-only so they never grow an H bar.

import "arena.yuga"
import "geometry.yuga"
import "platform.yuga"

fn flex_grow_shrink(id: int, extra: int, row: int) -> int {
    let nk = arena.nodes[id].kids.len
    if extra == 0 {
        return 0
    }
    if extra > 0 {
        let mut growsum = 0
        for i in 0..nk {
            let c = arena.nodes[id].kids[i]
            if arena.skip_flow(c) == 0 {
                if arena.axis_frozen(c, row) == 0 {
                    if arena.nodes[c].grow > 0 {
                        growsum = growsum + arena.nodes[c].grow
                    }
                }
            }
        }
        if growsum <= 0 {
            return extra
        }
        let mut left = extra
        let mut last = -1
        for i in 0..nk {
            let c = arena.nodes[id].kids[i]
            if arena.skip_flow(c) == 0 {
                if arena.axis_frozen(c, row) == 0 {
                    if arena.nodes[c].grow > 0 {
                        let add = extra * arena.nodes[c].grow / growsum
                        arena.szbuf[i] = arena.szbuf[i] + add
                        left = left - add
                        last = i
                    }
                }
            }
        }
        if last >= 0 {
            arena.szbuf[last] = arena.szbuf[last] + left
            return 0
        }
        return extra
    }
    let mut shrinksum = 0
    for i in 0..nk {
        let c = arena.nodes[id].kids[i]
        if arena.skip_flow(c) == 0 {
            if arena.axis_frozen(c, row) == 0 {
                if arena.nodes[c].shrink > 0 {
                    if arena.szbuf[i] > 0 {
                        shrinksum = shrinksum + arena.nodes[c].shrink
                    }
                }
            }
        }
    }
    if shrinksum <= 0 {
        return extra
    }
    let need = -extra
    let mut left = need
    for i in 0..nk {
        let c = arena.nodes[id].kids[i]
        if arena.skip_flow(c) == 0 {
            if arena.axis_frozen(c, row) == 0 {
                if arena.nodes[c].shrink > 0 {
                    if arena.szbuf[i] > 0 {
                        let cut = need * arena.nodes[c].shrink / shrinksum
                        if cut > arena.szbuf[i] {
                            left = left - arena.szbuf[i]
                            arena.szbuf[i] = 0
                        } else {
                            arena.szbuf[i] = arena.szbuf[i] - cut
                            left = left - cut
                        }
                    }
                }
            }
        }
    }
    return -left
}

fn apply_label_wrap(id: int) {
    if arena.nodes[id].kind != 3 {
        return
    }
    if arena.has_bound_num(id) != 0 {
        return
    }
    let inner = arena.inner_w(id)
    if inner <= 0 {
        return
    }
    if inner >= arena.nodes[id].tw {
        return
    }
    /* A squeezed label in a flex row must not grow to two lines under siblings. */
    if arena.nodes[id].wrap == 0 {
        let p = arena.nodes[id].parent
        if p > 0 {
            if arena.nodes[p].dir == 0 {
                if arena.nodes[p].kind == 1 {
                    return
                }
            }
        }
    }
    let mut ww = 0
    let mut hh = 0
    platform.plat_measure_wrap(arena.nodes[id].text, arena.nodes[id].font, inner, &mut ww, &mut hh)
    arena.nodes[id].wrap = 1
    let need = hh + arena.box_pad_y(id)
    if need > arena.nodes[id].h {
        arena.nodes[id].h = arena.clamp_h(id, need)
    }
}

fn grow_to_children(id: int) {
    let nk = arena.nodes[id].kids.len
    let mut max_b = 0
    for i in 0..nk {
        let c = arena.nodes[id].kids[i]
        if arena.skip_flow(c) == 0 {
            let b = arena.nodes[c].y + arena.nodes[c].h + arena.nodes[c].m_b - arena.nodes[id].y
            if b > max_b {
                max_b = b
            }
        }
    }
    let mut need = max_b + arena.nodes[id].pad_b + arena.nodes[id].border_w
    if arena.nodes[id].eh >= 0 {
        if need < arena.nodes[id].eh {
            need = arena.nodes[id].eh
        }
    }
    if need > arena.nodes[id].h {
        arena.nodes[id].h = need
    }
}

fn stretch_cross(p: int, c: int, row: int) -> int {
    if row != 0 {
        if arena.has_h(c) != 0 {
            return 0
        }
    } else {
        if arena.has_w(c) != 0 {
            return 0
        }
    }
    let al = arena.child_align(p, c)
    if al == 6 {
        return 1
    }
    return 0
}

fn measure_text(id: int) {
    let mut tw = 0
    let mut th = 0
    if arena.has_bound_num(id) != 0 {
        platform.plat_measure_int(arena.bound_num(id), arena.nodes[id].font, &mut tw, &mut th)
    } else if arena.nodes[id].kind == 10 {
        platform.plat_measure(arena.input_shown(id), arena.nodes[id].font, &mut tw, &mut th)
    } else {
        platform.plat_measure(arena.nodes[id].text, arena.nodes[id].font, &mut tw, &mut th)
    }
    arena.nodes[id].tw = tw
    arena.nodes[id].th = th
}

fn measure_node(id: int) {
    if id <= 0 {
        return
    }
    if arena.want_show(id) == 0 {
        arena.nodes[id].iw = 0
        arena.nodes[id].ih = 0
        return
    }
    let k = arena.nodes[id].kind
    let nk = arena.nodes[id].kids.len
    if k == 3 {
        measure_text(id)
        let mut iw = arena.nodes[id].tw + arena.box_pad_x(id)
        let mut ih = arena.nodes[id].th + arena.box_pad_y(id)
        if arena.nodes[id].ew >= 0 {
            iw = arena.nodes[id].ew
        }
        if arena.nodes[id].eh >= 0 {
            ih = arena.nodes[id].eh
        }
        arena.nodes[id].iw = arena.clamp_w(id, iw)
        arena.nodes[id].ih = arena.clamp_h(id, ih)
        return
    }
    if k == 4 {
        measure_text(id)
        let mut iw = arena.nodes[id].tw + arena.nodes[id].pad_l + arena.nodes[id].pad_r
        let mut ih = arena.nodes[id].th + arena.nodes[id].pad_t + arena.nodes[id].pad_b
        if arena.nodes[id].ew >= 0 {
            iw = arena.nodes[id].ew
        }
        if arena.nodes[id].eh >= 0 {
            ih = arena.nodes[id].eh
        }
        arena.nodes[id].iw = arena.clamp_w(id, iw)
        arena.nodes[id].ih = arena.clamp_h(id, ih)
        return
    }
    if k == 10 {
        measure_text(id)
        let mut iw = arena.nodes[id].tw + arena.box_pad_x(id)
        let mut ih = arena.nodes[id].th + arena.box_pad_y(id)
        if arena.nodes[id].ew >= 0 {
            iw = arena.nodes[id].ew
        }
        if arena.nodes[id].eh >= 0 {
            ih = arena.nodes[id].eh
        }
        arena.nodes[id].iw = arena.clamp_w(id, iw)
        arena.nodes[id].ih = arena.clamp_h(id, ih)
        return
    }
    if k == 5 {
        let mut iw = 0
        let mut ih = 0
        if arena.nodes[id].ew >= 0 {
            iw = arena.nodes[id].ew
        }
        if arena.nodes[id].eh >= 0 {
            ih = arena.nodes[id].eh
        }
        arena.nodes[id].iw = arena.clamp_w(id, iw)
        arena.nodes[id].ih = arena.clamp_h(id, ih)
        return
    }
    if k == 6 {
        let mut iw = 0
        let mut ih = 0
        if arena.nodes[id].ew >= 0 {
            iw = arena.nodes[id].ew
        }
        if arena.nodes[id].eh >= 0 {
            ih = arena.nodes[id].eh
        }
        arena.nodes[id].iw = arena.clamp_w(id, iw)
        arena.nodes[id].ih = arena.clamp_h(id, ih)
        return
    }
    if k == 7 {
        let mut iw = 0
        let mut ih = 0
        if arena.nodes[id].ew >= 0 {
            iw = arena.nodes[id].ew
        }
        if arena.nodes[id].eh >= 0 {
            ih = arena.nodes[id].eh
        }
        arena.nodes[id].iw = arena.clamp_w(id, iw)
        arena.nodes[id].ih = arena.clamp_h(id, ih)
        return
    }
    if k == 8 {
        let mut iw = 0
        let mut ih = 0
        if arena.nodes[id].ew >= 0 {
            iw = arena.nodes[id].ew
        }
        if arena.nodes[id].eh >= 0 {
            ih = arena.nodes[id].eh
        }
        arena.nodes[id].iw = arena.clamp_w(id, iw)
        arena.nodes[id].ih = arena.clamp_h(id, ih)
        return
    }
    if k == 12 {
        let mut iw = 0
        let mut ih = 0
        if arena.nodes[id].ew >= 0 {
            iw = arena.nodes[id].ew
        }
        if arena.nodes[id].eh >= 0 {
            ih = arena.nodes[id].eh
        }
        arena.nodes[id].iw = arena.clamp_w(id, iw)
        arena.nodes[id].ih = arena.clamp_h(id, ih)
        return
    }
    if k == 13 {
        let mut iw = 0
        let mut ih = 0
        if arena.nodes[id].ew >= 0 {
            iw = arena.nodes[id].ew
        }
        if arena.nodes[id].eh >= 0 {
            ih = arena.nodes[id].eh
        }
        arena.nodes[id].iw = arena.clamp_w(id, iw)
        arena.nodes[id].ih = arena.clamp_h(id, ih)
        return
    }
    for i in 0..nk {
        measure_node(arena.nodes[id].kids[i])
    }
    if k == 2 {
        let mut nflow = 0
        let mut cw = 0
        let mut rh = 0
        for i in 0..nk {
            let c = arena.nodes[id].kids[i]
            if arena.skip_flow(c) == 0 {
                nflow = nflow + 1
                cw = geometry.max2(cw, arena.nodes[c].iw)
                rh = geometry.max2(rh, arena.nodes[c].ih)
            }
        }
        let mut cols = arena.nodes[id].grid_cols
        if cols < 1 {
            cols = 1
        }
        if arena.nodes[id].grid_auto != 0 {
            cols = 2
        }
        let mut rows = 0
        if nflow > 0 {
            rows = (nflow + cols - 1) / cols
        }
        let gx = arena.gap_x(id)
        let gy = arena.gap_y(id)
        let mut iw = cols * cw + gx * geometry.max2(cols - 1, 0) + arena.box_pad_x(id)
        let mut ih = rows * rh + gy * geometry.max2(rows - 1, 0) + arena.box_pad_y(id)
        if arena.nodes[id].ew >= 0 {
            iw = arena.nodes[id].ew
        }
        if arena.nodes[id].eh >= 0 {
            ih = arena.nodes[id].eh
        }
        arena.nodes[id].iw = arena.clamp_w(id, iw)
        arena.nodes[id].ih = arena.clamp_h(id, ih)
        return
    }
    let mut acc = 0
    let mut cross = 0
    let mut first = 1
    for i in 0..nk {
        let c = arena.nodes[id].kids[i]
        if arena.skip_flow(c) == 0 {
            if first == 0 {
                if arena.nodes[id].dir == 0 {
                    acc = acc + arena.gap_x(id)
                } else {
                    acc = acc + arena.gap_y(id)
                }
            }
            first = 0
            if arena.nodes[id].dir == 0 {
                acc = acc + arena.nodes[c].iw + arena.nodes[c].m_l + arena.nodes[c].m_r
                cross = geometry.max2(cross, arena.nodes[c].ih + arena.nodes[c].m_t + arena.nodes[c].m_b)
            } else {
                acc = acc + arena.nodes[c].ih + arena.nodes[c].m_t + arena.nodes[c].m_b
                cross = geometry.max2(cross, arena.nodes[c].iw + arena.nodes[c].m_l + arena.nodes[c].m_r)
            }
        }
    }
    let mut iw = 0
    let mut ih = 0
    if arena.nodes[id].dir == 0 {
        iw = acc + arena.box_pad_x(id)
        ih = cross + arena.box_pad_y(id)
    } else {
        iw = cross + arena.box_pad_x(id)
        ih = acc + arena.box_pad_y(id)
    }
    if arena.nodes[id].ew >= 0 {
        iw = arena.nodes[id].ew
    }
    if arena.nodes[id].eh >= 0 {
        ih = arena.nodes[id].eh
    }
    arena.nodes[id].iw = arena.clamp_w(id, iw)
    arena.nodes[id].ih = arena.clamp_h(id, ih)
}

fn layout_flex_row(id: int) {
    let nk = arena.nodes[id].kids.len
    if nk <= 0 {
        return
    }
    let mut nflow = 0
    for i in 0..nk {
        if arena.skip_flow(arena.nodes[id].kids[i]) == 0 {
            nflow = nflow + 1
        }
    }
    if nflow <= 0 {
        return
    }
    arena.sz_fit(nk)
    let iw = arena.inner_w(id)
    let ih = arena.inner_h(id)
    let gx = arena.gap_x(id)
    let mut fixed = gx * geometry.max2(nflow - 1, 0)
    for i in 0..nk {
        let c = arena.nodes[id].kids[i]
        arena.szbuf[i] = 0
        if arena.skip_flow(c) == 0 {
            let avail = iw - arena.nodes[c].m_l - arena.nodes[c].m_r
            arena.szbuf[i] = geometry.fit_avail(arena.sized_w(c, iw, 1), avail)
            fixed = fixed + arena.szbuf[i] + arena.nodes[c].m_l + arena.nodes[c].m_r
        }
    }
    let mut extra = iw - fixed
    if extra < 0 {
        layout_flex_row_wrap(id)
        return
    }
    extra = flex_grow_shrink(id, extra, 1)
    for i in 0..nk {
        arena.nodes[arena.nodes[id].kids[i]].aw = arena.szbuf[i]
    }
    let mut ox = 0
    let mut between = 0
    if extra > 0 {
        if nflow > 0 {
            let mode = arena.nodes[id].justify
            if mode == 1 {
                ox = extra / 2
            } else if mode == 2 {
                ox = extra
            } else if mode == 3 {
                if nflow > 1 {
                    between = extra / (nflow - 1)
                }
            } else if mode == 4 {
                between = extra / nflow
                ox = between / 2
            } else if mode == 5 {
                between = extra / (nflow + 1)
                ox = between
            }
        }
    }
    let x0 = arena.content_x(id)
    let y0 = arena.content_y(id)
    let mut cx = x0 + ox
    for j in 0..nk {
        let mut i = j
        if arena.nodes[id].reverse != 0 {
            i = nk - 1 - j
        }
        let c = arena.nodes[id].kids[i]
        if arena.skip_flow(c) == 0 {
            let al = arena.child_align(id, c)
            let aw = arena.nodes[c].aw
            let mut ch = arena.sized_h(c, ih, aw)
            if stretch_cross(id, c, 1) != 0 {
                ch = geometry.max2(ih - arena.nodes[c].m_t - arena.nodes[c].m_b, 0)
            }
            let cy = geometry.cross_origin(al, y0, ih, ch + arena.nodes[c].m_t + arena.nodes[c].m_b) + arena.nodes[c].m_t
            layout_node(c, cx + arena.nodes[c].m_l, cy, aw, ch)
            cx = cx + arena.nodes[c].w + arena.nodes[c].m_l + arena.nodes[c].m_r + gx + between
        }
    }
    grow_to_children(id)
}

fn is_flex_row(id: int) -> int {
    if arena.nodes[id].dir != 0 {
        return 0
    }
    if arena.nodes[id].kind == 1 {
        return 1
    }
    if arena.nodes[id].kind == 9 {
        return 1
    }
    return 0
}

/// Height a row needs when children wrap at `outer_w` (includes padding).
fn wrap_row_h(id: int, outer_w: int) -> int {
    let nk = arena.nodes[id].kids.len
    let iw = geometry.max2(outer_w - arena.box_pad_x(id), 0)
    let gx = arena.gap_x(id)
    let gy = arena.gap_y(id)
    let mut x = 0
    let mut line_h = 0
    let mut total = 0
    let mut first = 1
    let mut nline = 0
    for i in 0..nk {
        let c = arena.nodes[id].kids[i]
        if arena.skip_flow(c) == 0 {
            let avail = iw - arena.nodes[c].m_l - arena.nodes[c].m_r
            let cw = geometry.fit_avail(arena.sized_w(c, iw, 1), avail)
            let ch = arena.sized_h(c, line_h, cw)
            let span = cw + arena.nodes[c].m_l + arena.nodes[c].m_r
            if first == 0 {
                if x + span > iw {
                    total = total + line_h
                    nline = nline + 1
                    x = 0
                    line_h = 0
                }
            }
            first = 0
            let mh = ch + arena.nodes[c].m_t + arena.nodes[c].m_b
            if mh > line_h {
                line_h = mh
            }
            x = x + span + gx
        }
    }
    if first == 0 {
        total = total + line_h
        nline = nline + 1
    }
    if nline > 1 {
        total = total + gy * (nline - 1)
    }
    total = total + arena.box_pad_y(id)
    if arena.nodes[id].eh >= 0 {
        if total < arena.nodes[id].eh {
            total = arena.nodes[id].eh
        }
    }
    return arena.clamp_h(id, total)
}

fn wrap_mark_line(id: int, lo: int, hi: int, line_h: int) {
    for j in lo..hi {
        let c = arena.nodes[id].kids[j]
        if arena.skip_flow(c) == 0 {
            arena.nodes[c].ah = line_h
        }
    }
}

fn layout_flex_row_wrap(id: int) {
    let nk = arena.nodes[id].kids.len
    let iw = arena.inner_w(id)
    let ih = arena.inner_h(id)
    let gx = arena.gap_x(id)
    let gy = arena.gap_y(id)
    let x0 = arena.content_x(id)
    let y0 = arena.content_y(id)
    arena.sz_fit(nk)
    let mut x = 0
    let mut line_h = 0
    let mut line_start = 0
    let mut first = 1
    for i in 0..nk {
        let c = arena.nodes[id].kids[i]
        if arena.skip_flow(c) == 0 {
            let avail = iw - arena.nodes[c].m_l - arena.nodes[c].m_r
            let mut cw = geometry.fit_avail(arena.sized_w(c, iw, 1), avail)
            let mut ch = arena.sized_h(c, ih, cw)
            let span = cw + arena.nodes[c].m_l + arena.nodes[c].m_r
            if first == 0 {
                if x + span > iw {
                    wrap_mark_line(id, line_start, i, line_h)
                    x = 0
                    line_h = 0
                    line_start = i
                }
            }
            first = 0
            arena.nodes[c].aw = cw
            let mh = ch + arena.nodes[c].m_t + arena.nodes[c].m_b
            if mh > line_h {
                line_h = mh
            }
            x = x + span + gx
        }
    }
    wrap_mark_line(id, line_start, nk, line_h)
    x = 0
    let mut y = 0
    line_start = 0
    first = 1
    for i in 0..nk {
        let c = arena.nodes[id].kids[i]
        if arena.skip_flow(c) == 0 {
            let cw = arena.nodes[c].aw
            let span = cw + arena.nodes[c].m_l + arena.nodes[c].m_r
            if first == 0 {
                if x + span > iw {
                    y = y + arena.nodes[arena.nodes[id].kids[line_start]].ah + gy
                    x = 0
                    line_start = i
                }
            }
            first = 0
            let lh = arena.nodes[c].ah
            let mut ch = arena.sized_h(c, ih, cw)
            let al = arena.child_align(id, c)
            if stretch_cross(id, c, 1) != 0 {
                ch = geometry.max2(lh - arena.nodes[c].m_t - arena.nodes[c].m_b, 0)
            }
            let cy = geometry.cross_origin(al, y0 + y, lh, ch + arena.nodes[c].m_t + arena.nodes[c].m_b) + arena.nodes[c].m_t
            layout_node(c, x0 + x + arena.nodes[c].m_l, cy, cw, ch)
            x = x + span + gx
        }
    }
    grow_to_children(id)
}

fn layout_flex_col(id: int) {
    let nk = arena.nodes[id].kids.len
    if nk <= 0 {
        return
    }
    let mut nflow = 0
    for i in 0..nk {
        if arena.skip_flow(arena.nodes[id].kids[i]) == 0 {
            nflow = nflow + 1
        }
    }
    if nflow <= 0 {
        return
    }
    arena.sz_fit(nk)
    let iw = arena.inner_w(id)
    let ih = arena.inner_h(id)
    let gy = arena.gap_y(id)
    let mut fixed = gy * geometry.max2(nflow - 1, 0)
    for i in 0..nk {
        let c = arena.nodes[id].kids[i]
        arena.szbuf[i] = 0
        if arena.skip_flow(c) == 0 {
            let avail = iw - arena.nodes[c].m_l - arena.nodes[c].m_r
            let mut cw = arena.sized_w(c, iw, 0)
            if arena.scrolls_x(id) != 0 {
                if arena.nodes[c].iw > cw {
                    cw = arena.clamp_w(c, arena.nodes[c].iw)
                }
            } else {
                if stretch_cross(id, c, 0) != 0 {
                    cw = arena.clamp_w(c, avail)
                }
                cw = geometry.fit_avail(cw, avail)
            }
            let mut ch = arena.sized_h(c, ih, cw)
            if is_flex_row(c) != 0 {
                let wh = wrap_row_h(c, cw)
                if wh > ch {
                    ch = wh
                }
            }
            arena.szbuf[i] = ch
            fixed = fixed + arena.szbuf[i] + arena.nodes[c].m_t + arena.nodes[c].m_b
        }
    }
    let mut extra = ih - fixed
    if arena.nodes[id].kind == 11 {
        if extra < 0 {
            extra = 0
        }
    }
    extra = flex_grow_shrink(id, extra, 0)
    for i in 0..nk {
        arena.nodes[arena.nodes[id].kids[i]].ah = arena.szbuf[i]
    }
    let mut oy = 0
    let mut between = 0
    if extra > 0 {
        if nflow > 0 {
            let mode = arena.nodes[id].justify
            if mode == 1 {
                oy = extra / 2
            } else if mode == 2 {
                oy = extra
            } else if mode == 3 {
                if nflow > 1 {
                    between = extra / (nflow - 1)
                }
            } else if mode == 4 {
                between = extra / nflow
                oy = between / 2
            } else if mode == 5 {
                between = extra / (nflow + 1)
                oy = between
            }
        }
    }
    let x0 = arena.content_x(id)
    let y0 = arena.content_y(id)
    let mut cy = y0 + oy
    for j in 0..nk {
        let mut i = j
        if arena.nodes[id].reverse != 0 {
            i = nk - 1 - j
        }
        let c = arena.nodes[id].kids[i]
        if arena.skip_flow(c) == 0 {
            let al = arena.child_align(id, c)
            let avail = iw - arena.nodes[c].m_l - arena.nodes[c].m_r
            let mut cw = arena.sized_w(c, iw, 0)
            if arena.scrolls_x(id) != 0 {
                if arena.nodes[c].iw > cw {
                    cw = arena.clamp_w(c, arena.nodes[c].iw)
                }
            } else {
                if stretch_cross(id, c, 0) != 0 {
                    cw = arena.clamp_w(c, avail)
                }
                cw = geometry.fit_avail(cw, avail)
            }
            let cx = geometry.cross_origin(al, x0, iw, cw + arena.nodes[c].m_l + arena.nodes[c].m_r) + arena.nodes[c].m_l
            layout_node(c, cx, cy + arena.nodes[c].m_t, cw, arena.nodes[c].ah)
            cy = cy + arena.nodes[c].h + arena.nodes[c].m_t + arena.nodes[c].m_b + gy + between
        }
    }
    if nflow > 0 {
        let content = cy - gy - between - arena.nodes[id].y + arena.nodes[id].pad_b + arena.nodes[id].border_w
        if arena.nodes[id].kind == 11 {
            arena.nodes[id].ih = geometry.max2(content, arena.nodes[id].h)
            if arena.scrolls_x(id) != 0 {
                let mut content_w = arena.nodes[id].w
                for i in 0..nk {
                    let c = arena.nodes[id].kids[i]
                    if arena.skip_flow(c) == 0 {
                        let right = arena.nodes[c].x + arena.nodes[c].w + arena.nodes[c].m_r - arena.nodes[id].x + arena.nodes[id].pad_r + arena.nodes[id].border_w
                        if right > content_w {
                            content_w = right
                        }
                    }
                }
                arena.nodes[id].iw = geometry.max2(content_w, arena.nodes[id].w)
            } else {
                arena.nodes[id].iw = arena.nodes[id].w
                arena.nodes[id].scroll_x = 0
            }
            arena.clamp_scroll(id)
        } else if content > arena.nodes[id].h {
            arena.nodes[id].h = content
        }
    }
}

fn layout_grid(id: int) {
    let nk = arena.nodes[id].kids.len
    let iw = arena.inner_w(id)
    let ih = arena.inner_h(id)
    let gx = arena.gap_x(id)
    let gy = arena.gap_y(id)
    let mut cols = arena.nodes[id].grid_cols
    if arena.nodes[id].grid_auto != 0 {
        let cell = arena.nodes[id].grid_min + gx
        cols = 1
        if cell > 0 {
            cols = (iw + gx) / cell
        }
        if cols < 1 {
            cols = 1
        }
        if nk > 0 {
            if cols > nk {
                cols = nk
            }
        }
    } else if cols < 1 {
        cols = 1
    }
    let mut cw = iw
    if cols > 0 {
        cw = (iw - gx * (cols - 1)) / cols
    }
    if cw < 0 {
        cw = 0
    }
    let x0 = arena.content_x(id)
    let y0 = arena.content_y(id)
    let mut col = 0
    let mut y = y0
    let mut rh = 0
    let mut placed = 0
    for i in 0..nk {
        let c = arena.nodes[id].kids[i]
        if arena.skip_flow(c) == 0 {
            let mut sp = arena.nodes[c].span
            if sp < 1 {
                sp = 1
            }
            if sp > cols {
                sp = cols
            }
            if col + sp > cols {
                y = y + rh + gy
                rh = 0
                col = 0
            }
            let cx = x0 + col * (cw + gx)
            let cww = cw * sp + gx * (sp - 1)
            let ch = arena.sized_h(c, ih, cww)
            layout_node(c, cx, y, cww, ch)
            rh = geometry.max2(rh, arena.nodes[c].h)
            col = col + sp
            placed = 1
        }
    }
    if placed != 0 {
        let content = y + rh - arena.nodes[id].y + arena.nodes[id].pad_b + arena.nodes[id].border_w
        if content > arena.nodes[id].h {
            arena.nodes[id].h = content
        }
    }
}

fn layout_abs(p: int) {
    let nk = arena.nodes[p].kids.len
    let iw = arena.inner_w(p)
    let ih = arena.inner_h(p)
    let ox = arena.content_x(p)
    let oy = arena.content_y(p)
    for i in 0..nk {
        let c = arena.nodes[p].kids[i]
        if c > 0 {
            if arena.want_show(c) != 0 {
                if arena.nodes[c].pos == 1 {
                    if arena.nodes[c].kind != 9 {
                        let mut w = arena.sized_w(c, iw, 0)
                        let mut h = arena.sized_h(c, ih, w)
                        let mut x = ox
                        let mut y = oy
                        if arena.nodes[c].pin_l >= 0 {
                            x = ox + arena.nodes[c].pin_l
                        }
                        if arena.nodes[c].pin_t >= 0 {
                            y = oy + arena.nodes[c].pin_t
                        }
                        if arena.nodes[c].pin_l >= 0 {
                            if arena.nodes[c].pin_r >= 0 {
                                w = arena.clamp_w(c, iw - arena.nodes[c].pin_l - arena.nodes[c].pin_r)
                            }
                        }
                        if arena.nodes[c].pin_t >= 0 {
                            if arena.nodes[c].pin_b >= 0 {
                                h = arena.clamp_h(c, ih - arena.nodes[c].pin_t - arena.nodes[c].pin_b)
                            }
                        }
                        if arena.nodes[c].pin_r >= 0 {
                            if arena.nodes[c].pin_l < 0 {
                                x = ox + iw - w - arena.nodes[c].pin_r
                            }
                        }
                        if arena.nodes[c].pin_b >= 0 {
                            if arena.nodes[c].pin_t < 0 {
                                y = oy + ih - h - arena.nodes[c].pin_b
                            }
                        }
                        layout_node(c, x, y, w, h)
                    }
                }
            }
        }
    }
}

fn layout_overlays(id: int) {
    if id <= 0 {
        return
    }
    if arena.want_show(id) == 0 {
        return
    }
    let nk = arena.nodes[id].kids.len
    for i in 0..nk {
        let c = arena.nodes[id].kids[i]
        if arena.want_show(c) != 0 {
            if arena.nodes[c].kind == 9 {
                layout_node(c, 0, 0, arena.win_w, arena.win_h)
            }
            layout_overlays(c)
        }
    }
}

fn layout_node(id: int, x: int, y: int, w: int, h: int) {
    if id <= 0 {
        return
    }
    arena.nodes[id].x = x
    arena.nodes[id].y = y
    arena.nodes[id].w = arena.clamp_w(id, w)
    arena.nodes[id].h = arena.clamp_h(id, h)
    apply_label_wrap(id)
    let k = arena.nodes[id].kind
    if k == 1 {
        if arena.nodes[id].dir == 0 {
            layout_flex_row(id)
        } else {
            layout_flex_col(id)
        }
    } else if k == 9 {
        if arena.nodes[id].dir == 0 {
            layout_flex_row(id)
        } else {
            layout_flex_col(id)
        }
    } else if k == 11 {
        layout_flex_col(id)
    } else if k == 2 {
        layout_grid(id)
    }
    layout_abs(id)
}

fn layout(width: int, height: int) {
    arena.ensure()
    if width > 0 {
        arena.win_w = width
    }
    if height > 0 {
        arena.win_h = height
    }
    arena.safe_t = platform.plat_inset_top()
    arena.safe_r = platform.plat_inset_right()
    arena.safe_b = platform.plat_inset_bottom()
    arena.safe_l = platform.plat_inset_left()
    if arena.root_id <= 0 {
        return
    }
    measure_node(arena.root_id)
    layout_node(arena.root_id, 0, 0, arena.win_w, arena.win_h)
    layout_overlays(arena.root_id)
}

