//! input — hit-test, click, scroll, drag, hover (GPUI input.rs / window events).
//!
//! Scroll: wheel `dx`/`dy` go to the innermost scroller that actually overflows
//! on that axis (table H vs page V). Thumb drag: `drag_bar` 1 = vertical,
//! 2 = horizontal. Hit tests add `scroll_x`/`scroll_y` when walking into a pane.

import "arena.yuga"
import "geometry.yuga"
import "platform.yuga"

struct Click {
    sid: int,
    mode: int,
    setv: int,
}

fn hit_floaters(id: int, px: int, py: int) -> int {
    if id <= 0 {
        return 0
    }
    if arena.want_show(id) == 0 {
        return 0
    }
    let mut hy = py
    let mut hx = px
    if arena.nodes[id].kind == 11 {
        if arena.in_box(id, px, py) == 0 {
            return 0
        }
        hy = py + arena.nodes[id].scroll_y
        hx = px + arena.nodes[id].scroll_x
    }
    let nk = arena.nodes[id].kids.len
    for j in 0..nk {
        let c = arena.nodes[id].kids[nk - 1 - j]
        let mut h = 0
        if arena.nodes[c].kind == 9 {
            h = hit_floaters(c, arena.ptr_x, arena.ptr_y)
        }
        if arena.nodes[c].kind != 9 {
            h = hit_floaters(c, hx, hy)
        }
        if h != 0 {
            return h
        }
    }
    if arena.is_floater(id) != 0 {
        if arena.nodes[id].kind == 9 {
            return hit_node(id, arena.ptr_x, arena.ptr_y)
        }
        return hit_node(id, px, hy)
    }
    return 0
}

fn hit_scrollbar(id: int, px: int, py: int) -> int {
    if platform.plat_overlay_scroll() != 0 {
        return 0
    }
    if arena.bar_visible(id) == 0 {
        return 0
    }
    let tx = arena.bar_x(id, arena.nodes[id].x)
    let tw = arena.bar_w()
    let ty = arena.bar_thumb_y(id, arena.nodes[id].y)
    let th = arena.bar_thumb_h(id)
    if px < tx {
        return 0
    }
    if px >= tx + tw {
        return 0
    }
    if py < ty {
        return 0
    }
    if py >= ty + th {
        return 0
    }
    return 1
}

fn hit_h_scrollbar(id: int, px: int, py: int) -> int {
    if platform.plat_overlay_scroll() != 0 {
        return 0
    }
    if arena.bar_visible_x(id) == 0 {
        return 0
    }
    let tx = arena.bar_thumb_x(id, arena.nodes[id].x)
    let tw = arena.bar_thumb_w(id)
    let ty = arena.bar_hy(id, arena.nodes[id].y)
    let th = arena.bar_w()
    if px < tx {
        return 0
    }
    if px >= tx + tw {
        return 0
    }
    if py < ty {
        return 0
    }
    if py >= ty + th {
        return 0
    }
    return 1
}

fn hit_node(id: int, px: int, py: int) -> int {
    if id <= 0 {
        return 0
    }
    if arena.want_show(id) == 0 {
        return 0
    }
    if arena.nodes[id].kind == 11 {
        if arena.in_box(id, px, py) == 0 {
            return 0
        }
        if hit_h_scrollbar(id, px, py) != 0 {
            return id
        }
        if hit_scrollbar(id, px, py) != 0 {
            return id
        }
    }
    let mut cx = px
    let mut cy = py
    if arena.nodes[id].kind == 11 {
        cx = px + arena.nodes[id].scroll_x
        cy = py + arena.nodes[id].scroll_y
    }
    let nk = arena.nodes[id].kids.len
    for j in 0..nk {
        let c = arena.nodes[id].kids[nk - 1 - j]
        let mut hx = cx
        let mut hy = cy
        if arena.nodes[c].kind == 9 {
            hx = arena.ptr_x
            hy = arena.ptr_y
        }
        let h = hit_node(c, hx, hy)
        if h != 0 {
            return h
        }
    }
    if arena.in_box(id, px, py) == 0 {
        return 0
    }
    if arena.nodes[id].click_sig > 0 {
        return id
    }
    if arena.nodes[id].click_fn > 0 {
        return id
    }
    // A node carrying only a pointer handler is hit-testable; children are
    // tried first, so this doubles as event bubbling.
    if arena.nodes[id].down_fn > 0 {
        return id
    }
    if arena.nodes[id].up_fn > 0 {
        return id
    }
    if arena.nodes[id].kind == 4 {
        return id
    }
    if arena.nodes[id].kind == 13 {
        if arena.nodes[id].bind_sig > 0 {
            return id
        }
    }
    if arena.nodes[id].kind == 7 {
        if arena.nodes[id].click_sig > 0 {
            return id
        }
    }
    if arena.nodes[id].kind == 8 {
        if arena.nodes[id].click_sig > 0 {
            return id
        }
    }
    if arena.nodes[id].kind == 11 {
        return id
    }
    if arena.nodes[id].kind == 10 {
        return id
    }
    if arena.nodes[id].focusable != 0 {
        return id
    }
    return 0
}

fn click(px: int, py: int) -> int {
    arena.ensure()
    arena.ptr_x = px
    arena.ptr_y = py
    arena.drag_id = 0
    arena.drag_bar = 0
    if arena.root_id <= 0 {
        return 0
    }
    let mut id = hit_floaters(arena.root_id, px, py)
    if id <= 0 {
        id = hit_node(arena.root_id, px, py)
    }
    if id <= 0 {
        return 0
    }
    arena.claim_focus(id)
    if arena.nodes[id].kind == 10 {
        let slot = arena.edit_ready(id)
        if slot >= 0 {
            let relx = px - arena.nodes[id].x - arena.nodes[id].pad_l - arena.nodes[id].border_w
            let rely = py - arena.nodes[id].y - arena.nodes[id].pad_t - arena.nodes[id].border_w
            let mut font = arena.nodes[id].font
            if font < 8 {
                font = 14
            }
            platform.plat_edit_click(slot, relx, rely, arena.input_inner_w(id), font)
        }
    }
    if arena.nodes[id].kind == 11 {
        if hit_h_scrollbar(id, px, py) != 0 {
            // Grab the thumb where it is: the drag moves it from its current
            // scroll, so the content never jumps under the pointer.
            arena.bar_on(id)
            arena.drag_id = id
            arena.drag_bar = 2
            arena.drag_ay = px
            arena.drag_as = arena.nodes[id].scroll_x
            return 1
        }
        if hit_scrollbar(id, px, py) != 0 {
            // Grab the thumb where it is: the drag moves it from its current
            // scroll, so the content never jumps under the pointer.
            let maxs = arena.scroll_max(id)
            arena.bar_on(id)
            arena.drag_id = id
            arena.drag_bar = 1
            arena.drag_ay = py
            arena.drag_as = arena.nodes[id].scroll_y
            return 1
        }
    }
    if arena.nodes[id].kind == 13 {
        if arena.nodes[id].bind_sig > 0 {
            let kd = 14
            let travel = geometry.max2(arena.nodes[id].w - kd, 1)
            let mut rel = px - arena.nodes[id].x - kd / 2
            if rel < 0 {
                rel = 0
            }
            if rel > travel {
                rel = travel
            }
            let v = (rel * 100 + travel / 2) / travel
            let sid = arena.nodes[id].bind_sig
            arena.store_sig(sid, v)
            arena.drag_id = id
            return 1
        }
    }
    let c1 = Click { sid: arena.nodes[id].click_sig, mode: arena.nodes[id].click_mode, setv: arena.nodes[id].click_set }
    apply_click(c1)
    let c2 = Click { sid: arena.nodes[id].click2_sig, mode: arena.nodes[id].click2_mode, setv: arena.nodes[id].click2_set }
    apply_click(c2)
    if arena.nodes[id].click_fn > 0 {
        platform.plat_invoke_fn(arena.nodes[id].click_fn)
    }
    arena.ev_x = px
    arena.ev_y = py
    arena.ev_button = 0
    arena.down_id = id
    if arena.nodes[id].down_fn > 0 {
        platform.plat_invoke_fn(arena.nodes[id].down_fn)
    }
    return 1
}

fn apply_click(c: Click) {
    if c.sid <= 0 {
        return
    }
    if c.sid >= arena.sigs.len {
        return
    }
    let mut next = arena.sigs[c.sid]
    if c.mode == 0 {
        next = next + 1
    } else if c.mode == 1 {
        if next == 0 {
            next = 1
        } else {
            next = 0
        }
    } else if c.mode == 2 {
        next = c.setv
    } else {
        next = next + c.setv
    }
    arena.store_sig(c.sid, next)
}

fn find_scroll_axis(id: int, px: int, py: int, horiz: int) -> int {
    if id <= 0 {
        return 0
    }
    if arena.want_show(id) == 0 {
        return 0
    }
    if arena.in_box(id, px, py) == 0 {
        return 0
    }
    let mut cy = py
    let mut cx = px
    if arena.nodes[id].kind == 11 {
        cy = py + arena.nodes[id].scroll_y
        cx = px + arena.nodes[id].scroll_x
    }
    let nk = arena.nodes[id].kids.len
    for j in 0..nk {
        let c = arena.nodes[id].kids[nk - 1 - j]
        let mut hy = cy
        let mut hx = cx
        if arena.nodes[c].kind == 9 {
            hy = py
            hx = px
        }
        let s = find_scroll_axis(c, hx, hy, horiz)
        if s != 0 {
            return s
        }
    }
    if arena.nodes[id].kind != 11 {
        return 0
    }
    if horiz != 0 {
        if arena.scrolls_x(id) == 0 {
            return 0
        }
        if arena.scroll_max_x(id) > 0 {
            return id
        }
        return 0
    }
    if arena.scroll_max(id) > 0 {
        return id
    }
    return 0
}

/// Pan / precise-wheel scroll with momentum: the delta is applied now and
/// becomes the velocity the physics coast decays from (touch, trackpads).
fn scroll(px: int, py: int, dx: int, dy: int) -> int {
    arena.ensure()
    if arena.root_id <= 0 {
        return 0
    }
    if dx == 0 {
        if dy == 0 {
            return 0
        }
    }
    let mut changed = 0
    if dy != 0 {
        let s = find_scroll_axis(arena.root_id, px, py, 0)
        if s > 0 {
            if arena.apply_delta_y(s, dy, 1) != 0 {
                changed = 1
            }
            arena.bar_on(s)
        }
    }
    if dx != 0 {
        let s = find_scroll_axis(arena.root_id, px, py, 1)
        if s > 0 {
            if arena.apply_delta_x(s, dx, 1) != 0 {
                changed = 1
            }
            arena.bar_on(s)
        }
    }
    return changed
}

/// Discrete wheel click (mouse notches, web line/page wheels): the delta is
/// applied exactly and no velocity is stored, so the scroller never coasts
/// past where the user clicked.
fn scroll_step(px: int, py: int, dx: int, dy: int) -> int {
    arena.ensure()
    if arena.root_id <= 0 {
        return 0
    }
    if dx == 0 {
        if dy == 0 {
            return 0
        }
    }
    let mut changed = 0
    if dy != 0 {
        let s = find_scroll_axis(arena.root_id, px, py, 0)
        if s > 0 {
            if arena.apply_delta_y(s, dy, 0) != 0 {
                changed = 1
            }
            arena.bar_on(s)
        }
    }
    if dx != 0 {
        let s = find_scroll_axis(arena.root_id, px, py, 1)
        if s > 0 {
            if arena.apply_delta_x(s, dx, 0) != 0 {
                changed = 1
            }
            arena.bar_on(s)
        }
    }
    return changed
}

fn drag(px: int, py: int) -> int {
    arena.ensure()
    if arena.drag_id <= 0 {
        return 0
    }
    if arena.drag_id >= arena.nodes.len {
        arena.drag_id = 0
        arena.drag_bar = 0
        return 0
    }
    let kind = arena.nodes[arena.drag_id].kind
    if kind == 13 {
        let kd = 14
        let travel = geometry.max2(arena.nodes[arena.drag_id].w - kd, 1)
        let mut rel = px - arena.nodes[arena.drag_id].x - kd / 2
        if rel < 0 {
            rel = 0
        }
        if rel > travel {
            rel = travel
        }
        let v = (rel * 100 + travel / 2) / travel
        let sid = arena.nodes[arena.drag_id].bind_sig
        arena.store_sig(sid, v)
        return 1
    }
    if kind != 11 {
        // The dragged node was recycled into another kind by a tree rebuild
        // (shape changed mid-drag): cancel the drag.
        arena.drag_id = 0
        arena.drag_bar = 0
        return 0
    }
    if arena.drag_bar == 2 {
        let maxs = arena.scroll_max_x(arena.drag_id)
        let tw = arena.bar_track_w(arena.drag_id)
        let thw = arena.bar_thumb_w(arena.drag_id)
        let range = geometry.max2(tw - thw, 1)
        let mut nx = arena.drag_as + (px - arena.drag_ay) * maxs / range
        if nx < 0 {
            nx = 0
        }
        if nx > maxs {
            nx = maxs
        }
        arena.nodes[arena.drag_id].scroll_x = nx
        arena.bar_on(arena.drag_id)
        return 1
    }
    let maxs = arena.scroll_max(arena.drag_id)
    let th = arena.bar_track_h(arena.drag_id)
    let thh = arena.bar_thumb_h(arena.drag_id)
    let range = geometry.max2(th - thh, 1)
    let mut ny = arena.drag_as + (py - arena.drag_ay) * maxs / range
    if ny < 0 {
        ny = 0
    }
    if ny > maxs {
        ny = maxs
    }
    arena.nodes[arena.drag_id].scroll_y = ny
    arena.bar_on(arena.drag_id)
    return 1
}

fn mouseup() {
    arena.drag_id = 0
    arena.drag_bar = 0
    let id = arena.down_id
    arena.down_id = 0
    if id <= 0 {
        return
    }
    if id >= arena.nodes.len {
        return
    }
    if arena.nodes[id].up_fn > 0 {
        arena.ev_button = 0
        platform.plat_invoke_fn(arena.nodes[id].up_fn)
    }
}

/// Deliver a key to the focused node's `on_key_down` / `on_key_press`
/// handlers. Returns 1 if a handler ran, so the host repaints.
fn key_handlers(k: int, mods: int, up: int) -> int {
    let id = arena.focus_id
    if id <= 0 {
        return 0
    }
    if id >= arena.nodes.len {
        return 0
    }
    arena.ev_key = k
    arena.ev_mods = mods
    let mut ran = 0
    if up != 0 {
        if arena.nodes[id].kup_fn > 0 {
            platform.plat_invoke_fn(arena.nodes[id].kup_fn)
            ran = 1
        }
        if arena.nodes[id].kpress_fn > 0 {
            platform.plat_invoke_fn(arena.nodes[id].kpress_fn)
            ran = 1
        }
        return ran
    }
    if arena.nodes[id].kdown_fn > 0 {
        platform.plat_invoke_fn(arena.nodes[id].kdown_fn)
        ran = 1
    }
    return ran
}

fn hover_walk(id: int, px: int, py: int, sid: int) -> int {
    if id <= 0 {
        return 0
    }
    if arena.want_show(id) == 0 {
        return 0
    }
    if arena.nodes[id].kind == 11 {
        if arena.in_box(id, px, py) == 0 {
            return 0
        }
    }
    let mut cy = py
    let mut cx = px
    if arena.nodes[id].kind == 11 {
        cy = py + arena.nodes[id].scroll_y
        cx = px + arena.nodes[id].scroll_x
    }
    let nk = arena.nodes[id].kids.len
    for i in 0..nk {
        let c = arena.nodes[id].kids[i]
        let mut hy = cy
        let mut hx = cx
        if arena.nodes[c].kind == 9 {
            hy = arena.ptr_y
            hx = arena.ptr_x
        }
        if hover_walk(c, hx, hy, sid) != 0 {
            return 1
        }
    }
    if arena.nodes[id].hover_sig == sid {
        if arena.in_box(id, px, py) != 0 {
            return 1
        }
    }
    return 0
}

fn hover(px: int, py: int) -> int {
    arena.ensure()
    arena.ptr_x = px
    arena.ptr_y = py
    if arena.root_id <= 0 {
        return 0
    }
    let mut dirty = 0
    let n = arena.nodes.len
    for i in 1..n {
        let sid = arena.nodes[i].hover_sig
        if sid > 0 {
            let mut first = 1
            for j in 1..i {
                if arena.nodes[j].hover_sig == sid {
                    first = 0
                }
            }
            if first != 0 {
                let over = hover_walk(arena.root_id, px, py, sid)
                if arena.sig_val(sid) != over {
                    arena.store_sig(sid, over)
                    dirty = 1
                }
            }
        }
        if arena.is_hot(i) != 0 {
            let over = arena.ptr_in(i)
            let a = arena.nodes[i].hover_amt
            if over != 0 {
                if a < 100 {
                    dirty = 1
                }
            }
            if over == 0 {
                if a > 0 {
                    dirty = 1
                }
            }
        }
    }
    return dirty
}

/// Pointer affordance: the host shows a hand cursor while the pointer is
/// inside an interactive node. This is decoupled from the hover wash
/// (`is_hot`, which `Box.hover_off` now silences by default): clickable
/// boxes and native thumbs claim the hand, while full-surface click
/// swallows (dialogs, picker panels) keep the arrow.
fn over_button() -> int {
    let n = arena.nodes.len
    for i in 1..n {
        if arena.want_show(i) == 0 {
            continue
        }
        if arena.ptr_in(i) == 0 {
            continue
        }
        let k = arena.nodes[i].kind
        if k == 9 {
            continue
        }
        if k == 11 {
            continue
        }
        // Native thumbs: buttons, progress/toggle/check/slider.
        if k == 4 || k == 7 || k == 8 || k == 13 {
            return 1
        }
        // Explicit hover opt-in (Boxes with hover_off = false still wash).
        if arena.nodes[i].hover_fade > 0 {
            return 1
        }
        // Click swallows that cover a whole surface act like the page,
        // not a control — no hand cursor over a dialog body.
        if arena.nodes[i].a11y_role == "dialog" {
            continue
        }
        if arena.nodes[i].click_sig > 0 || arena.nodes[i].click_fn > 0 {
            return 1
        }
    }
    return 0
}

/// CSS cursor name for the node under the pointer. Nodes with an explicit
/// cursor ("" = default) win; later-created nodes outrank earlier ones, so
/// children override parents. Returns "" when nothing claims a cursor.
fn cursor_at() -> string {
    let n = arena.nodes.len
    for i in 1..n {
        let id = n - i
        if arena.want_show(id) == 0 {
            continue
        }
        if arena.ptr_in(id) == 0 {
            continue
        }
        let k = arena.nodes[id].kind
        if k == 9 {
            continue
        }
        if k == 11 {
            continue
        }
        if arena.nodes[id].cursor.len > 0 {
            return arena.nodes[id].cursor
        }
    }
    return ""
}

fn key(k: int) -> int {
    let handled = key_handlers(k, arena.ev_mods, 0)
    if k == 27 {
        let mut changed = 0
        if arena.focus_id != 0 {
            arena.focus_id = 0
            changed = 1
        }
        let n = arena.nodes.len
        for i in 1..n {
            if arena.nodes[i].kind == 9 {
                let sid = arena.nodes[i].show_sig
                if sid > 0 {
                    if arena.want_show(i) != 0 {
                        arena.store_sig(sid, 0)
                        changed = 1
                    }
                }
            }
        }
        return changed
    }
    if arena.focus_captures_text() == 0 {
        return handled
    }
    let id = arena.focus_id
    if id <= 0 {
        return 0
    }
    if arena.nodes[id].kind != 10 {
        return 0
    }
    let slot = arena.edit_ready(id)
    if slot < 0 {
        return handled
    }
    let extend = arena.ev_mods % 2
    let mut edited = 0
    if k == 8 {
        edited = platform.plat_edit_back(slot)
    } else if k == 127 {
        edited = platform.plat_edit_del(slot)
    } else if k == 9 {
        edited = platform.plat_edit_append(slot, 9)
    } else if k == 10 {
        if arena.nodes[id].wrap != 0 {
            edited = platform.plat_edit_append(slot, 10)
        }
    } else if k == 13 {
        if arena.nodes[id].wrap != 0 {
            edited = platform.plat_edit_append(slot, 10)
        }
    } else if k == 1000 {
        edited = platform.plat_edit_move(slot, -1, extend)
    } else if k == 1001 {
        edited = platform.plat_edit_move(slot, 1, extend)
    } else if k == 1002 {
        edited = platform.plat_edit_move(slot, -3, extend)
    } else if k == 1003 {
        edited = platform.plat_edit_move(slot, 3, extend)
    } else if k == 1006 {
        edited = platform.plat_edit_move(slot, -2, extend)
    } else if k == 1007 {
        edited = platform.plat_edit_move(slot, 2, extend)
    } else if k >= 32 {
        if k < 127 {
            edited = platform.plat_edit_append(slot, k)
        }
    }
    if edited != 0 {
        /* `Input(bind = sig)` writes the edit buffer back on each edit; the
           signal store notifies only on a real change. Nav keys do not write. */
        let mut write = 1
        if k >= 1000 {
            if k <= 1007 {
                write = 0
            }
        }
        if write != 0 {
            if arena.nodes[id].bind_fn > 0 {
                platform.plat_invoke_fn(arena.nodes[id].bind_fn)
            }
        }
        return 1
    }
    return handled
}

fn insert_text(s: string) -> int {
    arena.ensure()
    if arena.focus_captures_text() == 0 {
        return 0
    }
    let id = arena.focus_id
    let slot = arena.edit_ready(id)
    if slot < 0 {
        return 0
    }
    if platform.plat_edit_insert(slot, s) == 0 {
        return 0
    }
    if arena.nodes[id].bind_fn > 0 {
        platform.plat_invoke_fn(arena.nodes[id].bind_fn)
    }
    return 1
}

fn mark_text(s: string) -> int {
    arena.ensure()
    if arena.focus_captures_text() == 0 {
        return 0
    }
    let id = arena.focus_id
    let slot = arena.edit_ready(id)
    if slot < 0 {
        return 0
    }
    return platform.plat_edit_mark(slot, s)
}
