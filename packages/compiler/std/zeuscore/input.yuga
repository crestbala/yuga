//! input — hit-test, click, scroll, drag, hover (GPUI input.rs / window events).
//!
//! Scroll: wheel `dx`/`dy` go to the innermost scroller that actually overflows
//! on that axis (table H vs page V). Thumb drag: `drag_bar` 1 = vertical,
//! 2 = horizontal. Hit tests add `scroll_x`/`scroll_y` when walking into a pane.

import "arena.yuga"
import "geometry.yuga"
import "platform.yuga"

struct Click {
    sid: int,
    mode: int,
    setv: int,
}

fn hit_floaters(id: int, px: int, py: int) -> int {
    if id <= 0 {
        return 0
    }
    if arena.want_show(id) == 0 {
        return 0
    }
    let mut hy = py
    let mut hx = px
    if arena.nodes[id].kind == 11 {
        if arena.in_box(id, px, py) == 0 {
            return 0
        }
        hy = py + arena.nodes[id].scroll_y
        hx = px + arena.nodes[id].scroll_x
    }
    let nk = arena.nodes[id].kids.len
    for j in 0..nk {
        let c = arena.nodes[id].kids[nk - 1 - j]
        let mut h = 0
        if arena.nodes[c].kind == 9 {
            h = hit_floaters(c, px, py)
        }
        if arena.nodes[c].kind != 9 {
            h = hit_floaters(c, hx, hy)
        }
        if h != 0 {
            return h
        }
    }
    if arena.is_floater(id) != 0 {
        if arena.nodes[id].kind == 9 {
            return hit_node(id, px, py)
        }
        return hit_node(id, px, hy)
    }
    return 0
}

fn hit_scrollbar(id: int, px: int, py: int) -> int {
    if platform.plat_overlay_scroll() != 0 {
        return 0
    }
    if arena.bar_visible(id) == 0 {
        return 0
    }
    let tx = arena.bar_x(id, arena.nodes[id].x)
    let tw = arena.bar_w()
    let ty = arena.bar_thumb_y(id, arena.nodes[id].y)
    let th = arena.bar_thumb_h(id)
    if px < tx {
        return 0
    }
    if px >= tx + tw {
        return 0
    }
    if py < ty {
        return 0
    }
    if py >= ty + th {
        return 0
    }
    return 1
}

fn hit_h_scrollbar(id: int, px: int, py: int) -> int {
    if platform.plat_overlay_scroll() != 0 {
        return 0
    }
    if arena.bar_visible_x(id) == 0 {
        return 0
    }
    let tx = arena.bar_thumb_x(id, arena.nodes[id].x)
    let tw = arena.bar_thumb_w(id)
    let ty = arena.bar_hy(id, arena.nodes[id].y)
    let th = arena.bar_w()
    if px < tx {
        return 0
    }
    if px >= tx + tw {
        return 0
    }
    if py < ty {
        return 0
    }
    if py >= ty + th {
        return 0
    }
    return 1
}

fn hit_node(id: int, px: int, py: int) -> int {
    if id <= 0 {
        return 0
    }
    if arena.want_show(id) == 0 {
        return 0
    }
    if arena.nodes[id].kind == 11 {
        if arena.in_box(id, px, py) == 0 {
            return 0
        }
        if hit_h_scrollbar(id, px, py) != 0 {
            return id
        }
        if hit_scrollbar(id, px, py) != 0 {
            return id
        }
    }
    let mut cx = px
    let mut cy = py
    if arena.nodes[id].kind == 11 {
        cx = px + arena.nodes[id].scroll_x
        cy = py + arena.nodes[id].scroll_y
    }
    let nk = arena.nodes[id].kids.len
    for j in 0..nk {
        let c = arena.nodes[id].kids[nk - 1 - j]
        let mut hx = cx
        let mut hy = cy
        if arena.nodes[c].kind == 9 {
            hx = px
            hy = py
        }
        let h = hit_node(c, hx, hy)
        if h != 0 {
            return h
        }
    }
    if arena.in_box(id, px, py) == 0 {
        return 0
    }
    if arena.nodes[id].click_sig > 0 {
        return id
    }
    if arena.nodes[id].click_fn > 0 {
        return id
    }
    if arena.nodes[id].kind == 4 {
        return id
    }
    if arena.nodes[id].kind == 13 {
        if arena.nodes[id].bind_sig > 0 {
            return id
        }
    }
    if arena.nodes[id].kind == 7 {
        if arena.nodes[id].click_sig > 0 {
            return id
        }
    }
    if arena.nodes[id].kind == 8 {
        if arena.nodes[id].click_sig > 0 {
            return id
        }
    }
    if arena.nodes[id].kind == 11 {
        return id
    }
    if arena.nodes[id].kind == 10 {
        return id
    }
    if arena.nodes[id].focusable != 0 {
        return id
    }
    return 0
}

fn click(px: int, py: int) -> int {
    arena.ensure()
    arena.drag_id = 0
    arena.drag_bar = 0
    if arena.root_id <= 0 {
        return 0
    }
    let mut id = hit_floaters(arena.root_id, px, py)
    if id <= 0 {
        id = hit_node(arena.root_id, px, py)
    }
    if id <= 0 {
        return 0
    }
    arena.claim_focus(id)
    if arena.nodes[id].kind == 11 {
        if hit_h_scrollbar(id, px, py) != 0 {
            let maxs = arena.scroll_max_x(id)
            let tx = arena.bar_hx(id, arena.nodes[id].x)
            let tw = arena.bar_track_w(id)
            let thw = arena.bar_thumb_w(id)
            let range = geometry.max2(tw - thw, 1)
            let mut nx = (px - tx) * maxs / range
            if nx < 0 {
                nx = 0
            }
            if nx > maxs {
                nx = maxs
            }
            arena.nodes[id].scroll_x = nx
            arena.bar_on(id)
            arena.drag_id = id
            arena.drag_bar = 2
            arena.drag_ay = px
            arena.drag_as = nx
            return 1
        }
        if hit_scrollbar(id, px, py) != 0 {
            let maxs = arena.scroll_max(id)
            let ty = arena.bar_y(id, arena.nodes[id].y)
            let th = arena.bar_track_h(id)
            let thh = arena.bar_thumb_h(id)
            let range = geometry.max2(th - thh, 1)
            let mut ny = (py - ty) * maxs / range
            if ny < 0 {
                ny = 0
            }
            if ny > maxs {
                ny = maxs
            }
            arena.nodes[id].scroll_y = ny
            arena.bar_on(id)
            arena.drag_id = id
            arena.drag_bar = 1
            arena.drag_ay = py
            arena.drag_as = ny
            return 1
        }
    }
    if arena.nodes[id].kind == 13 {
        if arena.nodes[id].bind_sig > 0 {
            let kd = 14
            let travel = geometry.max2(arena.nodes[id].w - kd, 1)
            let mut rel = px - arena.nodes[id].x - kd / 2
            if rel < 0 {
                rel = 0
            }
            if rel > travel {
                rel = travel
            }
            let v = (rel * 100 + travel / 2) / travel
            let sid = arena.nodes[id].bind_sig
            arena.store_sig(sid, v)
            arena.drag_id = id
            return 1
        }
    }
    let c1 = Click { sid: arena.nodes[id].click_sig, mode: arena.nodes[id].click_mode, setv: arena.nodes[id].click_set }
    apply_click(c1)
    let c2 = Click { sid: arena.nodes[id].click2_sig, mode: arena.nodes[id].click2_mode, setv: arena.nodes[id].click2_set }
    apply_click(c2)
    if arena.nodes[id].click_fn > 0 {
        platform.plat_invoke_fn(arena.nodes[id].click_fn)
    }
    return 1
}

fn apply_click(c: Click) {
    if c.sid <= 0 {
        return
    }
    if c.sid >= arena.sigs.len {
        return
    }
    let mut next = arena.sigs[c.sid]
    if c.mode == 0 {
        next = next + 1
    } else if c.mode == 1 {
        if next == 0 {
            next = 1
        } else {
            next = 0
        }
    } else if c.mode == 2 {
        next = c.setv
    } else {
        next = next + c.setv
    }
    arena.store_sig(c.sid, next)
}

fn find_scroll_axis(id: int, px: int, py: int, horiz: int) -> int {
    if id <= 0 {
        return 0
    }
    if arena.want_show(id) == 0 {
        return 0
    }
    if arena.in_box(id, px, py) == 0 {
        return 0
    }
    let mut cy = py
    let mut cx = px
    if arena.nodes[id].kind == 11 {
        cy = py + arena.nodes[id].scroll_y
        cx = px + arena.nodes[id].scroll_x
    }
    let nk = arena.nodes[id].kids.len
    for j in 0..nk {
        let c = arena.nodes[id].kids[nk - 1 - j]
        let mut hy = cy
        let mut hx = cx
        if arena.nodes[c].kind == 9 {
            hy = py
            hx = px
        }
        let s = find_scroll_axis(c, hx, hy, horiz)
        if s != 0 {
            return s
        }
    }
    if arena.nodes[id].kind != 11 {
        return 0
    }
    if horiz != 0 {
        if arena.scrolls_x(id) == 0 {
            return 0
        }
        if arena.scroll_max_x(id) > 0 {
            return id
        }
        return 0
    }
    if arena.scroll_max(id) > 0 {
        return id
    }
    return 0
}

fn scroll(px: int, py: int, dx: int, dy: int) -> int {
    arena.ensure()
    if arena.root_id <= 0 {
        return 0
    }
    if dx == 0 {
        if dy == 0 {
            return 0
        }
    }
    let mut changed = 0
    if dy != 0 {
        let s = find_scroll_axis(arena.root_id, px, py, 0)
        if s > 0 {
            let maxs = arena.scroll_max(s)
            let mut ny = arena.nodes[s].scroll_y + dy
            if ny < 0 {
                ny = 0
            }
            if ny > maxs {
                ny = maxs
            }
            if ny != arena.nodes[s].scroll_y {
                arena.nodes[s].scroll_y = ny
                changed = 1
            }
            arena.bar_on(s)
        }
    }
    if dx != 0 {
        let s = find_scroll_axis(arena.root_id, px, py, 1)
        if s > 0 {
            let maxs = arena.scroll_max_x(s)
            let mut nx = arena.nodes[s].scroll_x + dx
            if nx < 0 {
                nx = 0
            }
            if nx > maxs {
                nx = maxs
            }
            if nx != arena.nodes[s].scroll_x {
                arena.nodes[s].scroll_x = nx
                changed = 1
            }
            arena.bar_on(s)
        }
    }
    return changed
}

fn drag(px: int, py: int) -> int {
    arena.ensure()
    if arena.drag_id <= 0 {
        return 0
    }
    if arena.drag_id >= arena.nodes.len {
        return 0
    }
    if arena.nodes[arena.drag_id].kind == 13 {
        let kd = 14
        let travel = geometry.max2(arena.nodes[arena.drag_id].w - kd, 1)
        let mut rel = px - arena.nodes[arena.drag_id].x - kd / 2
        if rel < 0 {
            rel = 0
        }
        if rel > travel {
            rel = travel
        }
        let v = (rel * 100 + travel / 2) / travel
        let sid = arena.nodes[arena.drag_id].bind_sig
        arena.store_sig(sid, v)
        return 1
    }
    if arena.nodes[arena.drag_id].kind == 11 {
        if arena.drag_bar == 2 {
            let maxs = arena.scroll_max_x(arena.drag_id)
            let tw = arena.bar_track_w(arena.drag_id)
            let thw = arena.bar_thumb_w(arena.drag_id)
            let range = geometry.max2(tw - thw, 1)
            let mut nx = arena.drag_as + (px - arena.drag_ay) * maxs / range
            if nx < 0 {
                nx = 0
            }
            if nx > maxs {
                nx = maxs
            }
            arena.nodes[arena.drag_id].scroll_x = nx
            arena.bar_on(arena.drag_id)
            return 1
        }
        let maxs = arena.scroll_max(arena.drag_id)
        let th = arena.bar_track_h(arena.drag_id)
        let thh = arena.bar_thumb_h(arena.drag_id)
        let range = geometry.max2(th - thh, 1)
        let mut ny = arena.drag_as + (py - arena.drag_ay) * maxs / range
        if ny < 0 {
            ny = 0
        }
        if ny > maxs {
            ny = maxs
        }
        arena.nodes[arena.drag_id].scroll_y = ny
        arena.bar_on(arena.drag_id)
        return 1
    }
    return 0
}

fn mouseup() {
    arena.drag_id = 0
    arena.drag_bar = 0
}

fn hover_walk(id: int, px: int, py: int, sid: int) -> int {
    if id <= 0 {
        return 0
    }
    if arena.want_show(id) == 0 {
        return 0
    }
    if arena.nodes[id].kind == 11 {
        if arena.in_box(id, px, py) == 0 {
            return 0
        }
    }
    let mut cy = py
    let mut cx = px
    if arena.nodes[id].kind == 11 {
        cy = py + arena.nodes[id].scroll_y
        cx = px + arena.nodes[id].scroll_x
    }
    let nk = arena.nodes[id].kids.len
    for i in 0..nk {
        let c = arena.nodes[id].kids[i]
        let mut hy = cy
        let mut hx = cx
        if arena.nodes[c].kind == 9 {
            hy = py
            hx = px
        }
        if hover_walk(c, hx, hy, sid) != 0 {
            return 1
        }
    }
    if arena.nodes[id].hover_sig == sid {
        if arena.in_box(id, px, py) != 0 {
            return 1
        }
    }
    return 0
}

fn hover(px: int, py: int) -> int {
    arena.ensure()
    arena.ptr_x = px
    arena.ptr_y = py
    if arena.root_id <= 0 {
        return 0
    }
    let mut dirty = 0
    let n = arena.nodes.len
    for i in 1..n {
        let sid = arena.nodes[i].hover_sig
        if sid > 0 {
            let mut first = 1
            for j in 1..i {
                if arena.nodes[j].hover_sig == sid {
                    first = 0
                }
            }
            if first != 0 {
                let over = hover_walk(arena.root_id, px, py, sid)
                if arena.sig_val(sid) != over {
                    arena.store_sig(sid, over)
                    dirty = 1
                }
            }
        }
        if arena.is_hot(i) != 0 {
            let over = arena.ptr_in(i)
            let a = arena.nodes[i].hover_amt
            if over != 0 {
                if a < 100 {
                    dirty = 1
                }
            }
            if over == 0 {
                if a > 0 {
                    dirty = 1
                }
            }
        }
    }
    return dirty
}

fn over_button() -> int {
    let n = arena.nodes.len
    for i in 1..n {
        if arena.is_hot(i) != 0 {
            if arena.ptr_in(i) != 0 {
                return 1
            }
        }
    }
    return 0
}

fn key(k: int) -> int {
    if k == 27 {
        let mut changed = 0
        if arena.focus_id != 0 {
            arena.focus_id = 0
            changed = 1
        }
        let n = arena.nodes.len
        for i in 1..n {
            if arena.nodes[i].kind == 9 {
                let sid = arena.nodes[i].show_sig
                if sid > 0 {
                    if arena.want_show(i) != 0 {
                        arena.store_sig(sid, 0)
                        changed = 1
                    }
                }
            }
        }
        return changed
    }
    if arena.focus_captures_text() == 0 {
        return 0
    }
    let id = arena.focus_id
    if id <= 0 {
        return 0
    }
    if arena.nodes[id].kind != 10 {
        return 0
    }
    if arena.nodes[id].edit_slot < 0 {
        arena.stamp_edits()
    }
    let slot = arena.nodes[id].edit_slot
    if slot < 0 {
        return 0
    }
    if k == 8 {
        return platform.plat_edit_back(slot)
    }
    if k == 127 {
        return platform.plat_edit_back(slot)
    }
    if k >= 32 {
        if k < 127 {
            return platform.plat_edit_append(slot, k)
        }
    }
    return 0
}
