//! WebSocket (RFC 6455) codec bits for `std:http`: base64, SHA-1, the
//! handshake accept key, and text-frame encode/decode. Pure Yuga over
//! bytes-in-strings — no C, no crypto library. Bit ops use the `wrapping_*`
//! builtins; 32-bit words live in ints masked to 32 bits.
//!
//! Client → server frames must be masked; server → client frames never are.
//! Frame reads are incremental: `take_frame` returns the first complete
//! frame and leaves the rest of the buffer for the next read.

fn eq(a: string, b: string) -> bool {
    let mut same = true
    if a.len != b.len {
        same = false
    }
    if a.len == b.len {
        for i in 0..a.len {
            if a[i] != b[i] {
                same = false
            }
        }
    }
    return same
}

fn bytes_of(s: string) -> []int {
    let mut out = []int {}
    for i in 0..s.len {
        out.push(s[i])
    }
    return out
}

fn string_of(b: []int) -> string {
    return string_from_bytes(b)
}

fn concat(a: string, b: string) -> string {
    let mut out = bytes_of(a)
    let nb = bytes_of(b)
    for i in 0..nb.len {
        out.push(nb[i])
    }
    return string_of(out)
}

fn slice_str(s: string, start: int, end: int) -> string {
    let mut b = []int {}
    let mut i = start
    if i < 0 {
        i = 0
    }
    let mut e = end
    if e > s.len {
        e = s.len
    }
    while i < e {
        b.push(s[i])
        i = i + 1
    }
    return string_of(b)
}

fn byte_at(s: string, i: int) -> int {
    if i < 0 {
        return 0
    }
    if i >= s.len {
        return 0
    }
    return s[i]
}

// --- base64 ---------------------------------------------------------------

const B64_ALPHA: string = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"

/// Base64 (RFC 4648, with padding) of `s`.
fn b64e(s: string) -> string {
    let mut out = []int {}
    let n = s.len
    let mut i = 0
    while i < n {
        let b0 = byte_at(s, i)
        let b1 = byte_at(s, i + 1)
        let b2 = byte_at(s, i + 2)
        out.push(B64_ALPHA[b0 / 4])
        out.push(B64_ALPHA[(b0 % 4) * 16 + b1 / 16])
        if i + 1 < n {
            out.push(B64_ALPHA[(b1 % 16) * 4 + b2 / 64])
        } else {
            out.push(61)
        }
        if i + 2 < n {
            out.push(B64_ALPHA[b2 % 64])
        } else {
            out.push(61)
        }
        i = i + 3
    }
    return string_of(out)
}

// --- SHA-1 (RFC 3174) -----------------------------------------------------

const MASK32: int = 4294967295
const H0: int = 1732584193
const H1: int = 4023233417
const H2: int = 2562383102
const H3: int = 271733878
const H4: int = 3285377520
const K0: int = 1518500249
const K1: int = 1859775393
const K2: int = 2400959708
const K3: int = 3395469782

fn rotl32(x: int, n: int) -> int {
    let v = wrapping_and(x, MASK32)
    return wrapping_and(wrapping_or(wrapping_shl(v, n), wrapping_shr(v, 32 - n)), MASK32)
}

fn xor32(a: int, b: int) -> int {
    return wrapping_or(a, b) - wrapping_and(a, b)
}

/// SHA-1 digest of `msg`, returned as 20 raw bytes.
fn sha1(msg: string) -> string {
    let mut m = bytes_of(msg)
    let bitlen = msg.len * 8
    m.push(128)
    while m.len % 64 != 56 {
        m.push(0)
    }
    for k in 0..8 {
        let shift = (7 - k) * 8
        m.push(wrapping_shr(bitlen, shift) % 256)
    }
    let mut h0 = H0
    let mut h1 = H1
    let mut h2 = H2
    let mut h3 = H3
    let mut h4 = H4
    let mut off = 0
    while off < m.len {
        let mut w = []int {}
        for i2 in 0..16 {
            let mut word = m[off + i2 * 4] * 16777216
            word += m[off + i2 * 4 + 1] * 65536
            word += m[off + i2 * 4 + 2] * 256
            word += m[off + i2 * 4 + 3]
            w.push(wrapping_and(word, MASK32))
        }
        for t in 16..80 {
            let x = xor32(xor32(xor32(w[t - 3], w[t - 8]), w[t - 14]), w[t - 16])
            w.push(rotl32(x, 1))
        }
        let mut a = h0
        let mut b = h1
        let mut c = h2
        let mut d = h3
        let mut e = h4
        for t in 0..80 {
            let mut f = 0
            let mut k = K0
            if t < 20 {
                f = wrapping_or(wrapping_and(b, c), wrapping_and(MASK32 - b, d))
            }
            if t >= 20 {
                if t < 40 {
                    f = xor32(xor32(b, c), d)
                    k = K1
                }
            }
            if t >= 40 {
                if t < 60 {
                    f = wrapping_or(wrapping_or(wrapping_and(b, c), wrapping_and(b, d)),
                                    wrapping_and(c, d))
                    k = K2
                }
            }
            if t >= 60 {
                f = xor32(xor32(b, c), d)
                k = K3
            }
            let temp = wrapping_and(rotl32(a, 5) + wrapping_and(f, MASK32) + e + k + w[t], MASK32)
            e = d
            d = c
            c = rotl32(b, 30)
            b = a
            a = temp
        }
        h0 = wrapping_and(h0 + a, MASK32)
        h1 = wrapping_and(h1 + b, MASK32)
        h2 = wrapping_and(h2 + c, MASK32)
        h3 = wrapping_and(h3 + d, MASK32)
        h4 = wrapping_and(h4 + e, MASK32)
        off = off + 64
    }
    let mut out = []int {}
    let mut hs = []int {}
    hs.push(h0)
    hs.push(h1)
    hs.push(h2)
    hs.push(h3)
    hs.push(h4)
    for i3 in 0..5 {
        let hv = hs[i3]
        out.push(wrapping_shr(hv, 24) % 256)
        out.push(wrapping_shr(hv, 16) % 256)
        out.push(wrapping_shr(hv, 8) % 256)
        out.push(hv % 256)
    }
    return string_of(out)
}

// --- handshake ------------------------------------------------------------

const WS_GUID: string = "258EAFA5-E914-47DA-95CA-C5AB0DC85B11"

/// `Sec-WebSocket-Accept` for a client `Sec-WebSocket-Key`.
fn accept_key(key: string) -> string {
    return b64e(sha1(concat(key, WS_GUID)))
}

/// 16 pseudo-random bytes for `Sec-WebSocket-Key`, seeded from the clock.
fn client_key(seed: int) -> string {
    let mut x = wrapping_and(seed, MASK32)
    let mut out = []int {}
    for i in 0..16 {
        x = wrapping_and(x * 1103515245 + 12345, MASK32)
        out.push(wrapping_shr(x, 16) % 256)
    }
    return string_of(out)
}

/// Header block value lookup: find `\r\nName: value` (case-insensitive) in a
/// raw HTTP/1.1 head. Empty when missing. `name` must be lowercase.
fn header_val(head: string, name: string) -> string {
    let nl = head.len
    let nn = name.len
    let mut at = -1
    let mut pos = 0
    while pos < nl {
        if head[pos] == 10 {
            let mut p = pos + 1
            if p + nn < nl {
                let mut ok = 1
                for j in 0..nn {
                    let mut ch = head[p + j]
                    if ch >= 65 {
                        if ch <= 90 {
                            ch = ch + 32
                        }
                    }
                    if ch != name[j] {
                        ok = 0
                    }
                }
                if ok == 1 {
                    if head[p + nn] == 58 {
                        at = p + nn + 1
                    }
                }
            }
        }
        pos = pos + 1
    }
    if at < 0 {
        return ""
    }
    if at >= nl {
        return ""
    }
    let mut end = at
    while end < nl {
        if head[end] == 13 {
            break
        }
        if head[end] == 10 {
            break
        }
        end = end + 1
    }
    let mut v = slice_str(head, at, end)
    while v.len > 0 {
        if v[0] == 32 {
            v = slice_str(v, 1, v.len)
        } else {
            break
        }
    }
    return v
}

// --- frames ---------------------------------------------------------------

/// Server → client text frame (never masked).
fn server_text(s: string) -> string {
    return frame_bytes(1, 0, s, 0)
}

/// Client → server masked text frame.
fn client_text(s: string, seed: int) -> string {
    return frame_bytes(1, 1, s, seed)
}

/// One outgoing frame. `masked` = client→server (RFC 6455 §5.3). Supports
/// payloads up to 65535 bytes (16-bit length).
fn frame_bytes(op: int, masked: int, s: string, seed: int) -> string {
    let mut out = []int {}
    out.push(128 + op)
    let n = s.len
    if n < 126 {
        if masked != 0 {
            out.push(128 + n)
        } else {
            out.push(n)
        }
    } else {
        if masked != 0 {
            out.push(254)
        } else {
            out.push(126)
        }
        out.push(n / 256)
        out.push(n % 256)
    }
    let mut mask = []int { 0, 0, 0, 0 }
    if masked != 0 {
        let mut x = wrapping_and(xor32(n * 2654435761 + 40503, seed), MASK32)
        for i in 0..4 {
            x = wrapping_and(x * 1103515245 + 12345, MASK32)
            mask[i] = wrapping_shr(x, 16) % 256
            out.push(mask[i])
        }
    }
    for i in 0..n {
        let b = s[i]
        if masked != 0 {
            out.push(xor32(b, mask[i % 4]))
        } else {
            out.push(b)
        }
    }
    return string_of(out)
}

/// One decoded frame: `ok` 1 = complete, 0 = need more bytes, -1 = bad.
/// `op`: 1 text, 8 close, 9 ping. `text` is the payload; `rest` is the
/// buffer after this frame.
struct Frame {
    ok: int,
    op: int,
    text: string,
    rest: string,
}

fn take_frame(buf: string) -> Frame {
    if buf.len < 2 {
        return Frame { ok: 0, op: 0, text: "", rest: buf }
    }
    let b0 = buf[0]
    let b1 = buf[1]
    let op = b0 % 16
    let masked = b1 / 128
    let mut len7 = b1 % 128
    let mut head = 2
    if len7 == 126 {
        if buf.len < 4 {
            return Frame { ok: 0, op: 0, text: "", rest: buf }
        }
        len7 = buf[2] * 256 + buf[3]
        head = 4
    }
    if len7 == 127 {
        if buf.len < 10 {
            return Frame { ok: 0, op: 0, text: "", rest: buf }
        }
        let mut hi = 0
        for i in 2..10 {
            hi = hi * 256 + buf[i]
            if hi > 1048576 {
                return Frame { ok: -1, op: 0, text: "", rest: buf }
            }
        }
        len7 = hi
        head = 10
    }
    if len7 > 1048576 {
        return Frame { ok: -1, op: 0, text: "", rest: buf }
    }
    let mut mask = []int { 0, 0, 0, 0 }
    if masked != 0 {
        if buf.len < head + 4 {
            return Frame { ok: 0, op: 0, text: "", rest: buf }
        }
        for i in 0..4 {
            mask[i] = buf[head + i]
        }
        head = head + 4
    }
    if buf.len < head + len7 {
        return Frame { ok: 0, op: 0, text: "", rest: buf }
    }
    let mut pl = []int {}
    for i in 0..len7 {
        let mut b = buf[head + i]
        if masked != 0 {
            b = xor32(b, mask[i % 4])
        }
        pl.push(b)
    }
    let rest = slice_str(buf, head + len7, buf.len)
    return Frame { ok: 1, op: op, text: string_of(pl), rest: rest }
}
