}

struct GridProps {
    config: GridConfig = GridConfig {},
    columns: int = -1,
    gap: int = -1,
    padding: int = -1,
}

struct InputProps {
    placeholder: string = "",
    width: fn() -> int = style_int_default,
    width__set: bool = false,
    grow: fn() -> int = style_int_default,
    grow__set: bool = false,
    font: fn() -> int = style_int_default,
    font__set: bool = false,
    background: fn() -> string = style_str_default,
    background__set: bool = false,
    color: fn() -> string = style_str_default,
    color__set: bool = false,
    padding: fn() -> int = style_int_default,
    padding__set: bool = false,
    pad_x: fn() -> int = style_int_default,
    pad_x__set: bool = false,
    pad_y: fn() -> int = style_int_default,
    pad_y__set: bool = false,
    radius: fn() -> int = style_int_default,
    radius__set: bool = false,
    border: fn() -> int = style_int_default,
    border__set: bool = false,
    border_color: fn() -> string = style_str_default,
    border_color__set: bool = false,
