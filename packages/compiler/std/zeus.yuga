//! `zeus` — UI toolkit. Native Cocoa and WASM/Canvas2D run the same source.
//!
//! Widgets are `Box` / `Text` / `Button` / `Input` / `Grid` / `Overlay` /
//! `Scroll` / `Svg` / `If` / `Each` / `For` / `App`. Hierarchy is a trailing
//! block. Lists: `zeus.signal([]string {})` + `For` + `push_item`.
//!
//! Example:
//! ```
//! import "std:zeus"
//!
//! fn main() {
//!     let n = zeus.signal(0)
//!     zeus.App("Count", 320, 200, fn() {
//!         zeus.Box(align_direction = DIRECTION.Column, padding = 16, spacing = 8) {
//!             zeus.Text("Count", font = 22)
//!             zeus.Text("{{n.get()}}", font = 28)
//!             zeus.Box(align_direction = DIRECTION.Row, spacing = 8) {
//!                 zeus.Button("-", on_click = fn() => n.set(n.get() - 1))
//!                 zeus.Button("+", on_click = fn() => n.set(n.get() + 1))
//!             }
//!         }
//!     })
//! }
//! ```
//!
//! `zeus.App` builds the tree once (retained). Per-frame rebuild is
//! `zeus.view` / `zeus.app`. Internals: `std/zeuscore/*.yuga`. C is host FFI
//! (`platform.yuga`). `Node` is `{ id: int }`. See `docs/boundary.md`.
//! `ZEUS_HEADLESS=1` layouts once and exits.

import "zeuscore/geometry.yuga"
import "zeuscore/platform.yuga"
import "zeuscore/arena.yuga"
import "zeuscore/layout.yuga"
import "zeuscore/scene.yuga"
import "zeuscore/input.yuga"
import "zeuscore/track.yuga"
import "std:async"
import "std:fmt"

/// A widget in the tree. Copy handle (`id`).
struct Node {
    /// Slot in the engine arena. Do not construct by hand; use `Box` / `Text`.
    id: int,
}

/// Opaque reactive cell. Copy handle (`id`). `T` must be Copy (`int`,
/// `string`, `float`, `bool`, `[]U` when `U` is Copy, or a Copy struct).
///
/// ```
/// let n = zeus.signal(0)
/// n.set(n.get() + 1)
/// ```
struct Signal<T> {
    id: int,
}

fn empty_view() -> Node {
    return Node { id: 0 }
}

let mut has_view: int = 0
let mut view_fn: fn() -> Node = empty_view
let mut hook_ids: []int = []int {}
let mut hook_at: int = 0

fn nd(id: int) -> Node {
    return Node { id: id }
}

fn sg(id: int) -> Signal<int> {
    return Signal { id: id }
}

fn raw_init() {
    arena.ensure()
}

fn open_window(title: string, width: int, height: int) {
    arena.ensure()
    arena.win_w = width
    arena.win_h = height
    platform.plat_set_window(title, width, height)
}

fn raw_run() {
    arena.ensure()
    if platform.plat_headless() != 0 {
        engine_layout(arena.win_w, arena.win_h)
        return
    }
    platform.plat_run()
}

fn init() {
    raw_init()
}

/// Open a native window. Sizes are CSS-like points, not pixels.
/// Prefer `zeus.App(...)` over calling this alone.
fn window(title: string, width: int, height: int) {
    init()
    open_window(title, width, height)
}

/// Host view size in points: browser canvas, or the native content view.
struct WindowSize {
    width: int,
    height: int,
}

fn window_size() -> WindowSize {
    return WindowSize {
        width: platform.plat_view_width(),
        height: platform.plat_view_height(),
    }
}

/// Enter the event loop with `node` as the tree root.
/// `ZEUS_HEADLESS=1` layouts once and exits (tests). Prefer `zeus.App`.
fn run(node: Node) {
    init()
    arena.root_id = node.id
    raw_run()
}

/// GPUI-style: each frame rebuilds the element tree from signals.
/// Omit this and the tree stays retained (kit apps).
fn view(build: fn() -> Node) {
    init()
    view_fn = build
    has_view = 1
}

/// Open a window, install `build` as the per-frame view, and run.
/// Rebuilds the tree every layout. Prefer `zeus.App` for a retained tree.
///
/// Example:
/// ```
/// zeus.app("Demo", 400, 300, || {
///     zeus.Text("frame")
/// })
/// ```
fn app(title: string, width: int, height: int, build: fn() -> Node) {
    window(title, width, height)
    view(build)
    init()
    raw_run()
}

// --- signals (live Copy state) ---

/// Allocate a live cell. `T` is inferred from `value`.
///
/// Example:
/// ```
/// let count = zeus.signal(0)
/// zeus.Button("+", on_click = fn() => count.set(count.get() + 1))
/// ```
/// Allocations made while a `For` / `refit` rebuild is running are owned by
/// that host (the C alloc hook records them) and are freed when the host
/// rebuilds or is torn down, so builders that create state do not grow the
/// signal arena.
fn signal<T>(value: T) -> Signal<T> {
    arena.ensure()
    Signal { id: __sig_push(value) }
}

/// Read the current value of `sig`. Inside a `.styled` closure this records
/// `sig` as a dependency of that closure. Call as `sig.get()`.
fn get<T>(sig: Signal<T>) -> T {
    arena.ensure()
    track.note_read(sig.id)
    __sig_load(sig.id)
}
/// Write `value` into `sig`. Re-runs every `.styled` closure that last read it.
/// Call as `sig.set(value)`.
fn set<T>(sig: Signal<T>, value: T) {
    arena.ensure()
    __sig_store(sig.id, value)
}

fn hook_begin() {
    hook_at = 0
}

fn hook_signal(init: int) -> Signal<int> {
    arena.ensure()
    if hook_at >= hook_ids.len {
        push(arena.sigs, init)
        let sid = arena.sigs.len - 1
        platform.plat_sig_bind_int(sid, init)
        push(hook_ids, sid)
    }
    let sid = hook_ids[hook_at]
    hook_at = hook_at + 1
    return sg(sid)
}

// --- unstyled allocators ---
/// Kinds: 1 box/row/col, 2 grid, 3 label, 4 button, 5 spacer, 6 progress,
/// 7 toggle, 8 check, 9 overlay, 10 input, 11 scroll, 12 svg, 13 slider.

fn raw_row() -> Node {
    let id = arena.alloc_node(1)
    arena.nodes[id].dir = 0
    return nd(id)
}
fn raw_col() -> Node {
    let id = arena.alloc_node(1)
    arena.nodes[id].dir = 1
    return nd(id)
}
fn raw_box() -> Node {
    return nd(arena.alloc_node(1))
}
fn raw_label(text: string) -> Node {
    let id = arena.alloc_node(3)
    arena.nodes[id].text = text
    return nd(id)
}
fn raw_button(text: string) -> Node {
    let id = arena.alloc_node(4)
    arena.nodes[id].text = text
    return nd(id)
}
fn raw_spacer() -> Node {
    return nd(arena.alloc_node(5))
}
fn raw_progress() -> Node {
    return nd(arena.alloc_node(6))
}
fn raw_slider() -> Node {
    return nd(arena.alloc_node(13))
}
fn raw_toggle() -> Node {
    return nd(arena.alloc_node(7))
}
fn raw_check(markup: string) -> Node {
    let id = arena.alloc_node(8)
    arena.nodes[id].text = markup
    return nd(id)
}
fn raw_overlay() -> Node {
    let id = arena.alloc_node(9)
    arena.nodes[id].pos = 1
    arena.nodes[id].enter_fade = 1
    return nd(id)
}
fn raw_input(placeholder: string) -> Node {
    let id = arena.alloc_node(10)
    arena.nodes[id].text = placeholder
    arena.nodes[id].focusable = 1
    arena.nodes[id].capture_text = 1
    return nd(id)
}
fn raw_scroll() -> Node {
    let id = arena.alloc_node(11)
    arena.nodes[id].dir = 1
    arena.nodes[id].overflow = 2
    return nd(id)
}
fn raw_svg(markup: string) -> Node {
    let id = arena.alloc_node(12)
    arena.nodes[id].text = markup
    return nd(id)
}
fn raw_grid(columns: int, gap: int) -> Node {
    let id = arena.alloc_node(2)
    arena.nodes[id].grid_cols = columns
    arena.nodes[id].gap = gap
    return nd(id)
}
fn raw_hover(node: Node, sig: Signal<int>) -> Node {
    arena.nodes[node.id].hover_sig = sig.id
    return node
}

/// Text currently in an input (typed buffer, else placeholder).
fn input_value(node: Node) -> string {
    return arena.input_shown(node.id)
}

/// Replace the typed buffer for `node`. No-op if it is not an input.
fn set_input(node: Node, text: string) -> Node {
    let mut slot = arena.nodes[node.id].edit_slot
    if slot < 0 {
        arena.stamp_edits()
        slot = arena.nodes[node.id].edit_slot
    }
    if slot >= 0 {
        platform.plat_edit_set(slot, text)
    }
    return node
}

// --- tree ---

/// Intern a handler or thunk, and record it as owned by the open rebuild
/// scope if there is one. A `For`/`refit` rebuild interns fresh closures per
/// row; when the host is torn down the recorded ids are freed and recycled,
/// so streaming lists do not leak handler envs.
fn __intern(h: fn()) -> int {
    let id = platform.plat_intern_fn(h)
    arena.record_intern(id, arena.scope_node)
    return id
}

fn __intern_int(h: fn() -> int) -> int {
    let id = platform.plat_intern_int_fn(h)
    arena.record_intern(id, arena.scope_node)
    return id
}

fn __intern_bool(h: fn() -> bool) -> int {
    let id = platform.plat_intern_bool_fn(h)
    arena.record_intern(id, arena.scope_node)
    return id
}

fn __intern_str(h: fn() -> string) -> int {
    let id = platform.plat_intern_str_fn(h)
    arena.record_intern(id, arena.scope_node)
    return id
}

/// Attach `node` under `parent`. Used by `ui_emit` for trailing blocks.
fn child(parent: Node, node: Node) -> Node {
    arena.ensure()
    push(arena.nodes[parent.id].kids, node.id)
    arena.nodes[node.id].parent = parent.id
    return parent
}

/// Run `handler` now and again whenever a `Signal` it `get`s changes.
/// The closure only updates paint state on existing nodes — it must not
/// call `child` or rebuild the tree.
fn styled(node: Node, handler: fn()) -> Node {
    arena.ensure()
    let eid = track.alloc(__intern(handler), node.id)
    track.run(eid)
    return node
}

fn root(node: Node) -> Node {
    arena.ensure()
    arena.root_id = node.id
    return node
}

// --- style ---
/// Field writers used by `Box` / `apply_int`. Not app-facing.

fn grow(node: Node, weight: int) -> Node {
    arena.nodes[node.id].grow = weight
    return node
}
fn shrink(node: Node, weight: int) -> Node {
    arena.nodes[node.id].shrink = weight
    return node
}

fn pad(node: Node, all: int) -> Node {
    arena.nodes[node.id].pad = all
    arena.nodes[node.id].pad_t = all
    arena.nodes[node.id].pad_r = all
    arena.nodes[node.id].pad_b = all
    arena.nodes[node.id].pad_l = all
    return node
}
fn padX(node: Node, px: int) -> Node {
    arena.nodes[node.id].pad_l = px
    arena.nodes[node.id].pad_r = px
    return node
}
fn padY(node: Node, py: int) -> Node {
    arena.nodes[node.id].pad_t = py
    arena.nodes[node.id].pad_b = py
    return node
}
fn padTop(node: Node, px: int) -> Node {
    arena.nodes[node.id].pad_t = px
    return node
}
fn padRight(node: Node, px: int) -> Node {
    arena.nodes[node.id].pad_r = px
    return node
}
fn padBottom(node: Node, px: int) -> Node {
    arena.nodes[node.id].pad_b = px
    return node
}
fn padLeft(node: Node, px: int) -> Node {
    arena.nodes[node.id].pad_l = px
    return node
}
fn margin(node: Node, all: int) -> Node {
    arena.nodes[node.id].m_t = all
    arena.nodes[node.id].m_r = all
    arena.nodes[node.id].m_b = all
    arena.nodes[node.id].m_l = all
    return node
}
fn marginX(node: Node, px: int) -> Node {
    arena.nodes[node.id].m_l = px
    arena.nodes[node.id].m_r = px
    return node
}
fn marginY(node: Node, py: int) -> Node {
    arena.nodes[node.id].m_t = py
    arena.nodes[node.id].m_b = py
    return node
}
fn marginTop(node: Node, px: int) -> Node {
    arena.nodes[node.id].m_t = px
    return node
}
fn marginRight(node: Node, px: int) -> Node {
    arena.nodes[node.id].m_r = px
    return node
}
fn marginBottom(node: Node, px: int) -> Node {
    arena.nodes[node.id].m_b = px
    return node
}
fn marginLeft(node: Node, px: int) -> Node {
    arena.nodes[node.id].m_l = px
    return node
}
fn border(node: Node, width: int) -> Node {
    arena.nodes[node.id].border_w = width
    return node
}
fn border_color(node: Node, rgb: int) -> Node {
    arena.nodes[node.id].border_c = rgb
    return node
}

fn gap(node: Node, g: int) -> Node {
    arena.nodes[node.id].gap = g
    return node
}
fn gap_row(node: Node, g: int) -> Node {
    arena.nodes[node.id].gap_row = g
    return node
}
fn gap_col(node: Node, g: int) -> Node {
    arena.nodes[node.id].gap_col = g
    return node
}

/// Default node width is 100% of the parent. `.w(px)` pins a pixel width
/// and clears the percentage. `.w(-1)` restores the 100% default.
fn w(node: Node, px: int) -> Node {
    if px < 0 {
        arena.nodes[node.id].ew = -1
        arena.nodes[node.id].w_pct = 100
    } else {
        arena.nodes[node.id].ew = px
        arena.nodes[node.id].w_pct = -1
    }
    return node
}
fn h(node: Node, px: int) -> Node {
    arena.nodes[node.id].eh = px
    return node
}
/// `.w(px).h(px)` in one call. Named `size_px`, not `size`: kit widgets expose
/// `.size()` for the sm/md/lg token, and two chain methods sharing a name and
/// a `(Node, int)` shape resolve by import order — which is how `.size(ui.sm())`
/// once silently became a 0x0 box. The `_px` suffix also keeps the unit at the
/// call site, next to kit's token form.
fn size_px(node: Node, px: int) -> Node {
    return node.w(px).h(px)
}
fn width_pct(node: Node, pct: int) -> Node {
    arena.nodes[node.id].ew = -1
    arena.nodes[node.id].w_pct = pct
    return node
}
fn height_pct(node: Node, pct: int) -> Node {
    arena.nodes[node.id].h_pct = pct
    return node
}
fn min_w(node: Node, px: int) -> Node {
    arena.nodes[node.id].min_w = px
    return node
}
fn max_w(node: Node, px: int) -> Node {
    arena.nodes[node.id].max_w = px
    return node
}
fn min_h(node: Node, px: int) -> Node {
    arena.nodes[node.id].min_h = px
    return node
}
fn max_h(node: Node, px: int) -> Node {
    arena.nodes[node.id].max_h = px
    return node
}
fn aspect(node: Node, aw: int, ah: int) -> Node {
    arena.nodes[node.id].aspect_w = aw
    arena.nodes[node.id].aspect_h = ah
    return node
}

fn flex_row(node: Node) -> Node {
    if arena.nodes[node.id].kind != 2 {
        if arena.nodes[node.id].kind != 9 {
            if arena.nodes[node.id].kind != 11 {
                arena.nodes[node.id].kind = 1
            }
        }
    }
    arena.nodes[node.id].dir = 0
    arena.nodes[node.id].reverse = 0
    return node
}
fn flex_col(node: Node) -> Node {
    if arena.nodes[node.id].kind != 2 {
        if arena.nodes[node.id].kind != 9 {
            if arena.nodes[node.id].kind != 11 {
                arena.nodes[node.id].kind = 1
            }
        }
    }
    arena.nodes[node.id].dir = 1
    arena.nodes[node.id].reverse = 0
    return node
}
fn flex_row_reverse(node: Node) -> Node {
    arena.nodes[node.id].dir = 0
    arena.nodes[node.id].reverse = 1
    return node
}
fn flex_col_reverse(node: Node) -> Node {
    arena.nodes[node.id].dir = 1
    arena.nodes[node.id].reverse = 1
    return node
}
fn flex_wrap(node: Node) -> Node {
    arena.nodes[node.id].wrap = 1
    return node
}
fn align_self(node: Node, mode: int) -> Node {
    arena.nodes[node.id].align_self = mode
    return node
}
fn span(node: Node, columns: int) -> Node {
    arena.nodes[node.id].span = columns
    return node
}

fn justify(node: Node, mode: int) -> Node {
    arena.nodes[node.id].justify = mode
    return node
}
fn align(node: Node, mode: int) -> Node {
    arena.nodes[node.id].align = mode
    return node
}

fn position(node: Node, mode: int) -> Node {
    arena.nodes[node.id].pos = mode
    return node
}
fn top(node: Node, px: int) -> Node {
    arena.nodes[node.id].pin_t = px
    return node
}
fn right(node: Node, px: int) -> Node {
    arena.nodes[node.id].pin_r = px
    return node
}
fn bottom(node: Node, px: int) -> Node {
    arena.nodes[node.id].pin_b = px
    return node
}
fn left(node: Node, px: int) -> Node {
    arena.nodes[node.id].pin_l = px
    return node
}
fn z_index(node: Node, z: int) -> Node {
    arena.nodes[node.id].z_index = z
    return node
}

fn bg(node: Node, rgb: int) -> Node {
    arena.nodes[node.id].bg = rgb
    return node
}
fn fg(node: Node, rgb: int) -> Node {
    arena.nodes[node.id].fg = rgb
    return node
}
fn radius(node: Node, px: int) -> Node {
    arena.nodes[node.id].radius = px
    return node
}
fn opacity(node: Node, pct: int) -> Node {
    arena.nodes[node.id].opacity = pct
    return node
}
fn overflow(node: Node, mode: int) -> Node {
    arena.nodes[node.id].overflow = mode
    return node
}
fn font(node: Node, px: int) -> Node {
    arena.nodes[node.id].font = px
    return node
}

/// Rotate a text node `deg` clockwise on screen around its top-left corner
/// (0 = horizontal). Used for chart axis labels that must not collide.
fn text_rot(node: Node, deg: int) -> Node {
    arena.nodes[node.id].text_rot = deg
    return node
}

// --- reactivity ---
/// `show` / `show_eq` / `show_ne` / `show_ge` / `show_le` hide a node from
/// layout when the predicate is false.

fn bind(label: Node, sig: Signal<int>) -> Node {
    arena.nodes[label.id].bind_sig = sig.id
    return label
}

fn click() -> int {
    return 1
}

fn on(node: Node, event: int, handler: fn()) -> Node {
    if event == 1 {
        arena.nodes[node.id].click_fn = __intern(handler)
    }
    return node
}

/// Click handler. `n.on_click(h)` is `n.on(zeus.click(), h)`.
fn on_click(node: Node, handler: fn()) -> Node {
    return on(node, click(), handler)
}

fn show(node: Node, sig: Signal<int>) -> Node {
    arena.nodes[node.id].show_sig = sig.id
    arena.nodes[node.id].show_mode = 0
    return node
}
fn show_eq(node: Node, sig: Signal<int>, value: int) -> Node {
    arena.nodes[node.id].show_sig = sig.id
    arena.nodes[node.id].show_mode = 1
    arena.nodes[node.id].show_val = value
    return node
}
fn show_ne(node: Node, sig: Signal<int>, value: int) -> Node {
    arena.nodes[node.id].show_sig = sig.id
    arena.nodes[node.id].show_mode = 2
    arena.nodes[node.id].show_val = value
    return node
}
// --- keyboard ---
/// A chord on a focused node resolves to a named action; a handler on that
/// same node writes a signal. App remaps (`map_key` / `remap_key`) still use
/// the action name, so a shortcut can move without the component changing.
/// Context is the family of the first action (`button.press` → `button`).
///
/// mode: 0 inc, 1 toggle, 2 set, 3 add — the same codes on_click_* uses.

fn key_context(node: Node, name: string) -> Node {
    arena.nodes[node.id].key_ctx = platform.plat_key_intern(name)
    return node
}
fn focusable(node: Node) -> Node {
    arena.nodes[node.id].focusable = 1
    return node
}
fn capture_text(node: Node) -> Node {
    arena.nodes[node.id].capture_text = 1
    arena.nodes[node.id].focusable = 1
    return node
}
fn on_action(node: Node, action: string, sig: Signal<int>, mode: int, value: int) -> Node {}
fn on_action_global(action: string, sig: Signal<int>, mode: int, value: int) {}

/// Step `sig` by `delta`, clamped to lo..hi — arrow navigation over a range.
fn on_range(node: Node, action: string, sig: Signal<int>, delta: int, lo: int, hi: int) -> Node {}
fn map_key(spec: string, action: string, ctx: string) {}
fn remap_key(spec: string, action: string, ctx: string) {}

/// Chord → action on this node. The action family (`button.press` → `button`)
/// is the keymap context; `key_context` is only needed to override that name.
/// Implies `.focusable()` — a node with a key binding needs focus to receive
/// it, so components don't chain both.
fn key(node: Node, spec: string, action: string) -> Node {
    let mut ctx = arena.nodes[node.id].key_ctx
    if ctx == 0 {
        ctx = platform.plat_key_intern_action(action)
        arena.nodes[node.id].key_ctx = ctx
    }
    if ctx != 0 {
        platform.plat_map_key(spec, action, ctx)
    }
    arena.nodes[node.id].focusable = 1
    return node
}

fn on_key_set(node: Node, action: string, sig: Signal<int>, value: int) -> Node {
    return on_action(node, action, sig, 2, value)
}

fn on_key_add(node: Node, action: string, sig: Signal<int>, delta: int) -> Node {
    return on_action(node, action, sig, 3, delta)
}

fn on_key_toggle(node: Node, action: string, sig: Signal<int>) -> Node {
    return on_action(node, action, sig, 1, 0)
}

fn on_key_fn(node: Node, action: string) -> Node {
    return on_action(node, action, sg(0), 5, arena.nodes[node.id].click_fn)
}

fn global_key_set(action: string, sig: Signal<int>, value: int) {
    on_action_global(action, sig, 2, value)
}

fn show_ge(node: Node, sig: Signal<int>, value: int) -> Node {
    arena.nodes[node.id].show_sig = sig.id
    arena.nodes[node.id].show_mode = 3
    arena.nodes[node.id].show_val = value
    return node
}
fn show_le(node: Node, sig: Signal<int>, value: int) -> Node {
    arena.nodes[node.id].show_sig = sig.id
    arena.nodes[node.id].show_mode = 4
    arena.nodes[node.id].show_val = value
    return node
}

fn hover(node: Node, sig: Signal<int>) -> Node {
    return raw_hover(node, sig)
}

fn hover_delay(node: Node, ms: int) -> Node {
    return node
}
fn hover_leave(node: Node, ms: int) -> Node {
    return node
}

fn pulse(node: Node) -> Node {
    arena.nodes[node.id].pulse = 1
    return node
}

fn hover_fade(node: Node) -> Node {
    arena.nodes[node.id].hover_fade = 1
    return node
}

fn hover_off(node: Node) -> Node {
    arena.nodes[node.id].hover_fade = -1
    return node
}

fn enter_fade(node: Node) -> Node {
    arena.nodes[node.id].enter_fade = 1
    return node
}
fn dismiss(node: Node) -> Node {
    return node
}
fn keys(node: Node, sig: Signal<int>, lo: int, hi: int) -> Node {
    return node.key("right", "slider.inc").key("left", "slider.dec").focusable().on_range("slider.inc", sig, 1, lo, hi).on_range("slider.dec", sig, -1, lo, hi)
}
fn keys_page(node: Node, sig: Signal<int>) -> Node {
    return node.key("right", "page.next").key("left", "page.prev").focusable().on_key_add("page.next", sig, 1).on_key_add("page.prev", sig, -1)
}

// --- flex constants (public; implemented in geometry) ---

fn flex_start() -> int {
    return geometry.flex_start()
}
fn flex_center() -> int {
    return geometry.flex_center()
}
fn flex_end() -> int {
    return geometry.flex_end()
}
fn flex_between() -> int {
    return geometry.flex_between()
}
fn flex_around() -> int {
    return geometry.flex_around()
}
fn flex_evenly() -> int {
    return geometry.flex_evenly()
}
fn flex_stretch() -> int {
    return geometry.flex_stretch()
}
fn pos_relative() -> int {
    return geometry.pos_relative()
}
fn pos_absolute() -> int {
    return geometry.pos_absolute()
}
fn overflow_visible() -> int {
    return geometry.overflow_visible()
}
fn overflow_hidden() -> int {
    return geometry.overflow_hidden()
}
fn overflow_scroll() -> int {
    return geometry.overflow_scroll()
}
fn overflow_auto() -> int {
    return geometry.overflow_auto()
}
fn rgb(r: int, g: int, b: int) -> int {
    return geometry.rgb(r, g, b)
}

fn center(node: Node) -> Node {
    return node.justify(flex_center()).align(flex_center())
}

fn appearance() -> Signal<int> {
    arena.ensure()
    if arena.appearance_sid == 0 {
        let s = signal(0)
        arena.appearance_sid = s.id
    }
    return sg(arena.appearance_sid)
}

fn theme(slot: int, light: int, dark: int) {
    arena.ensure()
    if slot < 0 {
        return
    }
    arena.theme_grow(slot)
    if slot < arena.theme_l.len {
        arena.theme_l[slot] = light
        arena.theme_d[slot] = dark
    }
}

fn role(slot: int) -> int {
    if slot < 0 {
        return 0
    }
    return 2130706432 + slot
}

fn engine_key_apply(sid: int, mode: int, value: int, lo: int, hi: int) {
    arena.ensure()
    if mode == 5 {
        platform.plat_invoke_fn(value)
        return
    }
    if sid <= 0 {
        return
    }
    if sid >= arena.sigs.len {
        return
    }
    let mut next = arena.sigs[sid]
    if mode == 1 {
        if next == 0 {
            next = 1
        } else {
            next = 0
        }
    } else if mode == 2 {
        next = value
    } else if mode == 3 {
        next = next + value
    } else if mode == 4 {
        let mut vlo = lo
        let mut vhi = hi
        if vhi < vlo {
            let t = vlo
            vlo = vhi
            vhi = t
        }
        next = next + value
        if next < vlo {
            next = vlo
        }
        if next > vhi {
            next = vhi
        }
    } else {
        next = next + 1
    }
    arena.store_sig(sid, next)
}

fn refresh_lists() {
    let n = arena.nodes.len
    for i in 1..n {
        if arena.nodes[i].list_fn > 0 {
            platform.plat_invoke_fn(arena.nodes[i].list_fn)
        }
    }
}

fn engine_layout(width: int, height: int) {
    // One frame of the async world first: steppers advance in-flight socket
    // state machines, then spawns and due timers fire. Callbacks set signals;
    // the rebuild and layout below paint their effect this very frame. Hosts
    // call this per frame (mac drawRect, web rAF, headless pump).
    async.tick()
    if has_view != 0 {
        arena.snapshot_focus()
        arena.snapshot_scroll()
        arena.reset_tree()
        platform.plat_key_reset()
        track.reset()
        hook_begin()
        let n = view_fn()
        arena.root_id = n.id
        arena.restore_scroll()
        arena.restore_focus()
        arena.stamp_edits()
    } else {
        arena.stamp_edits()
        refresh_lists()
    }
    layout.layout(width, height)
}

fn engine_fill_focus() {
    arena.fill_focus_chain()
}

fn engine_focus_depth() -> int {
    return arena.chain_nodes.len
}

fn engine_focus_node(i: int) -> int {
    if i < 0 {
        return 0
    }
    if i >= arena.chain_nodes.len {
        return 0
    }
    return arena.chain_nodes[i]
}

fn engine_focus_ctx(i: int) -> int {
    if i < 0 {
        return 0
    }
    if i >= arena.chain_ctxs.len {
        return 0
    }
    return arena.chain_ctxs[i]
}

fn engine_focus_step(back: int) -> int {
    return arena.focus_step(back)
}

fn engine_focus_captures_text() -> int {
    return arena.focus_captures_text()
}

fn engine_key(key: int) -> int {
    return input.key(key)
}

fn engine_key_ev(key: int, mods: int) -> int {
    arena.ensure()
    arena.ev_mods = mods
    return platform.plat_key_ev(key, mods)
}

/// Key release, from hosts that deliver it. Runs the focused node's
/// `on_key_up`, then `on_key_press` — the down→up cycle.
fn engine_key_up(key: int, mods: int) -> int {
    arena.ensure()
    return input.key_handlers(key, mods, 1)
}

// --- engine trampolines ---
/// Cocoa calls these through zeus_plat.c (`yuga_zeus_engine_*`). Do not use
/// from app code; use `App`, clicks, and signals instead.

fn engine_paint() {
    scene.paint()
}

fn engine_step() -> int {
    let d = scene.step()
    // While an async op is in flight or a spawn waits, hosts must keep
    // drawing frames: only a frame's tick advances them.
    if async.busy() != 0 {
        return 1
    }
    return d
}

/// Milliseconds until the next async timer is due (0 = none; -1 = a spawn
/// waits). Native hosts that stop drawing when idle use this to schedule the
/// next frame exactly at the deadline.
fn engine_next_ms() -> int {
    return async.next_due()
}

/// One headless host frame: async tick, rebuild + layout, then paint. Tests
/// use this instead of calling `engine_layout` by hand.
fn pump() {
    engine_layout(arena.win_w, arena.win_h)
    engine_paint()
}

fn engine_click(px: int, py: int) -> int {
    return input.click(px, py)
}

fn click_id(id: int) -> int {
    let mut i = id
    while i > 0 {
        if arena.nodes[i].click_fn > 0 {
            let x = arena.nodes[i].x + arena.nodes[i].w / 2
            let y = arena.nodes[i].y + arena.nodes[i].h / 2
            return input.click(x, y)
        }
        i = arena.nodes[i].parent
    }
    let x = arena.nodes[id].x + arena.nodes[id].w / 2
    let y = arena.nodes[id].y + arena.nodes[id].h / 2
    return input.click(x, y)
}

/// Node id whose `text` or `a11y_label` equals `label` (tests, headless
/// hosts). 0 when nothing visible matches. Hidden nodes are skipped.
fn engine_find_text(label: string) -> int {
    let n = arena.nodes.len
    for i in 1..n {
        if arena.want_show(i) == 0 {
            continue
        }
        if fmt.eq(arena.nodes[i].text, label) {
            return i
        }
        if fmt.eq(arena.nodes[i].a11y_label, label) {
            return i
        }
    }
    return 0
}

/// Node id whose `a11y_role` equals `role` (tests, headless hosts); the
/// first match in tree order, 0 when none is visible.
fn engine_find_role(role: string) -> int {
    let n = arena.nodes.len
    for i in 1..n {
        if arena.want_show(i) == 0 {
            continue
        }
        if fmt.eq(arena.nodes[i].a11y_role, role) {
            return i
        }
    }
    return 0
}

/// Whether a node is currently shown by its own show binding (tests).
/// Hidden ancestors still hide it from paint and hit tests.
fn node_visible(id: int) -> int {
    if id <= 0 {
        return 0
    }
    if id >= arena.nodes.len {
        return 0
    }
    return arena.want_show(id)
}

/// Click the control whose label or `a11y_label` is `label`. Tests use this
/// instead of pixel coordinates.
fn engine_click_text(label: string) -> int {
    let id = engine_find_text(label)
    if id <= 0 {
        return 0
    }
    return click_id(id)
}

fn engine_scroll(px: int, py: int, dx: int, dy: int) -> int {
    return input.scroll(px, py, dx, dy)
}

fn engine_drag(px: int, py: int) -> int {
    return input.drag(px, py)
}

fn engine_mouseup() {
    input.mouseup()
}

fn engine_hover(px: int, py: int) -> int {
    return input.hover(px, py)
}

fn engine_over_button() -> int {
    return input.over_button()
}

/// CSS cursor name under the pointer: the most recently created node with an
/// explicit `cursor` wins (children outrank parents). "" = default arrow.
fn engine_cursor() -> string {
    return input.cursor_at()
}

/// Set a cursor name directly on any node (native thumbs have no props).
fn cursor(n: Node, s: string) -> Node {
    arena.nodes[n.id].cursor = s
    return n
}

fn draw_count() -> int {
    return scene.draws.len
}

/// Layout results for tests: the box of the node that matched
/// `engine_find_text`. Positions are window-space after the last layout.
fn node_x(id: int) -> int {
    return arena.nodes[id].x
}

fn node_y(id: int) -> int {
    return arena.nodes[id].y
}

fn node_w(id: int) -> int {
    return arena.nodes[id].w
}

fn node_h(id: int) -> int {
    return arena.nodes[id].h
}

/// Live slot counts (diagnostics for tests). `nodes` includes dead slots
/// waiting to be recycled; `sigs` is the same for signals. A streaming `For`
/// that rebuilds without growing the tree keeps both constant.
fn arena_nodes() -> int {
    return arena.nodes.len
}

fn arena_sigs() -> int {
    return arena.sigs.len
}

fn dump() {
    let n = scene.draws.len
    fmt.println("DRAW", n)
    for i in 0..n {
        let d = scene.draws[i]
        if d.kind == 0 {
            fmt.println("fill", d.x, d.y, d.w, d.h, d.rgb, d.radius)
        } else if d.kind == 1 {
            fmt.println("fill_a", d.x, d.y, d.w, d.h, d.rgb, d.alpha)
        } else if d.kind == 2 {
            fmt.println("text", d.x, d.y, d.rgb, d.font, d.text)
        } else if d.kind == 3 {
            fmt.println("text_int", d.x, d.y, d.value, d.rgb, d.font)
        } else if d.kind == 4 {
            fmt.println("text_wrap", d.x, d.y, d.w, d.text)
        } else if d.kind == 5 {
            fmt.println("svg", d.x, d.y, d.w, d.h, d.rgb)
        } else if d.kind == 6 {
            fmt.println("save")
        } else if d.kind == 7 {
            fmt.println("clip", d.x, d.y, d.w, d.h)
        } else if d.kind == 8 {
            fmt.println("restore")
        } else if d.kind == 9 {
            fmt.println("text_rot", d.x, d.y, d.rgb, d.font, d.w, d.text)
        }
    }
}

fn snapshot(width: int, height: int, build: fn() -> Node) {
    window("zeus-snap", width, height)
    let n = build()
    root(n)
    engine_layout(width, height)
    engine_paint()
    dump()
}


// --- declarative layer ---
//
// Components are plain `fn`s, hierarchy comes from trailing blocks, props are
// named arguments on a props struct, and every style prop is a thunk so a
// signal read inside it re-applies just that prop.

/// Layout direction for `align_direction`.
enum DIRECTION {
    Row = 0,
    Column = 1,
}

/// Cross-axis and main-axis alignment. Same codes the layout solver uses.
enum ALIGN {
    Start = 0,
    Center = 1,
    End = 2,
    Between = 3,
    Around = 4,
    Evenly = 5,
    Stretch = 6,
}

/// The spacing scale, in points.
enum SPACE {
    None = 0,
    Exxxs = 2,
    Exxs = 6,
    Exs = 8,
    Xs = 12,
    Sm = 16,
    Md = 20,
    Lg = 24,
    Xl = 32,
    Xxl = 48,
    Xxxl = 62,
    Xxxxl = 72
}

/// Key codes as delivered by the hosts. `e.key == Key.K` is the spell.
enum Key {
    Backspace = 8,
    Tab = 9,
    Enter = 13,
    Escape = 27,
    Space = 32,
    A = 97,
    B = 98,
    C = 99,
    D = 100,
    E = 101,
    F = 102,
    G = 103,
    H = 104,
    I = 105,
    J = 106,
    K = 107,
    L = 108,
    M = 109,
    N = 110,
    O = 111,
    P = 112,
    Q = 113,
    R = 114,
    S = 115,
    T = 116,
    U = 117,
    V = 118,
    W = 119,
    X = 120,
    Y = 121,
    Z = 122,
    Left = 1000,
    Right = 1001,
    Up = 1002,
    Down = 1003,
    Home = 1004,
    End = 1005,
}

/// Pointer payload, staged by the engine and read inside a handler.
struct MouseEvent {
    x: int,
    y: int,
    button: int,
}

/// Keyboard payload, staged by the engine and read inside a handler.
struct KeyEvent {
    key: int,
    ctrl: bool,
    shift: bool,
    alt: bool,
}

/// Multi-value box sizing, passed as one `style =` prop.
struct BoxStyle {
    width: int = -1,
    height: int = -1,
    background: string = "",
    padding: int = 0,
    grow: int = 0,
}

/// 2D grid configuration.
struct GridConfig {
    columns: int = 1,
    gap: int = 0,
    padding: int = 0,
}

/// The event payload for the handler now running. A handler is invoked with
/// no arguments, so `fn(e: MouseEvent)` is lowered to a `let` of this.
fn current_mouse() -> MouseEvent {
    return MouseEvent { x: arena.ev_x, y: arena.ev_y, button: arena.ev_button }
}

fn current_key() -> KeyEvent {
    return KeyEvent {
        key: arena.ev_key,
        ctrl: arena.ev_mods % 4 >= 2,
        shift: arena.ev_mods % 2 == 1,
        alt: arena.ev_mods % 8 >= 4,
    }
}

/// Default for an unset handler prop. Never installed: `on_x__set` says
/// whether the caller passed one.
fn __noop() {
    return
}

/// `#rrggbb` / `#rgb` to packed RGB. -1 for empty or malformed, which every
/// style setter reads as "leave unset".
fn hex(s: string) -> int {
    let n = s.len
    if n == 0 {
        return -1
    }
    if s[0] != 35 {
        return -1
    }
    let mut v = 0
    if n == 7 {
        for i in 1..7 {
            let d = hex_digit(s[i])
            if d < 0 {
                return -1
            }
            v = v * 16 + d
        }
        return v
    }
    if n == 4 {
        for i in 1..4 {
            let d = hex_digit(s[i])
            if d < 0 {
                return -1
            }
            v = v * 256 + d * 17
        }
        return v
    }
    return -1
}

fn hex_digit(c: int) -> int {
    if c >= 48 {
        if c <= 57 {
            return c - 48
        }
    }
    if c >= 97 {
        if c <= 102 {
            return c - 87
        }
    }
    if c >= 65 {
        if c <= 70 {
            return c - 55
        }
    }
    return -1
}

// --- builder stack ---
// A trailing block `C(...) { ... }` lowers to `__ui_scope(C(...), || { ... })`.
// `__ui_scope` makes the node the current parent, runs the block, and pops;
// every widget ends with `ui_emit`, which attaches it to that parent. The
// hierarchy is therefore block structure — no parenting calls.

let mut __ui_parents: []int = []int {}

fn __ui_push(id: int) {
    push(__ui_parents, id)
}

fn __ui_pop() {
    if __ui_parents.len > 0 {
        pop(__ui_parents)
    }
}

fn __ui_scope(node: Node, build: fn()) -> Node {
    __ui_push(node.id)
    build()
    __ui_pop()
    return node
}

/// Attach `node` to the innermost enclosing trailing block, if any.
fn ui_emit(node: Node) -> Node {
    if __ui_parents.len > 0 {
        let pid = __ui_parents[__ui_parents.len - 1]
        if pid > 0 {
            child(nd(pid), node)
        }
    }
    return node
}

// --- reactive props ---
// A style prop is a thunk. Interning it yields an int id, which a plain `||`
// effect closure can capture — a `fn` value is not Copy and cannot be. The
// effect calls the thunk and re-applies one setter, so setting a signal
// repaints exactly the props that read it.

fn apply_int(nid: int, setter: int, v: int) {
    let n = nd(nid)
    if setter == 1 {
        if v >= 0 {
            w(n, v)
        }
    } else if setter == 2 {
        if v >= 0 {
            h(n, v)
        }
    } else if setter == 3 {
        if v >= 0 {
            pad(n, v)
        }
    } else if setter == 4 {
        if v >= 0 {
            padX(n, v)
        }
    } else if setter == 5 {
        if v >= 0 {
            padY(n, v)
        }
    } else if setter == 6 {
        if v >= 0 {
            gap(n, v)
        }
    } else if setter == 7 {
        if v >= 0 {
            radius(n, v)
        }
    } else if setter == 8 {
        arena.nodes[nid].border_w = v
    } else if setter == 9 {
        if v >= 0 {
            grow(n, v)
        }
    } else if setter == 10 {
        if v >= 0 {
            align(n, v)
        }
    } else if setter == 11 {
        if v >= 0 {
            justify(n, v)
        }
    } else if setter == 12 {
        if v > 0 {
            font(n, v)
        }
    } else if setter == 13 {
        if v >= 0 {
            opacity(n, v)
        }
    } else if setter == 14 {
        if v == 1 {
            flex_col(n)
        } else {
            flex_row(n)
        }
    } else if setter == 15 {
        if v >= 0 {
            bg(n, v)
        }
    } else if setter == 16 {
        if v >= 0 {
            fg(n, v)
        }
    } else if setter == 17 {
        if v >= 0 {
            border_color(n, v)
        }
    } else if setter == 18 {
        if v >= 0 {
            min_w(n, v)
        }
    } else if setter == 19 {
        if v >= 0 {
            max_w(n, v)
        }
    } else if setter == 20 {
        if v >= 0 {
            min_h(n, v)
        }
    } else if setter == 21 {
        if v >= 0 {
            max_h(n, v)
        }
    } else if setter == 22 {
        if v != 0 {
            flex_wrap(n)
        }
    } else if setter == 23 {
        if v != 0 {
            arena.nodes[nid].safe = 1
        } else {
            arena.nodes[nid].safe = 0
        }
    } else if setter == 24 {
        if v >= 0 {
            arena.nodes[nid].pos = v
        }
    } else if setter == 25 {
        if v >= 0 {
            arena.nodes[nid].pin_l = v
        }
    } else if setter == 26 {
        if v >= 0 {
            arena.nodes[nid].pin_t = v
        }
    } else if setter == 27 {
        if v >= 0 {
            arena.nodes[nid].pin_r = v
        }
    } else if setter == 28 {
        if v >= 0 {
            arena.nodes[nid].pin_b = v
        }
    } else if setter == 29 {
        if v >= 0 {
            arena.nodes[nid].z_index = v
        }
    } else if setter == 30 {
        if v >= 0 {
            shrink(n, v)
        }
    } else if setter == 31 {
        if v == 0 || v == 1 {
            arena.nodes[nid].show_on = v
        }
    }
}

fn apply_str(nid: int, setter: int, v: string) {
    if setter == 100 {
        arena.nodes[nid].text = v
        return
    }
    if setter == 101 {
        arena.nodes[nid].a11y_label = v
        return
    }
    if setter == 102 {
        arena.nodes[nid].a11y_role = v
        return
    }
    if setter == 103 {
        arena.nodes[nid].cursor = v
        return
    }
    apply_int(nid, setter, hex(v))
}

fn prop_int(node: Node, setter: int, thunk: fn() -> int) -> Node {
    let fid = __intern_int(thunk)
    let nid = node.id
    return styled(node, || { apply_int(nid, setter, platform.plat_invoke_int_fn(fid)) })
}

fn prop_str(node: Node, setter: int, thunk: fn() -> string) -> Node {
    let fid = __intern_str(thunk)
    let nid = node.id
    return styled(node, || { apply_str(nid, setter, platform.plat_invoke_str_fn(fid)) })
}

// --- widgets ---
// Every prop is optional; an omitted one takes its declared default. A
// `foo__set` companion records whether the caller passed `foo`, which is how
// an optional handler is told from its default — function values cannot be
// compared.

struct BoxProps {
    width: fn() -> int = -1,
    height: fn() -> int = -1,
    padding: fn() -> int = -1,
    padding_x: fn() -> int = -1,
    padding_y: fn() -> int = -1,
    spacing: fn() -> int = -1,
    radius: fn() -> int = -1,
    border: fn() -> int = -1,
    border_color: fn() -> string = "",
    background: fn() -> string = "",
    color: fn() -> string = "",
    font: fn() -> int = -1,
    opacity: fn() -> int = -1,
    /// Flex-grow weight: a row or column hands leftover space to the
    /// children with the highest positive `grow` (the engine's `grow`). A
    /// positive `grow` also allows narrowing on overflow (like CSS `flex:
    /// 1`) unless `shrink` is given explicitly.
    grow: fn() -> int = -1,
    /// Flex-shrink weight. `-1` (the default) follows `grow`: a grown child
    /// may narrow before a row wraps; `0` refuses to narrow, `1` allows it.
    shrink: fn() -> int = -1,
    /// Visible when the thunk is true. Signal shows (`zeus.show` / `show_eq`
    /// / `If`) win over this prop on the same node.
    show: fn() -> bool = true,
    align_direction: fn() -> int = 1,
    align_items: fn() -> int = -1,
    justify: fn() -> int = -1,
    wrap: fn() -> int = 0,
    min_width: fn() -> int = -1,
    max_width: fn() -> int = -1,
    min_height: fn() -> int = -1,
    max_height: fn() -> int = -1,
    /// Position mode: `zeus.pos_absolute()` takes the node out of flow and
    /// pins it to this parent's content box; `zeus.pos_relative()` (the
    /// default) leaves it in flow. Omitted (`-1`) means no change.
    position: fn() -> int = -1,
    /// Pin offsets from the parent content box (when `position` is absolute);
    /// `-1` = unpinned on that side. `left` + `right` or `top` + `bottom`
    /// stretch the child to the inner box instead of sizing it.
    left: fn() -> int = -1,
    top: fn() -> int = -1,
    right: fn() -> int = -1,
    bottom: fn() -> int = -1,
    /// Paint and hit-test order against siblings (`> 0` lifts above them;
    /// values only compare inside the same parent). `Overlay` sets 50 itself.
    z_index: fn() -> int = -1,
    /// 1 adds host safe-area insets. App's root scroller already insets.
    safe: fn() -> int = 0,
    /// 1 silences the gray hover wash on clickable boxes (the shadcn default:
    /// flat chrome). Set `hover_off = false` to let a box wash on hover.
    hover_off: fn() -> bool = true,
    /// CSS cursor under the pointer, e.g. `cursor = "pointer"` / `"text"`.
    /// Default `""` = `default` (arrow); hosts fall back for exotic shapes.
    cursor: fn() -> string = "",
    /// Spoken name. Empty means use child text. Native hosts; Canvas2D has no ARIA.
    a11y_label: fn() -> string = "",
    /// Role token: `button`, `text`, `heading`, `dialog`, `list`, `listitem`.
    a11y_role: fn() -> string = "",
    style: BoxStyle = BoxStyle {},
    style__set: bool = false,
    on_click: fn() = __noop,
    on_click__set: bool = false,
    on_mouse_down: fn() = __noop,
    on_mouse_down__set: bool = false,
    on_mouse_up: fn() = __noop,
    on_mouse_up__set: bool = false,
    on_key_down: fn() = __noop,
    on_key_down__set: bool = false,
    on_key_up: fn() = __noop,
    on_key_up__set: bool = false,
    on_key_press: fn() = __noop,
    on_key_press__set: bool = false,
}

struct TextProps {
    color: fn() -> string = "",
    font: fn() -> int = -1,
    padding: fn() -> int = -1,
    opacity: fn() -> int = -1,
    // grow / shrink / show: as BoxProps. `grow = 1` text fills leftover row
    // space and narrows before the row wraps; `show` hides without
    // rebuilding.
    grow: fn() -> int = -1,
    shrink: fn() -> int = -1,
    show: fn() -> bool = true,
    wrap: fn() -> int = 0,
    // position / left / top / right / bottom / z_index: as BoxProps. Pinned
    // labels are how axis ticks and rotated chart text place themselves.
    position: fn() -> int = -1,
    left: fn() -> int = -1,
    top: fn() -> int = -1,
    right: fn() -> int = -1,
    bottom: fn() -> int = -1,
    z_index: fn() -> int = -1,
    a11y_label: fn() -> string = "",
    a11y_role: fn() -> string = "",
}

struct BtnProps {
    color: fn() -> string = "",
    background: fn() -> string = "",
    font: fn() -> int = -1,
    padding: fn() -> int = -1,
    radius: fn() -> int = -1,
    width: fn() -> int = -1,
    height: fn() -> int = -1,
    // position / left / top / right / bottom / z_index: as BoxProps.
    position: fn() -> int = -1,
    left: fn() -> int = -1,
    top: fn() -> int = -1,
    right: fn() -> int = -1,
    bottom: fn() -> int = -1,
    z_index: fn() -> int = -1,
    /// Visible when the thunk is true (signal shows win, as BoxProps).
    show: fn() -> bool = true,
    enabled: fn() -> bool = true,
    /// 1 silences the gray hover wash (the shadcn default: flat chrome).
    /// Set `hover_off = false` to let the button wash on hover.
    hover_off: fn() -> bool = true,
    /// CSS cursor under the pointer (default `""` = arrow).
    cursor: fn() -> string = "",
    on_click: fn() = __noop,
    on_click__set: bool = false,
}

struct InputProps {
    placeholder: string = "",
    width: fn() -> int = -1,
    height: fn() -> int = -1,
    // position / left / top / right / bottom / z_index: as BoxProps.
    position: fn() -> int = -1,
    left: fn() -> int = -1,
    top: fn() -> int = -1,
    right: fn() -> int = -1,
    bottom: fn() -> int = -1,
    z_index: fn() -> int = -1,
    /// Visible when the thunk is true (signal shows win, as BoxProps).
    show: fn() -> bool = true,
    color: fn() -> string = "",
    background: fn() -> string = "",
    font: fn() -> int = -1,
    padding: fn() -> int = -1,
    bind: Signal<string> = Signal { id: 0 },
    bind__set: bool = false,
    /// CSS cursor under the pointer (default `""` = arrow; inputs usually
    /// want `"text"` on their frame).
    cursor: fn() -> string = "",
    a11y_label: fn() -> string = "",
    on_key_down: fn() = __noop,
    on_key_down__set: bool = false,
    on_key_up: fn() = __noop,
    on_key_up__set: bool = false,
    on_key_press: fn() = __noop,
    on_key_press__set: bool = false,
}

struct GridProps {
    config: GridConfig = GridConfig {},
    width: fn() -> int = -1,
    background: fn() -> string = "",
    padding: fn() -> int = -1,
    // position / left / top / right / bottom / z_index: as BoxProps.
    position: fn() -> int = -1,
    left: fn() -> int = -1,
    top: fn() -> int = -1,
    right: fn() -> int = -1,
    bottom: fn() -> int = -1,
    z_index: fn() -> int = -1,
    /// Visible when the thunk is true (signal shows win, as BoxProps).
    show: fn() -> bool = true,
}

struct OverlayProps {
    background: fn() -> string = "",
    opacity: fn() -> int = -1,
    /// Visible when the thunk is true (signal shows win, as BoxProps).
    show: fn() -> bool = true,
    on_click: fn() = __noop,
    on_click__set: bool = false,
}

/// Geometry for `Svg` layers: explicit size plus absolute placement
/// (`position` / `left` / `top` / `right` / `bottom` / `z_index`, as
/// `BoxProps`). Without `width`/`height` an svg is measured like a label.
struct SvgProps {
    width: fn() -> int = -1,
    height: fn() -> int = -1,
    position: fn() -> int = -1,
    left: fn() -> int = -1,
    top: fn() -> int = -1,
    right: fn() -> int = -1,
    bottom: fn() -> int = -1,
    z_index: fn() -> int = -1,
    /// Visible when the thunk is true (signal shows win, as BoxProps).
    show: fn() -> bool = true,
}

/// Install the pointer and key handlers a container or input accepts.
fn __box_events(node: Node, p: BoxProps) -> Node {
    if p.on_click__set {
        arena.nodes[node.id].click_fn = __intern(p.on_click)
    }
    if p.on_mouse_down__set {
        arena.nodes[node.id].down_fn = __intern(p.on_mouse_down)
    }
    if p.on_mouse_up__set {
        arena.nodes[node.id].up_fn = __intern(p.on_mouse_up)
    }
    if p.on_key_down__set {
        arena.nodes[node.id].kdown_fn = __intern(p.on_key_down)
        arena.nodes[node.id].focusable = 1
    }
    if p.on_key_up__set {
        arena.nodes[node.id].kup_fn = __intern(p.on_key_up)
        arena.nodes[node.id].focusable = 1
    }
    if p.on_key_press__set {
        arena.nodes[node.id].kpress_fn = __intern(p.on_key_press)
        arena.nodes[node.id].focusable = 1
    }
    return node
}

/// A flex container. `align_direction = DIRECTION.Row | DIRECTION.Column`; a
/// row centres on the cross axis and a column stretches, unless `align_items`
/// is given. `wrap` / `min_width` / `max_width` / `min_height` / `max_height`
/// / `safe` are layout props. Takes a trailing block of children.
fn Box(p: BoxProps) -> Node {
    arena.ensure()
    let n = raw_box()
    shrink(n, 0)
    if p.style__set {
        if p.style.width >= 0 {
            w(n, p.style.width)
        }
        if p.style.height >= 0 {
            h(n, p.style.height)
        }
        if p.style.padding > 0 {
            pad(n, p.style.padding)
        }
        if p.style.grow > 0 {
            grow(n, p.style.grow)
        }
        let sbg = hex(p.style.background)
        if sbg >= 0 {
            bg(n, sbg)
        }
    }
    prop_int(n, 14, p.align_direction)
    prop_int(n, 1, p.width)
    prop_int(n, 2, p.height)
    prop_int(n, 3, p.padding)
    prop_int(n, 4, p.padding_x)
    prop_int(n, 5, p.padding_y)
    prop_int(n, 6, p.spacing)
    prop_int(n, 7, p.radius)
    prop_int(n, 8, p.border)
    prop_int(n, 9, p.grow)
    let sw = __shrink_weight(p.grow, p.shrink)
    prop_int(n, 30, sw)
    prop_int(n, 10, p.align_items)
    prop_int(n, 11, p.justify)
    prop_int(n, 22, p.wrap)
    prop_int(n, 18, p.min_width)
    prop_int(n, 19, p.max_width)
    prop_int(n, 20, p.min_height)
    prop_int(n, 21, p.max_height)
    prop_int(n, 23, p.safe)
    prop_int(n, 24, p.position)
    prop_int(n, 25, p.left)
    prop_int(n, 26, p.top)
    prop_int(n, 27, p.right)
    prop_int(n, 28, p.bottom)
    prop_int(n, 29, p.z_index)
    let show = __show_on(p.show)
    prop_int(n, 31, show)
    prop_int(n, 12, p.font)
    prop_int(n, 13, p.opacity)
    prop_str(n, 15, p.background)
    prop_str(n, 16, p.color)
    prop_str(n, 17, p.border_color)
    prop_str(n, 101, p.a11y_label)
    prop_str(n, 102, p.a11y_role)
    prop_str(n, 103, p.cursor)
    __box_events(n, p)
    if platform.plat_invoke_bool_fn(__intern_bool(p.hover_off)) != 0 {
        hover_off(n)
    }
    return ui_emit(n)
}

/// Static or reactive text. The label is a thunk, so a signal read inside it
/// is recorded against this label's own effect: setting the signal repaints
/// this one node.
fn Text(label: fn() -> string, p: TextProps) -> Node {
    arena.ensure()
    let n = raw_label("")
    shrink(n, 0)
    prop_str(n, 100, label)
    prop_str(n, 16, p.color)
    prop_int(n, 12, p.font)
    prop_int(n, 3, p.padding)
    prop_int(n, 13, p.opacity)
    prop_int(n, 9, p.grow)
    let sw = __shrink_weight(p.grow, p.shrink)
    prop_int(n, 30, sw)
    prop_int(n, 22, p.wrap)
    prop_int(n, 24, p.position)
    prop_int(n, 25, p.left)
    prop_int(n, 26, p.top)
    prop_int(n, 27, p.right)
    prop_int(n, 28, p.bottom)
    prop_int(n, 29, p.z_index)
    let show = __show_on(p.show)
    prop_int(n, 31, show)
    prop_str(n, 101, p.a11y_label)
    prop_str(n, 102, p.a11y_role)
    return ui_emit(n)
}

/// Clickable button. `on_click = fn() => ...`.
fn Button(label: fn() -> string, p: BtnProps) -> Node {
    arena.ensure()
    let n = raw_button("")
    shrink(n, 0)
    prop_str(n, 100, label)
    prop_str(n, 16, p.color)
    prop_str(n, 15, p.background)
    prop_int(n, 12, p.font)
    prop_int(n, 3, p.padding)
    prop_int(n, 7, p.radius)
    prop_int(n, 1, p.width)
    prop_int(n, 2, p.height)
    prop_int(n, 24, p.position)
    prop_int(n, 25, p.left)
    prop_int(n, 26, p.top)
    prop_int(n, 27, p.right)
    prop_int(n, 28, p.bottom)
    prop_int(n, 29, p.z_index)
    let show = __show_on(p.show)
    prop_int(n, 31, show)
    let dim = __enabled_opacity(p.enabled)
    prop_int(n, 13, dim)
    prop_str(n, 103, p.cursor)
    if p.on_click__set {
        arena.nodes[n.id].click_fn = __intern(p.on_click)
        arena.nodes[n.id].a11y_role = "button"
    }
    if platform.plat_invoke_bool_fn(__intern_bool(p.hover_off)) != 0 {
        hover_off(n)
    }
    return ui_emit(n)
}

/// The `show` prop is a bool thunk; visibility is a 0/1 int on the node, so
/// fold the bool through an int thunk exactly like `enabled` folds into an
/// opacity.
fn __show_on(show: fn() -> bool) -> fn() -> int {
    let fid = __intern_bool(show)
    return || {
        if platform.plat_invoke_bool_fn(fid) != 0 {
            1
        } else {
            0
        }
    }
}

/// Shrink weight for a grown child: an explicit `shrink` (>= 0) wins; an
/// omitted one follows `grow`, so `grow = 1` alone is elastic (it may
/// narrow when a row overflows) — the CSS `flex: 1` reading of `grow`.
fn __shrink_weight(grow: fn() -> int, shrink: fn() -> int) -> fn() -> int {
    let gid = __intern_int(grow)
    let sid = __intern_int(shrink)
    return || {
        let g = platform.plat_invoke_int_fn(gid)
        let s = platform.plat_invoke_int_fn(sid)
        if s >= 0 {
            s
        } else if g > 0 {
            1
        } else {
            0
        }
    }
}

/// A disabled button is dimmed. `enabled` stays a thunk so it tracks.
fn __enabled_opacity(enabled: fn() -> bool) -> fn() -> int {
    let fid = __intern_bool(enabled)
    return || {
        let mut v = 40
        if platform.plat_invoke_bool_fn(fid) != 0 {
            v = 100
        }
        v
    }
}

/// Single-line text field. `bind = sig` writes the edit buffer back into a
/// `Signal<string>` on every edit; the store notifies only on a real change.
fn Input(p: InputProps) -> Node {
    arena.ensure()
    let n = raw_input(p.placeholder)
    shrink(n, 0)
    prop_int(n, 1, p.width)
    prop_int(n, 2, p.height)
    prop_int(n, 24, p.position)
    prop_int(n, 25, p.left)
    prop_int(n, 26, p.top)
    prop_int(n, 27, p.right)
    prop_int(n, 28, p.bottom)
    prop_int(n, 29, p.z_index)
    let show = __show_on(p.show)
    prop_int(n, 31, show)
    prop_str(n, 16, p.color)
    prop_str(n, 15, p.background)
    prop_int(n, 12, p.font)
    prop_int(n, 3, p.padding)
    prop_str(n, 101, p.a11y_label)
    prop_str(n, 103, p.cursor)
    arena.nodes[n.id].a11y_role = "textbox"
    if p.bind__set {
        let sig = p.bind
        let nid = n.id
        arena.nodes[nid].edit_sig = sig.id
        arena.nodes[nid].bind_fn = __intern(|| { set(sig, input_value(nd(nid))) })
    }
    if p.on_key_down__set {
        arena.nodes[n.id].kdown_fn = __intern(p.on_key_down)
    }
    if p.on_key_up__set {
        arena.nodes[n.id].kup_fn = __intern(p.on_key_up)
    }
    if p.on_key_press__set {
        arena.nodes[n.id].kpress_fn = __intern(p.on_key_press)
    }
    return ui_emit(n)
}

/// 2D grid. `config = GridConfig(columns = 3, gap = 12, padding = 16)`.
fn Grid(p: GridProps) -> Node {
    arena.ensure()
    let n = raw_grid(p.config.columns, p.config.gap)
    shrink(n, 0)
    if p.config.padding > 0 {
        pad(n, p.config.padding)
    }
    prop_int(n, 1, p.width)
    prop_int(n, 3, p.padding)
    prop_int(n, 24, p.position)
    prop_int(n, 25, p.left)
    prop_int(n, 26, p.top)
    prop_int(n, 27, p.right)
    prop_int(n, 28, p.bottom)
    prop_int(n, 29, p.z_index)
    let show = __show_on(p.show)
    prop_int(n, 31, show)
    prop_str(n, 15, p.background)
    return ui_emit(n)
}

/// Full-window floater. Kind 9 is out of flow, so showing it does not grow
/// the page scroller. Children are centred; click the dim to dismiss.
fn Overlay(p: OverlayProps) -> Node {
    arena.ensure()
    let n = raw_overlay()
    arena.nodes[n.id].dir = 1
    center(n)
    z_index(n, 50)
    prop_str(n, 15, p.background)
    prop_int(n, 13, p.opacity)
    let show = __show_on(p.show)
    prop_int(n, 31, show)
    if p.on_click__set {
        arena.nodes[n.id].click_fn = __intern(p.on_click)
    }
    return ui_emit(n)
}

/// A column that skips layout while `visible` is 0. Trailing block is the body.
/// The subtree is built once (retained), unlike a build-time `if`.
fn If(visible: Signal<int>) -> Node {
    arena.ensure()
    let n = raw_box()
    shrink(n, 0)
    flex_col(n)
    show(n, visible)
    return ui_emit(n)
}

/// Run `build(i, item)` for each element. `[]T` is Copy when `T` is Copy, so
/// this is safe inside a trailing block.
fn Each<T>(items: []T, build: fn(int, T)) {
    let n = items.len
    for i in 0..n {
        build(i, items[i])
    }
}

/// Append `v` to a live list signal and notify. Use with `For`.
fn push_item<T>(sig: Signal<[]T>, v: T) {
    let mut xs = sig.get()
    push(xs, v)
    sig.set(xs)
}

/// Remove the last item from a live list signal. No-op if empty.
fn pop_item<T>(sig: Signal<[]T>) {
    let mut xs = sig.get()
    if xs.len > 0 {
        pop(xs)
        sig.set(xs)
    }
}

fn for_refresh(nid: int, items: Signal<[]string>, build: fn(int, string)) {
    let gen = platform.plat_sig_gen(items.id)
    if gen == arena.nodes[nid].list_gen {
        if arena.nodes[nid].kids.len > 0 {
            return
        }
    }
    arena.nodes[nid].list_gen = gen
    // Everything the builder allocated last time is owned by this host:
    // signals and interned handlers are freed (and their ids recycled) on
    // the next rebuild, so streaming data does not grow the arena.
    let prev = arena.scope_begin(nid)
    arena.release_sigs(nid)
    arena.release_fns(nid)
    arena.drop_children(nid)
    __ui_push(nid)
    let xs = items.get()
    let m = xs.len
    for i in 0..m {
        build(i, xs[i])
    }
    __ui_pop()
    arena.scope_end(prev)
}

/// Growing list of strings. `items` is `zeus.signal([]string {})`.
/// Push with `push_item`. Rebuilds on the next layout after a push.
fn For(items: Signal<[]string>, build: fn(int, string)) -> Node {
    arena.ensure()
    let n = raw_box()
    shrink(n, 0)
    flex_col(n)
    let nid = n.id
    for_refresh(nid, items, build)
    arena.nodes[nid].list_fn = __intern(|| {
        for_refresh(nid, items, build)
    })
    return ui_emit(n)
}

/// Width a node measured by the last layout pass (0 until the first one).
fn node_width(n: Node) -> int {
    return arena.nodes[n.id].w
}

/// Re-run `build` into `host` whenever the host's measured width changes
/// (window resize, card reflow). `host` must be widthless so it stretches
/// with its parent. Pixel-exact widgets — charts, plots — lay out their
/// children from the measured width, so they stay glued to the container.
/// Rebuilds happen on the layout after a size change.
fn refit_refresh(nid: int, build: fn()) {
    let w = arena.nodes[nid].w
    if w == arena.nodes[nid].list_gen {
        return
    }
    arena.nodes[nid].list_gen = w
    let prev = arena.scope_begin(nid)
    arena.release_sigs(nid)
    arena.release_fns(nid)
    arena.drop_children(nid)
    __ui_push(nid)
    build()
    __ui_pop()
    arena.scope_end(prev)
}

fn refit(host: Node, build: fn()) -> Node {
    arena.ensure()
    let nid = host.id
    arena.nodes[nid].list_fn = __intern(|| {
        refit_refresh(nid, build)
    })
    return host
}

/// Vertical scroller. Children keep intrinsic height; a bar appears on overflow.
fn Scroll() -> Node {
    arena.ensure()
    return ui_emit(raw_scroll())
}

/// Inline SVG. `currentColor` follows the node's foreground. Geometry props:
/// `width`, `height` (an svg is otherwise measured like a label), plus the
/// usual `position` / pins / `z_index` for layered plots.
fn Svg(markup: string, p: SvgProps) -> Node {
    arena.ensure()
    let n = raw_svg(markup)
    shrink(n, 0)
    prop_int(n, 1, p.width)
    prop_int(n, 2, p.height)
    prop_int(n, 24, p.position)
    prop_int(n, 25, p.left)
    prop_int(n, 26, p.top)
    prop_int(n, 27, p.right)
    prop_int(n, 28, p.bottom)
    prop_int(n, 29, p.z_index)
    let show = __show_on(p.show)
    prop_int(n, 31, show)
    return ui_emit(n)
}

/// Open a window and build the tree once. The tree is retained: signals
/// update the props that read them, never a whole subtree.
/// The root is a vertical scroller: children keep their intrinsic height
/// (they are not shrunk to the window) and a bar appears when they overflow.
fn App(title: string, width: int, height: int, build: fn()) {
    init()
    window(title, width, height)
    let top = raw_scroll()
    __ui_push(top.id)
    build()
    __ui_pop()
    root(top)
    raw_run()
}
