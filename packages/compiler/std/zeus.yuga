    on_key_down__set: bool = false,
    on_key_up: fn(KeyEvent) = noop_key,
    on_key_up__set: bool = false,
    on_key_press: fn(KeyEvent) = noop_key,
    on_key_press__set: bool = false,
}

// --- shared prop application ---

/// Apply the container props shared by every `Box` (and the widgets built on
/// it). Each passed style prop becomes a tracked effect on the node; `bind_style_*`
/// runs it now and re-applies the setter when a signal the thunk reads changes.
/// `gap` and `spacing` share one slot — when both are passed, `gap` wins,
/// exactly like the old plain-value props.
fn apply_box(node: Node, p: BoxProps) -> Node {
    let n = node
    // `style` first so the flat fields win.
    if p.style__set {
        let t = p.style
        bind_style_b(n, t)
    }
    // `align_direction = DIRECTION.Row | DIRECTION.Column` replaces the old
    // Row/Column widgets. Row's default cross-axis alignment is center,
    // Column's is stretch — applied only when `align_items` was not passed.
    if p.align_direction__set {
        let t = p.align_direction
        let m = if p.align_items__set { StyleInt.DirOnly } else { StyleInt.DirDefaultAlign }
        bind_style_i(n, m, t)
    }
    if p.width__set {
        let t = p.width
        bind_style_i(n, StyleInt.W, t)
    }
    if p.height__set {
        let t = p.height
        bind_style_i(n, StyleInt.H, t)
    }
    if p.padding__set {
        let t = p.padding
        bind_style_i(n, StyleInt.Pad, t)
    }
    if p.flex__set {
        let t = p.flex
        bind_style_i(n, StyleInt.Flex, t)
    }
    if p.radius__set {
        let t = p.radius
        bind_style_i(n, StyleInt.Radius, t)
    }
    if p.font__set {
        let t = p.font
        bind_style_i(n, StyleInt.Font, t)
    }
    if p.gap__set {
        let t = p.gap
        bind_style_i(n, StyleInt.Gap, t)
    } else if p.spacing__set {
        let t = p.spacing
        bind_style_i(n, StyleInt.Gap, t)
    }
    if p.background__set {
        let t = p.background
        bind_style_s(n, StyleStr.Bg, t)
    }
    if p.color__set {
        let t = p.color
        bind_style_s(n, StyleStr.Fg, t)
    }
    if p.size__set {
        let t = p.size
        bind_style_i(n, StyleInt.SizePx, t)
    }
    if p.pad_x__set {
        let t = p.pad_x
        bind_style_i(n, StyleInt.PadX, t)
    }
    if p.pad_y__set {
        let t = p.pad_y
        bind_style_i(n, StyleInt.PadY, t)
    }
    if p.pad_top__set {
        let t = p.pad_top
        bind_style_i(n, StyleInt.PadTop, t)
    }
    if p.pad_right__set {
        let t = p.pad_right
        bind_style_i(n, StyleInt.PadRight, t)
    }
    if p.pad_bottom__set {
        let t = p.pad_bottom
        bind_style_i(n, StyleInt.PadBottom, t)
    }
    if p.pad_left__set {
        let t = p.pad_left
        bind_style_i(n, StyleInt.PadLeft, t)
    }
    if p.margin__set {
        let t = p.margin
        bind_style_i(n, StyleInt.Margin, t)
    }
    if p.border__set {
        let t = p.border
        bind_style_i(n, StyleInt.Border, t)
    }
    if p.border_color__set {
        let t = p.border_color
        bind_style_s(n, StyleStr.BorderColor, t)
    }
    if p.overflow__set {
        let t = p.overflow
        bind_style_i(n, StyleInt.Overflow, t)
    }
    if p.grow__set {
        let t = p.grow
        bind_style_i(n, StyleInt.Grow, t)
    }
    if p.shrink__set {
        let t = p.shrink
        bind_style_i(n, StyleInt.Shrink, t)
    }
    if p.min_w__set {
        let t = p.min_w
        bind_style_i(n, StyleInt.MinW, t)
    }
    if p.max_w__set {
        let t = p.max_w
        bind_style_i(n, StyleInt.MaxW, t)
    }
    if p.min_h__set {
        let t = p.min_h
        bind_style_i(n, StyleInt.MinH, t)
    }
    if p.max_h__set {
        let t = p.max_h
        bind_style_i(n, StyleInt.MaxH, t)
    }
    if p.opacity__set {
        let t = p.opacity
        bind_style_i(n, StyleInt.Opacity, t)
    }
    if p.position__set {
        let t = p.position
        bind_style_i(n, StyleInt.Position, t)
    }
    if p.top__set {
        let t = p.top
        bind_style_i(n, StyleInt.PinTop, t)
    }
    if p.left__set {
        let t = p.left
        bind_style_i(n, StyleInt.PinLeft, t)
    }
    if p.z_index__set {
        let t = p.z_index
        bind_style_i(n, StyleInt.ZIndex, t)
    }
    if p.align_self__set {
        let t = p.align_self
        bind_style_i(n, StyleInt.AlignSelf, t)
    }
    if p.hover_fade {
        hover_fade(n)
    }
    if p.align_items__set {
        let t = p.align_items
        bind_style_i(n, StyleInt.Align, t)
    }
    if p.justify_content__set {
        let t = p.justify_content
        bind_style_i(n, StyleInt.Justify, t)
    }
    if p.on_click__set {
        on_click(n, p.on_click)
    }
    if p.on_mouse_down__set {
        arena.nodes[n.id].mouse_down_fn = add_mouse_fn(p.on_mouse_down)
    }
    if p.on_mouse_up__set {
        arena.nodes[n.id].mouse_up_fn = add_mouse_fn(p.on_mouse_up)
    }
    if p.on_key_down__set {
        arena.nodes[n.id].key_down_fn = add_key_fn(p.on_key_down)
    }
    if p.on_key_up__set {
        arena.nodes[n.id].key_up_fn = add_key_fn(p.on_key_up)
    }
    if p.on_key_press__set {
        arena.nodes[n.id].key_press_fn = add_key_fn(p.on_key_press)
    }
    return n
}

// --- reactive text ---

/// One effect per bound label. `txt_dispatch` is registered as the handler for
/// all of them; the effect id that is currently running selects the slot, so
/// no closure has to capture the node or the thunk.
let mut txt_eids: []int = []int {}
let mut txt_nodes: []int = []int {}
/// `body` is a parameter, which Yuga drops when the widget returns; `keep_txt`
/// snapshots its captured env so the stored thunk stays valid.
let mut txt_bodies: []fn() -> string = []fn() -> string {}

fn keep_txt(h: fn() -> string) -> fn() -> string {}

/// Re-render the single label whose effect is running. `track.run` pushes the
/// effect id before invoking, and `get` records reads against it, so each
/// label depends only on the signals its own thunk touched.
fn txt_dispatch() {
    if track.stack.len == 0 {
        return
    }
    let eid = track.stack[track.stack.len - 1]
    let n = txt_eids.len
    for i in 0..n {
        if txt_eids[i] == eid {
            arena.nodes[txt_nodes[i]].text = txt_bodies[i]()
            return
        }
    }
}

/// Paint `node`'s text from `body`, re-running only this node when a signal
/// `body` read changes.
fn bind_text(node: Node, body: fn() -> string) -> Node {
    arena.ensure()
    let eid = track.alloc(platform.plat_intern_fn(txt_dispatch), node.id)
    push(txt_eids, eid)
    push(txt_nodes, node.id)
    push(txt_bodies, keep_txt(body))
    track.run(eid)
    return node
}

// --- reactive style props ---
//
// A style prop is a thunk (`fn() -> int` / `fn() -> string` / `fn() -> BoxStyle`):
// the compiler auto-wraps a plain value, so `color = "red"` and
// `color = if sel { accent() } else { muted() }` behave identically. Each
// widget registers the thunk as a tracked effect on its node, and a `get(sig)`
// inside it re-runs just that prop — re-applying its setter — when `sig`
// changes. This is the declarative replacement for `styled(node, fn() {
// paint(node) })` closures: no node mutation after build, everything rides in
// the props. `mode` picks the setter (see the `StyleStr` / `StyleInt` enums);
// the sentinel checks mirror the old plain-value props (`> 0` / `>= 0`).

/// Default thunks for props the caller did not pass. Their values are never
/// consulted — an unpassed prop registers no effect — so one default per type
/// is enough.
fn style_str_default() -> string {
    return ""
}
fn style_int_default() -> int {
    return 0
}
fn style_box_default() -> BoxStyle {
    return BoxStyle {}
}

/// Main-axis direction for `Box(align_direction = ...)`. Values are the
/// engine's `dir` codes — `DIRECTION.Row` is a plain `int` constant.
enum DIRECTION {
    Row = 0,
    Column = 1,
}

/// Cross-axis / main-axis alignment for `align_items` / `justify_content`.
/// Values mirror `zeuscore/geometry.yuga`'s `flex_*` constants.
enum ALIGN {
    Start = 0,
    Center = 1,
    End = 2,
    Between = 3,
    Around = 4,
    Evenly = 5,
    Stretch = 6,
}

/// Mode codes for `bind_style_s`.
enum StyleStr {
    Fg = 0,
    Bg = 1,
    BorderColor = 2,
}

/// Mode codes for `bind_style_i`. `Border` applies unconditionally so a
/// reactive `border = if sel { 1 } else { 0 }` can clear the border; every
/// other mode keeps its sentinel check. `DirDefaultAlign` also applies the
/// row/column default cross-axis alignment (used when `align_items` was not
/// passed); `DirOnly` is used when `align_items` was passed explicitly.
enum StyleInt {
    W = 0,
    H = 1,
    Pad = 2,
    Radius = 3,
    Font = 4,
    SizePx = 5,
    Grow = 6,
    Shrink = 7,
    MinW = 8,
    MaxW = 9,
    MinH = 10,
    MaxH = 11,
    Opacity = 12,
    Position = 13,
    PinTop = 14,
    PinLeft = 15,
    ZIndex = 16,
    AlignSelf = 17,
    Margin = 18,
    PadX = 19,
    PadY = 20,
    PadTop = 21,
    PadRight = 22,
    PadBottom = 23,
    PadLeft = 24,
    Gap = 25,
    Border = 26,
    Align = 27,
    Justify = 28,
    Overflow = 29,
    Flex = 30,
    DirDefaultAlign = 31,
    DirOnly = 32,
}

let mut sty_eids: []int = []int {}
let mut sty_nodes: []int = []int {}
/// 0 = string body, 1 = int body, 2 = BoxStyle body.
let mut sty_kinds: []int = []int {}
let mut sty_modes: []int = []int {}
/// Index of this row's body in its kind's table: each body table holds only
/// its own kind's entries, so rows cannot share one index.
let mut sty_idxs: []int = []int {}
let mut sty_bodies_s: []fn() -> string = []fn() -> string {}
let mut sty_bodies_i: []fn() -> int = []fn() -> int {}
let mut sty_bodies_b: []fn() -> BoxStyle = []fn() -> BoxStyle {}

fn keep_sty_s(h: fn() -> string) -> fn() -> string {}
fn keep_sty_i(h: fn() -> int) -> fn() -> int {}
fn keep_sty_b(h: fn() -> BoxStyle) -> fn() -> BoxStyle {}

/// One dispatch for every style effect: `track.run` pushes the effect id before
/// invoking, so the row selects the node, the body thunk, and the setter.
fn sty_dispatch() {
    if track.stack.len == 0 {
        return
    }
    let eid = track.stack[track.stack.len - 1]
    let n = sty_eids.len
    for i in 0..n {
        if sty_eids[i] == eid {
            let id = sty_nodes[i]
            let m = sty_modes[i]
            let ix = sty_idxs[i]
            if sty_kinds[i] == 0 {
                sty_apply_s(id, m, sty_bodies_s[ix]())
            } else if sty_kinds[i] == 1 {
                sty_apply_i(id, m, sty_bodies_i[ix]())
            } else {
                sty_apply_b(id, sty_bodies_b[ix]())
            }
            return
        }
    }
}

fn sty_apply_s(id: int, m: int, v: string) {
    let c = hex(v)
    if c >= 0 {
        if m == StyleStr.Fg {
            style.set_fg(id, c)
        } else if m == StyleStr.Bg {
            style.set_bg(id, c)
        } else if m == StyleStr.BorderColor {
            style.set_border_color(id, c)
        }
    }
}

fn sty_apply_i(id: int, m: int, v: int) {
    if m == StyleInt.Border {
        style.set_border(id, v)
    } else if m == StyleInt.W {
        if v >= 0 {
            style.set_w(id, v)
        }
    } else if m == StyleInt.H {
        if v >= 0 {
            style.set_h(id, v)
        }
    } else if m == StyleInt.Pad {
        if v > 0 {
            style.set_pad(id, v)
        }
    } else if m == StyleInt.Radius {
        if v > 0 {
            style.set_radius(id, v)
        }
    } else if m == StyleInt.Font {
        if v > 0 {
            style.set_font(id, v)
        }
    } else if m == StyleInt.SizePx {
        if v > 0 {
            style.set_size_px(id, v)
        }
    } else if m == StyleInt.Grow || m == StyleInt.Flex {
        if v > 0 {
            style.set_grow(id, v)
        }
    } else if m == StyleInt.Shrink {
        if v >= 0 {
            style.set_shrink(id, v)
        }
    } else if m == StyleInt.MinW {
        if v >= 0 {
            style.set_min_w(id, v)
        }
    } else if m == StyleInt.MaxW {
        if v >= 0 {
            style.set_max_w(id, v)
        }
    } else if m == StyleInt.MinH {
        if v >= 0 {
            style.set_min_h(id, v)
        }
    } else if m == StyleInt.MaxH {
        if v >= 0 {
            style.set_max_h(id, v)
        }
    } else if m == StyleInt.Opacity {
        if v >= 0 {
            style.set_opacity(id, v)
        }
    } else if m == StyleInt.Position {
        if v >= 0 {
            style.set_position(id, v)
        }
    } else if m == StyleInt.PinTop {
        if v >= 0 {
            style.set_pin_top(id, v)
        }
    } else if m == StyleInt.PinLeft {
        if v >= 0 {
            style.set_pin_left(id, v)
        }
    } else if m == StyleInt.ZIndex {
        if v > 0 {
            style.set_z_index(id, v)
        }
    } else if m == StyleInt.AlignSelf {
        if v >= 0 {
            style.set_align_self(id, v)
        }
    } else if m == StyleInt.Margin {
        if v > 0 {
            style.set_margin(id, v)
        }
    } else if m == StyleInt.PadX {
        if v > 0 {
            style.set_pad_x(id, v)
        }
    } else if m == StyleInt.PadY {
        if v > 0 {
            style.set_pad_y(id, v)
        }
    } else if m == StyleInt.PadTop {
        if v > 0 {
            style.set_pad_top(id, v)
        }
    } else if m == StyleInt.PadRight {
        if v > 0 {
            style.set_pad_right(id, v)
        }
    } else if m == StyleInt.PadBottom {
        if v > 0 {
            style.set_pad_bottom(id, v)
        }
    } else if m == StyleInt.PadLeft {
        if v > 0 {
            style.set_pad_left(id, v)
        }
    } else if m == StyleInt.Gap {
        if v > 0 {
            style.set_gap(id, v)
        }
    } else if m == StyleInt.Align {
        if v >= 0 {
            style.set_align(id, v)
        }
    } else if m == StyleInt.Justify {
        if v >= 0 {
            style.set_justify(id, v)
        }
    } else if m == StyleInt.Overflow {
        if v >= 0 {
            style.set_overflow(id, v)
        }
    } else if m == StyleInt.DirDefaultAlign || m == StyleInt.DirOnly {
        // `align_direction = DIRECTION.Row | DIRECTION.Column`. Row's default
        // cross-axis alignment is center, Column's is stretch — applied only
        // when `align_items` was not passed.
        if v == DIRECTION.Row {
            style.set_dir(id, 0)
            if m == StyleInt.DirDefaultAlign {
                style.set_align(id, ALIGN.Center)
            }
        } else if v == DIRECTION.Column {
            style.set_dir(id, 1)
            if m == StyleInt.DirDefaultAlign {
                style.set_align(id, ALIGN.Stretch)
            }
        }
    }
}

fn sty_apply_b(id: int, s: BoxStyle) {
    if s.width >= 0 {
        style.set_w(id, s.width)
    }
    if s.height >= 0 {
        style.set_h(id, s.height)
    }
    if s.padding > 0 {
        style.set_pad(id, s.padding)
    }
    if s.flex > 0 {
        style.set_grow(id, s.flex)
    }
    let bg = hex(s.background)
    if bg >= 0 {
        style.set_bg(id, bg)
    }
}

/// Register `body` as a tracked style effect on `node`: run it now (applying
/// the value) and again whenever a signal `body` reads changes.
fn bind_style_s(node: Node, mode: int, body: fn() -> string) -> Node {
    arena.ensure()
    let eid = track.alloc(platform.plat_intern_fn(sty_dispatch), node.id)
    push(sty_eids, eid)
    push(sty_nodes, node.id)
    push(sty_kinds, 0)
    push(sty_modes, mode)
    push(sty_bodies_s, keep_sty_s(body))
    push(sty_idxs, sty_bodies_s.len - 1)
    track.run(eid)
    return node
}

fn bind_style_i(node: Node, mode: int, body: fn() -> int) -> Node {
    arena.ensure()
    let eid = track.alloc(platform.plat_intern_fn(sty_dispatch), node.id)
    push(sty_eids, eid)
    push(sty_nodes, node.id)
    push(sty_kinds, 1)
    push(sty_modes, mode)
    push(sty_bodies_i, keep_sty_i(body))
    push(sty_idxs, sty_bodies_i.len - 1)
    track.run(eid)
    return node
}

fn bind_style_b(node: Node, body: fn() -> BoxStyle) -> Node {
    arena.ensure()
    let eid = track.alloc(platform.plat_intern_fn(sty_dispatch), node.id)
    push(sty_eids, eid)
    push(sty_nodes, node.id)
    push(sty_kinds, 2)
    push(sty_modes, 0)
    push(sty_bodies_b, keep_sty_b(body))
    push(sty_idxs, sty_bodies_b.len - 1)
    track.run(eid)
    return node
}

// --- widgets ---

/// Text. `body` is a thunk, so `Text("Count: {{count.get()}}")` re-runs only
/// this label's effect when `count` changes — no parent rebuild. Style props
/// are thunks too: `Text("x", color = if sel { accent() } else { muted() })`
/// re-applies just the colour when `sel` changes.
fn Text(body: fn() -> string, p: TextProps) -> Node {
    let n = ui_emit(raw_label(""))
    if p.color__set {
        let t = p.color
        bind_style_s(n, StyleStr.Fg, t)
    }
    if p.font__set {
        let t = p.font
        bind_style_i(n, StyleInt.Font, t)
    }
    if p.width__set {
        let t = p.width
        bind_style_i(n, StyleInt.W, t)
    }
    if p.grow__set {
        let t = p.grow
        bind_style_i(n, StyleInt.Grow, t)
    }
    if p.shrink__set {
        let t = p.shrink
        bind_style_i(n, StyleInt.Shrink, t)
    }
    if p.min_w__set {
        let t = p.min_w
        bind_style_i(n, StyleInt.MinW, t)
    }
    if p.pad_x__set {
        let t = p.pad_x
        bind_style_i(n, StyleInt.PadX, t)
    }
    if p.pad_y__set {
        let t = p.pad_y
        bind_style_i(n, StyleInt.PadY, t)
    }
    if p.pad_left__set {
        let t = p.pad_left
        bind_style_i(n, StyleInt.PadLeft, t)
    }
    if p.pad_right__set {
        let t = p.pad_right
        bind_style_i(n, StyleInt.PadRight, t)
    }
    if p.wrap {
        style.set_flex_wrap(n.id)
    }
    if p.hover_fade {
        hover_fade(n)
    }
    return bind_text(n, body)
}

/// Clickable button. `Button("Save", on_click = fn() => save())`.
fn Button(body: fn() -> string, p: BtnProps) -> Node {
    let n = ui_emit(raw_button(""))
    if p.color__set {
        let t = p.color
        bind_style_s(n, StyleStr.Fg, t)
    }
    if p.background__set {
        let t = p.background
        bind_style_s(n, StyleStr.Bg, t)
    }
    if p.font__set {
        let t = p.font
        bind_style_i(n, StyleInt.Font, t)
    }
    if p.padding__set {
        let t = p.padding
        bind_style_i(n, StyleInt.Pad, t)
    }
    if p.pad_x__set {
        let t = p.pad_x
        bind_style_i(n, StyleInt.PadX, t)
    }
    if p.pad_y__set {
        let t = p.pad_y
        bind_style_i(n, StyleInt.PadY, t)
    }
    if p.radius__set {
        let t = p.radius
        bind_style_i(n, StyleInt.Radius, t)
    }
    if p.size__set {
        let t = p.size
        bind_style_i(n, StyleInt.SizePx, t)
    }
    if p.width__set {
        let t = p.width
        bind_style_i(n, StyleInt.W, t)
    }
    if p.height__set {
        let t = p.height
        bind_style_i(n, StyleInt.H, t)
    }
    if p.shrink__set {
        let t = p.shrink
        bind_style_i(n, StyleInt.Shrink, t)
    }
    if p.border__set {
        let t = p.border
        bind_style_i(n, StyleInt.Border, t)
    }
    if p.border_color__set {
        let t = p.border_color
        bind_style_s(n, StyleStr.BorderColor, t)
    }
    if p.on_click__set && p.enabled {
        on_click(n, p.on_click)
    }
    if !p.enabled {
        style.set_opacity(n.id, 50)
    }
    return bind_text(n, body)
}

/// Generic container. Children come from the trailing block. Direction is
/// `align_direction = DIRECTION.Row` or `DIRECTION.Column` — there is no
/// separate `Row` / `Column` widget.
fn Box(p: BoxProps) -> Node {
    return apply_box(ui_emit(raw_box()), p)
}

/// 2D grid. `Grid(config = GridConfig(columns = 3, gap = 12))` or the flat
/// `Grid(columns = 3, gap = 12)`.
fn Grid(p: GridProps) -> Node {
    let mut cols = p.config.columns
    let mut g = p.config.gap
    let mut pad = p.config.padding
    if p.columns >= 0 {
        cols = p.columns
    }
    if p.gap >= 0 {
        g = p.gap
    }
    if p.padding >= 0 {
        pad = p.padding
    }
    let id = arena.alloc_node(2)
    arena.nodes[id].grid_cols = cols
    arena.nodes[id].gap = g
    let n = ui_emit(nd(id))
    if pad > 0 {
        style.set_pad(n.id, pad)
    }
    return n
}

/// Single-line text input. `Input(bind = sig)` writes each edit back into
/// `sig`; reading `sig` elsewhere re-runs just that dependent.
fn Input(p: InputProps) -> Node {
    let n = ui_emit(raw_input(p.placeholder))
    if p.width__set {
        let t = p.width
        bind_style_i(n, StyleInt.W, t)
    }
    if p.grow__set {
        let t = p.grow
        bind_style_i(n, StyleInt.Grow, t)
    }
    if p.color__set {
        let t = p.color
        bind_style_s(n, StyleStr.Fg, t)
    }
    if p.pad_x__set {
        let t = p.pad_x
        bind_style_i(n, StyleInt.PadX, t)
    }
    if p.pad_y__set {
        let t = p.pad_y
        bind_style_i(n, StyleInt.PadY, t)
    }
    if p.radius__set {
        let t = p.radius
        bind_style_i(n, StyleInt.Radius, t)
    }
    if p.border__set {
        let t = p.border
        bind_style_i(n, StyleInt.Border, t)
    }
    if p.border_color__set {
        let t = p.border_color
        bind_style_s(n, StyleStr.BorderColor, t)
    }
    if p.font__set {
        let t = p.font
        bind_style_i(n, StyleInt.Font, t)
    }
    if p.background__set {
        let t = p.background
        bind_style_s(n, StyleStr.Bg, t)
    }
    if p.padding__set {
        let t = p.padding
        bind_style_i(n, StyleInt.Pad, t)
    }
    if p.bind__set {
        arena.nodes[n.id].bind_str_sig = p.bind.id
        // Two-way binding. A buffer with text (a rebuild after typing) is
        // authoritative: sync it out. Otherwise seed the field with the
        // signal's value — never the placeholder, which is what `input_shown`
        // returns for an empty field. Every edit writes back via `after_edit`.
        if arena.nodes[n.id].edit_slot < 0 {
            arena.stamp_edits()
        }
        let slot = arena.nodes[n.id].edit_slot
        if slot >= 0 && platform.plat_edit_len(slot) > 0 {
            set(p.bind, platform.plat_edit_text(slot))
        } else if slot >= 0 {
            platform.plat_edit_set(slot, p.bind.get())
        }
    }
    if p.on_key_down__set {
        arena.nodes[n.id].key_down_fn = add_key_fn(p.on_key_down)
    }
    if p.on_key_up__set {
        arena.nodes[n.id].key_up_fn = add_key_fn(p.on_key_up)
    }
    if p.on_key_press__set {
        arena.nodes[n.id].key_press_fn = add_key_fn(p.on_key_press)
    }
    return n
}

// --- entry point ---

/// Open a window and build the tree declaratively, then run.
///
/// ```
/// fn main() {
///     App("Counter", 360, 240, fn() { Counter() })
/// }
/// ```
fn App(title: string, width: int, height: int, build: fn()) {
    init()
    window(title, width, height)
    ui_reset()
    build()
    run(ui_root())
}

// --- declarative kit: controls and chrome (ZEUS_SPEC.md examples) ---
// Struct names are global across modules, so these props structs are named
// to avoid the UI kit's (`ProgressProps`, `SliderProps`, `ScrollProps`,
// `DialogProps` all exist there) — the same reason `BtnProps` is not
// `ButtonProps`. Users never write these names: named arguments build them.

struct BarProps {
    sig: Signal<int> = Signal { id: 0 },
    sig__set: bool = false,
    height: fn() -> int = style_int_default,
    height__set: bool = false,
    radius: fn() -> int = style_int_default,
    radius__set: bool = false,
    background: fn() -> string = style_str_default,
    background__set: bool = false,
    color: fn() -> string = style_str_default,
    color__set: bool = false,
}

/// Horizontal bar whose fill tracks `sig` (0–100). Track colour is
/// `background`, fill colour is `color`.
fn Progress(p: BarProps) -> Node {
    let n = ui_emit(raw_progress())
    style.set_grow(n.id, 1)
    style.set_h(n.id, 4)
    style.set_radius(n.id, 2)
    style.set_bg(n.id, hex("#313244"))
    style.set_fg(n.id, hex("#89b4fa"))
    if p.height__set {
        let t = p.height
        bind_style_i(n, StyleInt.H, t)
    }
    if p.radius__set {
        let t = p.radius
        bind_style_i(n, StyleInt.Radius, t)
    }
    if p.background__set {
        let t = p.background
        bind_style_s(n, StyleStr.Bg, t)
    }
    if p.color__set {
        let t = p.color
        bind_style_s(n, StyleStr.Fg, t)
    }
    if p.sig__set {
        bind(n, p.sig)
    }
    return n
}

struct ToggleProps {
    sig: Signal<int> = Signal { id: 0 },
    sig__set: bool = false,
    width: fn() -> int = style_int_default,
    width__set: bool = false,
    height: fn() -> int = style_int_default,
    height__set: bool = false,
    radius: fn() -> int = style_int_default,
    radius__set: bool = false,
    background: fn() -> string = style_str_default,
    background__set: bool = false,
    color: fn() -> string = style_str_default,
    color__set: bool = false,
    border_color: fn() -> string = style_str_default,
    border_color__set: bool = false,
}

/// Switch. Clicking or pressing Space/Enter flips `sig` between 0 and 1.
fn Toggle(p: ToggleProps) -> Node {
    let n = ui_emit(raw_toggle())
    style.set_w(n.id, 32)
    style.set_h(n.id, 18)
    style.set_radius(n.id, 9)
    style.set_bg(n.id, hex("#313244"))
    style.set_fg(n.id, hex("#89b4fa"))
    style.set_border_color(n.id, hex("#cdd6f4"))
    if p.width__set {
        let t = p.width
        bind_style_i(n, StyleInt.W, t)
    }
    if p.height__set {
        let t = p.height
        bind_style_i(n, StyleInt.H, t)
    }
    if p.radius__set {
        let t = p.radius
        bind_style_i(n, StyleInt.Radius, t)
    }
    if p.background__set {
        let t = p.background
        bind_style_s(n, StyleStr.Bg, t)
    }
    if p.color__set {
        let t = p.color
        bind_style_s(n, StyleStr.Fg, t)
    }
    if p.border_color__set {
        let t = p.border_color
        bind_style_s(n, StyleStr.BorderColor, t)
    }

    if p.sig__set {
        bind(n, p.sig)
        on_click_toggle(n, p.sig)
        key(n, "space", "toggle.press")
        key(n, "enter", "toggle.press")
        on_key_toggle(n, "toggle.press", p.sig)
    }
    return n
}

struct CheckProps {
    sig: Signal<int> = Signal { id: 0 },
    sig__set: bool = false,
    width: fn() -> int = style_int_default,
    width__set: bool = false,
    height: fn() -> int = style_int_default,
    height__set: bool = false,
    radius: fn() -> int = style_int_default,
    radius__set: bool = false,
    background: fn() -> string = style_str_default,
    background__set: bool = false,
    color: fn() -> string = style_str_default,
    color__set: bool = false,
    border_color: fn() -> string = style_str_default,
    border_color__set: bool = false,
}

/// Checkbox square. Clicking or pressing Space/Enter flips `sig`.
fn Check(p: CheckProps) -> Node {
    let n = ui_emit(raw_check(""))
    style.set_w(n.id, 16)
    style.set_h(n.id, 16)
    style.set_radius(n.id, 4)
    style.set_bg(n.id, hex("#313244"))
    style.set_fg(n.id, hex("#89b4fa"))
    style.set_border_color(n.id, hex("#cdd6f4"))
    if p.width__set {
        let t = p.width
        bind_style_i(n, StyleInt.W, t)
    }
    if p.height__set {
        let t = p.height
        bind_style_i(n, StyleInt.H, t)
    }
    if p.radius__set {
        let t = p.radius
        bind_style_i(n, StyleInt.Radius, t)
    }
    if p.background__set {
        let t = p.background
        bind_style_s(n, StyleStr.Bg, t)
    }
    if p.color__set {
        let t = p.color
        bind_style_s(n, StyleStr.Fg, t)
    }
    if p.border_color__set {
        let t = p.border_color
        bind_style_s(n, StyleStr.BorderColor, t)
    }

    if p.sig__set {
        bind(n, p.sig)
        on_click_toggle(n, p.sig)
        key(n, "space", "check.press")
        key(n, "enter", "check.press")
        on_key_toggle(n, "check.press", p.sig)
    }
    return n
}

struct RangeProps {
    sig: Signal<int> = Signal { id: 0 },
    sig__set: bool = false,
    height: fn() -> int = style_int_default,
    height__set: bool = false,
    radius: fn() -> int = style_int_default,
    radius__set: bool = false,
    background: fn() -> string = style_str_default,
    background__set: bool = false,
    color: fn() -> string = style_str_default,
    color__set: bool = false,
    border_color: fn() -> string = style_str_default,
    border_color__set: bool = false,
}

/// Draggable 0–100 slider writing `sig`. Arrow keys nudge it too.
fn Slider(p: RangeProps) -> Node {
    let n = ui_emit(raw_slider())
    style.set_grow(n.id, 1)
    style.set_h(n.id, 16)
    style.set_radius(n.id, 2)
    style.set_bg(n.id, hex("#313244"))
    style.set_fg(n.id, hex("#89b4fa"))
    style.set_border_color(n.id, hex("#89b4fa"))
    if p.height__set {
        let t = p.height
        bind_style_i(n, StyleInt.H, t)
    }
    if p.radius__set {
        let t = p.radius
        bind_style_i(n, StyleInt.Radius, t)
    }
    if p.background__set {
        let t = p.background
        bind_style_s(n, StyleStr.Bg, t)
    }
    if p.color__set {
        let t = p.color
        bind_style_s(n, StyleStr.Fg, t)
    }
    if p.border_color__set {
        let t = p.border_color
        bind_style_s(n, StyleStr.BorderColor, t)
    }
    if p.sig__set {
        bind(n, p.sig)
        keys(n, p.sig, 0, 100)
    }
    return n
}

/// Elastic spacer between row/column children.
fn Spacer() -> Node {
    return ui_emit(raw_spacer())
}

/// One-pixel horizontal rule.
fn Divider() -> Node {
    let n = ui_emit(raw_box())
    style.set_h(n.id, 1)
    style.set_bg(n.id, hex("#313244"))
    return n
}

struct ViewProps {
    background: fn() -> string = style_str_default,
    background__set: bool = false,
    padding: fn() -> int = style_int_default,
    padding__set: bool = false,
    spacing: fn() -> int = style_int_default,
    spacing__set: bool = false,
    height: fn() -> int = style_int_default,
    height__set: bool = false,
}

/// Vertical page scroller: the widget every app wraps its content in.
fn Scroll(p: ViewProps) -> Node {
    let n = ui_emit(raw_scroll())
    if p.background__set {
        let t = p.background
        bind_style_s(n, StyleStr.Bg, t)
    }
    if p.padding__set {
        let t = p.padding
        bind_style_i(n, StyleInt.Pad, t)
    }
    if p.spacing__set {
        let t = p.spacing
        bind_style_i(n, StyleInt.Gap, t)
    }
    if p.height__set {
        let t = p.height
        bind_style_i(n, StyleInt.H, t)
    }
    return n
}

struct SvgProps {
    markup: string = "",
    color: fn() -> string = style_str_default,
    color__set: bool = false,
    size: fn() -> int = style_int_default,
    size__set: bool = false,
    shrink: fn() -> int = style_int_default,
    shrink__set: bool = false,
}

/// Inline SVG glyph painted in `color`. `currentColor` in the markup takes
/// that colour.
fn Svg(p: SvgProps) -> Node {
    let n = ui_emit(raw_svg(p.markup))
    if p.size__set {
        let t = p.size
        bind_style_i(n, StyleInt.SizePx, t)
    }
    if p.color__set {
        let t = p.color
        bind_style_s(n, StyleStr.Fg, t)
    }
    if p.shrink__set {
        let t = p.shrink
        bind_style_i(n, StyleInt.Shrink, t)
    }
    return n
}

struct ModalProps {
    title: string = "",
    body: string = "",
    cancel: string = "Cancel",
    discard: string = "Discard",
    open: Signal<int> = Signal { id: 0 },
    open__set: bool = false,
    // Card. `width` is what lets the body wrap instead of running on one line.
    background: string = "",
    border: string = "",
    radius: int = 0,
    width: int = 0,
    padding: int = 0,
    spacing: int = 0,
    // Scrim behind the card.
    scrim: string = "",
    scrim_opacity: int = 0,
    // Type. Passed in rather than hardcoded so the theme owns the palette.
    title_color: string = "",
    title_font: int = 0,
    body_color: string = "",
    body_font: int = 0,
    // Footer buttons: ghost cancel, filled destructive.
    cancel_color: string = "",
    discard_background: string = "",
    discard_color: string = "",
    button_pad_x: int = 0,
    button_pad_y: int = 0,
    button_radius: int = 0,
}

/// Scrim + centred card, shown while `open` is non-zero. Clicking the scrim
/// or either button clears it. Emits nothing when `open` is not passed.
fn Dialog(p: ModalProps) -> Node {
    if !p.open__set {
        return nd(0)
    }
    // The overlay node centres the card and stacks it above the page.
    let dim = ui_emit(raw_overlay())
    style.set_dir(dim.id, 1)
    style.set_justify(dim.id, ALIGN.Center)
    style.set_align(dim.id, ALIGN.Center)
    style.set_z_index(dim.id, 50)
    show(dim, p.open)
    on_click(dim, fn() => p.open.set(0))
    let scrim_rgb = hex(p.scrim)
    if scrim_rgb >= 0 {
        style.set_bg(dim.id, scrim_rgb)
    }
    if p.scrim_opacity > 0 {
        style.set_opacity(dim.id, p.scrim_opacity)
    }
    __ui_scope(dim, || {
        let card = Box(align_direction = DIRECTION.Column, background = p.background, spacing = p.spacing)
        if p.width > 0 {
            style.set_w(card.id, p.width)
        }
        if p.padding > 0 {
            style.set_pad(card.id, p.padding)
        }
        if p.radius > 0 {
            style.set_radius(card.id, p.radius)
        }
        let edge = hex(p.border)
        if edge >= 0 {
            style.set_border(card.id, 1)
            style.set_border_color(card.id, edge)
        }
        // The card sizes to `width`; without this the scrim would stretch it.
        style.set_shrink(card.id, 0)
        style.set_align(card.id, ALIGN.Stretch)
        __ui_scope(card, || {
            Text(p.title, color = p.title_color, font = p.title_font)
            Text(p.body, color = p.body_color, font = p.body_font, wrap = true)
            let foot = Box(align_direction = DIRECTION.Row, justify_content = ALIGN.End, spacing = p.spacing)
            __ui_scope(foot, || {
                if p.cancel.len > 0 {
                    // Ghost: text only, no fill.
                    let b = Button(p.cancel, color = p.cancel_color, font = p.body_font,
                                   on_click = fn() => p.open.set(0))
                    style.set_pad_x(b.id, p.button_pad_x)
                    style.set_pad_y(b.id, p.button_pad_y)
                    style.set_radius(b.id, p.button_radius)
                }
                if p.discard.len > 0 {
                    let b = Button(p.discard, color = p.discard_color, background = p.discard_background,
                                   font = p.body_font, on_click = fn() => p.open.set(0))
                    style.set_pad_x(b.id, p.button_pad_x)
                    style.set_pad_y(b.id, p.button_pad_y)
                    style.set_radius(b.id, p.button_radius)
                }
            })
        })
    })
    return dim
}

/// Current text of a node. Test/debug helper.
fn node_text(id: int) -> string {
    return arena.nodes[id].text
}

// --- key codes (ZEUS_SPEC.md `Key.K`) ---
/// Key event codes. Printable keys are their ASCII code (letters lowercase,
/// so `Key.K` is 107, the same value the old `key_k()` returned); `Key`
/// names the rest. Compare against `KeyEvent.key` in `on_key_down` handlers:
///
/// ```
/// on_key_down = fn(e: KeyEvent) {
///     if e.ctrl && e.key == Key.K {
///         print("Shortcut triggered!")
///     }
/// }
/// ```
enum Key {
    Enter = 13,
    Escape = 27,
    Backspace = 8,
    Tab = 9,
    Space = 32,
    A = 97,
    B = 98,
    C = 99,
    D = 100,
    E = 101,
    F = 102,
    G = 103,
    H = 104,
    I = 105,
    J = 106,
    K = 107,
    L = 108,
    M = 109,
    N = 110,
    O = 111,
    P = 112,
    Q = 113,
    R = 114,
    S = 115,
    T = 116,
    U = 117,
    V = 118,
    W = 119,
    X = 120,
    Y = 121,
    Z = 122,
}

/// Legacy names for `Key.*` constants. New code writes `Key.K`.
fn key_a() -> int {
    return 97
}
fn key_k() -> int {
    return 107
}
fn key_enter() -> int {
    return 13
}
fn key_escape() -> int {
    return 27
}
fn key_backspace() -> int {
    return 8
}
fn key_tab() -> int {
    return 9
}

/// Laid-out position of a node. Test/debug helpers.
fn node_x(id: int) -> int {
    return arena.nodes[id].x
}
fn node_y(id: int) -> int {
    return arena.nodes[id].y
}
fn node_w(id: int) -> int {
    return arena.nodes[id].w
}
fn node_h(id: int) -> int {
    return arena.nodes[id].h
}
fn node_ew(id: int) -> int {
    return arena.nodes[id].ew
}
fn node_eh(id: int) -> int {
    return arena.nodes[id].eh
}

/// Current paint alpha (0-255) of a node. Test/debug helper.
fn node_alpha(id: int) -> int {
    return arena.paint_alpha(id)
}
fn node_fg(id: int) -> int {
    return arena.nodes[id].fg
}

/// `i`-th child id of `node`, or 0. Lets a component reach a child it built
/// inside a trailing block, where the handle is not returned.
fn node_kid(id: int, i: int) -> int {
    if id <= 0 || id >= arena.nodes.len {
        return 0
    }
    if i < 0 || i >= arena.nodes[id].kids.len {
        return 0
    }
    return arena.nodes[id].kids[i]
}
fn node_pad_l(id: int) -> int {
    return arena.nodes[id].pad_l
}
fn node_pad_t(id: int) -> int {
    return arena.nodes[id].pad_t
}
fn node_radius(id: int) -> int {
    return arena.nodes[id].radius
}
