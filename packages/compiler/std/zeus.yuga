//! `zeus` — declarative UI toolkit. Native Cocoa and WASM/Canvas2D run the
//! same source.
//!
//! Widgets are functions taking named props; containers take a trailing
//! block. No chaining: style and behavior are props, not `.pad(8).gap(4)`
//! method calls. Names are unqualified — `import "std:zeus"` exposes
//! `Text`, `Button`, `Box`, `signal`, `App`, … directly.
//!
//! Example:
//! ```
//! import "std:zeus"
//!
//! fn Counter() {
//!     let count = signal(0)
//!     Box(align_direction = DIRECTION.Column, spacing = 8, padding = 16) {
//!         Text("Count: {{count.get()}}")
//!         Button("Increment", on_click = fn() => count.set(count.get() + 1))
//!     }
//! }
//!
//! fn main() {
//!     App("Counter", 320, 200, fn() { Counter() })
//! }
//! ```
//!
//! `Box(align_direction = DIRECTION.Row | DIRECTION.Column)` replaces the old
//! `Row` / `Column` widgets. Events ride in as props (`on_click`, `on_key_down`,
//! `on_mouse_down`, …) with inline `fn(e)` closures; `Key.K`-style enum
//! constants name key codes. State is `signal` / `sig.get()` / `sig.set()`.
//! Advanced wiring (`key`, `show`, `each`, …) stays available as plain
//! functions taking the node first — never as method chains. Style is props,
//! and a prop value that reads a signal re-applies just that prop.
//!
//! Per-frame rebuild: `view(|| { ... })`. Kit apps that build once stay
//! retained (omit `view`). Internals: `std/zeuscore/*.yuga`. `Node` is
//! `{ id: int }` (not generic). `each<T>` is the generic list helper.
//! See `docs/boundary.md`. `ZEUS_HEADLESS=1` layouts once and exits.

import "zeuscore/geometry.yuga"
import "zeuscore/platform.yuga"
import "zeuscore/arena.yuga"
import "zeuscore/layout.yuga"
import "zeuscore/scene.yuga"
import "zeuscore/input.yuga"
import "zeuscore/track.yuga"
import "zeuscore/style.yuga"
import "std:fmt"

/// A widget in the tree. Copy handle (`id`). Never constructed by hand; use
/// the declarative widgets (`Text`, `Button`, `Box`, …).
struct Node {
    /// Slot in the engine arena.
    id: int,
}

/// Opaque reactive cell. Copy handle (`id`). `T` must be Copy (`int`,
/// `string`, `float`, `bool`, or a Copy struct). Read and write with
/// `sig.get()` / `sig.set(v)`:
///
/// ```
/// let n = signal(0)
/// n.set(n.get() + 1)
/// ```
struct Signal<T> {
    id: int,
}

fn empty_view() -> Node {
    return Node { id: 0 }
}

let mut has_view: int = 0
let mut view_fn: fn() -> Node = empty_view
let mut hook_ids: []int = []int {}
let mut hook_at: int = 0

fn nd(id: int) -> Node {
    return Node { id: id }
}

fn sg(id: int) -> Signal<int> {
    return Signal { id: id }
}

fn raw_init() {
    arena.ensure()
}

fn open_window(title: string, width: int, height: int) {
    arena.ensure()
    arena.win_w = width
    arena.win_h = height
    platform.plat_set_window(title, width, height)
}

fn raw_run() {
    arena.ensure()
    if platform.plat_headless() != 0 {
        engine_layout(arena.win_w, arena.win_h)
        return
    }
    platform.plat_run()
}

fn init() {
    raw_init()
}

/// Open a native window. Sizes are CSS-like points, not pixels.
/// Prefer `App(...)` or `run(...)` over calling this alone.
fn window(title: string, width: int, height: int) {
    init()
    open_window(title, width, height)
}

/// Enter the event loop for the built tree. `ZEUS_HEADLESS=1` layouts once
/// and exits (tests).
///
/// Example:
/// ```
/// App("Demo", 400, 300, fn() { Text("Hi") })
/// ```
fn run(node: Node) {
    init()
    arena.root_id = node.id
    raw_run()
}

/// GPUI-style: each frame rebuilds the element tree from signals.
/// Omit this and the tree stays retained (kit apps).
fn view(build: fn() -> Node) {
    init()
    view_fn = build
    has_view = 1
}

// --- signals (live Copy state) ---

/// Allocate a live cell. `T` is inferred from `value`.
///
/// Example:
/// ```
/// let count = signal(0)
/// Button("+", on_click = fn() => count.set(count.get() + 1))
/// ```
fn signal<T>(value: T) -> Signal<T> {
    arena.ensure()
    Signal { id: __sig_push(value) }
}

/// Read the current value of `sig`. Inside a tracked effect (a text thunk or
/// a style-prop thunk) this records `sig` as a dependency of that effect.
/// Call as `sig.get()`.
fn get<T>(sig: Signal<T>) -> T {
    arena.ensure()
    track.note_read(sig.id)
    __sig_load(sig.id)
}
/// Write `value` into `sig`. Re-runs every tracked effect that last read it.
/// Call as `sig.set(value)`.
fn set<T>(sig: Signal<T>, value: T) {
    arena.ensure()
    __sig_store(sig.id, value)
}

fn hook_begin() {
    hook_at = 0
}

fn hook_signal(init: int) -> Signal<int> {
    arena.ensure()
    if hook_at >= hook_ids.len {
        push(arena.sigs, init)
        let sid = arena.sigs.len - 1
        platform.plat_sig_bind_int(sid, init)
        push(hook_ids, sid)
    }
    let sid = hook_ids[hook_at]
    hook_at = hook_at + 1
    return sg(sid)
}

// --- unstyled allocators ---
/// Kinds: 1 box/row/col, 2 grid, 3 label, 4 button, 5 spacer, 6 progress,
/// 7 toggle, 8 check, 9 overlay, 10 input, 11 scroll, 12 svg, 13 slider.

fn raw_row() -> Node {
    let id = arena.alloc_node(1)
    arena.nodes[id].dir = 0
    return nd(id)
}
fn raw_col() -> Node {
    let id = arena.alloc_node(1)
    arena.nodes[id].dir = 1
    return nd(id)
}
fn raw_box() -> Node {
    return nd(arena.alloc_node(1))
}
fn raw_label(text: string) -> Node {
    let id = arena.alloc_node(3)
    arena.nodes[id].text = text
    return nd(id)
}
fn raw_button(text: string) -> Node {
    let id = arena.alloc_node(4)
    arena.nodes[id].text = text
    return nd(id)
}
fn raw_spacer() -> Node {
    return nd(arena.alloc_node(5))
}
fn raw_progress() -> Node {
    return nd(arena.alloc_node(6))
}
fn raw_slider() -> Node {
    return nd(arena.alloc_node(13))
}
fn raw_toggle() -> Node {
    return nd(arena.alloc_node(7))
}
fn raw_check(markup: string) -> Node {
    let id = arena.alloc_node(8)
    arena.nodes[id].text = markup
    return nd(id)
}
fn raw_overlay() -> Node {
    let id = arena.alloc_node(9)
    arena.nodes[id].pos = 1
    arena.nodes[id].enter_fade = 1
    return nd(id)
}
fn raw_input(placeholder: string) -> Node {
    let id = arena.alloc_node(10)
    arena.nodes[id].text = placeholder
    arena.nodes[id].focusable = 1
    arena.nodes[id].capture_text = 1
    return nd(id)
}
fn raw_scroll() -> Node {
    let id = arena.alloc_node(11)
    arena.nodes[id].dir = 1
    arena.nodes[id].overflow = 2
    return nd(id)
}
fn raw_svg(markup: string) -> Node {
    let id = arena.alloc_node(12)
    arena.nodes[id].text = markup
    return nd(id)
}
fn raw_hover(node: Node, sig: Signal<int>) -> Node {
    arena.nodes[node.id].hover_sig = sig.id
    return node
}

// --- tree ---

/// Attach `node` under `parent`. Plain call — never chained.
fn child(parent: Node, node: Node) -> Node {
    arena.ensure()
    push(arena.nodes[parent.id].kids, node.id)
    arena.nodes[node.id].parent = parent.id
    return parent
}

/// Attach `node` under `parent` and return `node`, so a component can fill it
/// after building (the counterpart of `child`, which returns the parent).
fn add(parent: Node, node: Node) -> Node {
    parent.child(node)
    return node
}

fn root(node: Node) -> Node {
    arena.ensure()
    arena.root_id = node.id
    return node
}

/// Run `handler` now and again whenever a `Signal` it `get`s changes.
/// Kept for compatibility: style changes belong in reactive props now
/// (`Box(border = if sel { 1 } else { 0 })`), so new code should not need it.
fn with_size(node: Node, s: int) -> Node {
    arena.nodes[node.id].ui_size = s
    track.run_node(node.id)
    return node
}

fn with_look(node: Node, v: int) -> Node {
    arena.nodes[node.id].ui_look = v
    track.run_node(node.id)
    return node
}

fn size_of(node: Node) -> int {
    return arena.nodes[node.id].ui_size
}

fn look_of(node: Node) -> int {
    return arena.nodes[node.id].ui_look
}

// --- reactivity ---
/// Clicks write a signal (`on_click_inc` / `on_click_toggle` / `on_click_set`
/// / `on_click_add`). `show` / `show_eq` / `show_ne` / `show_ge` / `show_le`
/// hide a node from layout while false. `bind` paints a label from a signal's
/// int, `bind_n` from a captured `let mut`.

fn bind(label: Node, sig: Signal<int>) -> Node {
    arena.nodes[label.id].bind_sig = sig.id
    return label
}

/// Paint an int. Pass a component `let mut` directly so retained paint stays
/// live; a plain int (a prop) snapshots until the parent view rebuilds.
fn bind_n(label: Node, n: int) -> Node {
    arena.nodes[label.id].bind_sig = -1
    arena.nodes[label.id].click_set = n
    return label
}

fn on_click_inc(button: Node, sig: Signal<int>) -> Node {
    arena.nodes[button.id].click_sig = sig.id
    arena.nodes[button.id].click_mode = 0
    return button
}
fn on_click_toggle(node: Node, sig: Signal<int>) -> Node {
    arena.nodes[node.id].click_sig = sig.id
    arena.nodes[node.id].click_mode = 1
    return node
}
fn on_click_set(node: Node, sig: Signal<int>, value: int) -> Node {
    arena.nodes[node.id].click_sig = sig.id
    arena.nodes[node.id].click_mode = 2
    arena.nodes[node.id].click_set = value
    return node
}
fn on_click_add(node: Node, sig: Signal<int>, delta: int) -> Node {
    arena.nodes[node.id].click_sig = sig.id
    arena.nodes[node.id].click_mode = 3
    arena.nodes[node.id].click_set = delta
    return node
}

fn on_click_also_set(node: Node, sig: Signal<int>, value: int) -> Node {
    arena.nodes[node.id].click2_sig = sig.id
    arena.nodes[node.id].click2_mode = 2
    arena.nodes[node.id].click2_set = value
    return node
}

fn click() -> int {
    return 1
}

fn on(node: Node, event: int, handler: fn()) -> Node {
    if event == 1 {
        arena.nodes[node.id].click_fn = platform.plat_intern_fn(handler)
    }
    return node
}

/// Click handler. `on_click(n, h)` is `on(n, click(), h)`.
fn on_click(node: Node, handler: fn()) -> Node {
    return on(node, click(), handler)
}

/// Map `items` into children of `parent`. `build` receives `(index, item)`.
fn each<T>(parent: Node, items: []T, build: fn(int, T) -> Node) -> Node {
    let n = items.len
    for i in 0..n {
        parent.child(build(i, items[i]))
    }
    return parent
}

/// Combinator form of `show`: builds the child once and hides it from layout
/// while `sig` is 0.
fn when(sig: Signal<int>, build: fn() -> Node) -> Node {
    return show(build(), sig)
}

fn show(node: Node, sig: Signal<int>) -> Node {
    arena.nodes[node.id].show_sig = sig.id
    arena.nodes[node.id].show_mode = 0
    return node
}
fn show_eq(node: Node, sig: Signal<int>, value: int) -> Node {
    arena.nodes[node.id].show_sig = sig.id
    arena.nodes[node.id].show_mode = 1
    arena.nodes[node.id].show_val = value
    return node
}
fn show_ne(node: Node, sig: Signal<int>, value: int) -> Node {
    arena.nodes[node.id].show_sig = sig.id
    arena.nodes[node.id].show_mode = 2
    arena.nodes[node.id].show_val = value
    return node
}
fn show_ge(node: Node, sig: Signal<int>, value: int) -> Node {
    arena.nodes[node.id].show_sig = sig.id
    arena.nodes[node.id].show_mode = 3
    arena.nodes[node.id].show_val = value
    return node
}
fn show_le(node: Node, sig: Signal<int>, value: int) -> Node {
    arena.nodes[node.id].show_sig = sig.id
    arena.nodes[node.id].show_mode = 4
    arena.nodes[node.id].show_val = value
    return node
}

fn hover(node: Node, sig: Signal<int>) -> Node {
    return raw_hover(node, sig)
}

fn hover_delay(node: Node, ms: int) -> Node {
    return node
}
fn hover_leave(node: Node, ms: int) -> Node {
    return node
}

fn pulse(node: Node) -> Node {
    arena.nodes[node.id].pulse = 1
    return node
}

/// Pin a node's pulse phase (0..143) rather than deriving it from `nid`.
/// Evenly spaced phases around a ring turn the alpha wave into apparent
/// rotation without rotating anything.
fn phase(node: Node, p: int) -> Node {
    arena.nodes[node.id].pulse_phase = p
    return node
}

fn hover_fade(node: Node) -> Node {
    arena.nodes[node.id].hover_fade = 1
    return node
}

fn enter_fade(node: Node) -> Node {
    arena.nodes[node.id].enter_fade = 1
    return node
}
fn dismiss(node: Node) -> Node {
    return node
}

// --- keyboard ---
/// A chord on a focused node resolves to a named action; a handler on that
/// same node writes a signal. App remaps (`map_key` / `remap_key`) still use
/// the action name, so a shortcut can move without the component changing.
/// Context is the family of the first action (`button.press` → `button`).
///
/// mode: 0 inc, 1 toggle, 2 set, 3 add — the same codes on_click_* uses.

fn key_context(node: Node, name: string) -> Node {
    arena.nodes[node.id].key_ctx = platform.plat_key_intern(name)
    return node
}
fn focusable(node: Node) -> Node {
    arena.nodes[node.id].focusable = 1
    return node
}
fn capture_text(node: Node) -> Node {
    arena.nodes[node.id].capture_text = 1
    arena.nodes[node.id].focusable = 1
    return node
}
fn on_action(node: Node, action: string, sig: Signal<int>, mode: int, value: int) -> Node {}
fn on_action_global(action: string, sig: Signal<int>, mode: int, value: int) {}

/// Step `sig` by `delta`, clamped to lo..hi — arrow navigation over a range.
fn on_range(node: Node, action: string, sig: Signal<int>, delta: int, lo: int, hi: int) -> Node {}
fn map_key(spec: string, action: string, ctx: string) {}
fn remap_key(spec: string, action: string, ctx: string) {}

/// Chord → action on this node. The action family (`button.press` → `button`)
/// is the keymap context; `key_context` is only needed to override that name.
/// Implies focusable — a node with a key binding needs focus to receive it,
/// so components don't call both.
fn key(node: Node, spec: string, action: string) -> Node {
    let mut ctx = arena.nodes[node.id].key_ctx
    if ctx == 0 {
        ctx = platform.plat_key_intern_action(action)
        arena.nodes[node.id].key_ctx = ctx
    }
    if ctx != 0 {
        platform.plat_map_key(spec, action, ctx)
    }
    arena.nodes[node.id].focusable = 1
    return node
}

fn on_key_set(node: Node, action: string, sig: Signal<int>, value: int) -> Node {
    return on_action(node, action, sig, 2, value)
}

fn on_key_add(node: Node, action: string, sig: Signal<int>, delta: int) -> Node {
    return on_action(node, action, sig, 3, delta)
}

fn on_key_toggle(node: Node, action: string, sig: Signal<int>) -> Node {
    return on_action(node, action, sig, 1, 0)
}

fn on_key_fn(node: Node, action: string) -> Node {
    return on_action(node, action, sg(0), 5, arena.nodes[node.id].click_fn)
}

fn global_key_set(action: string, sig: Signal<int>, value: int) {
    on_action_global(action, sig, 2, value)
}

fn keys(node: Node, sig: Signal<int>, lo: int, hi: int) -> Node {
    let mut n = on_range(node, "slider.inc", sig, 1, lo, hi)
    n = on_range(n, "slider.dec", sig, -1, lo, hi)
    n = key(n, "right", "slider.inc")
    n = key(n, "left", "slider.dec")
    n = focusable(n)
    return n
}
fn keys_page(node: Node, sig: Signal<int>) -> Node {
    let mut n = key(node, "right", "page.next")
    n = key(n, "left", "page.prev")
    n = on_key_add(n, "page.next", sig, 1)
    n = on_key_add(n, "page.prev", sig, -1)
    return focusable(n)
}

// --- position / overflow constants (public; implemented in geometry) ---

fn pos_relative() -> int {
    return geometry.pos_relative()
}
fn pos_absolute() -> int {
    return geometry.pos_absolute()
}
fn overflow_visible() -> int {
    return geometry.overflow_visible()
}
fn overflow_hidden() -> int {
    return geometry.overflow_hidden()
}
fn overflow_scroll() -> int {
    return geometry.overflow_scroll()
}
fn overflow_auto() -> int {
    return geometry.overflow_auto()
}
fn rgb(r: int, g: int, b: int) -> int {
    return geometry.rgb(r, g, b)
}

fn appearance() -> Signal<int> {
    arena.ensure()
    if arena.appearance_sid == 0 {
        let s = signal(0)
        arena.appearance_sid = s.id
    }
    return sg(arena.appearance_sid)
}

fn theme(slot: int, light: int, dark: int) {
    arena.ensure()
    if slot < 0 {
        return
    }
    arena.theme_grow(slot)
    if slot < arena.theme_l.len {
        arena.theme_l[slot] = light
        arena.theme_d[slot] = dark
    }
}

fn role(slot: int) -> int {
    if slot < 0 {
        return 0
    }
    return 2130706432 + slot
}

fn engine_key_apply(sid: int, mode: int, value: int, lo: int, hi: int) {
    arena.ensure()
    if mode == 5 {
        platform.plat_invoke_fn(value)
        return
    }
    if sid <= 0 {
        return
    }
    if sid >= arena.sigs.len {
        return
    }
    let mut next = arena.sigs[sid]
    if mode == 1 {
        if next == 0 {
            next = 1
        } else {
            next = 0
        }
    } else if mode == 2 {
        next = value
    } else if mode == 3 {
        next = next + value
    } else if mode == 4 {
        let mut vlo = lo
        let mut vhi = hi
        if vhi < vlo {
            let t = vlo
            vlo = vhi
            vhi = t
        }
        next = next + value
        if next < vlo {
            next = vlo
        }
        if next > vhi {
            next = vhi
        }
    } else {
        next = next + 1
    }
    arena.store_sig(sid, next)
}

fn engine_layout(width: int, height: int) {
    if has_view != 0 {
        arena.snapshot_focus()
        arena.snapshot_scroll()
        arena.reset_tree()
        platform.plat_key_reset()
        track.reset()
        hook_begin()
        let n = view_fn()
        arena.root_id = n.id
        arena.restore_scroll()
        arena.restore_focus()
        arena.stamp_edits()
    } else {
        arena.stamp_edits()
    }
    layout.layout(width, height)
}

fn engine_fill_focus() {
    arena.fill_focus_chain()
}

fn engine_focus_depth() -> int {
    return arena.chain_nodes.len
}

fn engine_focus_node(i: int) -> int {
    if i < 0 {
        return 0
    }
    if i >= arena.chain_nodes.len {
        return 0
    }
    return arena.chain_nodes[i]
}

fn engine_focus_ctx(i: int) -> int {
    if i < 0 {
        return 0
    }
    if i >= arena.chain_ctxs.len {
        return 0
    }
    return arena.chain_ctxs[i]
}

fn engine_focus_step(back: int) -> int {
    return arena.focus_step(back)
}

fn engine_focus_captures_text() -> int {
    return arena.focus_captures_text()
}

fn engine_key(key: int) -> int {
    return dispatch_key(key, 0, input.key(key))
}

fn engine_key_ev(key: int, mods: int) -> int {
    return dispatch_key(key, mods, platform.plat_key_ev(key, mods))
}

fn engine_key_up(key: int, mods: int) -> int {
    return dispatch_key_up(key, mods)
}

/// Deliver a `KeyEvent` to the focused node's `on_key_down`, after the normal
/// text/binding handling has run. `mods` is a bitmask: 1 shift, 2 ctrl, 4 alt.
/// The key is remembered so its `key_up` can complete the press.
fn dispatch_key(key: int, mods: int, r: int) -> int {
    let id = arena.focus_id
    if id <= 0 {
        return r
    }
    let h = arena.nodes[id].key_down_fn
    if h <= 0 {
        return r
    }
    ev_key = key
    ev_shift = mods % 2 == 1
    ev_ctrl = (mods / 2) % 2 == 1
    ev_alt = (mods / 4) % 2 == 1
    press_key = key
    fire_key(h)
    return r
}

/// Deliver a `KeyEvent` to the focused node's `on_key_up`; when this is the
/// key that went down, also fire its `on_key_press` — a full down→up cycle,
/// the keyboard analog of a click.
fn dispatch_key_up(key: int, mods: int) -> int {
    let id = arena.focus_id
    if id <= 0 {
        return 0
    }
    ev_key = key
    ev_shift = mods % 2 == 1
    ev_ctrl = (mods / 2) % 2 == 1
    ev_alt = (mods / 4) % 2 == 1
    let mut fired = 0
    let h = arena.nodes[id].key_up_fn
    if h > 0 {
        fire_key(h)
        fired = 1
    }
    let p = arena.nodes[id].key_press_fn
    if press_key == key && p > 0 {
        fire_key(p)
        fired = 1
    }
    if press_key == key {
        press_key = 0
    }
    return fired
}

// --- engine trampolines ---
/// Cocoa calls these through zeus_plat.c (`yuga_zeus_engine_*`). Do not use
/// from app code; use `App(...)`, clicks, and signals instead.

fn engine_paint() {
    scene.paint()
}

fn engine_step() -> int {
    return scene.step()
}

fn engine_click(px: int, py: int) -> int {
    ev_x = px
    ev_y = py
    ev_button = 0
    arena.last_hit = 0
    let r = input.click(px, py)
    let id = arena.last_hit
    if id > 0 {
        fire_mouse(arena.nodes[id].mouse_down_fn)
    }
    return r
}

fn engine_scroll(px: int, py: int, dx: int, dy: int) -> int {
    return input.scroll(px, py, dx, dy)
}

fn engine_drag(px: int, py: int) -> int {
    return input.drag(px, py)
}

fn engine_mouseup() {
    let id = arena.last_hit
    if id > 0 {
        ev_x = arena.nodes[id].x
        ev_y = arena.nodes[id].y
        fire_mouse(arena.nodes[id].mouse_up_fn)
    }
    input.mouseup()
}

fn engine_hover(px: int, py: int) -> int {
    return input.hover(px, py)
}

fn engine_over_button() -> int {
    return input.over_button()
}

fn draw_count() -> int {
    return scene.draws.len
}

fn dump() {
    let n = scene.draws.len
    println("DRAW", n)
    for i in 0..n {
        let d = scene.draws[i]
        if d.kind == 0 {
            println("fill", d.x, d.y, d.w, d.h, d.rgb, d.radius)
        } else if d.kind == 1 {
            println("fill_a", d.x, d.y, d.w, d.h, d.rgb, d.alpha)
        } else if d.kind == 2 {
            println("text", d.x, d.y, d.rgb, d.font, d.text)
        } else if d.kind == 3 {
            println("text_int", d.x, d.y, d.value, d.rgb, d.font)
        } else if d.kind == 4 {
            println("text_wrap", d.x, d.y, d.w, d.text)
        } else if d.kind == 6 {
            println("save")
        } else if d.kind == 7 {
            println("clip", d.x, d.y, d.w, d.h)
        } else if d.kind == 8 {
            println("restore")
        }
    }
}

fn snapshot(width: int, height: int, build: fn() -> Node) {
    window("zeus-snap", width, height)
    let n = build()
    root(n)
    engine_layout(width, height)
    engine_paint()
    dump()
}

// =====================================================================
// Declarative UI
// =====================================================================
//
// Components are ordinary `fn`s. Containers take a trailing block, and every
// widget evaluated inside it attaches to that container, so the tree comes
// from block structure rather than explicit parenting:
//
//     fn Counter() {
//         let count = signal(0)
//         Box(align_direction = DIRECTION.Column, spacing = 8) {
//             Text("Count: {{count.get()}}")
//             Button("Increment", on_click = fn() => count.set(count.get() + 1))
//         }
//     }
//
// `Box(...) { ... }` is sugar for `__ui_scope(Box(...), || { ... })`.
// Props are structs with defaults filled by named arguments. Text is taken as
// `fn() -> string`, so a signal read inside it is recorded as a dependency of
// that one label's effect: setting the signal repaints that label alone.

/// Containers currently being built, innermost last.
let mut ui_stack: []int = []int {}
/// Implicit top-level container, created on first emit.
let mut ui_root_id: int = -1

/// Default for optional handler props. Never invoked: a props struct pairs
/// each handler with a `<name>__set` flag the compiler sets when the argument
/// is actually passed.
/// Bodies are deliberately non-empty: an empty body marks a std function as a
/// runtime hook, which would suppress the `__as_fn` adapter these need to be
/// usable as values.
fn noop() {
    return
}
fn noop_mouse(e: MouseEvent) {
    return
}
fn noop_key(e: KeyEvent) {
    return
}

/// Drop any partly built tree and start over.
fn ui_reset() {
    arena.ensure()
    ui_stack = []int {}
    // Allocate the root up front so widget ids follow build order. Creating it
    // lazily on first emit would give the first widget a lower id than its own
    // parent.
    let r = raw_col()
    style.set_align(r.id, ALIGN.Stretch)
    ui_root_id = r.id
    arena.root_id = r.id
}

/// The implicit root container. Created lazily so a component can be called
/// without an enclosing container.
fn ui_root() -> Node {
    if ui_root_id < 0 {
        ui_reset()
    }
    return nd(ui_root_id)
}

/// Attach `n` to the container being built, else to the implicit root.
/// Every declarative widget ends with this.
fn ui_emit(n: Node) -> Node {
    if ui_stack.len > 0 {
        nd(ui_stack[ui_stack.len - 1]).child(n)
    } else {
        ui_root().child(n)
    }
    return n
}

/// Make `n` the current parent, run `body`, then restore. Trailing UI blocks
/// desugar to this; see `parse_ui_trailing_block` in the compiler.
fn __ui_scope(n: Node, body: fn()) -> Node {
    push(ui_stack, n.id)
    body()
    if ui_stack.len > 0 {
        pop(ui_stack)
    }
    return n
}

// --- colors ---

/// Parse `"#rrggbb"` or `"#rgb"` into a packed RGB int. `-1` for empty or
/// malformed input, which every style setter reads as "leave unset".
fn hex(s: string) -> int {
    if s.len == 0 {
        return -1
    }
    let mut i = 0
    if s[0] == 35 {
        i = 1
    }
    let mut v = 0
    let mut n = 0
    while i < s.len {
        let c = s[i]
        let mut d = -1
        if c >= 48 && c <= 57 {
            d = c - 48
        }
        if c >= 97 && c <= 102 {
            d = c - 87
        }
        if c >= 65 && c <= 70 {
            d = c - 55
        }
        if d < 0 {
            return -1
        }
        v = v * 16 + d
        n = n + 1
        i = i + 1
    }
    if n == 3 {
        let r = v / 256
        let g = (v / 16) % 16
        let b = v % 16
        return rgb(r * 17, g * 17, b * 17)
    }
    if n == 6 {
        return v
    }
    return -1
}

// --- event payloads ---

/// Pointer event. `button` is 0 for the primary button.
struct MouseEvent {
    x: int = 0,
    y: int = 0,
    button: int = 0,
}

/// Key event. `key` is a character code or a `Key.*` constant.
struct KeyEvent {
    key: int = 0,
    ctrl: bool = false,
    shift: bool = false,
    alt: bool = false,
}

/// Event being dispatched. The engine invokes interned `fn()` adapters, so the
/// payload rides here rather than through the call.
let mut ev_x: int = 0
let mut ev_y: int = 0
let mut ev_button: int = 0
let mut ev_key: int = 0
let mut ev_ctrl: bool = false
let mut ev_shift: bool = false
let mut ev_alt: bool = false
/// Key that went down; `dispatch_key_up` matches it to complete a press.
let mut press_key: int = 0

/// The pointer event currently being delivered.
fn current_mouse() -> MouseEvent {
    return MouseEvent { x: ev_x, y: ev_y, button: ev_button }
}

/// The key event currently being delivered.
fn current_key() -> KeyEvent {
    return KeyEvent { key: ev_key, ctrl: ev_ctrl, shift: ev_shift, alt: ev_alt }
}

/// Payload-carrying handlers, held by slot so a node stores a plain int.
///
/// Runtime hooks (empty body): a handler is read out of a props struct, which
/// Yuga drops on return, freeing the closure's captured env. The runtime
/// snapshots that env, so the stored handler stays valid for the app's life.
/// The typed call is made here, in Yuga, so C never sees the event layouts.
fn keep_ev(h: fn(MouseEvent)) -> fn(MouseEvent) {}
fn keep_key(h: fn(KeyEvent)) -> fn(KeyEvent) {}

let mut mouse_fns: []fn(MouseEvent) = []fn(MouseEvent) {}
let mut key_fns: []fn(KeyEvent) = []fn(KeyEvent) {}

/// Register `h`, returning its 1-based slot (0 means "no handler").
fn add_mouse_fn(h: fn(MouseEvent)) -> int {
    push(mouse_fns, keep_ev(h))
    return mouse_fns.len
}

fn add_key_fn(h: fn(KeyEvent)) -> int {
    push(key_fns, keep_key(h))
    return key_fns.len
}

/// Invoke slot `i` with the event being dispatched. Called through the vec
/// directly: binding it to a local would make Yuga drop (and free) it.
fn fire_mouse(i: int) {
    if i > 0 && i <= mouse_fns.len {
        mouse_fns[i - 1](current_mouse())
    }
}

fn fire_key(i: int) {
    if i > 0 && i <= key_fns.len {
        key_fns[i - 1](current_key())
    }
}

// --- props ---

/// Multi-value box styling, per ZEUS_SPEC.md section 2C. `-1` means auto.
struct BoxStyle {
    width: int = -1,
    height: int = -1,
    background: string = "",
    padding: int = 0,
    flex: int = 0,
}

/// 2D grid configuration.
struct GridConfig {
    columns: int = 1,
    gap: int = 0,
    padding: int = 0,
}

/// Shared container/box props. `style` supplies several at once; the flat
/// fields override it, so `Box(style = s, padding = 4)` works. Every style
/// prop is a thunk (`fn() -> T`); plain values auto-wrap, and a value that
/// reads a signal re-applies just that prop when the signal changes, so
/// `Box(align_direction = if a { DIRECTION.Row } else { DIRECTION.Column })`
/// is reactive. Each thunk prop has a `name__set` companion the widget uses
/// to learn whether it was actually passed.
struct BoxProps {
    style: fn() -> BoxStyle = style_box_default,
    style__set: bool = false,
    width: fn() -> int = style_int_default,
    width__set: bool = false,
    height: fn() -> int = style_int_default,
    height__set: bool = false,
    background: fn() -> string = style_str_default,
    background__set: bool = false,
    color: fn() -> string = style_str_default,
    color__set: bool = false,
    padding: fn() -> int = style_int_default,
    padding__set: bool = false,
    flex: fn() -> int = style_int_default,
    flex__set: bool = false,
    gap: fn() -> int = style_int_default,
    gap__set: bool = false,
    spacing: fn() -> int = style_int_default,
    spacing__set: bool = false,
    radius: fn() -> int = style_int_default,
    radius__set: bool = false,
    font: fn() -> int = style_int_default,
    font__set: bool = false,
    align_items: fn() -> int = style_int_default,
    align_items__set: bool = false,
    justify_content: fn() -> int = style_int_default,
    justify_content__set: bool = false,
    /// Main-axis direction: `"row"` or `"column"` (the replacement for the
    /// old `Row` / `Column` widgets). Empty leaves the engine default (row).
    /// Main-axis direction: `DIRECTION.Row` or `DIRECTION.Column` (the
    /// replacement for the old `Row` / `Column` widgets). A row box centers on
    /// the cross axis, a column box stretches, unless `align_items` is given.
    align_direction: fn() -> int = style_int_default,
    align_direction__set: bool = false,
    // Box model. The sentinels (`0` / `-1`) are checked by the dispatcher.
    pad_x: fn() -> int = style_int_default,
    pad_x__set: bool = false,
    pad_y: fn() -> int = style_int_default,
    pad_y__set: bool = false,
    pad_top: fn() -> int = style_int_default,
    pad_top__set: bool = false,
    pad_right: fn() -> int = style_int_default,
    pad_right__set: bool = false,
    pad_bottom: fn() -> int = style_int_default,
    pad_bottom__set: bool = false,
    pad_left: fn() -> int = style_int_default,
    pad_left__set: bool = false,
    margin: fn() -> int = style_int_default,
    margin__set: bool = false,
    border: fn() -> int = style_int_default,
    border__set: bool = false,
    border_color: fn() -> string = style_str_default,
    border_color__set: bool = false,
    overflow: fn() -> int = style_int_default,
    overflow__set: bool = false,
    // Sizing.
    size: fn() -> int = style_int_default,
    size__set: bool = false,
    grow: fn() -> int = style_int_default,
    grow__set: bool = false,
    shrink: fn() -> int = style_int_default,
    shrink__set: bool = false,
    min_w: fn() -> int = style_int_default,
    min_w__set: bool = false,
    max_w: fn() -> int = style_int_default,
    max_w__set: bool = false,
    min_h: fn() -> int = style_int_default,
    min_h__set: bool = false,
    max_h: fn() -> int = style_int_default,
    max_h__set: bool = false,
    opacity: fn() -> int = style_int_default,
    opacity__set: bool = false,
    // Absolute placement.
    position: fn() -> int = style_int_default,
    position__set: bool = false,
    top: fn() -> int = style_int_default,
    top__set: bool = false,
    left: fn() -> int = style_int_default,
    left__set: bool = false,
    z_index: fn() -> int = style_int_default,
    z_index__set: bool = false,
    align_self: fn() -> int = style_int_default,
    align_self__set: bool = false,
    hover_fade: bool = false,
    on_click: fn() = noop,
    on_click__set: bool = false,
    on_mouse_down: fn(MouseEvent) = noop_mouse,
    on_mouse_down__set: bool = false,
    on_mouse_up: fn(MouseEvent) = noop_mouse,
    on_mouse_up__set: bool = false,
    on_key_down: fn(KeyEvent) = noop_key,
    on_key_down__set: bool = false,
    on_key_up: fn(KeyEvent) = noop_key,
    on_key_up__set: bool = false,
    on_key_press: fn(KeyEvent) = noop_key,
    on_key_press__set: bool = false,
}

struct TextProps {
    color: fn() -> string = style_str_default,
    color__set: bool = false,
    font: fn() -> int = style_int_default,
    font__set: bool = false,
    width: fn() -> int = style_int_default,
