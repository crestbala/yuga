//! `zeus` — UI toolkit. Native Cocoa and WASM/Canvas2D run the same source.
//!
//! Build a tree of `Node`s, then `.run()`. Clicks and keys write `Signal`s
//! (or captured `let mut` ints). Methods chain: `n.pad(8)` is `zeus.pad(n, 8)`.
//! Extra `.child(a, b, c)` arguments become nested `.child` calls.
//!
//! Example:
//! ```
//! import "std:zeus"
//!
//! fn main() {
//!     let n = zeus.signal(0)
//!     zeus.col().pad(16).gap(8).child(
//!         zeus.text("Count").font(22),
//!         zeus.label("").bind(n).font(28),
//!         zeus.row().gap(8).child(
//!             zeus.button("-").on(zeus.click(), || { zeus.inc(n, -1) }),
//!             zeus.button("+").on(zeus.click(), || { zeus.inc(n, 1) }),
//!         ),
//!     ).run()
//! }
//! ```
//!
//! Per-frame rebuild: `zeus.view(|| { ... })` or `zeus.app(title, w, h, || { ... })`.
//! Kit apps that build once stay retained (omit `view`).
//! Internals: `std/zeuscore/*.yuga`. C is host FFI (`platform.yuga`), not a Zeus
//! runtime file. `Node` is `{ id: int }` (not generic). `each<T>` / `each_i<T>`
//! are the generic helpers. See `docs/boundary.md`.
//! `ZEUS_HEADLESS=1` layouts once and exits.

import "zeuscore/geometry.yuga"
import "zeuscore/platform.yuga"
import "zeuscore/arena.yuga"
import "zeuscore/layout.yuga"
import "zeuscore/scene.yuga"
import "zeuscore/input.yuga"
import "zeuscore/track.yuga"
import "std:fmt"

/// A widget in the tree. Copy handle (`id`). Chain layout and `.child` / `.run`.
struct Node {
    /// Slot in the engine arena. Do not construct by hand; use `zeus.row()` etc.
    id: int,
}

/// Opaque reactive int. Copy (id handle). Use `get` / `set` / `inc`.
///
/// Example:
/// ```
/// let n = zeus.signal(0)
/// zeus.set(n, zeus.get(n) + 1)
/// ```
struct Signal {
    id: int,
}

struct Style {
    pad: int,
    gap: int,
    bg: int,
    fg: int,
    font: int,
    radius: int,
}

fn empty_view() -> Node {
    return Node { id: 0 }
}

let mut has_view: int = 0
let mut view_fn: fn() -> Node = empty_view
let mut hook_ids: []int = []int {}
let mut hook_at: int = 0

fn nd(id: int) -> Node {
    return Node { id: id }
}

fn sg(id: int) -> Signal {
    return Signal { id: id }
}

fn raw_init() {
    arena.ensure()
}

fn open_window(title: string, width: int, height: int) {
    arena.ensure()
    arena.win_w = width
    arena.win_h = height
    platform.plat_set_window(title, width, height)
}

fn raw_run() {
    arena.ensure()
    if platform.plat_headless() != 0 {
        engine_layout(arena.win_w, arena.win_h)
        return
    }
    platform.plat_run()
}

fn init() {
    raw_init()
}

/// Open a native window. Sizes are CSS-like points, not pixels.
/// Prefer `n.run()` or `zeus.app(...)` over calling this alone.
fn window(title: string, width: int, height: int) {
    init()
    open_window(title, width, height)
}

/// Enter the event loop. Chain on the built tree: `page.child(...).run()`.
/// `ZEUS_HEADLESS=1` layouts once and exits (tests).
///
/// Example:
/// ```
/// zeus.text("Hi").pad(16).run()
/// ```
fn run(node: Node) {
    init()
    arena.root_id = node.id
    raw_run()
}

/// GPUI-style: each frame rebuilds the element tree from signals.
/// Omit this and the tree stays retained (kit apps).
fn view(build: fn() -> Node) {
    init()
    view_fn = build
    has_view = 1
}

/// Alias for `box()` — a direction-agnostic container. Chain `.flex_row()` /
/// `.flex_col()` to pick a direction.
fn container() -> Node {
    return raw_box()
}

/// Open a window, install `build` as the per-frame view, and run.
///
/// Example:
/// ```
/// zeus.app("Demo", 400, 300, || {
///     zeus.text("frame")
/// })
/// ```
fn app(title: string, width: int, height: int, build: fn() -> Node) {
    window(title, width, height)
    view(build)
    init()
    raw_run()
}

// --- signals (live int state) ---

/// Allocate a live int. Pass the handle to `get` / `set` / `.bind`.
///
/// Example:
/// ```
/// let count = zeus.signal(0)
/// zeus.button("+").on(zeus.click(), || { zeus.inc(count, 1) })
/// ```
fn signal(value: int) -> Signal {
    arena.ensure()
    push(arena.sigs, value)
    return sg(arena.sigs.len - 1)
}

/// Read the current value of `sig`. Inside a `.styled` closure this records
/// `sig` as a dependency of that closure.
fn get(sig: Signal) -> int {
    arena.ensure()
    if sig.id <= 0 {
        return 0
    }
    track.note_read(sig.id)
    if sig.id >= arena.sigs.len {
        return 0
    }
    return arena.sigs[sig.id]
}
/// Write `value` into `sig`. Re-runs every `.styled` closure that last read it.
fn set(sig: Signal, value: int) {
    arena.ensure()
    arena.store_sig(sig.id, value)
}
/// Add `delta` to `sig` (`set(sig, get(sig) + delta)`).
fn inc(sig: Signal, delta: int) {
    set(sig, get(sig) + delta)
}

fn hook_begin() {
    hook_at = 0
}

fn hook_signal(init: int) -> Signal {
    arena.ensure()
    if hook_at >= hook_ids.len {
        push(arena.sigs, init)
        push(hook_ids, arena.sigs.len - 1)
    }
    let sid = hook_ids[hook_at]
    hook_at = hook_at + 1
    return sg(sid)
}

// --- unstyled allocators ---
/// Kinds: 1 box/row/col, 2 grid, 3 label, 4 button, 5 spacer, 6 progress,
/// 7 toggle, 8 check, 9 overlay, 10 input, 11 scroll, 12 svg, 13 slider.

fn raw_row() -> Node {
    let id = arena.alloc_node(1)
    arena.nodes[id].dir = 0
    return nd(id)
}
fn raw_col() -> Node {
    let id = arena.alloc_node(1)
    arena.nodes[id].dir = 1
    return nd(id)
}
fn raw_box() -> Node {
    return nd(arena.alloc_node(1))
}
fn raw_label(text: string) -> Node {
    let id = arena.alloc_node(3)
    arena.nodes[id].text = text
    return nd(id)
}
fn raw_button(text: string) -> Node {
    let id = arena.alloc_node(4)
    arena.nodes[id].text = text
    return nd(id)
}
fn raw_spacer() -> Node {
    return nd(arena.alloc_node(5))
}
fn raw_progress() -> Node {
    return nd(arena.alloc_node(6))
}
fn raw_slider() -> Node {
    return nd(arena.alloc_node(13))
}
fn raw_toggle() -> Node {
    return nd(arena.alloc_node(7))
}
fn raw_check(markup: string) -> Node {
    let id = arena.alloc_node(8)
    arena.nodes[id].text = markup
    return nd(id)
}
fn raw_overlay() -> Node {
    let id = arena.alloc_node(9)
    arena.nodes[id].pos = 1
    arena.nodes[id].enter_fade = 1
    return nd(id)
}
fn raw_input(placeholder: string) -> Node {
    let id = arena.alloc_node(10)
    arena.nodes[id].text = placeholder
    arena.nodes[id].focusable = 1
    arena.nodes[id].capture_text = 1
    return nd(id)
}
fn raw_scroll() -> Node {
    let id = arena.alloc_node(11)
    arena.nodes[id].dir = 1
    arena.nodes[id].overflow = 2
    return nd(id)
}
fn raw_svg(markup: string) -> Node {
    let id = arena.alloc_node(12)
    arena.nodes[id].text = markup
    return nd(id)
}
fn raw_hover(node: Node, sig: Signal) -> Node {
    arena.nodes[node.id].hover_sig = sig.id
    return node
}

// --- primitives ---

/// Horizontal flex row. Cross-axis centered. Chain `.gap` / `.child`.
///
/// Example:
/// ```
/// zeus.row().gap(8).child(zeus.button("-"), zeus.button("+"))
/// ```
fn row() -> Node {
    return raw_row().align(geometry.flex_center())
}

/// Vertical flex column. Cross-axis stretched (children fill width).
fn col() -> Node {
    return raw_col().align(geometry.flex_stretch())
}

fn box() -> Node {
    return raw_box()
}

fn grid(columns: int, gap: int) -> Node {
    let id = arena.alloc_node(2)
    arena.nodes[id].grid_cols = columns
    arena.nodes[id].gap = gap
    return nd(id)
}

fn grid_auto(min_width: int, gap: int) -> Node {
    let id = arena.alloc_node(2)
    arena.nodes[id].grid_auto = 1
    arena.nodes[id].grid_min = min_width
    arena.nodes[id].gap = gap
    return nd(id)
}

fn label(text: string) -> Node {
    return raw_label(text)
}

/// Static text label.
fn text(s: string) -> Node {
    return raw_label(s)
}

/// Clickable text button. Pair with `.on(zeus.click(), || { ... })`.
fn button(text: string) -> Node {
    return raw_button(text)
}

fn spacer() -> Node {
    return raw_spacer().grow(1)
}

fn progress() -> Node {
    return raw_progress()
}

fn slider() -> Node {
    return raw_slider()
}

fn toggle() -> Node {
    return raw_toggle()
}

fn check() -> Node {
    return raw_check("")
}

fn overlay() -> Node {
    let n = raw_overlay()
    arena.nodes[n.id].dir = 1
    return n.center().z_index(50)
}

fn input(placeholder: string) -> Node {
    return raw_input(placeholder)
}

fn scroll() -> Node {
    return raw_scroll()
}

/// Both-axis auto: H and V bars only when content overflows the viewport.
fn scroll_xy() -> Node {
    let n = raw_scroll()
    arena.nodes[n.id].overflow = geometry.overflow_auto()
    return n
}

fn svg(markup: string) -> Node {
    return raw_svg(markup).shrink(0)
}

// --- tree ---

/// Attach `node` under `parent` and return `parent` (chain siblings).
/// Extra arguments `.child(a, b, c)` expand to nested `.child` calls.
///
/// Example:
/// ```
/// zeus.col().child(
///     zeus.text("A"),
///     zeus.text("B"),
/// )
/// ```
fn child(parent: Node, node: Node) -> Node {
    arena.ensure()
    push(arena.nodes[parent.id].kids, node.id)
    arena.nodes[node.id].parent = parent.id
    return parent
}

fn with_size(node: Node, s: int) -> Node {
    arena.nodes[node.id].ui_size = s
    track.run_node(node.id)
    return node
}

fn with_look(node: Node, v: int) -> Node {
    arena.nodes[node.id].ui_look = v
    track.run_node(node.id)
    return node
}

fn size_of(node: Node) -> int {
    return arena.nodes[node.id].ui_size
}

fn look_of(node: Node) -> int {
    return arena.nodes[node.id].ui_look
}

/// Run `handler` now and again whenever a `Signal` it `get`s changes.
/// The closure only updates paint state on existing nodes — it must not
/// call `.child()` or rebuild the tree.
fn styled(node: Node, handler: fn()) -> Node {
    arena.ensure()
    let eid = track.alloc(platform.plat_intern_fn(handler), node.id)
    track.run(eid)
    return node
}

/// Attach `node` under `parent` and return `node`. `child` returns the parent
/// so a builder can chain siblings; `add` returns the new node so callers can
/// fill it. Components that do `let n = parent.add(row())` then `n.txt(...)`
/// must use this, not `child`.
fn add(parent: Node, node: Node) -> Node {
    parent.child(node)
    return node
}

fn root(node: Node) -> Node {
    arena.ensure()
    arena.root_id = node.id
    return node
}

// --- style ---
/// Chainable. `n.pad(8)` rewrites to `zeus.pad(n, 8)`.
/// Flex: grow/shrink, justify/align (`flex_start` … `flex_stretch`).
/// Size: `w`/`h` in points; `width_pct`/`height_pct`; min/max; `aspect`.
/// Box: pad*, margin*, border, gap, radius, overflow, opacity.
/// Color: `bg`/`fg` packed RGB (`zeus.rgb(r,g,b)`). `-1` means no fill/stroke.

fn grow(node: Node, weight: int) -> Node {
    arena.nodes[node.id].grow = weight
    return node
}
fn shrink(node: Node, weight: int) -> Node {
    arena.nodes[node.id].shrink = weight
    return node
}

fn pad(node: Node, all: int) -> Node {
    arena.nodes[node.id].pad = all
    arena.nodes[node.id].pad_t = all
    arena.nodes[node.id].pad_r = all
    arena.nodes[node.id].pad_b = all
    arena.nodes[node.id].pad_l = all
    return node
}
fn padX(node: Node, px: int) -> Node {
    arena.nodes[node.id].pad_l = px
    arena.nodes[node.id].pad_r = px
    return node
}
fn padY(node: Node, py: int) -> Node {
    arena.nodes[node.id].pad_t = py
    arena.nodes[node.id].pad_b = py
    return node
}
fn padTop(node: Node, px: int) -> Node {
    arena.nodes[node.id].pad_t = px
    return node
}
fn padRight(node: Node, px: int) -> Node {
    arena.nodes[node.id].pad_r = px
    return node
}
fn padBottom(node: Node, px: int) -> Node {
    arena.nodes[node.id].pad_b = px
    return node
}
fn padLeft(node: Node, px: int) -> Node {
    arena.nodes[node.id].pad_l = px
    return node
}
fn margin(node: Node, all: int) -> Node {
    arena.nodes[node.id].m_t = all
    arena.nodes[node.id].m_r = all
    arena.nodes[node.id].m_b = all
    arena.nodes[node.id].m_l = all
    return node
}
fn marginX(node: Node, px: int) -> Node {
    arena.nodes[node.id].m_l = px
    arena.nodes[node.id].m_r = px
    return node
}
fn marginY(node: Node, py: int) -> Node {
    arena.nodes[node.id].m_t = py
    arena.nodes[node.id].m_b = py
    return node
}
fn marginTop(node: Node, px: int) -> Node {
    arena.nodes[node.id].m_t = px
    return node
}
fn marginRight(node: Node, px: int) -> Node {
    arena.nodes[node.id].m_r = px
    return node
}
fn marginBottom(node: Node, px: int) -> Node {
    arena.nodes[node.id].m_b = px
    return node
}
fn marginLeft(node: Node, px: int) -> Node {
    arena.nodes[node.id].m_l = px
    return node
}
fn border(node: Node, width: int) -> Node {
    arena.nodes[node.id].border_w = width
    return node
}
fn border_color(node: Node, rgb: int) -> Node {
    arena.nodes[node.id].border_c = rgb
    return node
}

fn gap(node: Node, g: int) -> Node {
    arena.nodes[node.id].gap = g
    return node
}
fn gap_row(node: Node, g: int) -> Node {
    arena.nodes[node.id].gap_row = g
    return node
}
fn gap_col(node: Node, g: int) -> Node {
    arena.nodes[node.id].gap_col = g
    return node
}

/// Default node width is 100% of the parent. `.w(px)` pins a pixel width
/// and clears the percentage. `.w(-1)` restores the 100% default.
fn w(node: Node, px: int) -> Node {
    if px < 0 {
        arena.nodes[node.id].ew = -1
        arena.nodes[node.id].w_pct = 100
    } else {
        arena.nodes[node.id].ew = px
        arena.nodes[node.id].w_pct = -1
    }
    return node
}
fn h(node: Node, px: int) -> Node {
    arena.nodes[node.id].eh = px
    return node
}
/// `.w(px).h(px)` in one call — a square.
fn size(node: Node, px: int) -> Node {
    return node.w(px).h(px)
}
fn width_pct(node: Node, pct: int) -> Node {
    arena.nodes[node.id].ew = -1
    arena.nodes[node.id].w_pct = pct
    return node
}
fn height_pct(node: Node, pct: int) -> Node {
    arena.nodes[node.id].h_pct = pct
    return node
}
fn min_w(node: Node, px: int) -> Node {
    arena.nodes[node.id].min_w = px
    return node
}
fn max_w(node: Node, px: int) -> Node {
    arena.nodes[node.id].max_w = px
    return node
}
fn min_h(node: Node, px: int) -> Node {
    arena.nodes[node.id].min_h = px
    return node
}
fn max_h(node: Node, px: int) -> Node {
    arena.nodes[node.id].max_h = px
    return node
}
fn aspect(node: Node, aw: int, ah: int) -> Node {
    arena.nodes[node.id].aspect_w = aw
    arena.nodes[node.id].aspect_h = ah
    return node
}

fn flex_row(node: Node) -> Node {
    if arena.nodes[node.id].kind != 2 {
        if arena.nodes[node.id].kind != 9 {
            if arena.nodes[node.id].kind != 11 {
                arena.nodes[node.id].kind = 1
            }
        }
    }
    arena.nodes[node.id].dir = 0
    arena.nodes[node.id].reverse = 0
    return node
}
fn flex_col(node: Node) -> Node {
    if arena.nodes[node.id].kind != 2 {
        if arena.nodes[node.id].kind != 9 {
            if arena.nodes[node.id].kind != 11 {
                arena.nodes[node.id].kind = 1
            }
        }
    }
    arena.nodes[node.id].dir = 1
    arena.nodes[node.id].reverse = 0
    return node
}
fn flex_row_reverse(node: Node) -> Node {
    arena.nodes[node.id].dir = 0
    arena.nodes[node.id].reverse = 1
    return node
}
fn flex_col_reverse(node: Node) -> Node {
    arena.nodes[node.id].dir = 1
    arena.nodes[node.id].reverse = 1
    return node
}
fn flex_wrap(node: Node) -> Node {
    arena.nodes[node.id].wrap = 1
    return node
}
fn align_self(node: Node, mode: int) -> Node {
    arena.nodes[node.id].align_self = mode
    return node
}
fn span(node: Node, columns: int) -> Node {
    arena.nodes[node.id].span = columns
    return node
}

fn justify(node: Node, mode: int) -> Node {
    arena.nodes[node.id].justify = mode
    return node
}
fn align(node: Node, mode: int) -> Node {
    arena.nodes[node.id].align = mode
    return node
}

fn position(node: Node, mode: int) -> Node {
    arena.nodes[node.id].pos = mode
    return node
}
fn top(node: Node, px: int) -> Node {
    arena.nodes[node.id].pin_t = px
    return node
}
fn right(node: Node, px: int) -> Node {
    arena.nodes[node.id].pin_r = px
    return node
}
fn bottom(node: Node, px: int) -> Node {
    arena.nodes[node.id].pin_b = px
    return node
}
fn left(node: Node, px: int) -> Node {
    arena.nodes[node.id].pin_l = px
    return node
}
fn z_index(node: Node, z: int) -> Node {
    arena.nodes[node.id].z_index = z
    return node
}

fn bg(node: Node, rgb: int) -> Node {
    arena.nodes[node.id].bg = rgb
    return node
}
fn fg(node: Node, rgb: int) -> Node {
    arena.nodes[node.id].fg = rgb
    return node
}
fn radius(node: Node, px: int) -> Node {
    arena.nodes[node.id].radius = px
    return node
}
fn opacity(node: Node, pct: int) -> Node {
    arena.nodes[node.id].opacity = pct
    return node
}
fn overflow(node: Node, mode: int) -> Node {
    arena.nodes[node.id].overflow = mode
    return node
}
fn font(node: Node, px: int) -> Node {
    arena.nodes[node.id].font = px
    return node
}

// --- reactivity ---
/// Clicks write a signal (inc / toggle / set / add). `show` / `show_eq` /
/// `show_ne` / `show_ge` / `show_le` hide a node from layout when false.
/// `bind` paints a label from a signal's int.

fn bind(label: Node, sig: Signal) -> Node {
    arena.nodes[label.id].bind_sig = sig.id
    return label
}

/// Paint an int. Pass a component `let mut` directly so retained paint stays
/// live; a plain int (a prop) snapshots until the parent view rebuilds.
fn bind_n(label: Node, n: int) -> Node {
    arena.nodes[label.id].bind_sig = -1
    arena.nodes[label.id].click_set = n
    return label
}

fn digits(n: int) -> Node {
    return label("0").bind_n(n)
}
fn on_click_inc(button: Node, sig: Signal) -> Node {
    arena.nodes[button.id].click_sig = sig.id
    arena.nodes[button.id].click_mode = 0
    return button
}
fn on_click_toggle(node: Node, sig: Signal) -> Node {
    arena.nodes[node.id].click_sig = sig.id
    arena.nodes[node.id].click_mode = 1
    return node
}
fn on_click_set(node: Node, sig: Signal, value: int) -> Node {
    arena.nodes[node.id].click_sig = sig.id
    arena.nodes[node.id].click_mode = 2
    arena.nodes[node.id].click_set = value
    return node
}
fn on_click_add(node: Node, sig: Signal, delta: int) -> Node {
    arena.nodes[node.id].click_sig = sig.id
    arena.nodes[node.id].click_mode = 3
    arena.nodes[node.id].click_set = delta
    return node
}

fn on_click_also_set(node: Node, sig: Signal, value: int) -> Node {
    arena.nodes[node.id].click2_sig = sig.id
    arena.nodes[node.id].click2_mode = 2
    arena.nodes[node.id].click2_set = value
    return node
}

fn click() -> int {
    return 1
}

fn heading() -> Style {
    return Style { pad: 0, gap: 0, bg: -1, fg: rgb(23, 23, 23), font: 22, radius: 0 }
}

fn class(node: Node, name: string) -> Node {
    if fmt.eq(name, "container") {
        return node.pad(16).gap(12).flex_col().bg(rgb(250, 250, 250))
    }
    if fmt.eq(name, "heading") {
        return node.font(22).fg(rgb(23, 23, 23))
    }
    if fmt.eq(name, "muted") {
        return node.font(13).fg(rgb(113, 113, 122))
    }
    if fmt.eq(name, "card") {
        return node.pad(16).gap(8).radius(10).bg(rgb(255, 255, 255)).border(1).border_color(rgb(228, 228, 231))
    }
    return node
}

fn style(node: Node, s: Style) -> Node {
    let mut n = node
    if s.pad > 0 {
        n = n.pad(s.pad)
    }
    if s.gap > 0 {
        n = n.gap(s.gap)
    }
    if s.bg >= 0 {
        n = n.bg(s.bg)
    }
    if s.fg >= 0 {
        n = n.fg(s.fg)
    }
    if s.font > 0 {
        n = n.font(s.font)
    }
    if s.radius > 0 {
        n = n.radius(s.radius)
    }
    return n
}

fn on(node: Node, event: int, handler: fn()) -> Node {
    if event == 1 {
        arena.nodes[node.id].click_fn = platform.plat_intern_fn(handler)
    }
    return node
}

fn each<T>(parent: Node, items: []T, build: fn(T) -> Node) -> Node {
    let n = items.len
    for i in 0..n {
        parent.child(build(items[i]))
    }
    return parent
}

/// Like `each`, with the index. `Node` stays a non-generic `{id}` handle.
fn each_i<T>(parent: Node, items: []T, build: fn(int, T) -> Node) -> Node {
    let n = items.len
    for i in 0..n {
        parent.child(build(i, items[i]))
    }
    return parent
}

/// `zeus.when(sig, || { node })` — combinator form of show. Builds the child
/// once and hides it from layout while `sig` is 0. `n.show(sig)` remains the
/// modifier (Yuga cannot overload `show`).
fn when(sig: Signal, build: fn() -> Node) -> Node {
    return build().show(sig)
}

fn show(node: Node, sig: Signal) -> Node {
    arena.nodes[node.id].show_sig = sig.id
    arena.nodes[node.id].show_mode = 0
    return node
}
fn show_eq(node: Node, sig: Signal, value: int) -> Node {
    arena.nodes[node.id].show_sig = sig.id
    arena.nodes[node.id].show_mode = 1
    arena.nodes[node.id].show_val = value
    return node
}
fn show_ne(node: Node, sig: Signal, value: int) -> Node {
    arena.nodes[node.id].show_sig = sig.id
    arena.nodes[node.id].show_mode = 2
    arena.nodes[node.id].show_val = value
    return node
}
// --- keyboard ---
/// A chord on a focused node resolves to a named action; a handler on that
/// same node writes a signal. App remaps (`map_key` / `remap_key`) still use
/// the action name, so a shortcut can move without the component changing.
/// Context is the family of the first action (`button.press` → `button`).
///
/// mode: 0 inc, 1 toggle, 2 set, 3 add — the same codes on_click_* uses.

fn key_context(node: Node, name: string) -> Node {
    arena.nodes[node.id].key_ctx = platform.plat_key_intern(name)
    return node
}
fn focusable(node: Node) -> Node {
    arena.nodes[node.id].focusable = 1
    return node
}
fn capture_text(node: Node) -> Node {
    arena.nodes[node.id].capture_text = 1
    arena.nodes[node.id].focusable = 1
    return node
}
fn on_action(node: Node, action: string, sig: Signal, mode: int, value: int) -> Node {}
fn on_action_global(action: string, sig: Signal, mode: int, value: int) {}

/// Step `sig` by `delta`, clamped to lo..hi — arrow navigation over a range.
fn on_range(node: Node, action: string, sig: Signal, delta: int, lo: int, hi: int) -> Node {}
fn map_key(spec: string, action: string, ctx: string) {}
fn remap_key(spec: string, action: string, ctx: string) {}

/// Chord → action on this node. The action family (`button.press` → `button`)
/// is the keymap context; `key_context` is only needed to override that name.
/// Implies `.focusable()` — a node with a key binding needs focus to receive
/// it, so components don't chain both.
fn key(node: Node, spec: string, action: string) -> Node {
    let mut ctx = arena.nodes[node.id].key_ctx
    if ctx == 0 {
        ctx = platform.plat_key_intern_action(action)
        arena.nodes[node.id].key_ctx = ctx
    }
    if ctx != 0 {
        platform.plat_map_key(spec, action, ctx)
    }
    arena.nodes[node.id].focusable = 1
    return node
}

fn on_key_set(node: Node, action: string, sig: Signal, value: int) -> Node {
    return on_action(node, action, sig, 2, value)
}

fn on_key_add(node: Node, action: string, sig: Signal, delta: int) -> Node {
    return on_action(node, action, sig, 3, delta)
}

fn on_key_toggle(node: Node, action: string, sig: Signal) -> Node {
    return on_action(node, action, sig, 1, 0)
}

fn on_key_fn(node: Node, action: string) -> Node {
    return on_action(node, action, sg(0), 5, arena.nodes[node.id].click_fn)
}

fn global_key_set(action: string, sig: Signal, value: int) {
    on_action_global(action, sig, 2, value)
}

fn show_ge(node: Node, sig: Signal, value: int) -> Node {
    arena.nodes[node.id].show_sig = sig.id
    arena.nodes[node.id].show_mode = 3
    arena.nodes[node.id].show_val = value
    return node
}
fn show_le(node: Node, sig: Signal, value: int) -> Node {
    arena.nodes[node.id].show_sig = sig.id
    arena.nodes[node.id].show_mode = 4
    arena.nodes[node.id].show_val = value
    return node
}

fn hover(node: Node, sig: Signal) -> Node {
    return raw_hover(node, sig)
}

fn hover_delay(node: Node, ms: int) -> Node {
    return node
}
fn hover_leave(node: Node, ms: int) -> Node {
    return node
}

fn pulse(node: Node) -> Node {
    arena.nodes[node.id].pulse = 1
    return node
}

fn hover_fade(node: Node) -> Node {
    arena.nodes[node.id].hover_fade = 1
    return node
}

fn enter_fade(node: Node) -> Node {
    arena.nodes[node.id].enter_fade = 1
    return node
}
fn dismiss(node: Node) -> Node {
    return node
}
fn keys(node: Node, sig: Signal, lo: int, hi: int) -> Node {
    return node.key("right", "slider.inc").key("left", "slider.dec").focusable().on_range("slider.inc", sig, 1, lo, hi).on_range("slider.dec", sig, -1, lo, hi)
}
fn keys_page(node: Node, sig: Signal) -> Node {
    return node.key("right", "page.next").key("left", "page.prev").focusable().on_key_add("page.next", sig, 1).on_key_add("page.prev", sig, -1)
}

// --- flex constants (public; implemented in geometry) ---

fn flex_start() -> int {
    return geometry.flex_start()
}
fn flex_center() -> int {
    return geometry.flex_center()
}
fn flex_end() -> int {
    return geometry.flex_end()
}
fn flex_between() -> int {
    return geometry.flex_between()
}
fn flex_around() -> int {
    return geometry.flex_around()
}
fn flex_evenly() -> int {
    return geometry.flex_evenly()
}
fn flex_stretch() -> int {
    return geometry.flex_stretch()
}
fn pos_relative() -> int {
    return geometry.pos_relative()
}
fn pos_absolute() -> int {
    return geometry.pos_absolute()
}
fn overflow_visible() -> int {
    return geometry.overflow_visible()
}
fn overflow_hidden() -> int {
    return geometry.overflow_hidden()
}
fn overflow_scroll() -> int {
    return geometry.overflow_scroll()
}
fn overflow_auto() -> int {
    return geometry.overflow_auto()
}
fn rgb(r: int, g: int, b: int) -> int {
    return geometry.rgb(r, g, b)
}

fn center(node: Node) -> Node {
    return node.justify(flex_center()).align(flex_center())
}

fn appearance() -> Signal {
    arena.ensure()
    if arena.appearance_sid == 0 {
        let s = signal(0)
        arena.appearance_sid = s.id
    }
    return sg(arena.appearance_sid)
}

fn theme(slot: int, light: int, dark: int) {
    arena.ensure()
    if slot < 0 {
        return
    }
    arena.theme_grow(slot)
    if slot < arena.theme_l.len {
        arena.theme_l[slot] = light
        arena.theme_d[slot] = dark
    }
}

fn role(slot: int) -> int {
    if slot < 0 {
        return 0
    }
    return 2130706432 + slot
}

fn engine_key_apply(sid: int, mode: int, value: int, lo: int, hi: int) {
    arena.ensure()
    if mode == 5 {
        platform.plat_invoke_fn(value)
        return
    }
    if sid <= 0 {
        return
    }
    if sid >= arena.sigs.len {
        return
    }
    let mut next = arena.sigs[sid]
    if mode == 1 {
        if next == 0 {
            next = 1
        } else {
            next = 0
        }
    } else if mode == 2 {
        next = value
    } else if mode == 3 {
        next = next + value
    } else if mode == 4 {
        let mut vlo = lo
        let mut vhi = hi
        if vhi < vlo {
            let t = vlo
            vlo = vhi
            vhi = t
        }
        next = next + value
        if next < vlo {
            next = vlo
        }
        if next > vhi {
            next = vhi
        }
    } else {
        next = next + 1
    }
    arena.store_sig(sid, next)
}

fn txt(parent: Node, s: string, color: int, px: int) -> Node {
    return parent.child(label(s).fg(color).font(px))
}

fn bound(parent: Node, sig: Signal, color: int, px: int) -> Node {
    return parent.child(label("0").bind(sig).fg(color).font(px))
}

/// Open a window and install a scrollable root — not the generic `container()`
/// alias for `box()` above; this one bootstraps a whole app/test window.
fn window_root(title: string, width: int, height: int) -> Node {
    window(title, width, height)
    return root(scroll())
}


fn engine_layout(width: int, height: int) {
    if has_view != 0 {
        arena.snapshot_focus()
        arena.snapshot_scroll()
        arena.reset_tree()
        platform.plat_key_reset()
        track.reset()
        hook_begin()
        let n = view_fn()
        arena.root_id = n.id
        arena.restore_scroll()
        arena.restore_focus()
        arena.stamp_edits()
    } else {
        arena.stamp_edits()
    }
    layout.layout(width, height)
}

fn engine_fill_focus() {
    arena.fill_focus_chain()
}

fn engine_focus_depth() -> int {
    return arena.chain_nodes.len
}

fn engine_focus_node(i: int) -> int {
    if i < 0 {
        return 0
    }
    if i >= arena.chain_nodes.len {
        return 0
    }
    return arena.chain_nodes[i]
}

fn engine_focus_ctx(i: int) -> int {
    if i < 0 {
        return 0
    }
    if i >= arena.chain_ctxs.len {
        return 0
    }
    return arena.chain_ctxs[i]
}

fn engine_focus_step(back: int) -> int {
    return arena.focus_step(back)
}

fn engine_focus_captures_text() -> int {
    return arena.focus_captures_text()
}

fn engine_key(key: int) -> int {
    return input.key(key)
}

fn engine_key_ev(key: int, mods: int) -> int {
    return platform.plat_key_ev(key, mods)
}

// --- engine trampolines ---
/// Cocoa calls these through zeus_plat.c (`yuga_zeus_engine_*`). Do not use
/// from app code; use `.run()`, clicks, and signals instead.

fn engine_paint() {
    scene.paint()
}

fn engine_step() -> int {
    return scene.step()
}

fn engine_click(px: int, py: int) -> int {
    return input.click(px, py)
}

fn engine_scroll(px: int, py: int, dx: int, dy: int) -> int {
    return input.scroll(px, py, dx, dy)
}

fn engine_drag(px: int, py: int) -> int {
    return input.drag(px, py)
}

fn engine_mouseup() {
    input.mouseup()
}

fn engine_hover(px: int, py: int) -> int {
    return input.hover(px, py)
}

fn engine_over_button() -> int {
    return input.over_button()
}

fn stack() -> Node {
    return col()
}

fn body() -> Style {
    return Style { pad: 0, gap: 0, bg: -1, fg: rgb(82, 82, 82), font: 14, radius: 0 }
}

fn mount(node: Node, title: string, width: int, height: int) -> Node {
    window(title, width, height)
    return root(node)
}

fn draw_count() -> int {
    return scene.draws.len
}

fn dump() {
    let n = scene.draws.len
    fmt.println("DRAW", n)
    for i in 0..n {
        let d = scene.draws[i]
        if d.kind == 0 {
            fmt.println("fill", d.x, d.y, d.w, d.h, d.rgb, d.radius)
        } else if d.kind == 1 {
            fmt.println("fill_a", d.x, d.y, d.w, d.h, d.rgb, d.alpha)
        } else if d.kind == 2 {
            fmt.println("text", d.x, d.y, d.rgb, d.font, d.text)
        } else if d.kind == 3 {
            fmt.println("text_int", d.x, d.y, d.value, d.rgb, d.font)
        } else if d.kind == 4 {
            fmt.println("text_wrap", d.x, d.y, d.w, d.text)
        } else if d.kind == 6 {
            fmt.println("save")
        } else if d.kind == 7 {
            fmt.println("clip", d.x, d.y, d.w, d.h)
        } else if d.kind == 8 {
            fmt.println("restore")
        }
    }
}

fn snapshot(width: int, height: int, build: fn() -> Node) {
    window("zeus-snap", width, height)
    let n = build()
    root(n)
    engine_layout(width, height)
    engine_paint()
    dump()
}

