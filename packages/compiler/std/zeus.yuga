}

/// Live slot counts (diagnostics for tests). `nodes` includes dead slots
/// waiting to be recycled; `sigs` is the same for signals. A streaming `For`
/// that rebuilds without growing the tree keeps both constant.
fn arena_nodes() -> int {
    return arena.nodes.len
}

fn arena_sigs() -> int {
    return arena.sigs.len
}

fn dump() {
    let n = scene.draws.len
    fmt.println("DRAW", n)
    for i in 0..n {
        let d = scene.draws[i]
        if d.kind == 0 {
            fmt.println("fill", d.x, d.y, d.w, d.h, d.rgb, d.radius)
        } else if d.kind == 1 {
            fmt.println("fill_a", d.x, d.y, d.w, d.h, d.rgb, d.alpha)
        } else if d.kind == 2 {
            fmt.println("text", d.x, d.y, d.rgb, d.font, d.text)
        } else if d.kind == 3 {
            fmt.println("text_int", d.x, d.y, d.value, d.rgb, d.font)
        } else if d.kind == 4 {
            fmt.println("text_wrap", d.x, d.y, d.w, d.text)
        } else if d.kind == 5 {
            fmt.println("svg", d.x, d.y, d.w, d.h, d.rgb)
        } else if d.kind == 6 {
            fmt.println("save")
        } else if d.kind == 7 {
            fmt.println("clip", d.x, d.y, d.w, d.h)
        } else if d.kind == 8 {
            fmt.println("restore")
        } else if d.kind == 9 {
            fmt.println("text_rot", d.x, d.y, d.rgb, d.font, d.w, d.text)
        } else if d.kind == 10 {
            fmt.println("image", d.x, d.y, d.w, d.h, d.alpha, d.radius, d.value)
        }
    }
}

fn snapshot(width: int, height: int, build: fn() -> Node) {
    window("zeus-snap", width, height)
    let n = build()
    root(n)
    engine_layout(width, height)
    engine_paint()
    dump()
}


// --- declarative layer ---
//
// Components are plain `fn`s, hierarchy comes from trailing blocks, props are
// named arguments on a props struct, and every style prop is a thunk so a
// signal read inside it re-applies just that prop.

/// Layout direction for `align_direction`.
enum DIRECTION {
    Row = 0,
    Column = 1,
}

/// Cross-axis and main-axis alignment. Same codes the layout solver uses.
enum ALIGN {
    Start = 0,
    Center = 1,
    End = 2,
    Between = 3,
    Around = 4,
    Evenly = 5,
    Stretch = 6,
}

/// How `Image` maps the bitmap into its layout box: Stretch (default, may
/// distort), Contain (letterbox), Cover (crop to fill), None (intrinsic size).
enum IMAGE_FIT {
    Stretch = 0,
    Contain = 1,
    Cover = 2,
    None = 3,
}

/// The spacing scale, in points.
enum SPACE {
    None = 0,
    Exxxs = 2,
    Exxs = 6,
    Exs = 8,
    Xs = 12,
    Sm = 16,
    Md = 20,
    Lg = 24,
    Xl = 32,
    Xxl = 48,
    Xxxl = 62,
    Xxxxl = 72
}

/// Key codes as delivered by the hosts. `e.key == Key.K` is the spell.
enum Key {
    Backspace = 8,
    Tab = 9,
    Enter = 13,
    Escape = 27,
    Space = 32,
    A = 97,
    B = 98,
    C = 99,
    D = 100,
    E = 101,
    F = 102,
    G = 103,
    H = 104,
    I = 105,
    J = 106,
    K = 107,
    L = 108,
    M = 109,
    N = 110,
    O = 111,
    P = 112,
    Q = 113,
    R = 114,
    S = 115,
    T = 116,
    U = 117,
    V = 118,
    W = 119,
    X = 120,
    Y = 121,
    Z = 122,
    Left = 1000,
    Right = 1001,
    Up = 1002,
    Down = 1003,
    Home = 1004,
    End = 1005,
}

/// Pointer payload, staged by the engine and read inside a handler.
struct MouseEvent {
    x: int,
    y: int,
    button: int,
}

/// Keyboard payload, staged by the engine and read inside a handler.
struct KeyEvent {
    key: int,
    ctrl: bool,
    shift: bool,
    alt: bool,
}

/// Multi-value box sizing, passed as one `style =` prop.
struct BoxStyle {
    width: int = -1,
    height: int = -1,
    background: string = "",
    padding: int = 0,
    grow: int = 0,
}

/// 2D grid configuration.
struct GridConfig {
    columns: int = 1,
    gap: int = 0,
    padding: int = 0,
}

/// The event payload for the handler now running. A handler is invoked with
/// no arguments, so `fn(e: MouseEvent)` is lowered to a `let` of this.
fn current_mouse() -> MouseEvent {
    return MouseEvent { x: arena.ev_x, y: arena.ev_y, button: arena.ev_button }
}

fn current_key() -> KeyEvent {
    return KeyEvent {
        key: arena.ev_key,
        ctrl: arena.ev_mods % 4 >= 2,
        shift: arena.ev_mods % 2 == 1,
        alt: arena.ev_mods % 8 >= 4,
    }
}

/// Default for an unset handler prop. Never installed: `on_x__set` says
/// whether the caller passed one.
fn __noop() {
    return
}

/// `#rrggbb` / `#rgb` to packed RGB. -1 for empty or malformed, which every
/// style setter reads as "leave unset".
fn hex(s: string) -> int {
    let n = s.len
    if n == 0 {
        return -1
    }
    if s[0] != 35 {
        return -1
    }
    let mut v = 0
    if n == 7 {
        for i in 1..7 {
            let d = hex_digit(s[i])
            if d < 0 {
                return -1
            }
            v = v * 16 + d
        }
        return v
    }
    if n == 4 {
        for i in 1..4 {
            let d = hex_digit(s[i])
            if d < 0 {
                return -1
            }
            v = v * 256 + d * 17
        }
        return v
    }
    return -1
}

fn hex_digit(c: int) -> int {
    if c >= 48 {
        if c <= 57 {
            return c - 48
        }
    }
    if c >= 97 {
        if c <= 102 {
            return c - 87
        }
    }
    if c >= 65 {
        if c <= 70 {
            return c - 55
        }
    }
    return -1
}

// --- builder stack ---
// A trailing block `C(...) { ... }` lowers to `__ui_scope(C(...), || { ... })`.
// `__ui_scope` makes the node the current parent, runs the block, and pops;
// every widget ends with `ui_emit`, which attaches it to that parent. The
// hierarchy is therefore block structure — no parenting calls.

let mut __ui_parents: []int = []int {}

fn __ui_push(id: int) {
    push(__ui_parents, id)
}

fn __ui_pop() {
    if __ui_parents.len > 0 {
        pop(__ui_parents)
    }
}

fn __ui_scope(node: Node, build: fn()) -> Node {
    __ui_push(node.id)
    build()
    __ui_pop()
    return node
}

/// Attach `node` to the innermost enclosing trailing block, if any.
fn ui_emit(node: Node) -> Node {
    if __ui_parents.len > 0 {
        let pid = __ui_parents[__ui_parents.len - 1]
        if pid > 0 {
            child(nd(pid), node)
        }
    }
    return node
}

// --- reactive props ---
// A style prop is a thunk. Interning it yields an int id, which a plain `||`
// effect closure can capture — a `fn` value is not Copy and cannot be. The
// effect calls the thunk and re-applies one setter, so setting a signal
// repaints exactly the props that read it.

fn apply_int(nid: int, setter: int, v: int) {
    let n = nd(nid)
    if setter == 1 {
        if v >= 0 {
            w(n, v)
        }
    } else if setter == 2 {
        if v >= 0 {
            h(n, v)
        }
    } else if setter == 3 {
        if v >= 0 {
            pad(n, v)
        }
    } else if setter == 4 {
        if v >= 0 {
            padX(n, v)
        }
    } else if setter == 5 {
        if v >= 0 {
            padY(n, v)
        }
    } else if setter == 6 {
        if v >= 0 {
            gap(n, v)
        }
    } else if setter == 7 {
        if v >= 0 {
            radius(n, v)
        }
    } else if setter == 8 {
        arena.nodes[nid].border_w = v
    } else if setter == 9 {
        if v >= 0 {
            grow(n, v)
        }
    } else if setter == 10 {
        if v >= 0 {
            align(n, v)
        }
    } else if setter == 11 {
        if v >= 0 {
            justify(n, v)
        }
    } else if setter == 12 {
        if v > 0 {
            font(n, v)
        }
    } else if setter == 13 {
        if v >= 0 {
            opacity(n, v)
        }
    } else if setter == 14 {
        if v == 1 {
            flex_col(n)
        } else {
            flex_row(n)
        }
    } else if setter == 15 {
        if v >= 0 {
            bg(n, v)
        }
    } else if setter == 16 {
        if v >= 0 {
            fg(n, v)
        }
    } else if setter == 17 {
        if v >= 0 {
            border_color(n, v)
        }
    } else if setter == 18 {
        if v >= 0 {
            min_w(n, v)
        }
    } else if setter == 19 {
        if v >= 0 {
            max_w(n, v)
        }
    } else if setter == 20 {
        if v >= 0 {
            min_h(n, v)
        }
    } else if setter == 21 {
        if v >= 0 {
            max_h(n, v)
        }
    } else if setter == 22 {
        if v != 0 {
            flex_wrap(n)
        }
    } else if setter == 23 {
        if v != 0 {
            arena.nodes[nid].safe = 1
        } else {
            arena.nodes[nid].safe = 0
        }
    } else if setter == 24 {
        if v >= 0 {
            arena.nodes[nid].pos = v
        }
    } else if setter == 25 {
        if v >= 0 {
            arena.nodes[nid].pin_l = v
        }
    } else if setter == 26 {
        if v >= 0 {
            arena.nodes[nid].pin_t = v
        }
    } else if setter == 27 {
        if v >= 0 {
            arena.nodes[nid].pin_r = v
        }
    } else if setter == 28 {
        if v >= 0 {
            arena.nodes[nid].pin_b = v
        }
    } else if setter == 29 {
        if v >= 0 {
            arena.nodes[nid].z_index = v
        }
    } else if setter == 30 {
        if v >= 0 {
            shrink(n, v)
        }
    } else if setter == 31 {
        if v == 0 || v == 1 {
            arena.nodes[nid].show_on = v
        }
    } else if setter == 32 {
        if v >= 0 {
            arena.nodes[nid].font = v
        }
    } else if setter == 33 {
        if v >= 0 {
            arena.nodes[nid].wrap = v
        }
    }
}

fn apply_str(nid: int, setter: int, v: string) {
    if setter == 100 {
        arena.nodes[nid].text = v
        return
    }
    if setter == 101 {
        arena.nodes[nid].a11y_label = v
        return
    }
    if setter == 102 {
        arena.nodes[nid].a11y_role = v
        return
    }
    if setter == 103 {
        arena.nodes[nid].cursor = v
        return
    }
    apply_int(nid, setter, hex(v))
}

fn prop_int(node: Node, setter: int, thunk: fn() -> int) -> Node {
    let fid = __intern_int(thunk)
    let nid = node.id
    return styled(node, || { apply_int(nid, setter, platform.plat_invoke_int_fn(fid)) })
}

fn prop_str(node: Node, setter: int, thunk: fn() -> string) -> Node {
    let fid = __intern_str(thunk)
    let nid = node.id
    return styled(node, || { apply_str(nid, setter, platform.plat_invoke_str_fn(fid)) })
}

// --- widgets ---
// Every prop is optional; an omitted one takes its declared default. A
// `foo__set` companion records whether the caller passed `foo`, which is how
// an optional handler is told from its default — function values cannot be
// compared.

struct BoxProps {
    width: fn() -> int = -1,
    height: fn() -> int = -1,
    padding: fn() -> int = -1,
    padding_x: fn() -> int = -1,
    padding_y: fn() -> int = -1,
    spacing: fn() -> int = -1,
    radius: fn() -> int = -1,
    border: fn() -> int = -1,
    border_color: fn() -> string = "",
    background: fn() -> string = "",
    color: fn() -> string = "",
    font: fn() -> int = -1,
    opacity: fn() -> int = -1,
    /// Flex-grow weight: a row or column hands leftover space to the
    /// children with the highest positive `grow` (the engine's `grow`). A
    /// positive `grow` also allows narrowing on overflow (like CSS `flex:
    /// 1`) unless `shrink` is given explicitly.
    grow: fn() -> int = -1,
    /// Flex-shrink weight. `-1` (the default) follows `grow`: a grown child
    /// may narrow before a row wraps; `0` refuses to narrow, `1` allows it.
    shrink: fn() -> int = -1,
    /// Visible when the thunk is true. Signal shows (`zeus.show` / `show_eq`
    /// / `If`) win over this prop on the same node.
    show: fn() -> bool = true,
    align_direction: fn() -> int = 1,
    align_items: fn() -> int = -1,
    justify: fn() -> int = -1,
    wrap: fn() -> int = 0,
    min_width: fn() -> int = -1,
    max_width: fn() -> int = -1,
    min_height: fn() -> int = -1,
    max_height: fn() -> int = -1,
    /// Position mode: `zeus.pos_absolute()` takes the node out of flow and
    /// pins it to this parent's content box; `zeus.pos_relative()` (the
    /// default) leaves it in flow. Omitted (`-1`) means no change.
    position: fn() -> int = -1,
    /// Pin offsets from the parent content box (when `position` is absolute);
    /// `-1` = unpinned on that side. `left` + `right` or `top` + `bottom`
    /// stretch the child to the inner box instead of sizing it.
    left: fn() -> int = -1,
    top: fn() -> int = -1,
    right: fn() -> int = -1,
    bottom: fn() -> int = -1,
    /// Paint and hit-test order against siblings (`> 0` lifts above them;
    /// values only compare inside the same parent). `Overlay` sets 50 itself.
    z_index: fn() -> int = -1,
    /// 1 adds host safe-area insets. App's root scroller already insets.
    safe: fn() -> int = 0,
    /// 1 silences the gray hover wash on clickable boxes (the shadcn default:
    /// flat chrome). Set `hover_off = false` to let a box wash on hover.
    hover_off: fn() -> bool = true,
    /// CSS cursor under the pointer, e.g. `cursor = "pointer"` / `"text"`.
    /// Default `""` = `default` (arrow); hosts fall back for exotic shapes.
    cursor: fn() -> string = "",
    /// Spoken name. Empty means use child text. Native hosts; Canvas2D has no ARIA.
    a11y_label: fn() -> string = "",
    /// Role token: `button`, `text`, `heading`, `dialog`, `list`, `listitem`.
    a11y_role: fn() -> string = "",
    style: BoxStyle = BoxStyle {},
    style__set: bool = false,
    on_click: fn() = __noop,
    on_click__set: bool = false,
    on_mouse_down: fn() = __noop,
    on_mouse_down__set: bool = false,
    on_mouse_up: fn() = __noop,
    on_mouse_up__set: bool = false,
    on_key_down: fn() = __noop,
    on_key_down__set: bool = false,
    on_key_up: fn() = __noop,
    on_key_up__set: bool = false,
    on_key_press: fn() = __noop,
    on_key_press__set: bool = false,
}

struct TextProps {
    color: fn() -> string = "",
    font: fn() -> int = -1,
    padding: fn() -> int = -1,
    opacity: fn() -> int = -1,
    // grow / shrink / show: as BoxProps. `grow = 1` text fills leftover row
    // space and narrows before the row wraps; `show` hides without
    // rebuilding.
    grow: fn() -> int = -1,
    shrink: fn() -> int = -1,
    show: fn() -> bool = true,
    wrap: fn() -> int = 0,
    // position / left / top / right / bottom / z_index: as BoxProps. Pinned
    // labels are how axis ticks and rotated chart text place themselves.
    position: fn() -> int = -1,
    left: fn() -> int = -1,
    top: fn() -> int = -1,
    right: fn() -> int = -1,
    bottom: fn() -> int = -1,
    z_index: fn() -> int = -1,
    a11y_label: fn() -> string = "",
    a11y_role: fn() -> string = "",
}

/// Options for `Button`. Pass `look = LOOK.*` and `size = SIZE.*` for the
/// themed chrome (solid / soft / outline / ghost / danger / link across
/// sm / md / lg). Without them the button is a plain clickable label:
/// `background` / `color` / `font` / `padding` / `radius` / `width` /
/// `height` / `enabled` (dims when false) style it, `on_click` fires it.
struct ButtonProps {
    /// `LOOK` token for themed chrome; -1 = raw (props below decide the look).
    look: fn() -> int = -1,
    /// `SIZE` token for themed chrome.
    size: fn() -> int = -1,
    color: fn() -> string = "",
    background: fn() -> string = "",
    font: fn() -> int = -1,
    padding: fn() -> int = -1,
    radius: fn() -> int = -1,
    width: fn() -> int = -1,
    height: fn() -> int = -1,
    // position / left / top / right / bottom / z_index: as BoxProps.
    position: fn() -> int = -1,
    left: fn() -> int = -1,
    top: fn() -> int = -1,
    right: fn() -> int = -1,
    bottom: fn() -> int = -1,
    z_index: fn() -> int = -1,
    /// Visible when the thunk is true (signal shows win, as BoxProps).
    show: fn() -> bool = true,
    enabled: fn() -> bool = true,
    /// 1 silences the gray hover wash (the shadcn default: flat chrome).
    /// Set `hover_off = false` to let the button wash on hover.
    hover_off: fn() -> bool = true,
    /// CSS cursor under the pointer (default `""` = arrow).
    cursor: fn() -> string = "",
    on_click: fn() = __noop,
    on_click__set: bool = false,
}

struct InputProps {
    placeholder: string = "",
    width: fn() -> int = -1,
    height: fn() -> int = -1,
    // position / left / top / right / bottom / z_index: as BoxProps.
    position: fn() -> int = -1,
    left: fn() -> int = -1,
    top: fn() -> int = -1,
    right: fn() -> int = -1,
    bottom: fn() -> int = -1,
    z_index: fn() -> int = -1,
    /// Visible when the thunk is true (signal shows win, as BoxProps).
    show: fn() -> bool = true,
    color: fn() -> string = "",
    background: fn() -> string = "",
    font: fn() -> int = -1,
    padding: fn() -> int = -1,
    grow: fn() -> int = -1,
    bind: Signal<string> = Signal { id: 0 },
    bind__set: bool = false,
    /// CSS cursor under the pointer (default `""` = arrow; inputs usually
    /// want `"text"` on their frame).
    cursor: fn() -> string = "",
    a11y_label: fn() -> string = "",
    /// 1 = multiline (Enter inserts a newline, wrap + caret up/down).
    multiline: fn() -> int = 0,
    on_key_down: fn() = __noop,
    on_key_down__set: bool = false,
    on_key_up: fn() = __noop,
    on_key_up__set: bool = false,
    on_key_press: fn() = __noop,
    on_key_press__set: bool = false,
}

struct GridProps {
    config: GridConfig = GridConfig {},
    width: fn() -> int = -1,
    background: fn() -> string = "",
    padding: fn() -> int = -1,
    // position / left / top / right / bottom / z_index: as BoxProps.
    position: fn() -> int = -1,
    left: fn() -> int = -1,
    top: fn() -> int = -1,
    right: fn() -> int = -1,
    bottom: fn() -> int = -1,
    z_index: fn() -> int = -1,
    /// Visible when the thunk is true (signal shows win, as BoxProps).
    show: fn() -> bool = true,
}

struct OverlayProps {
    background: fn() -> string = "",
    opacity: fn() -> int = -1,
    /// Visible when the thunk is true (signal shows win, as BoxProps).
    show: fn() -> bool = true,
    on_click: fn() = __noop,
    on_click__set: bool = false,
}

/// Options for `Scroll`. `bind` is a two-way `scroll_y` signal: writing it
/// calls `scroll_to`, and wheel / pan / physics write the live offset back.
struct ScrollProps {
    width: fn() -> int = -1,
    height: fn() -> int = -1,
    grow: fn() -> int = -1,
    bind: Signal<int> = Signal { id: 0 },
    bind__set: bool = false,
}

/// One column of a `VirtualTable`. `width` 0 means the column takes an equal
/// share of the row (pair cells with `basis0(...).grow(1)`); a positive value
/// is a pixel width. `title` is the header cell.
struct TableCol {
    title: string,
    width: int,
}

/// Geometry for `Svg` layers: explicit size plus absolute placement
/// (`position` / `left` / `top` / `right` / `bottom` / `z_index`, as
/// `BoxProps`). Without `width`/`height` an svg is measured like a label.
struct SvgProps {
    width: fn() -> int = -1,
    height: fn() -> int = -1,
    position: fn() -> int = -1,
    left: fn() -> int = -1,
    top: fn() -> int = -1,
    right: fn() -> int = -1,
    bottom: fn() -> int = -1,
    z_index: fn() -> int = -1,
    /// Visible when the thunk is true (signal shows win, as BoxProps).
    show: fn() -> bool = true,
}

/// Options for `Image`. Hosts decode PNG / JPEG / WebP / GIF from a path,
/// data URI, or URL and cache by `src`. Without `width`/`height` the box is
/// empty. `fit` is `IMAGE_FIT` (stretch / contain / cover / none).
struct ImageProps {
    width: fn() -> int = -1,
    height: fn() -> int = -1,
    radius: fn() -> int = -1,
    /// `IMAGE_FIT.Stretch` (default), `.Contain`, `.Cover`, or `.None`.
    fit: fn() -> int = 0,
    /// 1 = decode only once the node intersects the view (skip off-screen).
    lazy: fn() -> int = 0,
    opacity: fn() -> int = -1,
    grow: fn() -> int = -1,
    shrink: fn() -> int = -1,
    min_width: fn() -> int = -1,
    max_width: fn() -> int = -1,
    min_height: fn() -> int = -1,
    max_height: fn() -> int = -1,
    position: fn() -> int = -1,
    left: fn() -> int = -1,
    top: fn() -> int = -1,
    right: fn() -> int = -1,
    bottom: fn() -> int = -1,
    z_index: fn() -> int = -1,
    /// Visible when the thunk is true (signal shows win, as BoxProps).
    show: fn() -> bool = true,
    a11y_label: fn() -> string = "",
}

/// Install the pointer and key handlers a container or input accepts.
fn __box_events(node: Node, p: BoxProps) -> Node {
    if p.on_click__set {
        arena.nodes[node.id].click_fn = __intern(p.on_click)
    }
    if p.on_mouse_down__set {
        arena.nodes[node.id].down_fn = __intern(p.on_mouse_down)
    }
    if p.on_mouse_up__set {
        arena.nodes[node.id].up_fn = __intern(p.on_mouse_up)
    }
    if p.on_key_down__set {
        arena.nodes[node.id].kdown_fn = __intern(p.on_key_down)
        arena.nodes[node.id].focusable = 1
    }
    if p.on_key_up__set {
        arena.nodes[node.id].kup_fn = __intern(p.on_key_up)
        arena.nodes[node.id].focusable = 1
    }
    if p.on_key_press__set {
        arena.nodes[node.id].kpress_fn = __intern(p.on_key_press)
        arena.nodes[node.id].focusable = 1
    }
    return node
}

/// A flex container. `align_direction = DIRECTION.Row | DIRECTION.Column`; a
/// row centres on the cross axis and a column stretches, unless `align_items`
/// is given. `wrap` / `min_width` / `max_width` / `min_height` / `max_height`
/// / `safe` are layout props. Takes a trailing block of children.
fn Box(p: BoxProps) -> Node {
    arena.ensure()
    let n = raw_box()
    shrink(n, 0)
    if p.style__set {
        if p.style.width >= 0 {
            w(n, p.style.width)
        }
        if p.style.height >= 0 {
            h(n, p.style.height)
        }
        if p.style.padding > 0 {
            pad(n, p.style.padding)
        }
        if p.style.grow > 0 {
            grow(n, p.style.grow)
        }
        let sbg = hex(p.style.background)
        if sbg >= 0 {
            bg(n, sbg)
        }
    }
    prop_int(n, 14, p.align_direction)
    prop_int(n, 1, p.width)
    prop_int(n, 2, p.height)
    prop_int(n, 3, p.padding)
    prop_int(n, 4, p.padding_x)
    prop_int(n, 5, p.padding_y)
    prop_int(n, 6, p.spacing)
    prop_int(n, 7, p.radius)
    prop_int(n, 8, p.border)
    prop_int(n, 9, p.grow)
    let sw = __shrink_weight(p.grow, p.shrink)
    prop_int(n, 30, sw)
    prop_int(n, 10, p.align_items)
    prop_int(n, 11, p.justify)
    prop_int(n, 22, p.wrap)
    prop_int(n, 18, p.min_width)
    prop_int(n, 19, p.max_width)
    prop_int(n, 20, p.min_height)
    prop_int(n, 21, p.max_height)
    prop_int(n, 23, p.safe)
    prop_int(n, 24, p.position)
    prop_int(n, 25, p.left)
    prop_int(n, 26, p.top)
    prop_int(n, 27, p.right)
    prop_int(n, 28, p.bottom)
    prop_int(n, 29, p.z_index)
    let show = __show_on(p.show)
    prop_int(n, 31, show)
    prop_int(n, 12, p.font)
    prop_int(n, 13, p.opacity)
    prop_str(n, 15, p.background)
    prop_str(n, 16, p.color)
    prop_str(n, 17, p.border_color)
    prop_str(n, 101, p.a11y_label)
    prop_str(n, 102, p.a11y_role)
    prop_str(n, 103, p.cursor)
    __box_events(n, p)
    if platform.plat_invoke_bool_fn(__intern_bool(p.hover_off)) != 0 {
        hover_off(n)
    }
    return ui_emit(n)
}

/// Static or reactive text. The label is a thunk, so a signal read inside it
/// is recorded against this label's own effect: setting the signal repaints
/// this one node.
fn Text(label: fn() -> string, p: TextProps) -> Node {
    arena.ensure()
    let n = raw_label("")
    shrink(n, 0)
    prop_str(n, 100, label)
    prop_str(n, 16, p.color)
    prop_int(n, 12, p.font)
    prop_int(n, 3, p.padding)
    prop_int(n, 13, p.opacity)
    prop_int(n, 9, p.grow)
    let sw = __shrink_weight(p.grow, p.shrink)
    prop_int(n, 30, sw)
    prop_int(n, 22, p.wrap)
    prop_int(n, 24, p.position)
    prop_int(n, 25, p.left)
    prop_int(n, 26, p.top)
    prop_int(n, 27, p.right)
    prop_int(n, 28, p.bottom)
    prop_int(n, 29, p.z_index)
    let show = __show_on(p.show)
    prop_int(n, 31, show)
    prop_str(n, 101, p.a11y_label)
    prop_str(n, 102, p.a11y_role)
    return ui_emit(n)
}

/// Action button. With `look = LOOK.*` (`Solid` / `Soft` / `Outline` /
/// `Ghost` / `Danger` / `Link`) and `size = SIZE.*` (`Sm` / `Md` / `Lg`)
/// it paints the themed chrome; without them it is a plain clickable label
/// styled by the props (`background` / `color` / `width` / `height` /
/// `enabled` dims when false). `on_click` is optional — omit it for a
/// look-only button.
fn Button(label: fn() -> string, p: ButtonProps) -> Node {
    arena.ensure()
    if platform.plat_invoke_int_fn(__intern_int(p.look)) >= 0 {
        return __btn_look(label, p)
    }
    let n = raw_button("")
    shrink(n, 0)
    prop_str(n, 100, label)
    prop_str(n, 16, p.color)
    prop_str(n, 15, p.background)
    prop_int(n, 12, p.font)
    prop_int(n, 3, p.padding)
    prop_int(n, 7, p.radius)
    prop_int(n, 1, p.width)
    prop_int(n, 2, p.height)
    prop_int(n, 24, p.position)
    prop_int(n, 25, p.left)
    prop_int(n, 26, p.top)
    prop_int(n, 27, p.right)
    prop_int(n, 28, p.bottom)
    prop_int(n, 29, p.z_index)
    let show = __show_on(p.show)
    prop_int(n, 31, show)
    let dim = __enabled_opacity(p.enabled)
    prop_int(n, 13, dim)
    prop_str(n, 103, p.cursor)
    if p.on_click__set {
        arena.nodes[n.id].click_fn = __intern(p.on_click)
        arena.nodes[n.id].a11y_role = "button"
    }
    if platform.plat_invoke_bool_fn(__intern_bool(p.hover_off)) != 0 {
        hover_off(n)
    }
    return ui_emit(n)
}

/// Themed chrome branch of `Button` (look + size tokens): centered label in
/// the shadcn fill / border / radius, hover wash on, pointer cursor.
fn __btn_look(label: fn() -> string, p: ButtonProps) -> Node {
    let look = platform.plat_invoke_int_fn(__intern_int(p.look))
    let size = platform.plat_invoke_int_fn(__intern_int(p.size))
    let n = Box(
        align_direction = DIRECTION.Row,
        align_items = ALIGN.Center,
        justify = ALIGN.Center,
        spacing = SPACE.Exs,
        background = btn_bg(look),
        color = btn_fg(look),
        height = btn_h(size),
        padding_x = btn_px(size),
        radius = btn_radius(size),
        border = btn_bw(look),
        border_color = btn_edge(look),
        on_click = p.on_click,
        a11y_role = "button",
        a11y_label = label,
        hover_off = false,
        cursor = "pointer"
    ) {
        Text(label, color = btn_fg(look), font = btn_font(size))
    }
    return n
}

/// The `show` prop is a bool thunk; visibility is a 0/1 int on the node, so
/// fold the bool through an int thunk exactly like `enabled` folds into an
/// opacity.
fn __show_on(show: fn() -> bool) -> fn() -> int {
    let fid = __intern_bool(show)
    return || {
        if platform.plat_invoke_bool_fn(fid) != 0 {
            1
        } else {
            0
        }
    }
}

/// Shrink weight for a grown child: an explicit `shrink` (>= 0) wins; an
/// omitted one follows `grow`, so `grow = 1` alone is elastic (it may
/// narrow when a row overflows) — the CSS `flex: 1` reading of `grow`.
fn __shrink_weight(grow: fn() -> int, shrink: fn() -> int) -> fn() -> int {
    let gid = __intern_int(grow)
    let sid = __intern_int(shrink)
    return || {
        let g = platform.plat_invoke_int_fn(gid)
        let s = platform.plat_invoke_int_fn(sid)
        if s >= 0 {
            s
        } else if g > 0 {
            1
        } else {
            0
        }
    }
}

/// A disabled button is dimmed. `enabled` stays a thunk so it tracks.
fn __enabled_opacity(enabled: fn() -> bool) -> fn() -> int {
    let fid = __intern_bool(enabled)
    return || {
        let mut v = 40
        if platform.plat_invoke_bool_fn(fid) != 0 {
            v = 100
        }
        v
    }
}

/// Text field. `multiline = 1` wraps and lets Enter insert a newline.
/// `bind = sig` writes the committed buffer into a `Signal<string>` on every
/// edit; the store notifies only on a real change.
fn Input(p: InputProps) -> Node {
    arena.ensure()
    let n = raw_input(p.placeholder)
    shrink(n, 0)
    prop_int(n, 1, p.width)
    prop_int(n, 2, p.height)
    prop_int(n, 24, p.position)
    prop_int(n, 25, p.left)
    prop_int(n, 26, p.top)
    prop_int(n, 27, p.right)
    prop_int(n, 28, p.bottom)
    prop_int(n, 29, p.z_index)
    let show = __show_on(p.show)
    prop_int(n, 31, show)
    prop_str(n, 16, p.color)
    prop_str(n, 15, p.background)
    prop_int(n, 12, p.font)
    prop_int(n, 3, p.padding)
    prop_int(n, 9, p.grow)
    prop_str(n, 101, p.a11y_label)
    prop_str(n, 103, p.cursor)
    prop_int(n, 22, p.multiline)
    arena.nodes[n.id].a11y_role = "textbox"
    if p.bind__set {
        let sig = p.bind
        let nid = n.id
        arena.nodes[nid].edit_sig = sig.id
        arena.nodes[nid].bind_fn = __intern(|| { set(sig, arena.input_committed(nid)) })
    }
    if p.on_key_down__set {
        arena.nodes[n.id].kdown_fn = __intern(p.on_key_down)
    }
    if p.on_key_up__set {
        arena.nodes[n.id].kup_fn = __intern(p.on_key_up)
    }
    if p.on_key_press__set {
        arena.nodes[n.id].kpress_fn = __intern(p.on_key_press)
    }
    return ui_emit(n)
}

/// 2D grid. `config = GridConfig(columns = 3, gap = 12, padding = 16)`.
fn Grid(p: GridProps) -> Node {
    arena.ensure()
    let n = raw_grid(p.config.columns, p.config.gap)
    shrink(n, 0)
    if p.config.padding > 0 {
        pad(n, p.config.padding)
    }
    prop_int(n, 1, p.width)
    prop_int(n, 3, p.padding)
    prop_int(n, 24, p.position)
    prop_int(n, 25, p.left)
    prop_int(n, 26, p.top)
    prop_int(n, 27, p.right)
    prop_int(n, 28, p.bottom)
    prop_int(n, 29, p.z_index)
    let show = __show_on(p.show)
    prop_int(n, 31, show)
    prop_str(n, 15, p.background)
    return ui_emit(n)
}

/// Full-window floater. Kind 9 is out of flow, so showing it does not grow
/// the page scroller. Children are centred; click the dim to dismiss.
fn Overlay(p: OverlayProps) -> Node {
    arena.ensure()
    let n = raw_overlay()
    arena.nodes[n.id].dir = 1
    center(n)
    z_index(n, 50)
    prop_str(n, 15, p.background)
    prop_int(n, 13, p.opacity)
    let show = __show_on(p.show)
    prop_int(n, 31, show)
    if p.on_click__set {
        arena.nodes[n.id].click_fn = __intern(p.on_click)
    }
    return ui_emit(n)
}

/// A column that skips layout while `visible` is 0. Trailing block is the body.
/// The subtree is built once (retained), unlike a build-time `if`.
fn If(visible: Signal<int>) -> Node {
    arena.ensure()
    let n = raw_box()
    shrink(n, 0)
    flex_col(n)
    show(n, visible)
    return ui_emit(n)
}

/// Run `build(i, item)` for each element. `[]T` is Copy when `T` is Copy, so
/// this is safe inside a trailing block.
fn Each<T>(items: []T, build: fn(int, T)) {
    let n = items.len
    for i in 0..n {
        build(i, items[i])
    }
}

/// Append `v` to a live list signal and notify. Use with `For` / `VirtualList`.
/// A windowed list only rebuilds the visible window, not every row.
fn push_item<T>(sig: Signal<[]T>, v: T) {
    let mut xs = sig.get()
    push(xs, v)
    sig.set(xs)
}

/// Insert `v` at index `i` (clamped to `0..len`). Use with `For` / `VirtualList`.
fn insert_item<T>(sig: Signal<[]T>, i: int, v: T) {
    let xs = sig.get()
    let n = xs.len
    let mut at = i
    if at < 0 {
        at = 0
    }
    if at > n {
        at = n
    }
    let mut out = []T {}
    let mut j = 0
    while j < at {
        push(out, xs[j])
        j = j + 1
    }
    push(out, v)
    while j < n {
        push(out, xs[j])
        j = j + 1
    }
    sig.set(out)
}

/// Remove the item at index `i`. No-op if `i` is out of range.
fn remove_item<T>(sig: Signal<[]T>, i: int) {
    let xs = sig.get()
    let n = xs.len
    if i < 0 {
        return
    }
    if i >= n {
        return
    }
    let mut out = []T {}
    let mut j = 0
    while j < n {
        if j != i {
            push(out, xs[j])
        }
        j = j + 1
    }
    sig.set(out)
}

/// Remove the last item from a live list signal. No-op if empty.
fn pop_item<T>(sig: Signal<[]T>) {
    let mut xs = sig.get()
    if xs.len > 0 {
        pop(xs)
        sig.set(xs)
    }
}

const VIRT_OVERSCAN: int = 4

struct VirtWin {
    first: int,
    last: int,
}

fn find_scroller(id: int) -> int {
    if id <= 0 {
        return 0
    }
    if id >= arena.nodes.len {
        return 0
    }
    if arena.nodes[id].kind == 11 {
        return id
    }
    let mut p = arena.nodes[id].parent
    while p > 0 {
        if arena.nodes[p].kind == 11 {
            return p
        }
        p = arena.nodes[p].parent
    }
    return 0
}

/// Visible index window for a windowed list. `row_h` is the fixed row height
/// used to turn `scroll_y` into indices; overscan keeps a few extra rows
/// mounted so a small flick does not rebuild.
fn virt_window(nid: int, n: int, row_h: int) -> VirtWin {
    let mut first = 0
    let mut last = n
    if row_h <= 0 {
        return VirtWin { first: first, last: last }
    }
    let sid = find_scroller(nid)
    let mut view_h = 240
    let mut local = 0
    if sid > 0 {
        if arena.nodes[sid].h > 0 {
            view_h = arena.nodes[sid].h
        }
        if nid == sid {
            local = arena.nodes[sid].scroll_y
        } else {
            local = arena.nodes[sid].scroll_y - (arena.nodes[nid].y - arena.nodes[sid].y)
        }
    } else if arena.nodes[nid].h > 0 {
        view_h = arena.nodes[nid].h
    }
    if local < 0 {
        local = 0
    }
    first = local / row_h - VIRT_OVERSCAN
    last = (local + view_h) / row_h + VIRT_OVERSCAN + 1
    if first < 0 {
        first = 0
    }
    if last > n {
        last = n
    }
    if last < first {
        last = first
    }
    return VirtWin { first: first, last: last }
}

fn virt_refresh<T>(nid: int, items: Signal<[]T>, build: fn(int, T), row_h: int) {
    let xs = items.get()
    let m = xs.len
    let gen = platform.plat_sig_gen(items.id)
    let mut first = 0
    let mut last = m
    if row_h > 0 {
        let w = virt_window(nid, m, row_h)
        first = w.first
        last = w.last
    }
    if gen == arena.nodes[nid].list_gen {
        if first == arena.nodes[nid].list_lo {
            if last == arena.nodes[nid].list_hi {
                if arena.nodes[nid].kids.len > 0 {
                    return
                }
                if m == 0 {
                    arena.nodes[nid].list_n = 0
                    return
                }
            }
        }
    }
    arena.nodes[nid].list_gen = gen
    arena.nodes[nid].list_lo = first
    arena.nodes[nid].list_hi = last
    arena.nodes[nid].list_n = m
    arena.nodes[nid].row_h = row_h
    // Everything the builder allocated last time is owned by this host:
    // signals and interned handlers are freed (and their ids recycled) on
    // the next rebuild, so streaming data does not grow the arena. A
    // windowed list only (re)builds the visible rows — append / insert
    // outside the window is a spacer resize, not O(n) widgets.
    let prev = arena.scope_begin(nid)
    arena.release_sigs(nid)
    arena.release_fns(nid)
    arena.drop_children(nid)
    __ui_push(nid)
    if row_h > 0 {
        if first > 0 {
            let top = raw_spacer()
            h(top, first * row_h)
            ui_emit(top)
        }
    }
    let mut i = first
    while i < last {
        build(i, xs[i])
        i = i + 1
    }
    if row_h > 0 {
        if last < m {
            let bot = raw_spacer()
            h(bot, (m - last) * row_h)
            ui_emit(bot)
        }
    }
    __ui_pop()
    arena.scope_end(prev)
}

/// Growing list. `items` is `zeus.signal([]T {})` (`T` Copy). Push with
/// `push_item` / `insert_item`. Rebuilds on the next layout after a mutation.
/// Pass `row_h` > 0 to window: only the rows that intersect the ancestor
/// scroller (± overscan) are mounted; spacers stand in for the rest.
fn For<T>(items: Signal<[]T>, build: fn(int, T), row_h: int = 0) -> Node {
    arena.ensure()
    let n = raw_box()
    shrink(n, 0)
    flex_col(n)
    arena.nodes[n.id].row_h = row_h
    let nid = n.id
    virt_refresh(nid, items, build, row_h)
    arena.nodes[nid].list_fn = __intern(|| {
        virt_refresh(nid, items, build, row_h)
    })
    return ui_emit(n)
}

/// Vertical scroller that window-renders `items`. `row_h` is the fixed row
/// height in points (spacers use it so `scroll_max` matches the full list).
/// `build(i, item)` is the row. 10k rows stay a few dozen nodes.
fn VirtualList<T>(items: Signal<[]T>, row_h: int, build: fn(int, T)) -> Node {
    arena.ensure()
    let n = raw_scroll()
    grow(n, 1)
    // Shrink so a parent with a fixed height can clamp the viewport; the
    // measured `ih` is the full list (spacers) and must not blow the page.
    shrink(n, 1)
    arena.nodes[n.id].a11y_role = "list"
    arena.nodes[n.id].row_h = row_h
    let nid = n.id
    virt_refresh(nid, items, build, row_h)
    arena.nodes[nid].list_fn = __intern(|| {
        virt_refresh(nid, items, build, row_h)
    })
    return ui_emit(n)
}

/// Windowed table. `rows` is `zeus.signal([]T {})` where `T` is a row struct;
/// `cols` is `[]TableCol` (title + width) for the header. The body is a
/// `VirtualList` of `build(i, row)` — only visible rows are mounted. The
/// themed header (`TableCols`) shares its gutter with body rows; build every
/// cell with `basis0(...).grow(1)` (or a fixed `.w(px)` matching the column)
/// so body columns line up under the header.
fn VirtualTable<T>(rows: Signal<[]T>, cols: []TableCol, row_h: int, build: fn(int, T)) -> Node {
    arena.ensure()
    let wrap = raw_box()
    flex_col(wrap)
    grow(wrap, 1)
    shrink(wrap, 1)
    arena.nodes[wrap.id].a11y_role = "table"
    __ui_push(wrap.id)
    TableCols(cols)
    VirtualList(rows, row_h, build)
    __ui_pop()
    return ui_emit(wrap)
}

/// Jump `n` (a `Scroll` / `VirtualList`) to vertical offset `y`. Clears
/// residual velocity so physics does not coast past the target. Clamped.
fn scroll_to(n: Node, y: int) -> Node {
    arena.nodes[n.id].vel_y = 0
    arena.nodes[n.id].scroll_y = y
    arena.clamp_scroll(n.id)
    if arena.nodes[n.id].bind_sig > 0 {
        arena.store_sig(arena.nodes[n.id].bind_sig, arena.nodes[n.id].scroll_y)
    }
    return n
}

/// Jump `n` to horizontal offset `x`.
fn scroll_to_x(n: Node, x: int) -> Node {
    arena.nodes[n.id].vel_x = 0
    arena.nodes[n.id].scroll_x = x
    arena.clamp_scroll(n.id)
    return n
}

/// Jump a windowed list so item `i` is at the top of the viewport.
fn scroll_to_index(n: Node, i: int) -> Node {
    let mut rh = arena.nodes[n.id].row_h
    if rh < 1 {
        rh = 1
    }
    let mut at = i
    if at < 0 {
        at = 0
    }
    return scroll_to(n, at * rh)
}

/// Live `scroll_y` of `n`.
fn scroll_y(n: Node) -> int {
    return arena.nodes[n.id].scroll_y
}

/// Width a node measured by the last layout pass (0 until the first one).
fn node_width(n: Node) -> int {
    return arena.nodes[n.id].w
}

/// Re-run `build` into `host` whenever the host's measured width changes
/// (window resize, card reflow). `host` must be widthless so it stretches
/// with its parent. Pixel-exact widgets — charts, plots — lay out their
/// children from the measured width, so they stay glued to the container.
/// Rebuilds happen on the layout after a size change.
fn refit_refresh(nid: int, build: fn()) {
    let w = arena.nodes[nid].w
    if w == arena.nodes[nid].list_gen {
        return
    }
    arena.nodes[nid].list_gen = w
    let prev = arena.scope_begin(nid)
    arena.release_sigs(nid)
    arena.release_fns(nid)
    arena.drop_children(nid)
    __ui_push(nid)
    build()
    __ui_pop()
    arena.scope_end(prev)
}

fn refit(host: Node, build: fn()) -> Node {
    arena.ensure()
    let nid = host.id
    arena.nodes[nid].list_fn = __intern(|| {
        refit_refresh(nid, build)
    })
    return host
}

/// Vertical scroller. Children keep intrinsic height; a bar appears on overflow.
/// `bind` is an optional two-way `scroll_y` signal (`scroll_to` writes it).
fn Scroll(p: ScrollProps) -> Node {
    arena.ensure()
    let n = raw_scroll()
    prop_int(n, 1, p.width)
    prop_int(n, 2, p.height)
    prop_int(n, 9, p.grow)
    if p.bind__set {
        arena.nodes[n.id].bind_sig = p.bind.id
        let nid = n.id
        let sid = p.bind.id
        styled(n, || {
            let y = sg(sid).get()
            if arena.nodes[nid].scroll_y != y {
                arena.nodes[nid].vel_y = 0
                arena.nodes[nid].scroll_y = y
                arena.clamp_scroll(nid)
            }
        })
    }
    return ui_emit(n)
}

/// Inline SVG. `currentColor` follows the node's foreground. Geometry props:
/// `width`, `height` (an svg is otherwise measured like a label), plus the
/// usual `position` / pins / `z_index` for layered plots.
fn Svg(markup: string, p: SvgProps) -> Node {
    arena.ensure()
    let n = raw_svg(markup)
    shrink(n, 0)
    prop_int(n, 1, p.width)
    prop_int(n, 2, p.height)
    prop_int(n, 24, p.position)
    prop_int(n, 25, p.left)
    prop_int(n, 26, p.top)
    prop_int(n, 27, p.right)
    prop_int(n, 28, p.bottom)
    prop_int(n, 29, p.z_index)
    let show = __show_on(p.show)
    prop_int(n, 31, show)
    return ui_emit(n)
}

/// Raster image. `src` is a file path, `data:` URI, or `http(s):` URL.
/// Hosts decode PNG / JPEG / WebP / GIF and cache by that string; a missing
/// or still-loading src paints nothing. `fit` is `IMAGE_FIT` (stretch /
/// contain / cover / none). `lazy = 1` skips decode while off-screen.
fn Image(src: fn() -> string, p: ImageProps) -> Node {
    arena.ensure()
    let n = raw_image("")
    shrink(n, 0)
    arena.nodes[n.id].a11y_role = "img"
    prop_str(n, 100, src)
    prop_int(n, 1, p.width)
    prop_int(n, 2, p.height)
    prop_int(n, 7, p.radius)
    prop_int(n, 32, p.fit)
    prop_int(n, 33, p.lazy)
    prop_int(n, 13, p.opacity)
    prop_int(n, 9, p.grow)
    let sw = __shrink_weight(p.grow, p.shrink)
    prop_int(n, 30, sw)
    prop_int(n, 18, p.min_width)
    prop_int(n, 19, p.max_width)
    prop_int(n, 20, p.min_height)
    prop_int(n, 21, p.max_height)
    prop_int(n, 24, p.position)
    prop_int(n, 25, p.left)
    prop_int(n, 26, p.top)
    prop_int(n, 27, p.right)
    prop_int(n, 28, p.bottom)
    prop_int(n, 29, p.z_index)
    let show = __show_on(p.show)
    prop_int(n, 31, show)
    prop_str(n, 101, p.a11y_label)
    return ui_emit(n)
}

let mut pick_dest: Signal<string> = Signal { id: 0 }
let mut pick_w: Signal<int> = Signal { id: 0 }
let mut pick_h: Signal<int> = Signal { id: 0 }

/// Open a host file picker (PNG / JPEG / WebP / GIF). Writes the chosen src
/// into `dest` and the image's intrinsic size into `dw` / `dh`. Native hosts
/// return from the dialog; wasm and mobile finish via `engine_picked_image`.
fn pick_image(dest: Signal<string>, dw: Signal<int>, dh: Signal<int>) {
    pick_dest = dest
    pick_w = dw
    pick_h = dh
    let mut w = 0
    let mut h = 0
    let src = platform.plat_pick_image(&mut w, &mut h)
    if src.len > 0 {
        set(dest, src)
        set(dw, w)
        set(dh, h)
        pick_dest = Signal { id: 0 }
        pick_w = Signal { id: 0 }
        pick_h = Signal { id: 0 }
    }
}

/// Host async completion for `pick_image` (file input, photo library).
fn engine_picked_image(src: string, w: int, h: int) {
    if pick_dest.id > 0 {
        if src.len > 0 {
            set(pick_dest, src)
            if pick_w.id > 0 {
                set(pick_w, w)
            }
            if pick_h.id > 0 {
                set(pick_h, h)
            }
        }
        pick_dest = Signal { id: 0 }
        pick_w = Signal { id: 0 }
        pick_h = Signal { id: 0 }
    }
}

/// Open a window and build the tree once. The tree is retained: signals
/// update the props that read them, never a whole subtree.
/// The root is a vertical scroller: children keep their intrinsic height
/// (they are not shrunk to the window) and a bar appears when they overflow.
fn App(title: string, width: int, height: int, build: fn()) {
    init()
    window(title, width, height)
    let top = raw_scroll()
    // Paint the page background on the root scroller itself (theme-aware,
    // like `Page`): when content rubber-bands past the top/bottom edge or
    // ends short of the viewport, the revealed strip stays paper instead of
    // showing the host's clear color (black on a dark window / wasm page).
    prop_str(top, 15, paper)
    __ui_push(top.id)
    build()
    __ui_pop()
    root(top)
    raw_run()
}

// ═══════════════════════════════════════════════════════════════════
// Design system: zinc palette + theme roles, LOOK / SIZE / TINT tokens,
// typography and radius constants, lucide icon paths, and themed chrome —
// Card / Chip / Badge / Dialog / forms (Field, TextInput, TextArea) / tabs /
// select / radio / toggle / Pagination / charts / DatePicker / Page.
// ═══════════════════════════════════════════════════════════════════


/// Theme roles. `accent` is the neutral "primary": near-black in light,
/// near-white in dark. Status tints (ok, danger) stay semantic; the chart
/// fields are the data-viz layer every chart reads (stroke + area wash).
struct Palette {
    bg: string,
    card: string,
    raised: string,
    text: string,
    muted: string,
    faint: string,
    line: string,
    line_strong: string,
    wash: string,
    on_solid: string,
    accent: string,
    accent_soft: string,
    danger: string,
    danger_solid: string,
    success: string,
    success_fill: string,
    /// Warning tint: text, pips, icons (amber).
    warn: string,
    /// Warning wash (alert fills, soft warning badges).
    warn_fill: string,
    /// Warning border: soft in light, full in dark.
    warn_edge: string,
    /// Destructive border: destructive/50 in light, full in dark.
    danger_edge: string,
    /// Solid success fill for badges and other ok-on-surface pills.
    ok_solid: string,
    /// Text on colored status fills (ok/danger solids) — white in both
    /// appearances.
    on_fill: string,
    /// Modal scrim (behind dialogs and popovers).
    scrim: string,
    /// Tooltip border.
    chart_edge: string,
    /// Series strokes (the shadcn chart defaults).
    chart1: string,
    chart2: string,
    chart3: string,
    chart4: string,
    chart5: string,
    /// Per-series area wash, one entry per appearance.
    fill1: string,
    fill2: string,
    fill3: string,
    fill4: string,
    fill5: string,
}

/// Zinc ("default" shadcn theme), hsl → hex:
/// background 0 0% 100%, foreground 240 10% 3.9%, muted 240 4.8% 95.9%,
/// muted-foreground 240 3.8% 46.1%, border/input 240 5.9% 90%,
/// primary 240 5.9% 10%, primary-foreground 0 0% 98%,
/// destructive 0 84.2% 60.2%.
const LIGHT: Palette = Palette(
    bg = "#ffffff",
    card = "#ffffff",
    raised = "#f4f4f5",
    text = "#09090b",
    muted = "#71717a",
    faint = "#a1a1aa",
    line = "#e4e4e7",
    line_strong = "#d4d4d8",
    wash = "#fafafa",
    on_solid = "#fafafa",
    accent = "#09090b",
    accent_soft = "#f4f4f5",
    danger = "#ef4444",
    danger_solid = "#ef4444",
    success = "#16a34a",
    success_fill = "#f0fdf4",
    warn = "#d97706",
    warn_fill = "#fef3c7",
    warn_edge = "#fde68a",
    danger_edge = "#fca5a5",
    ok_solid = "#16a34a",
    on_fill = "#fafafa",
    scrim = "#000000",
    chart_edge = "#f1f1f3",
    chart1 = "#0d9488",
    chart2 = "#2563eb",
    chart3 = "#f59e0b",
    chart4 = "#db2777",
    chart5 = "#f97316",
    fill1 = "#cdeae4",
    fill2 = "#dbe7fd",
    fill3 = "#fdeecb",
    fill4 = "#fbdce9",
    fill5 = "#ffe3d3"
)

/// Dark: background/foreground swap, muted = zinc-800, border = zinc-800.
const DARK: Palette = Palette(
    bg = "#09090b",
    card = "#09090b",
    raised = "#27272a",
    text = "#fafafa",
    muted = "#a1a1aa",
    faint = "#71717a",
    line = "#27272a",
    line_strong = "#3f3f46",
    wash = "#18181b",
    on_solid = "#09090b",
    accent = "#fafafa",
    accent_soft = "#27272a",
    danger = "#f87171",
    danger_solid = "#dc2626",
    success = "#4ade80",
    success_fill = "#052e16",
    warn = "#fbbf24",
    warn_fill = "#451a03",
    warn_edge = "#78350f",
    danger_edge = "#dc2626",
    ok_solid = "#15803d",
    on_fill = "#fafafa",
    scrim = "#000000",
    chart_edge = "#18181c",
    chart1 = "#0d9488",
    chart2 = "#2563eb",
    chart3 = "#f59e0b",
    chart4 = "#db2777",
    chart5 = "#f97316",
    fill1 = "#0d2f2b",
    fill2 = "#101f45",
    fill3 = "#3c2a05",
    fill4 = "#451026",
    fill5 = "#4a1c0d"
)

fn pick(lit: string, dim: string) -> string {
    if appearance().get() == 1 {
        return dim
    }
    return lit
}

/// Page background. Dark is zinc-950.
fn paper() -> string { return pick(LIGHT.bg, DARK.bg) }
/// Card / popover / dialog surface.
fn plate() -> string { return pick(LIGHT.card, DARK.card) }
/// Muted / secondary / accent background (hover, chips, tab tray).
fn raised() -> string { return pick(LIGHT.raised, DARK.raised) }
/// Foreground text. `ink` is the strongest ink.
fn ink() -> string { return pick(LIGHT.text, DARK.text) }
/// Muted-foreground: secondary text, labels on wash.
fn mute() -> string { return pick(LIGHT.muted, DARK.muted) }
/// Faint text: captions, overlines, placeholders.
fn dim() -> string { return pick(LIGHT.faint, DARK.faint) }
/// Border / input stroke.
fn rule() -> string { return pick(LIGHT.line, DARK.line) }
/// Stronger border: popovers, focus-ish outlines.
fn hard() -> string { return pick(LIGHT.line_strong, DARK.line_strong) }
/// Soft fill for code blocks and inset panels.
fn wash() -> string { return pick(LIGHT.wash, DARK.wash) }
/// Text on `accent` (primary-foreground).
fn on_ink() -> string { return pick(LIGHT.on_solid, DARK.on_solid) }
/// Primary: fills for default buttons, switches, selection. Neutral.
fn accent() -> string { return pick(LIGHT.accent, DARK.accent) }
/// Soft accent surface (`secondary`): soft buttons, pressed toggles.
fn accent_soft() -> string { return pick(LIGHT.accent_soft, DARK.accent_soft) }
/// Destructive text (errors, destructive alerts).
fn danger() -> string { return pick(LIGHT.danger, DARK.danger) }
/// Destructive fill (destructive buttons, filled danger badges).
fn danger_solid() -> string { return pick(LIGHT.danger_solid, DARK.danger_solid) }
/// Destructive border: destructive/50 in light, full in dark.
fn danger_edge() -> string { return pick(LIGHT.danger_edge, DARK.danger_edge) }
/// Solid success fill (ok badges). Deeper than `ok` so white text holds.
fn ok_solid() -> string { return pick(LIGHT.ok_solid, DARK.ok_solid) }
/// Success tint.
fn ok() -> string { return pick(LIGHT.success, DARK.success) }
/// Success wash.
fn ok_fill() -> string { return pick(LIGHT.success_fill, DARK.success_fill) }
/// Warning tint: alert icons, warning chips/pips.
fn warn() -> string { return pick(LIGHT.warn, DARK.warn) }
/// Warning wash (soft warning badges, alert fills).
fn warn_fill() -> string { return pick(LIGHT.warn_fill, DARK.warn_fill) }
/// Warning border: soft in light, full in dark.
fn warn_edge() -> string { return pick(LIGHT.warn_edge, DARK.warn_edge) }
/// Text on danger fills is white in both appearances.
fn on_danger() -> string { return pick(LIGHT.on_fill, DARK.on_fill) }
/// Text on ok fills is white in both appearances.
fn on_ok() -> string { return pick(LIGHT.on_fill, DARK.on_fill) }
/// Modal scrim behind dialogs and popovers.
fn scrim() -> string { return pick(LIGHT.scrim, DARK.scrim) }
/// Skeleton fill: borders in light, raised in dark.
fn bone() -> string { return pick(LIGHT.line, DARK.raised) }

/// Theme roles so native thumbs (switch / slider) follow appearance at paint.
/// 32 primary, 33 input track, 34 thumb (background), 35 primary/20 track.
/// Theme roles so native thumbs (switch / slider) follow appearance at paint.
/// The four slots are palette-backed: text (32), line (33), surface/card
/// (34), and line_strong (35), so restyling the palette restyles the thumbs.
fn roles() {
    theme(32, hex(LIGHT.text), hex(DARK.text))
    theme(33, hex(LIGHT.line), hex(DARK.line))
    theme(34, hex(LIGHT.card), hex(DARK.card))
    theme(35, hex(LIGHT.line_strong), hex(DARK.line_strong))
}

/// Button variants, named after the fill they carry. `Solid` is the shadcn
/// `default` (primary) variant, `Soft` is `secondary`, `Danger` is
/// `destructive`, and `Link` is text-only. Gallery rows read
/// Primary / Secondary / Outline / Ghost / Destructive / Link.
enum LOOK {
    Solid = 0,
    Soft = 1,
    Outline = 2,
    Ghost = 3,
    Danger = 4,
    Link = 5,
}

/// Button sizes: sm h-8, default h-9, lg h-10.
enum SIZE {
    Sm = 0,
    Md = 1,
    Lg = 2,
}

/// Status tints for chips, badges, stats, meters.
enum TINT {
    Ink = 0,
    Ok = 1,
    Mute = 2,
    Dim = 3,
    Danger = 4,
    Warn = 5,
}

fn tint_of(kind: int) -> string {
    if kind == TINT.Ok {
        ok()
    } else if kind == TINT.Mute {
        mute()
    } else if kind == TINT.Dim {
        dim()
    } else if kind == TINT.Danger {
        danger()
    } else if kind == TINT.Warn {
        warn()
    } else {
        ink()
    }
}

/// Type scale. Canvas hosts draw one weight, so hierarchy leans on size and
/// color. 14 is the shadcn `text-sm` workhorse.
const FONT_DISPLAY: int = 30
const FONT_HEADING: int = 20
const FONT_TITLE: int = 16
const FONT_BODY: int = 14
const FONT_CONTROL: int = 13
const FONT_CAPTION: int = 12
const FONT_OVERLINE: int = 11

const PAGE_PAD: int = 32
const SECTION: int = 24
/// shadcn radii (0.625rem base): rounded-sm/md/lg/xl.
const RAD_SM: int = 6
const RAD_MD: int = 8
const RAD_LG: int = 10
const RAD_XL: int = 14
const RAD_FULL: int = 999
const BAR: int = 52
const DOT: int = 8
const HAIRLINE: int = 1

// --- button geometry (Tailwind classes h-8/h-9/h-10, px-3/px-4/px-8) ---

fn btn_px(size: int) -> int {
    if size == SIZE.Sm { 12 } else if size == SIZE.Lg { 32 } else { 16 }
}

fn btn_h(size: int) -> int {
    if size == SIZE.Sm { 32 } else if size == SIZE.Lg { 40 } else { 36 }
}

fn btn_font(size: int) -> int {
    if size == SIZE.Sm { 12 } else { FONT_BODY }
}

fn btn_radius(size: int) -> int {
    return RAD_MD
}

fn btn_bg(look: int) -> string {
    if look == LOOK.Solid {
        accent()
    } else if look == LOOK.Soft {
        raised()
    } else if look == LOOK.Outline {
        plate()
    } else if look == LOOK.Danger {
        danger_solid()
    } else {
        ""
    }
}

fn btn_fg(look: int) -> string {
    if look == LOOK.Solid {
        on_ink()
    } else if look == LOOK.Danger {
        on_danger()
    } else {
        ink()
    }
}

fn btn_bw(look: int) -> int {
    if look == LOOK.Outline {
        HAIRLINE
    } else {
        0
    }
}

fn btn_edge(look: int) -> string {
    if look == LOOK.Outline {
        rule()
    } else {
        ""
    }
}

// --- inline SVG icons (lucide, CC BY 4.0) ---
// The engine's svg reader knows path / circle, `currentColor`, and the
// stroke attrs used below. `Icon` tints them with the node's foreground.

const IC_CHECK: string =
    "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'><path fill='none' stroke='currentColor' stroke-linecap='round' stroke-linejoin='round' stroke-width='1.5' d='M20 6 9 17l-5-5'/></svg>"

const IC_X: string =
    "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'><path fill='none' stroke='currentColor' stroke-linecap='round' stroke-linejoin='round' stroke-width='1.5' d='M18 6 6 18'/><path fill='none' stroke='currentColor' stroke-linecap='round' stroke-linejoin='round' stroke-width='1.5' d='m6 6 12 12'/></svg>"

const IC_CHEV_DOWN: string =
    "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'><path fill='none' stroke='currentColor' stroke-linecap='round' stroke-linejoin='round' stroke-width='1.5' d='m19 9-7 6-7-6'/></svg>"

const IC_CHEV_LEFT: string =
    "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'><path fill='none' stroke='currentColor' stroke-linecap='round' stroke-linejoin='round' stroke-width='1.5' d='m15 18-6-6 6-6'/></svg>"

const IC_CHEV_RIGHT: string =
    "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'><path fill='none' stroke='currentColor' stroke-linecap='round' stroke-linejoin='round' stroke-width='1.5' d='m9 18 6-6-6-6'/></svg>"

const IC_CALENDAR: string =
    "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'><path fill='none' stroke='currentColor' stroke-linecap='round' stroke-linejoin='round' stroke-width='1.5' d='M8 2v4'/><path fill='none' stroke='currentColor' stroke-linecap='round' stroke-linejoin='round' stroke-width='1.5' d='M16 2v4'/><path fill='none' stroke='currentColor' stroke-linecap='round' stroke-linejoin='round' stroke-width='1.5' d='M3 10h18'/><path fill='none' stroke='currentColor' stroke-linecap='round' stroke-linejoin='round' stroke-width='1.5' d='M5 4h14v16H5z'/></svg>"

const IC_INFO: string =
    "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'><circle cx='12' cy='12' r='10' fill='none' stroke='currentColor' stroke-width='1.5'/><path fill='none' stroke='currentColor' stroke-linecap='round' stroke-linejoin='round' stroke-width='1.5' d='M12 16v-4'/><path fill='none' stroke='currentColor' stroke-linecap='round' stroke-linejoin='round' stroke-width='1.5' d='M12 8h.01'/></svg>"

const IC_ALERT_CIRCLE: string =
    "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'><circle cx='12' cy='12' r='10' fill='none' stroke='currentColor' stroke-width='1.5'/><path fill='none' stroke='currentColor' stroke-linecap='round' stroke-linejoin='round' stroke-width='1.5' d='M12 8v4'/><path fill='none' stroke='currentColor' stroke-linecap='round' stroke-linejoin='round' stroke-width='1.5' d='M12 16h.01'/></svg>"

const IC_PLUS: string =
    "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'><path fill='none' stroke='currentColor' stroke-linecap='round' stroke-linejoin='round' stroke-width='1.5' d='M5 12h14'/><path fill='none' stroke='currentColor' stroke-linecap='round' stroke-linejoin='round' stroke-width='1.5' d='M12 5v14'/></svg>"

const IC_MINUS: string =
    "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'><path fill='none' stroke='currentColor' stroke-linecap='round' stroke-linejoin='round' stroke-width='1.5' d='M5 12h14'/></svg>"


/// `markup` painted at `px` square and tinted by `tint`. Returns the node so
/// callers can bind visibility.
///
/// An svg node has no intrinsic size, so the box is set explicitly. The tint
/// goes through `prop_str` rather than `fg` so it re-applies on an
/// appearance change: `apply_str` hands an unknown setter to `apply_int`, and
/// 16 is the fg slot.
fn Icon(markup: string, px: int, tint: fn() -> string) -> Node {
    let n = Svg(markup, width = px, height = px)
    prop_str(n, 16, tint)
    return n
}

fn Pip(fill: string, size: int) {
    Box(width = size, height = size, radius = size / 2, background = fill)
}

fn Row(spacing: int) -> Node {
    return Box(align_direction = DIRECTION.Row, spacing = spacing,
                    align_items = ALIGN.Center)
}

/// Row that wraps onto the next line when it overflows (`flex-wrap: wrap`).
/// Use for responsive clusters of chips, buttons, and badges.
fn RowWrap(spacing: int) -> Node {
    return Box(align_direction = DIRECTION.Row, spacing = spacing,
                    align_items = ALIGN.Center, wrap = 1)
}

fn Column(spacing: int) -> Node {
    return Box(align_direction = DIRECTION.Column, spacing = spacing)
}

fn Grow() {
    Box(grow = 1)
}

/// Card: `rounded-xl border bg-card shadow` (canvas draws no shadow).
/// Padding is the card's own (shadcn's p-6 lives on CardContent).
fn Card() -> Node {
    let n = Box(
        align_direction = DIRECTION.Column,
        spacing = SPACE.Xs,
        background = plate(),
        padding_x = 20,
        padding_y = 16,
        radius = RAD_XL,
        border = HAIRLINE,
        border_color = rule()
    )
    return n
}

/// Horizontal hairline. Kept as `Divider` for older callers.
fn Separator() {
    Box(height = 1, background = rule())
}

/// Legacy name for `Separator`.
fn Divider() {
    Separator()
}

fn Overline(text: string) {
    Text(text, color = dim(), font = FONT_OVERLINE)
}

fn Display(text: string) {
    Text(text, color = ink(), font = FONT_DISPLAY)
}

fn Heading(text: string) {
    Text(text, color = ink(), font = FONT_HEADING)
}

fn Title(text: string) {
    Text(text, color = ink(), font = FONT_TITLE)
}

fn Body(text: string) {
    Text(text, color = mute(), font = FONT_BODY)
}

fn Note(text: string) {
    Text(text, color = dim(), font = FONT_CAPTION)
}

/// Overline + heading + supporting copy as one block.
fn SectionHeader(overline: string, title: string, body: string) {
    Column(SPACE.Exxxs) {
        Text(overline, color = dim(), font = FONT_OVERLINE)
        Text(title, color = ink(), font = FONT_HEADING)
        Text(body, color = mute(), font = FONT_BODY, wrap = 1)
    }
}

/// `SectionHeader` without the supporting copy.
fn SectionTitle(overline: string, title: string) {
    Column(SPACE.Exxxs) {
        Text(overline, color = dim(), font = FONT_OVERLINE)
        Text(title, color = ink(), font = FONT_HEADING)
    }
}



/// Icon-only button, shadcn `size="icon"`: square, 16px lucide glyph in the
/// `look` chrome. `size` picks h-8 / h-9 / h-10. `press` is optional — omit
/// it for a look-only demo (`IconButton(IC_X, LOOK.Ghost, SIZE.Md, "Close")`).
fn IconButton(markup: string, look: int, size: int, label: string,
              press: fn() = __noop) {
    let s = btn_h(size)
    let n = Box(
        align_direction = DIRECTION.Row,
        align_items = ALIGN.Center,
        justify = ALIGN.Center,
        width = s,
        height = s,
        radius = btn_radius(size),
        background = btn_bg(look),
        border = btn_bw(look),
        border_color = btn_edge(look),
        on_click = press,
        a11y_role = "button",
        a11y_label = label,
        hover_off = false,
        cursor = "pointer"
    ) {
        Icon(markup, 16, fn() => btn_fg(look))
    }
}

/// Status pill: tinted dot and label on a muted border pill.
fn Chip(label: string, kind: int) {
    Box(align_direction = DIRECTION.Row, spacing = SPACE.Exxs,
             align_items = ALIGN.Center, padding_x = 10, padding_y = 5,
             background = raised(), radius = RAD_FULL, border = HAIRLINE,
             border_color = rule(), height = 26) {
        Pip(tint_of(kind), DOT - 2)
        Text(label, color = tint_of(kind), font = FONT_CAPTION)
    }
}

fn badge_bg(kind: int) -> string {
    if kind == TINT.Mute {
        raised()
    } else if kind == TINT.Ok {
        ok_solid()
    } else if kind == TINT.Danger {
        danger_solid()
    } else if kind == TINT.Warn {
        warn_fill()
    } else {
        accent()
    }
}

fn badge_fg(kind: int) -> string {
    if kind == TINT.Mute {
        ink()
    } else if kind == TINT.Dim {
        ink()
    } else if kind == TINT.Ok {
        on_ok()
    } else if kind == TINT.Warn {
        warn()
    } else {
        on_ink()
    }
}

fn badge_bw(kind: int) -> int {
    if kind == TINT.Dim {
        HAIRLINE
    } else {
        0
    }
}

fn badge_edge(kind: int) -> string {
    if kind == TINT.Dim {
        hard()
    } else {
        ""
    }
}

/// Badge: `rounded-md border px-2.5 py-0.5 text-xs font-semibold`.
/// Kinds map to shadcn variants: Ink default, Mute secondary, Dim outline,
/// Danger destructive; Ok is a filled success badge.
fn Badge(label: string, kind: int) {
    Box(align_direction = DIRECTION.Row, padding_x = 10, padding_y = 2,
             radius = RAD_MD, background = badge_bg(kind), border = badge_bw(kind),
             border_color = badge_edge(kind), align_items = ALIGN.Center,
             justify = ALIGN.Center) {
        Text(label, color = badge_fg(kind), font = FONT_CAPTION)
    }
}

/// Key cap: 1px border on muted, mono-ish small text (shadcn kbd h-5).
fn Kbd(key: string) {
    Box(align_direction = DIRECTION.Row, padding_x = 6, radius = 4,
             height = 20, background = raised(), border = HAIRLINE,
             border_color = rule(), align_items = ALIGN.Center,
             justify = ALIGN.Center) {
        Text(key, color = mute(), font = 10)
    }
}

/// Toggle `on` (0/1). Native toggle: off track = input, on track = primary,
/// thumb rides on `background`. Pass `appearance()` for Dark mode.
fn Switch(on: Signal<int>) {
    roles()
    let n = raw_toggle()
    bind(n, on)
    w(n, 36)
    h(n, 20)
    radius(n, 10)
    bg(n, role(33))
    fg(n, role(32))
    border_color(n, role(34))
    on_click(n, fn() => on.set(1 - on.get()))
    // Boxes opt into hover with `hover_off = false`; native thumbs stay flat.
    hover_off(n)
    cursor(n, "pointer")
    ui_emit(n)
}

/// Slider. Track is `primary/20`-ish, filled range primary, thumb surface.
fn Slider(value: Signal<int>) {
    roles()
    let n = raw_slider()
    bind(n, value)
    w(n, 220)
    h(n, 20)
    radius(n, 10)
    bg(n, role(35))
    fg(n, role(32))
    border_color(n, role(34))
    keys(n, value, 0, 100)
    // Native thumbs stay flat; only Buttons wash on hover.
    hover_off(n)
    cursor(n, "pointer")
    ui_emit(n)
}

/// Progress: h-2 track, rounded, filled with primary. Value 0..100.
fn Progress(value: Signal<int>) {
    roles()
    let n = raw_progress()
    bind(n, value)
    w(n, 220)
    h(n, 8)
    radius(n, 4)
    bg(n, role(35))
    fg(n, role(32))
    border_color(n, role(34))
    ui_emit(n)
}

/// Legacy name for `Progress`.
fn Meter(value: Signal<int>) {
    Progress(value)
}

/// Alert: `rounded-lg border px-4 py-3`, leading icon, title + description.
/// The default variant is background + foreground; destructive is a red
/// border with red text. Body sits at 13 (text-sm on the web reads one step
/// smaller in canvas).
fn Alert(title: string, body: string) {
    __alert(title, body, 0)
}

/// Destructive variant of `Alert`.
fn AlertDestructive(title: string, body: string) {
    __alert(title, body, 1)
}

/// Warning variant of `Alert`: amber edge and icon.
fn AlertWarning(title: string, body: string) {
    __alert(title, body, 2)
}

fn __alert(title: string, body: string, kind: int) {
    Box(align_direction = DIRECTION.Row, spacing = 12,
             align_items = ALIGN.Start, background = plate(),
             border = HAIRLINE,
             border_color = if kind == 1 { danger_edge() } else if kind == 2 { warn_edge() } else { rule() },
             padding_x = 16, padding_y = 12, radius = RAD_LG) {
        if kind == 1 {
            Icon(IC_ALERT_CIRCLE, 16, danger)
        } else if kind == 2 {
            Icon(IC_ALERT_CIRCLE, 16, warn)
        } else {
            Icon(IC_INFO, 16, ink)
        }
        Column(4) {
            Text(title, color = if kind == 1 { danger() } else if kind == 2 { warn() } else { ink() },
                      font = FONT_BODY)
            Text(body, color = if kind == 1 { danger() } else { mute() },
                      font = FONT_CONTROL, wrap = 1)
        }
    }
}

/// Raised panel (no border). Prefer `Card` for shadcn look.
fn Surface() -> Node {
    return Box(
        align_direction = DIRECTION.Column,
        spacing = SPACE.Xs,
        background = raised(),
        padding = SPACE.Md,
        radius = RAD_LG
    )
}

/// shadcn `Label`: `text-sm font-medium`.
fn Label(text: string) {
    Text(text, color = ink(), font = FONT_BODY)
}

/// Text input frame (themed; raw editing widget is `Input`): h-9, rounded-md, 1px input border, transparent fill.
fn TextInput(value: Signal<string>, placeholder: string) {
    Box(
        background = plate(),
        border = HAIRLINE,
        border_color = rule(),
        radius = RAD_MD,
        padding_x = 12,
        padding_y = 8,
        cursor = "text"
    ) {
        Input(bind = value, placeholder = placeholder,
                   background = "", color = ink(), font = FONT_BODY,
                   padding = 0, a11y_label = placeholder)
    }
}

/// Multiline compose field: min-height ~4 lines, same chrome as `TextInput`.
/// `on_edit` runs on key-up (autosave).
fn TextArea(value: Signal<string>, placeholder: string, on_edit: fn() = __noop) {
    Box(
        background = plate(),
        border = HAIRLINE,
        border_color = rule(),
        radius = RAD_MD,
        padding_x = 12,
        padding_y = 8,
        min_height = 96,
        cursor = "text"
    ) {
        Input(bind = value, placeholder = placeholder,
                   background = "", color = ink(), font = FONT_BODY,
                   padding = 0, multiline = 1, grow = 1, a11y_label = placeholder,
                   on_key_up = on_edit)
    }
}

/// Label + input, the shadcn form demo.
fn Field(label: string, value: Signal<string>, placeholder: string) {
    Column(SPACE.Exs) {
        Label(label)
        TextInput(value, placeholder)
    }
}

/// Checkbox: 16px rounded-sm box, 1px primary border, primary fill when
/// checked with a white SVG check (shadcn Check h-4 w-4).
fn Checkbox(label: string, on: Signal<int>) {
    Box(align_direction = DIRECTION.Row, spacing = SPACE.Exs,
             align_items = ALIGN.Center,
             on_click = fn() => on.set(1 - on.get()),
             cursor = "pointer") {
        Box(width = 16, height = 16, radius = RAD_SM,
                 background = if on.get() == 1 { accent() } else { plate() },
                 border = HAIRLINE,
                 border_color = accent(),
                 align_items = ALIGN.Center, justify = ALIGN.Center) {
            let mark = Svg(IC_CHECK, width = 16, height = 16)
            prop_str(mark, 16, on_ink)
            show(mark, on)
        }
        Text(label, color = ink(), font = FONT_BODY)
    }
}


/// Avatar: rounded-full with initials on muted. `size` is the diameter
/// (40 = shadcn h-10). Pass `src` for a photo; initials remain the fallback
/// while the host loads. `User` composes it.
fn Avatar(initials: string, size: int, src: string = "") {
    Box(align_direction = DIRECTION.Row, width = size, height = size,
             radius = size / 2, background = raised(), align_items = ALIGN.Center,
             justify = ALIGN.Center) {
        Text(initials, color = ink(), font = (size + 8) / 4)
        if src.len > 0 {
            Image(src, width = size, height = size, radius = size / 2,
                       position = pos_absolute(), left = 0, top = 0)
        }
    }
}

/// Avatar + name + role column, the "user card" pattern.
fn User(initials: string, name: string, role: string, src: string = "") {
    Row(SPACE.Xs) {
        Avatar(initials, 40, src)
        Column(2) {
            Text(name, color = ink(), font = FONT_BODY)
            Text(role, color = mute(), font = FONT_CAPTION)
        }
    }
}

/// Stat card: small muted label over a big tinted value.
fn Stat(label: string, value: string, kind: int) {
    let c = Card() {
        Text(label, color = mute(), font = FONT_CONTROL)
        Text(value, color = tint_of(kind), font = 26)
    }
    grow(c, 1)
}

fn StatCount(label: string, sig: Signal<int>, kind: int) {
    let c = Card() {
        Text(label, color = mute(), font = FONT_CONTROL)
        Text("{{sig.get()}}", color = tint_of(kind), font = 26)
    }
    grow(c, 1)
}

/// Breadcrumb: items separated by chevron icons; last item is foreground.
fn Breadcrumbs(a: string, b: string, c: string) {
    Row(6) {
        Text(a, color = mute(), font = FONT_BODY)
        Icon(IC_CHEV_RIGHT, 14, mute)
        Text(b, color = mute(), font = FONT_BODY)
        Icon(IC_CHEV_RIGHT, 14, mute)
        Text(c, color = ink(), font = FONT_BODY)
    }
}

/// One tab trigger. Active: card background, foreground text.
fn Tab(label: string, selected: Signal<int>, index: int) {
    Box(
        align_direction = DIRECTION.Row,
        align_items = ALIGN.Center,
        spacing = SPACE.Exxs,
        background = if selected.get() == index { plate() } else { raised() },
        padding_x = 12,
        padding_y = 5,
        radius = RAD_MD,
        on_click = fn() => selected.set(index),
        a11y_role = "button",
        a11y_label = label,
        cursor = "pointer"
    ) {
        Text(label, color = if selected.get() == index { ink() } else { mute() },
                  font = FONT_BODY)
    }
}

/// Tabs: h-9 muted tray (`rounded-lg bg-muted p-1`) with a card trigger.
/// The tray sits in a row wrapper so it hugs its triggers instead of
/// stretching to the column width (columns stretch children cross-axis).
fn Tabs(selected: Signal<int>, labels: []string) {
    Row(0) {
        Box(
            align_direction = DIRECTION.Row,
            spacing = 2,
            padding = 4,
            background = raised(),
            radius = RAD_LG,
            align_items = ALIGN.Center
        ) {
            Each(labels, fn(i, lab) {
                Tab(lab, selected, i)
            })
        }
    }
}

/// One toggle-style choice row inside `Segmented` / `ToggleGroup`.
fn Choice(label: string, value: Signal<int>, index: int) {
    Box(
        align_direction = DIRECTION.Row,
        align_items = ALIGN.Center,
        spacing = SPACE.Exxs,
        background = if value.get() == index { plate() } else { raised() },
        padding_x = 12,
        padding_y = 5,
        radius = RAD_MD,
        on_click = fn() => value.set(index),
        cursor = "pointer"
    ) {
        Text(label, color = if value.get() == index { ink() } else { mute() },
                  font = FONT_BODY)
    }
}

/// Exclusive pick from `labels` as a Tabs-style tray. Same chrome as
/// `Tabs`; kept for older callers.
fn Segmented(value: Signal<int>, labels: []string) {
    Row(0) {
        Box(
            align_direction = DIRECTION.Row,
            spacing = 2,
            padding = 4,
            background = raised(),
            radius = RAD_LG,
            align_items = ALIGN.Center
        ) {
            Each(labels, fn(i, lab) {
                Choice(lab, value, i)
            })
        }
    }
}

const SELECT_W: int = 200
/// Trigger height 36 + 6pt of air.
const SELECT_DROP: int = 42

/// One row of a `Select` menu: hover wash, check icon on the picked row.
fn SelectRow(value: Signal<int>, open: Signal<int>, index: int, label: string) {
    Box(
        align_direction = DIRECTION.Row,
        align_items = ALIGN.Center,
        spacing = 4,
        padding_x = 8,
        padding_y = 6,
        radius = RAD_SM,
        on_click = fn() {
            value.set(index)
            open.set(0)
        },
        a11y_role = "listitem",
        a11y_label = label,
        cursor = "pointer"
    ) {
        Text(label, color = ink(), font = FONT_BODY)
        Grow()
        let mark = Icon(IC_CHECK, 16, ink)
        show_eq(mark, value, index)
    }
}

/// Dropdown. The trigger shows the current label; the menu is a floater
/// pinned under it (card surface, p-1 viewport, hairline border).
fn Select(value: Signal<int>, labels: []string) {
    let open = signal(0)
    let host = Box(align_direction = DIRECTION.Column)
    __ui_push(host.id)
    let trigger = Box(
        align_direction = DIRECTION.Row,
        align_items = ALIGN.Center,
        spacing = 4,
        width = SELECT_W,
        padding_x = 12,
        padding_y = 8,
        background = plate(),
        border = HAIRLINE,
        border_color = rule(),
        radius = RAD_MD,
        on_click = fn() => open.set(1 - open.get()),
        a11y_role = "button",
        cursor = "pointer"
    ) {
        // Every label is built once and all but the selected one is hidden —
        // no dynamic indexing is needed.
        Each(labels, fn(i, lab) {
            let t = Text(lab, color = ink(), font = FONT_BODY)
            show_eq(t, value, i)
        })
        Grow()
        Icon(IC_CHEV_DOWN, 16, dim)
    }
    let menu = Box(
        align_direction = DIRECTION.Column,
        width = SELECT_W,
        padding = 4,
        spacing = 2,
        background = plate(),
        border = HAIRLINE,
        border_color = rule(),
        radius = RAD_MD,
        position = pos_absolute(),
        top = SELECT_DROP,
        left = 0,
        z_index = 10
    )
    show(menu, open)
    enter_fade(menu)
    __ui_push(menu.id)
    Each(labels, fn(i, lab) {
        SelectRow(value, open, i, lab)
    })
    __ui_pop()
    __ui_pop()
    // The host stays in flow (the default); the menu above is its absolute
    // child.
    align_self(host, ALIGN.Start)
}

/// Radio group: vertical stack of `Radio` rows, gap-2. The picked row gets a
/// filled primary dot.
fn Radio(label: string, value: Signal<int>, index: int) {
    Box(align_direction = DIRECTION.Row, spacing = SPACE.Exs,
             align_items = ALIGN.Center,
             on_click = fn() => value.set(index),
             cursor = "pointer") {
        Box(width = 16, height = 16, radius = 8,
                 background = plate(), border = HAIRLINE,
                 border_color = accent(),
                 align_items = ALIGN.Center, justify = ALIGN.Center) {
            Box(width = 14, height = 14, radius = 7,
                     background = if value.get() == index { accent() } else { plate() })
        }
        Text(label, color = ink(), font = FONT_BODY)
    }
}

/// `RadioGroup(value, labels)`: one circle per option.
fn RadioGroup(value: Signal<int>, labels: []string) {
    Column(SPACE.Exs) {
        Each(labels, fn(i, lab) {
            Radio(lab, value, i)
        })
    }
}

/// Toggle: default variant, no border — a pressed state fills muted
/// (`bg-accent`), h-9 rounded-md, like the shadcn toggle demo.
fn Toggle(label: string, on: Signal<int>) {
    Box(
        align_direction = DIRECTION.Row,
        align_items = ALIGN.Center,
        justify = ALIGN.Center,
        spacing = SPACE.Exxs,
        height = 36,
        padding_x = 12,
        radius = RAD_MD,
        background = if on.get() == 1 { raised() } else { plate() },
        on_click = fn() => on.set(1 - on.get()),
        a11y_role = "button",
        a11y_label = label,
        cursor = "pointer"
    ) {
        Text(label, color = if on.get() == 1 { ink() } else { mute() },
                  font = FONT_BODY)
    }
}

/// Toggle group: `flex gap-1` of single-choice toggles with outline chrome
/// (shadcn toggle `variant="outline"`), pressed state fills muted.
fn ToggleGroup(value: Signal<int>, labels: []string) {
    Row(4) {
        Each(labels, fn(i, lab) {
            Box(
                align_direction = DIRECTION.Row,
                align_items = ALIGN.Center,
                justify = ALIGN.Center,
                height = 36,
                padding_x = 12,
                radius = RAD_MD,
                background = if value.get() == i { raised() } else { plate() },
                border = HAIRLINE,
                border_color = rule(),
                on_click = fn() => value.set(i),
                a11y_role = "button",
                a11y_label = lab,
                cursor = "pointer"
            ) {
                Text(lab, color = ink(), font = FONT_BODY)
            }
        })
    }
}

/// Placeholder surface (`rounded-md bg-primary/10`). Width/height explicit;
/// wrap in a card to demo.
fn Skeleton(w: int, h: int, radius: int) {
    Box(width = w, height = h, radius = radius, background = bone())
}

/// Dialog + AlertDialog shared chrome. `x` adds the close button.
fn __dialog(open: Signal<int>, close_x: int) -> Node {
    let dim = Overlay(
        background = scrim(),
        opacity = 80,
        on_click = fn() => open.set(0)
    )
    show(dim, open)
    __ui_push(dim.id)
    let panel = Box(
        align_direction = DIRECTION.Column,
        width = 440,
        padding = 24,
        spacing = 16,
        background = plate(),
        border = HAIRLINE,
        border_color = rule(),
        radius = RAD_LG,
        a11y_role = "dialog",
        on_click = fn() { return }
    )
    enter_fade(panel)
    if close_x == 1 {
        __ui_push(panel.id)
        let close = Box(
            align_direction = DIRECTION.Row,
            width = 28,
            height = 28,
            radius = RAD_MD,
            align_items = ALIGN.Center,
            justify = ALIGN.Center,
            position = pos_absolute(),
            top = 16,
            right = 16,
            z_index = 20,
            on_click = fn() => open.set(0),
            a11y_role = "button",
            a11y_label = "Close",
            cursor = "pointer"
        ) {
            Icon(IC_X, 16, mute)
        }
        __ui_pop()
    }
    __ui_pop()
    return panel
}

/// Modal dialog: dim scrim, centered card, X to close. The trailing block is
/// the body. Click the dim (not the card) to close.
fn Dialog(open: Signal<int>) -> Node {
    return __dialog(open, 1)
}

/// AlertDialog: modal confirm with no X — Cancel / destructive actions only.
fn AlertDialog(open: Signal<int>) -> Node {
    return __dialog(open, 0)
}

fn Navbar(brand: string) {
    Column(0) {
        Box(align_direction = DIRECTION.Row, spacing = SPACE.Md,
                 align_items = ALIGN.Center, height = BAR,
                 a11y_role = "navigation") {
            Pip(ink(), 10)
            Text(brand, color = ink(), font = FONT_TITLE)
            Grow()
            Text("Dark", color = mute(), font = FONT_CONTROL)
            Switch(appearance())
        }
        Separator()
    }
}

/// Docs-style nav item: muted text, muted pill when active. h-9 like the
/// shadcn docs nav.
fn NavTab(label: string, page: Signal<int>, index: int) {
    Box(
        align_direction = DIRECTION.Row,
        align_items = ALIGN.Center,
        spacing = SPACE.Exxs,
        padding_x = 12,
        height = 36,
        radius = RAD_MD,
        background = if page.get() == index { raised() } else { paper() },
        on_click = fn() => page.set(index),
        a11y_role = "button",
        a11y_label = label,
        cursor = "pointer"
    ) {
        Text(label, color = if page.get() == index { ink() } else { mute() },
                  font = FONT_BODY)
    }
}

/// Header row: muted label cells above a hairline (th h-10 px-2). Cells use
/// zero basis + grow so the three columns split the row evenly and line up
/// with `TableRow` bodies regardless of text width.
fn TableHead(a: string, b: string, c: string) {
    Column(SPACE.Exs) {
        Row(SPACE.Sm) {
            basis0(Text(a, color = mute(), font = FONT_BODY, grow = 1))
            basis0(Text(b, color = mute(), font = FONT_BODY, grow = 1))
            basis0(Text(c, color = mute(), font = FONT_BODY, grow = 1))
        }
        Separator()
    }
}

/// Body row: three cells under a hairline, foreground text (td p-2).
fn TableRow(a: string, b: string, c: string) {
    Column(SPACE.Exs) {
        Row(SPACE.Sm) {
            basis0(Text(a, color = ink(), font = FONT_BODY, grow = 1))
            basis0(Text(b, color = ink(), font = FONT_BODY, grow = 1))
            basis0(Text(c, color = ink(), font = FONT_BODY, grow = 1))
        }
        Separator()
    }
}

/// Header from `[]TableCol` (`title` + `width`; 0 = equal share of the row).
fn TableCols(cols: []TableCol) {
    Column(SPACE.Exs) {
        // Same gutter as the body rows (`padding_x = SPACE.Exs`), so header
        // and cells share the same column boundaries.
        Box(align_direction = DIRECTION.Row, align_items = ALIGN.Center,
                 spacing = SPACE.Sm, padding_x = SPACE.Exs) {
            Each(cols, fn(i, c) {
                if c.width > 0 {
                    Box(width = c.width) {
                        Text(c.title, color = mute(), font = FONT_BODY)
                    }
                } else {
                    basis0(Text(c.title, color = mute(), font = FONT_BODY, grow = 1))
                }
            })
        }
        Separator()
    }
}


/// One page number for `Pagination`: ghost number; the current page is an
/// outline button. Reads happen inside prop thunks so the row repaints.
fn PageButton(page: Signal<int>, n: int) {
    Box(align_direction = DIRECTION.Row,
        width = 36,
        height = 36,
        radius = RAD_MD,
        align_items = ALIGN.Center,
        justify = ALIGN.Center,
        background = if page.get() == n { plate() } else { paper() },
        border = if page.get() == n { HAIRLINE } else { 0 },
        border_color = rule(),
        on_click = fn() => page.set(n),
        a11y_role = "button",
        a11y_label = "{{n}}",
        cursor = "pointer"
    ) {
        Text("{{n}}",
                  color = if page.get() == n { ink() } else { mute() },
                  font = FONT_BODY)
    }
}

/// `Pagination(cur, pages)`: `pages` is the 1-based page count.
fn Pagination(cur: Signal<int>, pages: int) {
    Row(4) {
        let prev = Box(
            align_direction = DIRECTION.Row,
            width = 36,
            height = 36,
            radius = RAD_MD,
            align_items = ALIGN.Center,
            justify = ALIGN.Center,
            on_click = fn() {
                if cur.get() > 1 {
                    cur.set(cur.get() - 1)
                }
            },
            a11y_role = "button",
            a11y_label = "Previous page",
            cursor = "pointer"
        ) {
            Icon(IC_CHEV_LEFT, 16, mute)
        }
        let mut i = 1
        while i <= pages {
            PageButton(cur, i)
            i = i + 1
        }
        let next = Box(
            align_direction = DIRECTION.Row,
            width = 36,
            height = 36,
            radius = RAD_MD,
            align_items = ALIGN.Center,
            justify = ALIGN.Center,
            on_click = fn() {
                if cur.get() < pages {
                    cur.set(cur.get() + 1)
                }
            },
            a11y_role = "button",
            a11y_label = "Next page",
            cursor = "pointer"
        ) {
            Icon(IC_CHEV_RIGHT, 16, mute)
        }
    }
}

// --- charts (shadcn / recharts look) ---
// Cartesian charts: muted gridlines, axis labels, a rounded floating tooltip
// per category (hovering any x-column shows it, like the recharts cursor),
// and a bottom legend. Data is flat: `labels` are the x categories, `names`
// the series, and `vals` holds `labels.len * names.len` ints row-major
// (category-major: `vals[i * s + j]` is category `i`, series `j`).

/// Chart width/height used by the demos (put charts in a Card column).
const CHART_W: int = 640
const CHART_H: int = 200
/// Left gutter for the y tick labels.
const CHART_GUTTER: int = 34
/// Air above the plot, room for the floating tooltip.
const CHART_TOP: int = 8
/// Bottom strip for the x labels (45° labels need diagonal room).
const CHART_XLAB: int = 34

/// Series palette (approx. of the shadcn default chart colors), from the
/// `chart*` theme tokens so restyling edits the palette, not the charts.
fn chart_color(i: int) -> string {
    let k = i % 5
    if k == 1 { pick(LIGHT.chart1, DARK.chart1)
    } else if k == 2 { pick(LIGHT.chart2, DARK.chart2)
    } else if k == 3 { pick(LIGHT.chart3, DARK.chart3)
    } else if k == 4 { pick(LIGHT.chart4, DARK.chart4)
    } else { pick(LIGHT.chart5, DARK.chart5) }
}

/// Area wash per series in the light appearance (theme `fill*` tokens).
fn __c_fl(i: int) -> string {
    let k = i % 5
    if k == 1 { LIGHT.fill1
    } else if k == 2 { LIGHT.fill2
    } else if k == 3 { LIGHT.fill3
    } else if k == 4 { LIGHT.fill4
    } else { LIGHT.fill5 }
}

/// Area wash per series in the dark appearance.
fn __c_fd(i: int) -> string {
    let k = i % 5
    if k == 1 { DARK.fill1
    } else if k == 2 { DARK.fill2
    } else if k == 3 { DARK.fill3
    } else if k == 4 { DARK.fill4
    } else { DARK.fill5 }
}

/// Area wash per series in the current appearance (`primary/20`-style
/// blends of the series strokes).
fn chart_fill(i: int) -> string {
    return pick(__c_fl(i), __c_fd(i))
}

/// Tooltip border: `border/50` in light, near-`border` in dark.
fn chart_edge() -> string { return pick(LIGHT.chart_edge, DARK.chart_edge) }

fn __b_s(b: []int, s: string) -> []int {
    let mut out = b
    for i in 0..s.len {
        out.push(s[i])
    }
    return out
}

fn __b_i(b: []int, v: int) -> []int {
    let mut out = b
    let mut w = v
    if w < 0 {
        out.push(45)
        w = -w
    }
    if w == 0 {
        out.push(48)
        return out
    }
    let mut digits = []int {}
    let mut t = w
    while t > 0 {
        digits.push(48 + t % 10)
        t = t / 10
    }
    let m = digits.len
    for i in 0..m {
        out.push(digits[m - 1 - i])
    }
    return out
}

/// Value at category `i`, series `j` in the row-major flat array.
fn __c_val(vals: []int, s: int, i: int, j: int) -> int {
    return vals[i * s + j]
}

/// Shared y domain over series `0..s`: one axis scales every series.
fn __c_domain(vals: []int, s: int, n: int) -> int {
    let mut hi = 1
    for i in 0..n {
        for j in 0..s {
            let v = __c_val(vals, s, i, j)
            if v > hi {
                hi = v
            }
        }
    }
    return hi
}

fn __c_col_x(gutter: int, col_w: int, i: int) -> int {
    return gutter + i * col_w
}

fn __c_y(maxv: int, plot_h: int, top: int, v: int) -> int {
    return top + plot_h - v * plot_h / maxv
}

/// Compose svg markup; `d` is in plot coordinates and the viewBox matches
/// the node size, so coordinates map 1:1.
fn __c_svg(d: string, w: int, h: int, fill: string, stroke: string, sw: int) -> string {
    let mut b = []int {}
    b = __b_s(b, "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 ")
    b = __b_i(b, w)
    b = __b_s(b, " ")
    b = __b_i(b, h)
    b = __b_s(b, "'><path fill='")
    b = __b_s(b, fill)
    b = __b_s(b, "' stroke='")
    b = __b_s(b, stroke)
    b = __b_s(b, "' stroke-width='")
    b = __b_i(b, sw)
    b = __b_s(b, "' d='")
    b = __b_s(b, d)
    b = __b_s(b, "'/></svg>")
    return string_from_bytes(b)
}

/// Full-size svg node for the plot, layered at 0,0.
fn __c_layer(markup: string, w: int, h: int) -> Node {
    return Svg(markup, width = w, height = h,
                    position = pos_absolute(), left = 0, top = 0)
}

/// Polyline for series `j` (straight segments — recharts default linear).
fn __c_line_d(vals: []int, s: int, j: int, maxv: int, gutter: int, col_w: int,
              plot_h: int, top: int, n: int) -> string {
    let mut b = []int {}
    b = __b_s(b, "M")
    for i in 0..n {
        let x = __c_col_x(gutter, col_w, i) + col_w / 2
        let y = __c_y(maxv, plot_h, top, __c_val(vals, s, i, j))
        b = __b_i(b, x)
        b = __b_s(b, " ")
        b = __b_i(b, y)
        if i + 1 < n {
            b = __b_s(b, "L")
        }
    }
    return string_from_bytes(b)
}

/// Closed polygon under series `j`: the line plus the baseline (area fill).
fn __c_area_d(vals: []int, s: int, j: int, maxv: int, gutter: int, col_w: int,
              plot_h: int, top: int, n: int) -> string {
    let base = top + plot_h
    let first_x = gutter + col_w / 2
    let last_x = __c_col_x(gutter, col_w, n - 1) + col_w / 2
    let mut b = []int {}
    b = __b_s(b, "M")
    for i in 0..n {
        let x = __c_col_x(gutter, col_w, i) + col_w / 2
        let y = __c_y(maxv, plot_h, top, __c_val(vals, s, i, j))
        b = __b_i(b, x)
        b = __b_s(b, " ")
        b = __b_i(b, y)
        b = __b_s(b, "L")
    }
    b = __b_i(b, last_x)
    b = __b_s(b, " ")
    b = __b_i(b, base)
    b = __b_s(b, "L")
    b = __b_i(b, first_x)
    b = __b_s(b, " ")
    b = __b_i(b, base)
    b = __b_s(b, "Z")
    return string_from_bytes(b)
}

/// Gridlines + y tick labels + baseline. Call with the plot pushed.
fn __c_axes(w: int, h: int, maxv: int) {
    let plot_h = h - CHART_TOP - CHART_XLAB
    let base_y = CHART_TOP + plot_h
    // Gridlines above the baseline (top = max value).
    for k in 0..4 {
        let line = Box(width = w - CHART_GUTTER, height = 1,
                            background = rule(), opacity = 45,
                            position = pos_absolute(),
                            left = CHART_GUTTER,
                            top = CHART_TOP + k * plot_h / 4)
    }
    // Y tick labels, max .. 0 (bottom 0 sits above the baseline).
    for k in 0..5 {
        let tv = maxv - k * maxv / 4
        let lab = Box(align_direction = DIRECTION.Row, justify = ALIGN.End,
                           width = CHART_GUTTER - 6, height = 12,
                           position = pos_absolute(),
                           left = 0,
                           top = CHART_TOP + k * plot_h / 4 - 6) {
            Text("{{tv}}", color = mute(), font = FONT_CAPTION)
        }
    }
    // Baseline axis.
    let axis = Box(width = w - CHART_GUTTER, height = 1, background = hard(),
                        position = pos_absolute(),
                        left = CHART_GUTTER,
                        top = base_y)
}

/// One floating tooltip panel shared by every category: its content and
/// position track the hovered column (`act` = category + 1, 0 = none)
/// through prop thunks, instead of one pre-built panel per category.
fn __c_tooltip(labels: []string, names: []string, vals: []int, s: int, n: int,
               w: int, col_w: int, act: Signal<int>) {
    let panel = Box(
        align_direction = DIRECTION.Column,
        width = 128,
        spacing = 4,
        padding_x = 10,
        padding_y = 6,
        background = plate(),
        border = HAIRLINE,
        border_color = chart_edge(),
        radius = RAD_LG,
        position = pos_absolute(),
        top = 0,
        z_index = 8,
        // Slide to the hovered column; -1 (no pin) while `act` is 0, when
        // the panel is hidden anyway.
        left = fn() -> int {
            let a = act.get() - 1
            if a >= 0 {
                if a < n {
                    let mut x = __c_col_x(CHART_GUTTER, col_w, a) + col_w / 2 - 64
                    if x < CHART_GUTTER {
                        x = CHART_GUTTER
                    }
                    let max_l = w - 128 - CHART_GUTTER
                    if x > max_l {
                        x = max_l
                    }
                    return x
                }
            }
            return -1
        },
        on_click = fn() { return },
        a11y_role = "dialog"
    )
    show(panel, act)
    enter_fade(panel)
    __ui_push(panel.id)
    Text(fn() -> string {
        let a = act.get() - 1
        if a >= 0 {
            if a < n {
                return labels[a]
            }
        }
        return ""
    }, color = ink(), font = FONT_CAPTION)
    for j in 0..s {
        let jj = j
        Row(SPACE.Exs) {
            Box(width = 8, height = 8, radius = 2, background = chart_color(jj))
            Text(names[jj], color = mute(), font = FONT_CAPTION)
            Grow()
            Text(fn() -> string {
                let a = act.get() - 1
                if a >= 0 {
                    if a < n {
                        return "{{vals[a * s + jj]}}"
                    }
                }
                return ""
            }, color = ink(), font = FONT_CAPTION)
        }
    }
    __ui_pop()
}

/// Transparent hover column for a category. Hovering it flips its own
/// signal; a watch effect folds that into the shared `act`.
fn __c_zone(i: int, hov: Signal<int>, act: Signal<int>, h: int, col_w: int) {
    let zone = Box(width = col_w, height = h,
                        position = pos_absolute(),
                        left = __c_col_x(CHART_GUTTER, col_w, i),
                        top = 0)
    hover(zone, hov)
    styled(zone, || {
        if hov.get() > 0 {
            act.set(i + 1)
        } else {
            if act.get() == i + 1 {
                act.set(0)
            }
        }
    })
}

/// X category label under the plot, rotated 45° clockwise around its top-left.
/// Rotated labels are parallel diagonal strips, so they never collide with
/// each other however narrow the plot gets; CHART_XLAB reserves their room.
fn __c_xlab(label: string, i: int, col_w: int, plot_h: int) {
    let lab = Text(label, color = mute(), font = FONT_CAPTION,
                        position = pos_absolute(),
                        left = __c_col_x(CHART_GUTTER, col_w, i) + 3,
                        top = CHART_TOP + plot_h + 3)
    text_rot(lab, 45)
}

/// Bottom-centered legend (`flex justify-center gap-4`).
fn __c_legend(names: []string) {
    Box(align_direction = DIRECTION.Row, spacing = 16,
             justify = ALIGN.Center, wrap = 1) {
        Each(names, fn(j, name) {
            Row(SPACE.Exxs) {
                Box(width = 8, height = 8, radius = 2, background = chart_color(j))
                Text(name, color = mute(), font = FONT_CAPTION)
            }
        })
    }
}

/// Hover cursor: a hairline through the hovered column (recharts-style).
/// `act` = category + 1; the line shows and slides with it.
fn __c_cursor(act: Signal<int>, n: int, col_w: int, plot_h: int) {
    let line = Box(width = 1, height = plot_h, background = hard(),
                        opacity = 55, radius = 0, a11y_label = "cursor",
                        position = pos_absolute(),
                        top = CHART_TOP,
                        left = fn() -> int {
                            let a = act.get() - 1
                            if a >= 0 {
                                if a < n {
                                    return __c_col_x(CHART_GUTTER, col_w, a) + col_w / 2
                                }
                            }
                            return -1
                        })
    show(line, act)
}

/// Wash band behind the hovered column (recharts' active bar): a soft raised
/// rectangle that slides with `act`, under the marks.
fn __c_band(act: Signal<int>, n: int, col_w: int, plot_h: int) {
    let band = Box(width = col_w, height = plot_h, background = raised(),
                        opacity = 60, radius = 0, a11y_label = "band",
                        position = pos_absolute(),
                        top = CHART_TOP,
                        left = fn() -> int {
                            let a = act.get() - 1
                            if a >= 0 {
                                if a < n {
                                    return __c_col_x(CHART_GUTTER, col_w, a)
                                }
                            }
                            return -1
                        })
    show(band, act)
}

/// Hover zones + the shared cursor + the single following tooltip; call with
/// the plot pushed. `act` is created by the chart builder so the marks can
/// dim for the hovered column.
fn __c_tooltips(labels: []string, names: []string, vals: []int, s: int, n: int,
                h: int, w: int, col_w: int, act: Signal<int>) {
    for i in 0..n {
        let hov = signal(0)
        __c_zone(i, hov, act, h, col_w)
    }
    __c_cursor(act, n, col_w, h - CHART_TOP - CHART_XLAB)
    __c_tooltip(labels, names, vals, s, n, w, col_w, act)
}

/// Dim/restore a mark for the hovered column: full at rest or on its own
/// column, faded while another column is hovered.
fn __c_dim(act: Signal<int>, i: int) -> int {
    let a = act.get()
    if a == 0 {
        return 100
    }
    if a == i + 1 {
        return 100
    }
    return 40
}

/// Resolve the plot width: a measured host width wins (the host stretches
/// with its parent, so the chart re-fits on window resize); before the first
/// layout the caller's estimate is used.
fn __c_w(w: int, host: Node) -> int {
    let mw = node_width(host)
    if mw > CHART_GUTTER + 8 {
        return mw
    }
    return w
}

/// Grouped bar chart (shadcn bar-chart demo look). One shared y domain.
/// The plot re-fits the container: pass the intended width, and the chart
/// re-lays out whenever its card measures a different width.
fn BarChart(labels: []string, names: []string, vals: []int, w: int, h: int) {
    let n = labels.len
    let s = names.len
    if n == 0 {
        return
    }
    if s == 0 {
        return
    }
    let host = Column(SPACE.Exs)
    let nid = host.id
    refit(host, fn() {
        __c_bars(labels, names, vals, n, s, w, h, host)
    })
    // Render immediately with the requested width; the next layout refits.
    __ui_push(nid)
    __c_bars(labels, names, vals, n, s, w, h, host)
    __ui_pop()
}

fn __c_bars(labels: []string, names: []string, vals: []int, n: int, s: int,
            w: int, h: int, host: Node) {
    let gw = __c_w(w, host)
    let plot_h = h - CHART_TOP - CHART_XLAB
    let col_w = (gw - CHART_GUTTER) / n
    let domain = __c_domain(vals, s, n)
    let base_y = CHART_TOP + plot_h
    let bar_w = (col_w - 10) / s
    // Shared hovered column: zones, cursor, tooltip, and the marks read it.
    let act = signal(0)
    let plot = Box(width = gw, height = h)
    __ui_push(plot.id)
    __c_axes(gw, h, domain)
    __c_band(act, n, col_w, plot_h)
    for i in 0..n {
        let x0 = __c_col_x(CHART_GUTTER, col_w, i) + 5
        let ii = i
        for j in 0..s {
            let v = __c_val(vals, s, i, j)
            let mut bar_h = v * plot_h / domain
            if v > 0 {
                if bar_h < 1 {
                    bar_h = 1
                }
                let bar = Box(width = bar_w, height = bar_h, radius = 3,
                                   background = chart_color(j),
                                   opacity = fn() -> int { __c_dim(act, ii) },
                                   position = pos_absolute(),
                                   left = x0 + j * bar_w,
                                   top = base_y - bar_h)
            }
        }
        __c_xlab(labels[i], i, col_w, plot_h)
    }
    __c_tooltips(labels, names, vals, s, n, h, gw, col_w, act)
    __ui_pop()
    __c_legend(names)
}

/// Straight-segment line chart with dots.
fn LineChart(labels: []string, names: []string, vals: []int, w: int, h: int) {
    let n = labels.len
    let s = names.len
    if n == 0 {
        return
    }
    if s == 0 {
        return
    }
    let host = Column(SPACE.Exs)
    let nid = host.id
    refit(host, fn() {
        __c_lines(labels, names, vals, n, s, w, h, host)
    })
    __ui_push(nid)
    __c_lines(labels, names, vals, n, s, w, h, host)
    __ui_pop()
}

fn __c_lines(labels: []string, names: []string, vals: []int, n: int, s: int,
             w: int, h: int, host: Node) {
    let gw = __c_w(w, host)
    let plot_h = h - CHART_TOP - CHART_XLAB
    let col_w = (gw - CHART_GUTTER) / n
    let domain = __c_domain(vals, s, n)
    // Shared hovered column: zones, cursor, tooltip, and the marks read it.
    let act = signal(0)
    let plot = Box(width = gw, height = h)
    __ui_push(plot.id)
    __c_axes(gw, h, domain)
    __c_band(act, n, col_w, plot_h)
    for j in 0..s {
        let d = __c_line_d(vals, s, j, domain, CHART_GUTTER, col_w, plot_h,
                           CHART_TOP, n)
        __c_layer(__c_svg(d, gw, h, "none", chart_color(j), 2), gw, h)
        for i in 0..n {
            let x = __c_col_x(CHART_GUTTER, col_w, i) + col_w / 2
            let y = __c_y(domain, plot_h, CHART_TOP, __c_val(vals, s, i, j))
            let dot = Box(width = 6, height = 6, radius = 3,
                               background = chart_color(j),
                               opacity = fn() -> int { __c_dim(act, i) },
                               position = pos_absolute(),
                               left = x - 3,
                               top = y - 3)
        }
    }
    for i in 0..n {
        __c_xlab(labels[i], i, col_w, plot_h)
    }
    __c_tooltips(labels, names, vals, s, n, h, gw, col_w, act)
    __ui_pop()
    __c_legend(names)
}

/// Area chart: tinted fill under the line (fill follows appearance).
fn AreaChart(labels: []string, names: []string, vals: []int, w: int, h: int) {
    let n = labels.len
    let s = names.len
    if n == 0 {
        return
    }
    if s == 0 {
        return
    }
    let host = Column(SPACE.Exs)
    let nid = host.id
    refit(host, fn() {
        __c_areas(labels, names, vals, n, s, w, h, host)
    })
    __ui_push(nid)
    __c_areas(labels, names, vals, n, s, w, h, host)
    __ui_pop()
}

fn __c_areas(labels: []string, names: []string, vals: []int, n: int, s: int,
             w: int, h: int, host: Node) {
    let gw = __c_w(w, host)
    let plot_h = h - CHART_TOP - CHART_XLAB
    let col_w = (gw - CHART_GUTTER) / n
    let domain = __c_domain(vals, s, n)
    // Shared hovered column: zones, cursor, tooltip, and the marks read it.
    let act = signal(0)
    let plot = Box(width = gw, height = h)
    __ui_push(plot.id)
    __c_axes(gw, h, domain)
    __c_band(act, n, col_w, plot_h)
    for j in 0..s {
        let d = __c_area_d(vals, s, j, domain, CHART_GUTTER, col_w, plot_h,
                           CHART_TOP, n)
        let fd = __c_svg(d, gw, h, __c_fd(j), "none", 0)
        let fl = __c_svg(d, gw, h, __c_fl(j), "none", 0)
        let area_l = __c_layer(fl, gw, h)
        let area_d = __c_layer(fd, gw, h)
        show_eq(area_l, appearance(), 0)
        show_eq(area_d, appearance(), 1)
        let dl = __c_line_d(vals, s, j, domain, CHART_GUTTER, col_w, plot_h,
                            CHART_TOP, n)
        __c_layer(__c_svg(dl, gw, h, "none", chart_color(j), 2), gw, h)
        for i in 0..n {
            let x = __c_col_x(CHART_GUTTER, col_w, i) + col_w / 2
            let y = __c_y(domain, plot_h, CHART_TOP, __c_val(vals, s, i, j))
            let dot = Box(width = 6, height = 6, radius = 3,
                               background = chart_color(j),
                               opacity = fn() -> int { __c_dim(act, i) },
                               position = pos_absolute(),
                               left = x - 3,
                               top = y - 3)
        }
    }
    for i in 0..n {
        __c_xlab(labels[i], i, col_w, plot_h)
    }
    __c_tooltips(labels, names, vals, s, n, h, gw, col_w, act)
    __ui_pop()
    __c_legend(names)
}

// --- calendar internals ---

const CAL_CELL: int = 36

fn cal_leap(year: int) -> int {
    if year % 4 != 0 {
        return 0
    }
    if year % 100 != 0 {
        return 1
    }
    if year % 400 == 0 {
        return 1
    }
    return 0
}

fn cal_len(year: int, month: int) -> int {
    if month == 2 {
        if cal_leap(year) != 0 {
            return 29
        }
        return 28
    }
    if month == 4 {
        return 30
    }
    if month == 6 {
        return 30
    }
    if month == 9 {
        return 30
    }
    if month == 11 {
        return 30
    }
    return 31
}

fn cal_month_t(month: int) -> int {
    if month == 1 { return 0 }
    if month == 2 { return 3 }
    if month == 3 { return 2 }
    if month == 4 { return 5 }
    if month == 5 { return 0 }
    if month == 6 { return 3 }
    if month == 7 { return 5 }
    if month == 8 { return 1 }
    if month == 9 { return 4 }
    if month == 10 { return 6 }
    if month == 11 { return 2 }
    return 4
}

fn cal_first_monday(year: int, month: int) -> int {
    let mut y = year
    if month < 3 {
        y = y - 1
    }
    let s = y + y / 4 - y / 100 + y / 400 + cal_month_t(month) + 1
    let sun = s % 7
    return (sun + 6) % 7
}

/// Ghost icon step button for the month/year rails.
fn CalStep(markup: string, label: string, press: fn()) {
    Box(align_direction = DIRECTION.Row,
        width = 28,
        height = 28,
        radius = RAD_MD,
        align_items = ALIGN.Center,
        justify = ALIGN.Center,
        on_click = press,
        a11y_role = "button",
        a11y_label = label,
        hover_off = true,
        cursor = "pointer"
    ) {
        Icon(markup, 16, mute)
    }
}

fn CalWeekday(s: string) {
    Box(align_direction = DIRECTION.Row, width = CAL_CELL, height = 24,
             align_items = ALIGN.Center, justify = ALIGN.Center) {
        Text(s, color = dim(), font = FONT_CAPTION)
    }
}

fn CalWeekRow() {
    let n = Grid(config = GridConfig(columns = 7, gap = 4))
    __ui_push(n.id)
    CalWeekday("Mo")
    CalWeekday("Tu")
    CalWeekday("We")
    CalWeekday("Th")
    CalWeekday("Fr")
    CalWeekday("Sa")
    CalWeekday("Su")
    __ui_pop()
}

fn cal_month_name(m: int) -> string {
    if m == 1 { return "January" }
    if m == 2 { return "February" }
    if m == 3 { return "March" }
    if m == 4 { return "April" }
    if m == 5 { return "May" }
    if m == 6 { return "June" }
    if m == 7 { return "July" }
    if m == 8 { return "August" }
    if m == 9 { return "September" }
    if m == 10 { return "October" }
    if m == 11 { return "November" }
    return "December"
}

/// Day number for grid cell `idx` (0-based) in the month `m` of `year`,
/// or 0 for a leading/trailing blank. Cells stay fixed; the value is
/// recomputed from the live y/m signals, so flipping month or year only
/// re-runs the cell prop thunks — no rebuild, no 12 pre-built grids.
fn cal_day_at(year: int, m: int, idx: int) -> int {
    let day = idx - cal_first_monday(year, m) + 1
    if day < 1 {
        return 0
    }
    if day > cal_len(year, m) {
        return 0
    }
    return day
}

fn CalCell(y: Signal<int>, m: Signal<int>, d: Signal<int>, open: Signal<int>, idx: int) {
    Box(
        align_direction = DIRECTION.Row,
        width = CAL_CELL,
        height = CAL_CELL,
        radius = RAD_LG,
        align_items = ALIGN.Center,
        justify = ALIGN.Center,
        // `""` never clears a fill (hex -1 is skipped), so the deselected
        // state repaints the panel surface — otherwise the last picked day
        // keeps its accent after the selection moves.
        background = fn() -> string {
            let day = cal_day_at(y.get(), m.get(), idx)
            if day > 0 {
                if d.get() == day {
                    return accent()
                }
            }
            return plate()
        },
        on_click = fn() {
            let day = cal_day_at(y.get(), m.get(), idx)
            if day > 0 {
                d.set(day)
                open.set(0)
            }
        },
        a11y_role = "button",
        a11y_label = fn() -> string {
            let day = cal_day_at(y.get(), m.get(), idx)
            if day > 0 {
                return "{{day}}"
            }
            return ""
        },
        padding_x = 2,
        cursor = "pointer"
    ) {
        Text(fn() -> string {
            let day = cal_day_at(y.get(), m.get(), idx)
            if day > 0 {
                return "{{day}}"
            }
            return ""
        },
        color = fn() -> string {
            let day = cal_day_at(y.get(), m.get(), idx)
            if day > 0 {
                if d.get() == day {
                    return on_ink()
                }
            }
            return ink()
        },
        font = FONT_BODY)
    }
}

/// One 7×6 grid for whichever month `m` names: 42 fixed cells whose content
/// tracks `y`/`m`/`d` through prop thunks. Built once, no per-month subtrees.
fn CalGrid(y: Signal<int>, m: Signal<int>, d: Signal<int>, open: Signal<int>) {
    let n = Grid(config = GridConfig(columns = 7, gap = 3))
    __ui_push(n.id)
    for i in 0..42 {
        CalCell(y, m, d, open, i)
    }
    __ui_pop()
}

/// Calendar picker: label, input-like trigger with a calendar icon, and a
/// floating sheet (kind-9 so the page scroller cannot clip it). Month and
/// year rails step with chevron icons; picking a day closes the sheet.
fn DatePicker(y: Signal<int>, m: Signal<int>, d: Signal<int>) {
    let open = signal(0)
    // Invisible full-window scrim: the first click that misses the popover
    // closes it. It is created before the anchor, so the calendar panel (a
    // z-indexed floater) hit-tests above it; the panel itself swallows clicks.
    let scrim = Overlay(
        background = "",
        on_click = fn() => open.set(0)
    )
    show(scrim, open)
    let anchor = Column(SPACE.Exs) {
        Label("Date")
        Box(
            align_direction = DIRECTION.Row,
            spacing = 4,
            width = 200,
            align_items = ALIGN.Center,
            background = plate(),
            border = HAIRLINE,
            border_color = rule(),
            radius = RAD_MD,
            padding_x = 12,
            padding_y = 8,
            on_click = fn() => open.set(1 - open.get()),
            a11y_role = "button",
            a11y_label = "Pick a date",
            cursor = "pointer"
        ) {
            Icon(IC_CALENDAR, 16, mute)
            Text("{{y.get()}}", color = ink(), font = FONT_BODY)
            Text("-", color = mute(), font = FONT_BODY)
            Text("{{m.get()}}", color = ink(), font = FONT_BODY)
            Text("-", color = mute(), font = FONT_BODY)
            Text("{{d.get()}}", color = ink(), font = FONT_BODY)
        }
    }
    __ui_push(anchor.id)
    let panel = Box(
        align_direction = DIRECTION.Column,
        width = 320,
        padding = 12,
        spacing = SPACE.Exs,
        background = plate(),
        border = HAIRLINE,
        border_color = rule(),
        radius = RAD_LG,
        // Label (18) + gap (8) + trigger (36) + 6pt of air: hang below.
        position = pos_absolute(),
        top = 68,
        left = 0,
        z_index = 20,
        a11y_role = "dialog",
        on_click = fn() { return }
    )
    show(panel, open)
    __ui_pop()
    __ui_push(panel.id)
    Row(4) {
        CalStep(IC_CHEV_LEFT, "Previous month", fn() {
            if m.get() <= 1 {
                m.set(12)
            } else {
                m.set(m.get() - 1)
            }
        })
        // One text node whose label tracks `m`; the rails are its only
        // writers, so no pre-built name stack is needed. Centered between
        // the month steps so long and short names do not jump the arrows.
        Box(align_direction = DIRECTION.Row,
                 justify = ALIGN.Center,
                 align_items = ALIGN.Center,
                 grow = 1) {
            Text(fn() -> string {
                return cal_month_name(m.get())
            }, color = ink(), font = FONT_BODY)
        }
        CalStep(IC_CHEV_RIGHT, "Next month", fn() {
            if m.get() >= 12 {
                m.set(1)
            } else {
                m.set(m.get() + 1)
            }
        })
        Grow()
        CalStep(IC_CHEV_LEFT, "Previous year", fn() => y.set(y.get() - 1))
        // Bound text paints the live year — same trick the gauge widgets use.
        bind(Text("", color = ink(), font = FONT_BODY), y)
        CalStep(IC_CHEV_RIGHT, "Next year", fn() => y.set(y.get() + 1))
    }
    CalWeekRow()
    CalGrid(y, m, d, open)
    __ui_pop()
}

/// Page: white background column with breathing room. Sets the native
/// roles once; every following component reads them at paint.
fn Page() -> Node {
    roles()
    return Box(align_direction = DIRECTION.Column, spacing = SECTION,
                    padding = PAGE_PAD, background = paper(), grow = 1)
}
